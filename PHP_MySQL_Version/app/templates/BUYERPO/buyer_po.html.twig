{% extends "_layout.html.twig" %}

{% block header_incoterm %}<span class="incoterm">ORDER ACCEPTANCE — Issued to Buyer for Signature and Return</span>{% endblock %}

{% block meta_table %}
<p class="placeholder-italic" style="font-size:9pt; margin:0 0 4pt;">This Purchase Order is prepared by NexaCrest and sent to the buyer for signature and return. Buyer fills Column B of Section 4 only. All other fields are pre-filled by NexaCrest.</p>
<table class="meta">
  <tr>
    <td><span class="label">PO NUMBER *</span><span class="value">{{ meta.document_reference }} {{ meta.client_revision_label }}</span></td>
    <td><span class="label">DATE *</span><span class="value">{{ meta.generated_date }}</span></td>
    <td><span class="label">QT REFERENCE *</span><span class="value">{{ order.quotation_ref ?: '—' }}</span></td>
    <td><span class="label">BUYER INQUIRY REF *</span><span class="value">{{ order.buyer_inquiry_ref }}</span></td>
  </tr>
</table>
{% endblock %}

{% block banner %}
<div class="banner banner-amber">&#9201;&nbsp; <span class="label">VALID UNTIL *</span> &nbsp; <span class="value">{{ order.quotation_valid_until ?: 'TBC' }}</span> &nbsp;&nbsp;<span class="note">This Purchase Order must be signed and returned before the Quotation validity expires.</span></div>
{% endblock %}

{% block body %}

<div class="section-title">2. BUYER / CONSIGNEE DETAILS &nbsp;(Pre-filled by NexaCrest — buyer to confirm)</div>
<table class="kv">
  <tr><td class="k">Company Legal Name *</td><td class="v">{{ buyer.company_legal_name }}</td></tr>
  <tr><td class="k">Billing Address *</td><td class="v">{{ buyer.billing_address }}</td></tr>
  <tr><td class="k">Consignee Name *</td><td class="v">{{ buyer.consignee_name }}</td></tr>
  <tr><td class="k">Consignee Address *</td><td class="v">{{ buyer.consignee_address }}</td></tr>
  <tr><td class="k">VAT / EORI / Tax Reg. *</td><td class="v">{{ buyer.vat_eori_tax_no ?: 'TBC' }}</td></tr>
  <tr><td class="k">Contact Person *</td><td class="v">{{ buyer.contact_person ?: 'TBC' }}</td></tr>
  <tr><td class="k">Phone *</td><td class="v">{{ buyer.phone ?: '—' }}</td></tr>
  <tr><td class="k">Email *</td><td class="v">{{ buyer.email ?: 'TBC' }}</td></tr>
  <tr><td class="k">Country of Destination *</td><td class="v">{{ buyer.country_of_destination ?: 'TBC' }}</td></tr>
  <tr><td class="k">Port of Discharge *</td><td class="v">{{ order.port_of_discharge }}</td></tr>
</table>

<div class="section-title">3. ORDER DETAILS &nbsp;(Pre-filled from Quotation — buyer to confirm)</div>
{% set productList = [] %}
{% for p in products %}
  {% set productList = productList|merge([p.description]) %}
{% endfor %}
<table class="kv">
  <tr><td class="k">Against Quotation No. *</td><td class="v">{{ order.quotation_ref ?: '—' }} <span class="placeholder-italic" style="font-size:8.5pt;">(fixed)</span></td></tr>
  <tr><td class="k">Quotation Date *</td><td class="v">{{ order.quotation_date ?: '—' }} <span class="placeholder-italic" style="font-size:8.5pt;">(fixed)</span></td></tr>
  <tr><td class="k">Product Description *</td><td class="v">{{ productList|join('; ') }}</td></tr>
  <tr><td class="k">Quantity *</td><td class="v">{{ products|first ? (products|first).quantity : 'TBC' }}</td></tr>
  <tr><td class="k">Unit *</td><td class="v">{{ products|first ? (products|first).unit : 'TBC' }}</td></tr>
  <tr><td class="k">Unit Price ({{ order.currency_code }}) *</td><td class="v">{{ products|first ? (products|first).unit_price : 'TBC' }}</td></tr>
  <tr><td class="k">Total FOB Value ({{ order.currency_code }}) *</td><td class="v">{{ financial.fob_value }}</td></tr>
  <tr><td class="k">Incoterm</td><td class="v">{{ order.incoterm_label }}</td></tr>
  <tr><td class="k">Port of Loading</td><td class="v">{{ order.port_of_loading }}</td></tr>
  <tr><td class="k">Port of Discharge *</td><td class="v">{{ order.port_of_discharge }}</td></tr>
  <tr><td class="k">Certificate of Origin *</td><td class="v">{{ order.coo_type }}</td></tr>
  <tr><td class="k">Payment Terms</td><td class="v">{{ financial.advance_pct }}% advance T/T against Proforma Invoice before production. {{ financial.balance_pct }}% balance T/T before shipment — {{ financial.balance_terms_text }} Freight &amp; Insurance (CFR/CIF): invoiced separately by Freight Debit Note before shipment.</td></tr>
</table>

<div class="section-title">4. BUYER ACCEPTANCE &nbsp;(Buyer fills this section, signs and returns)</div>
<table class="kv" style="table-layout:fixed;">
  <tr>
    <td colspan="1" style="background:#173B73; color:#FFFFFF; font-weight:bold; width:50%;">Prepared &amp; Issued by NexaCrest</td>
    <td colspan="1" style="background:#173B73; color:#FFFFFF; font-weight:bold; width:50%;">Accepted by Buyer &nbsp;&#8226;&nbsp; Fill, Sign &amp; Return</td>
  </tr>
  <tr>
    <td class="v" style="vertical-align:top;">
      {% if signatory.signature_data_uri %}<img class="signature-img" src="{{ signatory.signature_data_uri }}"><br>{% endif %}
      {% if signatory.seal_data_uri %}<img class="seal-img" src="{{ signatory.seal_data_uri }}"><br>{% endif %}
      <p style="margin:8pt 0 0;"><strong style="color:#17233A;">{{ signatory.name }}</strong><br>{{ signatory.designation }}<br><span style="font-size:8.5pt; color:#555555;">{{ company.legal_name }}</span></p>
    </td>
    <td class="v" style="vertical-align:top; background:#FFFDE7;">
      <p style="margin:0 0 4pt;"><strong>Authorised Signature:</strong><br><span style="color:#999999;">_________________________________</span></p>
      <p style="margin:0 0 2pt;">Name: _____________________________</p>
      <p style="margin:0 0 2pt;">Designation: ______________________</p>
      <p style="margin:0 0 2pt;">Buyer's PO No.: __________________ <span class="placeholder-italic" style="font-size:8pt;">(write NIL if not applicable)</span></p>
      <p style="margin:0 0 4pt;"><strong>Date:</strong> _____________________________</p>
      <p style="margin:0; font-size:8.5pt; color:#888888; font-style:italic;">Company Stamp: (if applicable)</p>
    </td>
  </tr>
</table>

<div class="banner" style="background:#E8F1FB; color:#185FA5; text-align:left; font-weight:normal;">
  <p style="margin:0 0 6pt;">By signing above, the buyer confirms acceptance of all order details, specifications and payment terms stated in this Purchase Order. <strong>This signed Purchase Order authorises NexaCrest to issue the Proforma Invoice and commence production upon receipt of the {{ financial.advance_pct }}% advance payment.</strong> <span style="color:#000000;">The following clauses are legally binding on both parties:</span></p>
  {% for clause in terms %}
  {% set clauseParts = clause|split(': ', 2) %}
  <p style="margin:0 0 6pt; color:#000000;">&#8226; <strong>{{ clauseParts[0] }}:</strong> {{ clauseParts[1]|default('') }}</p>
  {% endfor %}
</div>

<table class="kv"><tr><td colspan="2" style="background:#F1F5F9; font-style:italic; font-size:8.5pt; color:#555555;">This Purchase Order form is prepared by NexaCrest International Private Limited for the exclusive use of the named buyer against Quotation No. {{ order.quotation_ref ?: '—' }} only. It is not transferable and cannot be used with any other supplier. Any unauthorised use or modification of this document is prohibited.</td></tr></table>

{% endblock %}

{% block terms_section %}{% endblock %}

{% block signature_block %}{% endblock %}

{% block annexure_appendix %}
{% if order.include_annexure_a and annexure_products is defined and annexure_products is not empty %}
<div class="annexure-appendix-start">
  <div class="section-title">ANNEXURE A &nbsp;— &nbsp;PRODUCT TECHNICAL SPECIFICATIONS</div>
  {% include '_annexure_body.html.twig' %}
</div>
{% endif %}
{% endblock %}
