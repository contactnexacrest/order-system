{% extends "_layout.html.twig" %}

{% block header_incoterm %}<span class="incoterm">FREIGHT COST RECOVERY</span>{% endblock %}

{% block meta_table %}
<table class="meta">
  <tr>
    <td><span class="label">DEBIT NOTE NO. *</span><span class="value">{{ meta.document_reference }} {{ meta.revision_label }}</span></td>
    <td><span class="label">DATE *</span><span class="value">{{ meta.generated_date }}</span></td>
    <td><span class="label">PI REFERENCE *</span><span class="value">{{ order.pi_ref ?: '—' }}</span></td>
    <td><span class="label">BUYER INQUIRY REF *</span><span class="value">{{ order.buyer_inquiry_ref }}</span></td>
  </tr>
</table>
{% endblock %}

{% block banner %}
<div class="banner banner-red">
  <span class="headline">&#9201;&nbsp; PAYMENT REQUIRED BEFORE SHIPMENT</span>
  <span class="sub">Payment of this Freight Debit Note is required within <strong>3 working days</strong> of the date above. NexaCrest will confirm shipment booking and hand over cargo to the shipping line <strong>only upon receipt of full freight payment.</strong></span>
</div>
{% endblock %}

{% block body %}

<div class="section-title">2. TO (BUYER)</div>
<table class="kv">
  <tr><td class="k">Company Legal Name *</td><td class="v">{{ buyer.company_legal_name }}</td></tr>
  <tr><td class="k">Billing Address *</td><td class="v">{{ buyer.billing_address }}</td></tr>
  <tr><td class="k">Contact Person *</td><td class="v">{{ buyer.contact_person ?: 'TBC' }}</td></tr>
  <tr><td class="k">Email *</td><td class="v">{{ buyer.email ?: 'TBC' }}</td></tr>
</table>

<div class="section-title">3. ORDER REFERENCE</div>
{% set productList = [] %}
{% for p in products %}
  {% set productList = productList|merge([p.description ~ ' (' ~ p.quantity ~ ' ' ~ p.unit ~ ')']) %}
{% endfor %}
<table class="kv">
  <tr><td class="k">Proforma Invoice No. *</td><td class="v">{{ order.pi_ref ?: '—' }}</td></tr>
  <tr><td class="k">Product(s)</td><td class="v">{{ productList|join('; ') }}</td></tr>
  <tr><td class="k">Incoterm *</td><td class="v">{{ order.incoterm_label }}. Freight recovery applies as agreed under the referenced Proforma Invoice.</td></tr>
  <tr><td class="k">Port of Loading *</td><td class="v">{{ order.port_of_loading }}</td></tr>
  <tr><td class="k">Port of Discharge *</td><td class="v">{{ order.port_of_discharge }}</td></tr>
  <tr><td class="k">Shipping Line</td><td class="v">{{ freight.freight_forwarder_name ?: 'TBC' }}</td></tr>
  <tr><td class="k">Cargo Status *</td><td class="v">{{ packing.packing_date ? 'Packed and ready for shipment as of ' ~ packing.packing_date : 'TBC' }}</td></tr>
</table>

<div class="section-title">4. FREIGHT &amp; CHARGES</div>
<table class="products">
  <tr><th>Description *</th><th>Container Type *</th><th>Amount ({{ order.currency_code }}) *</th><th>Remarks</th></tr>
  <tr>
    <td>Ocean Freight</td>
    <td class="placeholder-italic">{{ order.container_type }}</td>
    <td class="num">{{ freight.confirmed_freight_rate ?: 'TBC' }}</td>
    <td class="placeholder-italic" style="font-size:8.5pt;">Confirmed rate — {{ order.port_of_loading }} to {{ order.port_of_discharge }}</td>
  </tr>
  <tr style="background:#F1F5F9;">
    <td>Origin Charges (if any)</td>
    <td></td>
    <td class="num placeholder-italic">NIL</td>
    <td class="placeholder-italic" style="font-size:8.5pt;">THC, documentation charges at {{ order.port_of_loading }} — if applicable</td>
  </tr>
  <tr>
    <td>Insurance</td>
    <td></td>
    <td class="num">{% if order.incoterm_code == 'CIF' %}{{ freight.insurance_amount ?: 'TBC' }}{% else %}NIL{% endif %}</td>
    <td class="placeholder-italic" style="font-size:8.5pt;">CIF only — if FOB/CFR enter NIL</td>
  </tr>
  <tr style="background:#F1F5F9;">
    <td>GST / IGST (if applicable)</td>
    <td></td>
    <td class="num">{{ freight.gst_treatment == 'IGST_18' ? '18% IGST' : 'NIL' }}</td>
    <td class="placeholder-italic" style="font-size:8.5pt;">As advised by CA — NIL if pure cost reimbursement</td>
  </tr>
</table>
<table class="totals">
  <tr class="highlight"><td class="k">TOTAL AMOUNT DUE ({{ order.currency_code }}) * &nbsp;<span style="font-weight:normal; font-style:italic; font-size:8.5pt;">(incl. GST if applicable)</span></td><td class="v" style="font-style:italic;">{{ freight.total_freight_and_insurance ?: 'TBC' }}</td></tr>
</table>

<div class="section-title">5. PAYMENT INSTRUCTIONS</div>
<div class="banner banner-red" style="text-align:left; font-size:9.5pt; font-weight:normal;">
  <p style="margin:0 0 4pt;"><strong>Payment Due:</strong> <span style="color:#5A1414;">Within 3 working days of this Debit Note date — by <em>{{ freight.payment_due_date ?: 'TBC' }}</em></span> <strong style="color:#C0392B;">*</strong></p>
  <p style="margin:0 0 4pt;"><strong>Payment Method:</strong> <span style="color:#5A1414;">T/T (Telegraphic Transfer) to the NexaCrest bank account below</span></p>
  <p style="margin:0 0 4pt;"><strong>Reference:</strong> <span style="color:#5A1414;">Quote Debit Note No. <em>{{ meta.document_reference }}</em> and PI No. <em>{{ order.pi_ref ?: '—' }}</em> in the remittance</span></p>
  <p style="margin:0;"><strong>&#9888; Critical:</strong> <span style="color:#5A1414;">Share bank remittance copy as per Section 1 contact details above immediately after payment. Shipment booking will be confirmed only upon verification of freight receipt.</span></p>
</div>

<div class="section-title">6. BANK DETAILS &nbsp;(for freight T/T payment)</div>
<table class="kv">
  <tr><td class="k">Account Holder</td><td class="v">{{ company.legal_name|upper }}</td></tr>
  <tr><td class="k">Bank</td><td class="v">{{ company.bank_name }}</td></tr>
  <tr><td class="k">Branch</td><td class="v">{{ company.bank_branch }}</td></tr>
  <tr><td class="k">Account No.</td><td class="v">{{ company.bank_account_no }}</td></tr>
  <tr><td class="k">IFSC</td><td class="v">{{ company.ifsc }}</td></tr>
  <tr><td class="k">SWIFT / BIC</td><td class="v">{{ company.swift_bic }}</td></tr>
  <tr><td class="k">Bank Address</td><td class="v">{{ company.bank_address }}</td></tr>
  <tr><td class="k">Payment Reference</td><td class="v" style="color:#185FA5;">Please quote FDN No. {{ meta.document_reference }} in your wire transfer remarks.</td></tr>
  <tr><td class="k">RBI Purpose Code</td><td class="v" style="color:#185FA5; font-weight:bold;">{{ company.rbi_purpose_code_freight }} — enter in the "Purpose of Remittance" field of your wire transfer form.</td></tr>
</table>

{% endblock %}
