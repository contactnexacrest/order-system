{% extends "_layout.html.twig" %}

{% block meta_table %}
<table class="meta">
  <tr>
    <td><span class="label">PI NUMBER *</span><span class="value">{{ meta.document_reference }} {{ meta.client_revision_label }}</span></td>
    <td><span class="label">PI DATE *</span><span class="value">{{ order.pi_date ?: meta.generated_date }}</span></td>
    <td><span class="label">QUOTATION REF *</span><span class="value">{{ order.quotation_ref ?: '—' }}</span></td>
    <td><span class="label">BUYER INQUIRY REF *</span><span class="value">{{ order.buyer_inquiry_ref }}</span></td>
  </tr>
</table>
{% endblock %}

{% block banner %}
<div class="banner banner-amber">&#9201;&nbsp; <span class="label">VALID UNTIL *</span> &nbsp; <span class="value">{{ order.pi_valid_until ?: 'To Be Confirmed' }}</span> &nbsp;&nbsp;<span class="note">Payment must be received before this date for prices and terms to remain valid.</span></div>
<div class="banner banner-green"><span class="label">GST DECLARATION:</span> <span class="value">Supply meant for export under Letter of Undertaking (LUT) without payment of Integrated Tax (IGST).</span> <span class="label">LUT Order No.: {{ company.lut_number }}</span> <span class="value">&nbsp;·&nbsp; Valid for {{ company.lut_valid_fy }} &nbsp;·&nbsp; GSTIN: {{ company.gstin }}</span></div>
{% endblock %}

{% block body %}

{% include '_buyer_details.html.twig' with {'section_number': 2} %}
{% include '_consignee_details.html.twig' with {'section_number': 3} %}
{% include '_notify_party.html.twig' with {'section_number': 4} %}
<table class="kv">
  <tr><td class="k">Certificate of Origin Type</td><td class="v">{{ order.coo_type }}</td></tr>
  <tr><td class="k">Buyer's PO / Ref No.</td><td class="v">{{ order.buyers_po_ref }}</td></tr>
</table>

<div class="section-title">5. PRODUCT / ORDER DETAILS</div>
<table class="products">
  <tr><th>#</th><th>Product Description *</th><th>Qty *</th><th>Unit *</th><th>Unit Price ({{ order.currency_code }}) *</th><th>Amount ({{ order.currency_code }}) *</th></tr>
  {% for p in products %}
  {% set lineColor = loop.index is odd ? '#1D6FA8' : '#2D7D56' %}
  <tr>
    <td class="line-no" style="color:{{ lineColor }};">{{ loop.index }}</td>
    <td>{{ p.description }}</td>
    <td class="num">{{ p.quantity }}</td>
    <td>{{ p.unit }}</td>
    <td class="num">{{ p.unit_price }}</td>
    <td class="num">{{ p.amount }}</td>
  </tr>
  {% if p.dimensions or p.finish %}
  <tr class="spec">
    <td></td>
    <td colspan="5">
      <span class="line-no" style="color:{{ lineColor }};">{{ loop.index }}.</span>
      <span class="spec-label">Dimensions:</span> {{ p.dimensions ?: 'To Be Confirmed' }}
      <span class="spec-sep">&nbsp;&middot;&nbsp;</span><span class="spec-label">Finish:</span> {{ p.finish ?: 'To Be Confirmed' }}
      <span class="spec-sep">&nbsp;&middot;&nbsp;</span><span class="spec-label">HS Code:</span> {{ p.hs_code }}
      <span class="spec-sep">&nbsp;&middot;&nbsp;</span><span class="spec-label">Country of Origin:</span> India
    </td>
  </tr>
  {% endif %}
  {% endfor %}
</table>

<table class="totals">
  {% for p in products %}
  <tr><td class="k" style="text-align:right;">{{ p.description }} ({{ p.quantity }} {{ p.unit }} &times; {{ p.unit_price }})</td><td class="v" style="text-align:right; font-style:italic; color:#5B6573;">{{ order.currency_code }} {{ p.amount }}</td></tr>
  {% endfor %}
  <tr class="highlight"><td class="k" style="text-align:right;">TOTAL PI VALUE ({{ order.currency_code }}) *</td><td class="v" style="text-align:right;">{{ financial.fob_value }}</td></tr>
</table>
<p><strong style="color:#17233A;">Remark:</strong> <em style="color:#5B6573;">Loading quantity subject to final packing confirmation.</em></p>

<table class="totals">
  <tr><td class="k">FOB Value ({{ order.currency_code }}) *</td><td class="v">{{ financial.fob_value }}</td></tr>
  <tr><td class="k">Freight ({{ order.currency_code }})</td><td class="v">
    {% if order.is_fob %}NIL — freight arranged by buyer.{% else %}Indicative approx. {{ order.currency_code }} {{ order.indicative_freight_low ?: 'XXX' }}–{{ order.indicative_freight_high ?: 'XXX' }} per {{ order.container_type }}, {{ order.port_of_loading }} to {{ order.port_of_discharge }}. Subject to confirmation at time of booking. Actual freight confirmed and recovered IN ADVANCE by separate Debit Note when cargo is packed and ready — payment required within 3 Calendar Days, and must be received BEFORE shipment booking is confirmed.{% endif %}
  </td></tr>
  <tr><td class="k">Insurance ({{ order.currency_code }})</td><td class="v">
    {% if order.is_fob %}NIL — buyer's responsibility.{% else %}Indicative approx. {{ order.currency_code }} {{ order.indicative_insurance_amount ?: 'XX' }}. Confirmed by Debit Note when cargo is ready.{% endif %}
  </td></tr>
  <tr class="highlight"><td class="k">TOTAL PI VALUE ({{ order.currency_code }}) *</td><td class="v">{{ financial.total_value }}</td></tr>
</table>

<p class="weight-caption">Weight &amp; Volume <span class="note">(Estimated — actuals confirmed on Packing List after production and packing)</span></p>
<table class="weight">
  <tr><th>Parameter</th><th>Estimated Value *</th><th>Unit</th></tr>
  <tr><td>Total CBM (m&sup3;)</td><td>{{ order.estimated_total_cbm ?: 'To Be Confirmed' }}</td><td>m&sup3;</td></tr>
  <tr><td>Gross Weight (incl. packing)</td><td>{{ order.estimated_gross_weight_kg ?: 'To Be Confirmed' }}</td><td>kg</td></tr>
  <tr><td>Net Weight (stone only)</td><td>{{ order.estimated_net_weight_kg ?: 'To Be Confirmed' }}</td><td>kg</td></tr>
  <tr><td>No. of Packages / Crates</td><td>{{ order.estimated_package_count }}</td><td>Crates</td></tr>
  <tr><td>Package Type</td><td>{{ order.estimated_package_type }}</td><td>—</td></tr>
</table>

<div class="section-title">6. SHIPPING / COMMERCIAL TERMS</div>
<table class="kv">
  <tr><td class="k">Incoterm *</td><td class="v">{{ order.incoterm_label }}</td></tr>
  <tr><td class="k">Port of Loading *</td><td class="v">{{ order.port_of_loading }}</td></tr>
  <tr><td class="k">Port of Discharge *</td><td class="v">{{ order.port_of_discharge }}</td></tr>
  <tr><td class="k">Container Type</td><td class="v">{{ order.container_type }}</td></tr>
  <tr><td class="k">Est. Shipment Date</td><td class="v">{{ order.est_shipment_date_text }}</td></tr>
  <tr><td class="k">Insurance</td><td class="v">{% if order.is_fob %}Buyer's responsibility.{% else %}Seller arranges — cost included in invoice.{% endif %}</td></tr>
</table>

<div class="section-title">7. PAYMENT TERMS</div>
<div class="bullet-block">
  <p>&#8226; {{ financial.advance_pct }}% Advance Payment on FOB Value against this document. <span class="mand-star">*</span></p>
  <p class="sub-line">&nbsp;&nbsp;{{ financial.advance_pct }}% Advance Amount:&nbsp;&nbsp;{{ order.currency_code }} {{ financial.advance_amount }} <span class="mand-star">*</span></p>
  <p>&#8226; {{ financial.balance_pct }}% Balance Payment on FOB Value {{ financial.balance_terms_text }} <span class="mand-star">*</span></p>
  <p class="sub-line">&nbsp;&nbsp;{{ financial.balance_pct }}% Balance Amount:&nbsp;&nbsp;{{ order.currency_code }} {{ financial.balance_amount }} <span class="mand-star">*</span></p>
  {% if not order.is_fob %}
  <p>&#8226; Freight &amp; Insurance (CFR/CIF orders only): <span class="sub-line">Actual confirmed amounts invoiced separately by Debit Note before shipment booking is confirmed. Payment required within 3 Calendar Days of Debit Note date.</span></p>
  {% endif %}
  <p>&nbsp;&nbsp;Currency: {{ order.currency_code }}</p>
</div>

<table class="kv">
  <tr><td colspan="2" style="background:#F1F5F9;">
    <p style="margin:0 0 4pt;"><strong style="color:#17233A;">Production status: </strong>{{ order.production_status_text }} &nbsp;&nbsp; <strong style="color:#17233A;">Estimated shipment: </strong><span style="font-style:italic; color:#5B6573;">{{ order.est_shipment_date_text }}</span> <span style="font-weight:bold; color:#C0392B;">*</span></p>
    <p style="margin:0; font-size:9pt;"><strong style="color:#17233A;">Note: </strong><span style="font-style:italic; color:#5B6573;">Estimated shipment date is indicative and subject to production completion, packing, and port scheduling. A confirmed Bill of Lading date will be communicated once the shipment is booked.</span></p>
  </td></tr>
</table>

<div class="section-title">8. BANK DETAILS</div>
<table class="kv">
  <tr><td class="k">Account Holder</td><td class="v">{{ company.legal_name|upper }}</td></tr>
  <tr><td class="k">Bank</td><td class="v">{{ company.bank_name }}</td></tr>
  <tr><td class="k">Branch</td><td class="v">{{ company.bank_branch }}</td></tr>
  <tr><td class="k">Account No.</td><td class="v">{{ company.bank_account_no }}</td></tr>
  <tr><td class="k">IFSC</td><td class="v">{{ company.ifsc }}</td></tr>
  <tr><td class="k">SWIFT / BIC</td><td class="v">{{ company.swift_bic }}</td></tr>
  <tr><td class="k">Bank Address</td><td class="v">{{ company.bank_address }}</td></tr>
  <tr><td class="k">Payment Reference</td><td class="v" style="color:#185FA5;">Please quote PI No. {{ meta.document_reference }} in your wire transfer remarks.</td></tr>
  <tr><td class="k">RBI Purpose Code</td><td class="v" style="color:#185FA5;">
    <strong>P0103</strong> — Advance Payment &nbsp;|&nbsp; <strong>P0102</strong> — Balance Payment &nbsp;|&nbsp; <strong>P0602</strong> — Freight/Insurance Recovery &nbsp;|&nbsp; <strong>P1022</strong> — Inspection/Certificate Fees &nbsp;|&nbsp; <strong>P0214</strong> — Port/Demurrage Recovery &nbsp;|&nbsp; <strong>P0701</strong> — Bank Charge Recovery &nbsp;|&nbsp; <strong>P1099</strong> — Any Other Export-Related Charge
    <br>Enter the applicable code in the "Purpose of Remittance" field of your wire transfer form.
    <br><span style="font-style:italic; font-size:8.5pt; color:#5B6573;">Purpose codes are indicative — confirm with your bank at time of remittance.</span>
  </td></tr>
</table>

<div class="section-title">9. EXPORT DOCUMENTATION</div>
<div class="numbered-block">
  <p><strong>Upon shipment, the following documents will be provided:</strong></p>
  <p>1.&nbsp;&nbsp;Commercial Invoice (digitally authorised)</p>
  <p>2.&nbsp;&nbsp;Packing List (digitally authorised)</p>
  <p>3.&nbsp;&nbsp;Certificate of Origin — {{ order.coo_type }} — Issued by CAPEXIL</p>
  <p>4.&nbsp;&nbsp;Bill of Lading — 3 originals issued by the shipping line | 2 originals couriered to Buyer within 3 Working Days of Balance Payment being confirmed as Payment Cleared | 1 original retained by NexaCrest</p>
  <p>5.&nbsp;&nbsp;Fumigation Certificate — provided as standard with every shipment</p>
</div>

{% endblock %}

{% block annexure_appendix %}
{% if order.include_annexure_a and annexure_has_content is defined and annexure_has_content %}
<div class="annexure-appendix-start">
  <div class="section-title">ANNEXURE A</div>
  {% include '_annexure_body.html.twig' %}
</div>
{% endif %}
{% endblock %}
