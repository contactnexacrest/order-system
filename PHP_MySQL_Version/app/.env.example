# Copy this file to ".env" (same folder) and fill in real values.
# .env must NEVER be committed to version control or placed inside public_html/.

APP_ENV=production
# Set to "local" only on your own dev machine — enables developer conveniences
# such as printing 2FA codes on screen instead of emailing them. NEVER set this
# to "local" on Bluehost or any environment reachable from the internet.

DEV_SERVER=false
# Set to "true" on any dev/staging/UAT deployment (independent of APP_ENV —
# a staging server reachable over the internet is NOT "local") to show a
# bright red "DEV / TEST ENVIRONMENT" strip on every page, so nobody
# mistakes it for production. Leave "false" on the real production server.

APP_URL=https://www.example.com

APP_ENCRYPTION_KEY=change-me
# Required — used to encrypt the Buyer Action Link token at rest
# (EncryptionService). Generate a real random value and never reuse the
# placeholder above in any environment staff actually log into:
#   php -r "echo bin2hex(random_bytes(32));"
# Changing this key after it's been used makes every already-encrypted
# value undecryptable (existing Buyer Action Links will need
# regenerating) — treat it like a database password, not something to
# rotate casually.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexacrest
DB_USERNAME=nexacrest_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

STORAGE_BASE_PATH=/absolute/path/outside/web/root/storage

# --- Email (SMTP) — used for deferred document sends and email-based 2FA ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls (or blank) = STARTTLS, and sending fails if the server doesn't offer it;
# ssl = implicit TLS (usually port 465). Same on both stacks (QA Round 5, R5-17).
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=NexaCrest International Private Limited

# --- Zoho (owner decisions 2026-10-29) — always write all three out, never comment them out. ---
# ZOHO_INTEGRATION_ENABLED: true = this server may talk to Zoho at all. false = no Zoho call is ever made.
# ZOHO_ENVIRONMENT: test = only customers named TEST-... may go to Zoho; production = only real orders
#   (test and sample orders are never sent). Use production on the live server only.
# ZOHO_EINVOICE_ENABLED: true = GST e-invoice (IRN), e-way bill and GST filing may be used — and only when
#   ZOHO_ENVIRONMENT=production too. Keep false until NexaCrest must e-invoice. Never true while testing.
# Zoho Mail is not used to send: all mail goes through the SMTP server above (Bluehost).
ZOHO_INTEGRATION_ENABLED=false
ZOHO_ENVIRONMENT=test
ZOHO_EINVOICE_ENABLED=false

# --- SMS gateway (2FA only) — OPTIONAL. Leave blank to offer email 2FA only. ---
# If SMS_GATEWAY_API_KEY is set, users may choose SMS as a 2FA method.
# If left blank, the SMS option simply does not appear — nothing else changes,
# nothing breaks. See ARCHITECTURE.md section 2 ("SMS (2FA only)").
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
