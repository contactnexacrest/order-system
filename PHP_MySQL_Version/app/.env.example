# Copy this file to ".env" (same folder) and fill in real values.
# .env must NEVER be committed to version control or placed inside public_html/.

APP_ENV=production
# Set to "local" only on your own dev machine — enables developer conveniences
# such as printing 2FA codes on screen instead of emailing them. NEVER set this
# to "local" on Bluehost or any environment reachable from the internet.

APP_URL=https://www.example.com
APP_ENCRYPTION_KEY=change-this-to-a-random-32-byte-value
SESSION_SECRET_KEY=change-this-to-a-different-random-32-byte-value

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexacrest
DB_USERNAME=nexacrest_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

STORAGE_BASE_PATH=/absolute/path/outside/web/root/storage

# --- Email (SMTP) — used for deferred document sends and email-based 2FA ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=NexaCrest International Private Limited

# --- SMS gateway (2FA only) — OPTIONAL. Leave blank to offer email 2FA only. ---
# If SMS_GATEWAY_API_KEY is set, users may choose SMS as a 2FA method.
# If left blank, the SMS option simply does not appear — nothing else changes,
# nothing breaks. See ARCHITECTURE.md section 2 ("SMS (2FA only)").
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
