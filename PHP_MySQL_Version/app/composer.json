{
  "name": "nexacrest/export-webapp",
  "description": "NexaCrest / StoneCrest export operations webapp",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "dompdf/dompdf": "^3.0",
    "phpoffice/phpword": "^1.2",
    "phpmailer/phpmailer": "^6.9",
    "twig/twig": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
