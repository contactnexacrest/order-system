{
  "name": "nexacrest/export-webapp",
  "description": "NexaCrest / StoneCrest export operations webapp",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "dompdf/dompdf": "^3.0",
    "ezyang/htmlpurifier": "^4.19",
    "league/commonmark": "^2.4",
    "phpmailer/phpmailer": "^6.9",
    "phpoffice/phpword": "^1.2",
    "twig/twig": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit"
  }
}
