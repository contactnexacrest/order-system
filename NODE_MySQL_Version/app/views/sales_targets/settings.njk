{#
  Owner decision D-378 (15 Nov 2026): Sales targets settings (manage_sales_targets). The company
  target (₹) only for holders of view_price_buildup as well (canMoney).
  Port of PHP_MySQL_Version/app/views/sales_targets/settings.php.
#}
<div class="card page-wide" id="sales-target-settings">
  <p class="muted small"><a href="/sales-targets">&larr; Sales targets</a> · <a href="/pricing/settings">Pricing settings</a></p>
  <h1>Sales targets settings</h1>
  <p class="muted">The company target, the target period, the multiple used by the calculator, the build-up for new joiners, the review interval and the alert level; and the default targets per designation. Every save needs a reason and is in the Audit Log. Order data is never changed here.</p>

  <form method="post" action="/sales-targets/settings">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {% if canMoney %}
    <fieldset><legend>Company target (₹ per month)</legend>
      <p class="muted small">Needed in a period = (costs + profit) × the months of the period. Leave both empty to switch the company target off. A change starts in the month you choose; earlier periods keep the figures that applied to them.</p>
      <label class="setting-row"><span class="setting-label">Company costs per month (₹)<small class="muted">Salaries, rent and every other running cost.</small></span>
        <input type="number" name="costs_monthly" min="0" step="0.01" value="{{ (company.costs_monthly | fixed2) if (company and company.costs_monthly != null) else '' }}" placeholder="e.g. 1500000.00"></label>
      <label class="setting-row"><span class="setting-label">Profit wanted per month (₹)<small class="muted">On top of the costs.</small></span>
        <input type="number" name="profit_monthly" min="0" step="0.01" value="{{ (company.profit_monthly | fixed2) if (company and company.profit_monthly != null) else '' }}" placeholder="e.g. 500000.00"></label>
      <label class="setting-row"><span class="setting-label">Effective from (month)<small class="muted">Needed when costs or profit are given.</small></span>
        <input type="month" name="effective_from" value="{{ (company.effective_from | string).slice(0, 7) if (company and company.effective_from) else '' }}"></label>
    </fieldset>
    {% else %}
    <p class="muted small">The company target (₹) is shown only to people who may also see the full price build-up.</p>
    {% endif %}

    <fieldset><legend>Targets</legend>
      <label class="setting-row"><span class="setting-label">Target period *<small class="muted">Targets, counts and alerts are per period.</small></span>
        <select name="period" required>
          {% for k, label in periodTypes %}
            <option value="{{ k }}"{{ ' selected' if settings.period == k }}>{{ label }}</option>
          {% endfor %}
        </select></label>
      <label class="setting-row"><span class="setting-label">Target multiple *<small class="muted">Used only by the calculator on the Targets page: a person should bring in this many times their cost. A person can have their own.</small></span>
        <input type="number" name="multiple" min="1" max="10" step="0.1" required value="{{ settings.multiple }}" placeholder="e.g. 3"></label>
      <label class="setting-row"><span class="setting-label">Build-up months *<small class="muted">A new joiner's target in their first month is 0, then half until this many months, then full. 0 or 1 = no build-up.</small></span>
        <input type="number" name="buildup_months" min="0" max="6" step="1" required value="{{ settings.buildup_months }}" placeholder="e.g. 3"></label>
      <label class="setting-row"><span class="setting-label">Review every … months *<small class="muted">A person's target not reviewed for this long gives an alert.</small></span>
        <input type="number" name="review_months" min="3" max="24" step="1" required value="{{ settings.review_months }}" placeholder="e.g. 12"></label>
      <label class="setting-row"><span class="setting-label">Alert below … % *<small class="muted">From half-way through the period: an alert when containers shipped or confirmed are below this share of the containers needed.</small></span>
        <input type="number" name="alert_pct" min="1" max="100" step="1" required value="{{ settings.alert_pct }}" placeholder="e.g. 60"></label>
    </fieldset>

    <fieldset><legend>Default targets per designation (per period)</legend>
      <p class="muted small">Used for everyone of that designation who has no own target. Empty = no target. Quotations are shown to a person during their build-up.</p>
      <div class="table-scroll">
      <table class="list">
        <tr><th>Department</th><th>Designation</th><th>Containers</th><th>New buyers</th><th>Quotations</th></tr>
        {% for d in designations %}{% set dt = defaults[d.id] %}
        <tr>
          <td>{{ d.department_name }}</td>
          <td>{{ d.title }}</td>
          <td><input type="number" name="designation[{{ d.id }}][containers]" min="0" step="0.1" value="{{ dt.containers if (dt and dt.containers != null) else '' }}" placeholder="e.g. 6" aria-label="{{ d.title }} — containers"></td>
          <td><input type="number" name="designation[{{ d.id }}][new_buyers]" min="0" step="1" value="{{ dt.new_buyers if (dt and dt.new_buyers != null) else '' }}" placeholder="e.g. 1" aria-label="{{ d.title }} — new buyers"></td>
          <td><input type="number" name="designation[{{ d.id }}][quotations]" min="0" step="1" value="{{ dt.quotations if (dt and dt.quotations != null) else '' }}" placeholder="e.g. 10" aria-label="{{ d.title }} — quotations"></td>
        </tr>
        {% endfor %}
        {% if designations.length == 0 %}<tr><td colspan="5" class="muted">No designations yet (Admin › Departments).</td></tr>{% endif %}
      </table>
      </div>
    </fieldset>

    <label>Reason for this change *<input type="text" name="reason" required minlength="10" maxlength="500" placeholder="e.g. New targets for the next quarter agreed with the team"></label>
    <button type="submit">Save settings</button>
  </form>
  <p class="muted small">Who is told about the target alerts: Admin › <a href="/admin/email-settings">E-mail settings</a>, section E.</p>
</div>
