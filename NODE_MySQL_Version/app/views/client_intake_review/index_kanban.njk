{# Owner hard rule 2026-11-01: every field and action of the Standard list's row (client_intake_review/index.njk) — Accept & Create Client, Reject with a reason, Resend Link. #}
{% macro kanbanCard(s, csrfToken) %}
<div class="entity-card kanban-card">
  <div class="entity-card-header">
    <span class="entity-card-title">{{ s.company_legal_name }}</span>
    {% if s.status and s.status != 'pending' %}<span class="badge {{ 'badge-active' if s.status == 'converted' else 'badge-lost' }}">{{ s.status | capitalize }}</span>{% endif %}
  </div>
  {% if not s.status or s.status == 'pending' %}
    <div class="muted small">{{ s.billing_address }}</div>
    <div class="entity-card-sub">{{ s.contact_person }}</div>
    <div class="muted small">{{ s.email }} · {{ s.phone or '' }}</div>
    <div class="muted small">Consignee: {{ 'Same as Buyer' if (s.consignee_same_as_buyer == null or s.consignee_same_as_buyer == 1) else (s.consignee_name or '—') }}</div>
    <div class="muted small">Destination: {{ s.country_of_destination }}{% if s.port_of_discharge_text %} · Port: {{ s.port_of_discharge_text }}{% endif %}{% if s.incoterm_preference %} · Incoterm: {{ s.incoterm_preference }}{% endif %}{% if s.coo_type %} · COO: {{ s.coo_type }}{% endif %}</div>
    <div class="muted small">Submitted {{ s.submitted_at }}</div>
    <div class="kanban-card-actions">
      <form method="post" action="/client-intake/{{ s.id }}/accept">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn-sm btn-success">Accept &amp; Create Client</button>
      </form>
      <form method="post" action="/client-intake/{{ s.id }}/reject" onsubmit="return confirm('Reject this quotation request?');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="text" name="reason" placeholder="Reason (required)" required aria-label="Reason for rejecting">
        <button type="submit" class="btn-sm btn-danger">Reject</button>
      </form>
      <form method="post" action="/client-intake/{{ s.id }}/resend-link">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn-sm btn-secondary" title="Re-send the self-correction link if the client never got it or it's expired">Resend Link</button>
      </form>
    </div>
  {% else %}
    <div class="entity-card-sub">{{ s.contact_person }}</div>
    <div class="muted small">Resolved by {{ s.reviewed_by_name or '—' }} · {{ s.reviewed_at }}</div>
    <div class="entity-card-footer">
      {% if s.status == 'converted' and s.client_unique_number %}
        <a href="/clients/{{ s.converted_client_id }}">&rarr; {{ s.client_unique_number }}</a>
      {% elif s.status == 'rejected' %}
        <span class="muted small">{{ s.rejection_reason or '' }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
{% endmacro %}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Quotation Intake Review — Kanban Board</h1>
      <p class="muted" style="margin:0;">Submissions from the public quotation-details form (<code>/quotation-details</code>). Nothing here becomes a real client or order until you accept it — accepting creates the client record and takes you to it, ready for you to create the order and generate the Quotation yourself.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn-sm btn-secondary" href="/client-intake?view=list">Switch to list view</a>
    </div>
  </div>

  <div class="kanban-board">
    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Pending</span>
        <span class="kanban-column-count">{{ pending.length }}</span>
      </div>
      {% if pending.length == 0 %}
        <p class="kanban-column-empty">Nothing pending</p>
      {% else %}
        {% for s in pending %}{{ kanbanCard(s, csrfToken) }}{% endfor %}
      {% endif %}
    </div>

    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Converted</span>
        <span class="kanban-column-count">{{ converted.length }}</span>
      </div>
      {% if converted.length == 0 %}
        <p class="kanban-column-empty">Nothing here</p>
      {% else %}
        {% for s in converted %}{{ kanbanCard(s, csrfToken) }}{% endfor %}
      {% endif %}
    </div>

    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Rejected</span>
        <span class="kanban-column-count">{{ rejected.length }}</span>
      </div>
      {% if rejected.length == 0 %}
        <p class="kanban-column-empty">Nothing here</p>
      {% else %}
        {% for s in rejected %}{{ kanbanCard(s, csrfToken) }}{% endfor %}
      {% endif %}
    </div>
  </div>
</div>
