{% if salesTargets %}{# Owner decision D-378: company sales target (containers; ₹ only with view_price_buildup) #}
{% set st = salesTargets.current %}
<div class="card page-wide" id="cockpit-sales-target">
  <h2 style="margin-top:0;">Sales target — {{ st.period.label }}</h2>
  <div class="kv-grid">
    <div><span class="k">Containers needed</span><span class="v">{{ st.containers_needed if st.containers_needed != null else 'not enough history yet' }}</span></div>
    <div><span class="k">Break-even containers</span><span class="v">{{ st.breakeven_containers if st.breakeven_containers != null else '—' }}</span></div>
    <div><span class="k">Counted (confirmed, with corrections)</span><span class="v">{{ st.counted }}</span></div>
    <div><span class="k">Shipped · awaiting shipment</span><span class="v">{{ st.shipped }} · {{ st.awaiting }}</span></div>
    <div><span class="k">Period gone</span><span class="v">{{ salesTargets.elapsed_pct }}%</span></div>
    {% if salesTargetsMoney %}
    <div><span class="k">Needed (₹)</span><span class="v">{{ st.needed | inr }}</span></div>
    <div><span class="k">Earned — orders shipped (₹)</span><span class="v">{{ st.earned | inr }}</span></div>
    <div><span class="k">Average margin per container (₹)</span><span class="v">{{ (st.avg_margin | inr) if st.avg_margin != null else 'not enough history yet' }}</span></div>
    {% endif %}
  </div>
  <table class="list">
    <tr><th>Period</th><th>Containers counted</th><th>Shipped</th>{% if salesTargetsMoney %}<th>Needed (₹)</th><th>Earned (₹)</th>{% endif %}</tr>
    {% for sp in salesTargets.previous %}
    <tr>
      <td>{{ sp.period.label }}</td>
      <td>{{ sp.counted }}</td>
      <td>{{ sp.shipped }}</td>
      {% if salesTargetsMoney %}<td>{{ (sp.needed | inr) if sp.on else '—' }}</td><td>{{ (sp.earned | inr) if sp.on else '—' }}</td>{% endif %}
    </tr>
    {% endfor %}
  </table>
  <p><a href="/sales-targets">Open Sales targets →</a></p>
</div>
{% endif %}
<div class="card page-wide">
  <h1>Management cockpit</h1>
  <p class="muted">Open work per department from every order's state — counts and status only, no amounts.</p>
  <table class="list">
    <tr><th>Department</th><th>Open tasks</th><th>Overdue</th><th>Escalated</th><th>Orders without an owner</th></tr>
    {% for name, c in byDepartment %}
    <tr>
      <td><span class="dept-tag" style="--dept-color:{{ c.color }}">{{ name }}</span></td>
      <td>{{ c.open }}</td>
      <td>{% if c.overdue > 0 %}<strong style="color:var(--danger)">{{ c.overdue }}</strong>{% else %}0{% endif %}</td>
      <td>{{ c.escalated }}</td>
      <td>{{ c.unowned }}</td>
    </tr>
    {% else %}
    <tr><td colspan="5" class="muted">No open work.</td></tr>
    {% endfor %}
  </table>
</div>

<div class="card page-wide">
  <h2>Orders by status</h2>
  <div class="kv-grid">
    {% for status, n in ordersByStatus %}<div><span class="k">{{ status | replace('_', ' ') | title }}</span><span class="v">{{ n }}</span></div>{% endfor %}
  </div>
</div>

<div class="card page-wide">
  <h2>Escalated — needs management</h2>
  <table class="list">
    <tr><th>Due</th><th>Department</th><th>Task</th><th>Order</th><th>Detail</th><th>Owner</th></tr>
    {% for t in escalated %}
    <tr>
      <td>{{ t.due_on }}</td>
      <td>{{ t.department_name }}</td>
      <td>{{ t.title }}</td>
      <td><a href="{{ t.link }}">{{ t.order_reference }}</a></td>
      <td>{{ t.subject }}</td>
      <td>{{ t.owner_name if t.owner_name != null else '—' }}</td>
    </tr>
    {% endfor %}
    {% if not escalated.length %}<tr><td colspan="6" class="muted">Nothing escalated.</td></tr>{% endif %}
  </table>
</div>

<div class="card page-wide">
  <h2>Supplier delays</h2>
  <table class="list">
    <tr><th>Needed by</th><th>Order</th><th>Purchase</th></tr>
    {% for t in supplierDelays %}
    <tr><td>{{ t.since }}</td><td>{{ t.order_reference }}</td><td><a href="{{ t.link }}">{{ t.subject }}</a></td></tr>
    {% endfor %}
    {% if not supplierDelays.length %}<tr><td colspan="3" class="muted">No supplier is late.</td></tr>{% endif %}
  </table>
</div>
