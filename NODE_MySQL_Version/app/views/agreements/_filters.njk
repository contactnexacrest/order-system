{# Owner hard rule 2026-11-01: the same filters on the list and on the board. #}
{% macro chipHref(status, f, listOfBoard) %}/agreements?status={{ status | urlencode }}{% if f.party %}&amp;party={{ f.party | urlencode }}{% endif %}{% if f.type %}&amp;type={{ f.type | urlencode }}{% endif %}{% if f.within %}&amp;within={{ f.within | urlencode }}{% endif %}{% if f.q %}&amp;q={{ f.q | urlencode }}{% endif %}{% if listOfBoard %}&amp;view=list{% endif %}{% endmacro %}
<div class="filter-chip-row">
  <a class="filter-chip{{ ' active' if f.status == 'all' else '' }}" href="{{ chipHref('all', f, listOfBoard) }}">All ({{ countAll }})</a>
  {% for key, label in agreementStatuses %}{% if not (key == 'renewed' and counts.renewed == 0) %}
    <a class="filter-chip{{ ' active' if f.status == key else '' }}" href="{{ chipHref(key, f, listOfBoard) }}">{{ label }} ({{ counts[key] }})</a>
  {% endif %}{% endfor %}
</div>
<form method="get" action="/agreements" class="inline-form" style="margin:8px 0;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:flex-end">
  <input type="hidden" name="status" value="{{ f.status }}">
  {% if listOfBoard %}<input type="hidden" name="view" value="list">{% endif %}
  <label>With
    <select name="party" style="width:auto">
      <option value="">Everyone</option>
      {% for k, label in partyTypes %}{% if not (k == 'staff' and not canManage) %}
        <option value="{{ k }}"{{ ' selected' if f.party == k else '' }}>{{ label }}</option>
      {% endif %}{% endfor %}
    </select>
  </label>
  <label>Type
    <select name="type" style="width:auto">
      <option value="">All types</option>
      {% for t in types %}<option value="{{ t }}"{{ ' selected' if f.type == t else '' }}>{{ t }}</option>{% endfor %}
    </select>
  </label>
  <label>Expiring within
    <select name="within" style="width:auto">
      <option value="">Any time</option>
      {% for d in ['7', '30', '60', '90'] %}<option value="{{ d }}"{{ ' selected' if f.within == d else '' }}>{{ d }} days</option>{% endfor %}
    </select>
  </label>
  <input type="search" name="q" value="{{ f.q }}" maxlength="100" placeholder="Name, type, title or note" aria-label="Search agreements" style="width:auto;min-width:220px">
  <button type="submit" class="btn-sm">Filter</button>
</form>
