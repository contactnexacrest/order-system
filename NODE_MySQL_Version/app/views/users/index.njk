<div class="card page-wide">
  <h1>Users</h1>
  <p class="muted">Create logins, edit an existing one, deactivate one, or force a password reset. A temporary password is shown once when you create a user or force-reset one — hand it to them directly (never emailed) since they're forced to set their own on first login regardless.</p>

  <div class="section">
    <h2>Existing Users</h2>
    <div class="btn-row" style="margin-bottom:0.6rem;">
      <a class="btn-sm {{ '' if currentStatus == 'active' else 'btn-secondary' }}" href="/users?status=active">Active ({{ statusCounts.active }})</a>
      <a class="btn-sm {{ '' if currentStatus == 'inactive' else 'btn-secondary' }}" href="/users?status=inactive">Inactive ({{ statusCounts.inactive }})</a>
      <a class="btn-sm {{ '' if currentStatus == 'archived' else 'btn-secondary' }}" href="/users?status=archived">Archived ({{ statusCounts.archived }})</a>
    </div>
    <table class="list">
      <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>2FA</th><th>Last Login</th><th>Actions</th></tr>
      {% for u in users %}
      <tr>
        <td>{{ u.name }}{% if u.is_protected_account %} <span class="badge badge-protected">Protected founder</span>{% endif %}</td>
        <td>{{ u.email }}</td>
        <td>{{ u.role_name or '—' }}</td>
        <td>
          {% if u.is_archived %}
            <span class="badge badge-inactive">Archived</span><br><small class="muted">Since {{ u.archived_at }}</small>
          {% elif u.is_active %}
            <span class="badge badge-active">Active</span>
          {% else %}
            <span class="badge badge-inactive">Deactivated</span>
          {% endif %}
          {% if u.force_password_change %}<br><small class="muted">Must change password</small>{% endif %}
          {% if u.locked_until %}<br><small class="muted">Locked until {{ u.locked_until }}</small>{% endif %}
        </td>
        <td>{{ 'On' if u.two_fa_enabled else '—' }}</td>
        <td>{{ u.last_login_at or 'Never' }}</td>
        <td>
          {% if u.is_protected_account %}
            <span class="muted small">Protected — cannot be edited, deactivated, archived, deleted, or password-reset by anyone else. They can recover their own login via "Forgot password" on the login screen.</span>
          {% elif u.is_archived %}
            <form method="post" action="/users/{{ u.id }}/unarchive" style="display:inline" data-confirm="Unarchive {{ u.name }}? They will still need to be separately reactivated to log in again.">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" class="btn-sm btn-secondary">Unarchive</button>
            </form>
            <form method="post" action="/users/{{ u.id }}/delete" style="display:inline" data-confirm="Permanently delete {{ u.name }}? This cannot be undone, and only succeeds if they have no order/document/audit history on file.">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" class="btn-sm btn-danger">Delete</button>
            </form>
          {% else %}
          <a href="/users/{{ u.id }}/edit" class="btn-sm btn-secondary">Edit</a>
          <form method="post" action="/users/{{ u.id }}/toggle-active" style="display:inline" data-confirm="{{ 'Deactivate' if u.is_active else 'Reactivate' }} {{ u.name }}?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm {{ 'btn-danger' if u.is_active else 'btn-success' }}">{{ 'Deactivate' if u.is_active else 'Reactivate' }}</button>
          </form>
          <form method="post" action="/users/{{ u.id }}/archive" style="display:inline" data-confirm="Archive {{ u.name }}? They will no longer be able to log in, and will move out of the Active/Inactive lists into Archived.">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm btn-secondary">Archive</button>
          </form>
          <details style="margin-top:0.4rem;">
            <summary class="muted small">Force password reset</summary>
            <form method="post" action="/users/{{ u.id }}/force-reset-password" data-confirm-name="{{ u.name }}" onsubmit="return confirmForceReset(this);">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <textarea class="reset-reason" name="reason" rows="2" placeholder="Reason for this reset *" required></textarea>
              <button type="submit" class="btn-sm btn-danger">Force Reset</button>
            </form>
          </details>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      {% if (users | length) == 0 %}<tr><td colspan="7" class="muted">No users in this view.</td></tr>{% endif %}
    </table>
  </div>

  <div class="section">
    <h2>Create User</h2>
    <form method="post" action="/users/create">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="kv-grid">
        <label>Name * <input type="text" name="name" required></label>
        <label>Email * <input type="email" name="email" required></label>
        <label>Phone <input type="text" name="phone"></label>
        <label>Role
          <select name="role_id">
            <option value="">— none —</option>
            {% for r in roles %}
              <option value="{{ r.id }}">{{ r.name }}</option>
            {% endfor %}
          </select>
        </label>
      </div>
      <button type="submit" class="btn-sm">Create User</button>
    </form>
  </div>
</div>
<script>
function confirmForceReset(form) {
  var reasonEl = form.querySelector('.reset-reason');
  if (!reasonEl || reasonEl.value.trim() === '') {
    alert('A reason is required before resetting.');
    return false;
  }
  // Read from a data attribute, not a JS-string-literal argument built
  // server-side — see app.js's initConfirmDialogs() docblock (External
  // QA report L-39) for why that would still break on an apostrophe.
  var name = form.dataset.confirmName;
  return confirm('Force-reset the password for ' + name + '? A new one-time temporary password will be generated and shown once. This is logged.');
}
</script>
