<div class="card">
  <h1>Dashboard</h1>
  <p>Signed in as <strong>{{ user.name }}</strong> ({{ user.email }}).</p>
</div>

{% if salesTarget %}{# Owner decision D-378: the signed-in person's own target, containers only #}
{% set tt = salesTarget.target %}{% set tc = salesTarget.counts %}
{% set kinds = { 'lost': 'lost', 'cancelled': 'cancelled', 'shipped_difference': 'shipped a different number of containers', 'reversed': 'reversed' } %}
{% macro targetOrderRef(id, orders) %}{% if orders[id] %}<a href="/orders/{{ id }}">{{ orders[id].order_reference }}</a>{% else %}#{{ id }}{% endif %}{% endmacro %}
<div class="card page-wide" id="your-target">
  <h2 style="margin-top:0;">Your target — {{ salesTarget.period.label }}</h2>
  <div class="kv-grid">
    <div><span class="k">Target</span><span class="v">{{ tt.containers | targetNum }} containers{% if tt.in_buildup %} <span class="muted small">(build-up)</span>{% endif %}</span></div>
    <div><span class="k">Confirmed</span><span class="v">{{ tc.counted }}</span></div>
    <div><span class="k">Shipped · awaiting · corrections · new buyers</span><span class="v">{{ tc.shipped }} · {{ tc.awaiting }} · {{ '+' if tc.corrections > 0 }}{{ tc.corrections }} · {{ tc.new_buyers }}</span></div>
    <div><span class="k">Still to achieve</span><span class="v">{{ salesTarget.still | targetNum }}</span></div>
    <div><span class="k">Pipeline (PI approved or quotation sent)</span><span class="v">{{ salesTarget.pipeline.length }} order(s)</span></div>
    <div><span class="k">Progress</span><span class="v">{{ salesTarget.progress }}%</span></div>
    {% if tt.in_buildup and tt.quotations != null %}
    <div><span class="k">Quotations sent (build-up goal)</span><span class="v">{{ salesTarget.quotations_sent }} / {{ tt.quotations }}</span></div>
    {% endif %}
  </div>
  {% if tc.rows.length or tc.correction_rows.length %}
  <table class="list">
    <tr><th>Order</th><th>Date</th><th>What</th><th>Containers</th>{% if salesTarget.has_fob %}<th>FOB</th>{% endif %}</tr>
    {% for tr in tc.rows %}{% set toid = tr.order_id | int %}
    <tr>
      <td>{{ targetOrderRef(toid, salesTarget.orders) }}</td>
      <td>{{ tr.confirmed_on | shortDate }}</td>
      <td>Confirmed{% if (tr.is_new_buyer | int) == 1 %} · new buyer{% endif %}{% if tr.shipped_on %} · shipped {{ tr.shipped_on | shortDate }}{% endif %}</td>
      <td>{{ tr.containers_confirmed | int }}</td>
      {% if salesTarget.has_fob %}{% set tcur = (salesTarget.orders[toid].currency_code if salesTarget.orders[toid] else null) %}<td>{% if salesTarget.fob[toid] != null %}{{ salesTarget.fob[toid] | docAmount(tcur or 'USD') }} {{ tcur or '' }}{% else %}—{% endif %}</td>{% endif %}
    </tr>
    {% endfor %}
    {% for te in tc.correction_rows %}
    <tr>
      <td>{{ targetOrderRef(te.order_id, salesTarget.orders) }}</td>
      <td>{{ te.date | shortDate }}</td>
      <td>Correction — {{ kinds[te.kind] or te.kind }}</td>
      <td>{{ '+' if te.containers > 0 }}{{ te.containers }}</td>
      {% if salesTarget.has_fob %}<td></td>{% endif %}
    </tr>
    {% endfor %}
  </table>
  {% endif %}
</div>
{% endif %}

{% if associateUpgrades and associateUpgrades.length %}{# D-261 / D-263: users with "Manage associates" see this #}
<div class="card page-wide" id="associate-upgrades">
  <h2 style="margin-top:0;">Associates ready for the Quoting level? ({{ associateUpgrades.length }})</h2>
  <ul>
    {% for u in associateUpgrades %}<li><a href="/associates/{{ u.id }}#portal-access">{{ u.name }}</a> — {{ u.completed_paid }} completed, fully paid orders</li>{% endfor %}
  </ul>
  <p class="small muted">Nothing upgrades by itself — review their access on the associate page.</p>
</div>
{% endif %}
{% if incentiveReadyCount %}{# Owner decision D-245 P4 #}
<div class="card page-wide" id="incentives-ready">
  <h2 style="margin-top:0;">Team incentives ready to lock ({{ incentiveReadyCount }})</h2>
  <p>These orders are fully paid by the buyer with no claim open. Lock them so the team is paid in the next payout run ({{ incentiveNextRun | shortDate }}).</p>
  <p><a href="/incentives/ready">Open Ready to lock →</a></p>
</div>
{% endif %}

{# Owner decision 2 Nov 2026 (point 4): agreements expiring within 30 days, for whoever may see the register. #}
{% if agreementsExpiring and agreementsExpiring.length %}
<div class="card page-wide" id="agreements-expiring">
  <h2 style="margin-top:0;">Agreements expiring soon ({{ agreementsExpiring.length }})</h2>
  <table class="list">
    <tr><th>With</th><th>Agreement</th><th>Expires</th></tr>
    {% for __r in agreementsExpiring.slice(0, 10) %}
      <tr><td>{{ __r.party_name }} <small class="muted">({{ agreementPartyTypes[__r.party_type] }})</small></td><td>{{ __r.agreement_type }}</td><td>{{ __r.expires_on }} — in {{ __r.days_left }} day(s)</td></tr>
    {% endfor %}
  </table>
  <p><a href="/agreements?status=expiring">Open the Agreements register →</a></p>
</div>
{% endif %}

<div class="card page-wide">
  <h2 style="margin-top:0;">Search — client or order reference</h2>
  <form method="get" action="/" class="search-box">
    <input type="text" name="q" value="{{ searchTerm }}" placeholder="Order ref, client no., or company name…" aria-label="Order ref, client no., or company name">
    <button type="submit" class="btn-sm">Search</button>
  </form>
  {% if searchTerm != '' %}
    {% if not searchResults or searchResults.length == 0 %}
      <p class="muted">No matches for "{{ searchTerm }}".</p>
    {% else %}
      <table class="list">
        <tr><th>Order Ref</th><th>Client No.</th><th>Client</th><th>Stage</th><th>Status</th><th></th></tr>
        {% for r in searchResults %}
        <tr>
          <td>{{ r.order_reference }}</td>
          <td>{{ r.client_unique_number }}</td>
          <td>{{ r.company_legal_name }}</td>
          <td>{{ r.current_stage_name or 'Quotation' }}</td>
          <td>{{ r.status | capitalize }}</td>
          <td><a href="/orders/{{ r.order_id }}">View</a></td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  {% endif %}
</div>

<div class="card page-wide">
  <h2 style="margin-top:0;">My Approvals</h2>
  <div class="stat-grid">
    {% if showApprovalTiles %}{# D-310 #}
    <div class="stat-tile {{ 'danger' if approvalCounts.prices > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></div>
      <div class="num">{{ approvalCounts.prices }}</div>
      <div class="label">Prices waiting for my approval</div>
    </div>
    <div class="stat-tile {{ 'warn' if approvalCounts.payment_terms > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></div>
      <div class="num">{{ approvalCounts.payment_terms }}</div>
      <div class="label">Payment terms</div>
    </div>
    <div class="stat-tile {{ 'warn' if approvalCounts.bank > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V10l7-5 7 5v11"></path></svg></div>
      <div class="num">{{ approvalCounts.bank }}</div>
      <div class="label">Bank details to verify</div>
    </div>
    <div class="stat-tile {{ 'warn' if approvalCounts.other > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
      <div class="num">{{ approvalCounts.other }}</div>
      <div class="label">Other approvals</div>
    </div>
    {% endif %}
    <div class="stat-tile {{ 'warn' if myPendingReviewCount > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg></div>
      <div class="num">{{ myPendingReviewCount }}</div>
      <div class="label">My pending reviews</div>
    </div>
    {% if pendingEmailApprovalCount != null %}
    <div class="stat-tile {{ 'warn' if pendingEmailApprovalCount > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><polyline points="3 7 12 13 21 7"></polyline></svg></div>
      <div class="num">{{ pendingEmailApprovalCount }}</div>
      <div class="label">Emails awaiting Level-2 approval</div>
    </div>
    {% endif %}
    {% if pendingAmendmentApprovalCount != null %}
    <div class="stat-tile {{ 'warn' if pendingAmendmentApprovalCount > 0 else '' }}">
      <div class="icon-chip" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg></div>
      <div class="num">{{ pendingAmendmentApprovalCount }}</div>
      <div class="label">Amendments awaiting MD approval</div>
    </div>
    {% endif %}
  </div>
  <div class="btn-row">
    {% if showApprovalTiles %}<a class="btn-sm" href="/approvals">Open my approvals ({{ approvalCounts.all }})</a>{% endif %}{# D-310 #}
    <a class="btn-sm btn-secondary" href="/reviews">My Reviews</a>
    {% if pendingEmailApprovalCount != null %}<a class="btn-sm btn-secondary" href="/email-approvals">Email Approvals</a>{% endif %}
  </div>
</div>

{% if canManageOrders %}
<div class="card page-wide">
  <h2 style="margin-top:0;">Active Orders by Stage ({{ activeOrderCount }} active)</h2>
  <div class="stat-grid">
    {% for s in stageBreakdown %}
    <div class="stat-tile">
      <div class="num">{{ s.order_count }}</div>
      <div class="label">{{ s.stage_name }}</div>
    </div>
    {% endfor %}
  </div>
  <div class="btn-row"><a class="btn-sm" href="/clients">Clients</a> <a class="btn-sm btn-secondary" href="/orders">All Orders</a></div>
</div>

<div class="card page-wide">
  <h2 style="margin-top:0;">Overdue Payments</h2>
  {% if (not overdueBalance or overdueBalance.length == 0) and (not overdueFreight or overdueFreight.length == 0) %}
    <p class="muted">Nothing overdue.</p>
  {% else %}
    {% if overdueBalance and overdueBalance.length > 0 %}
      <h3 style="font-size:0.9rem;color:var(--danger);">Balance payment overdue</h3>
      <table class="list">
        <tr><th>Order Ref</th><th>Client</th><th>Due Date</th><th>Amount</th><th></th></tr>
        {% for r in overdueBalance %}
        <tr>
          <td>{{ r.order_reference }}</td>
          <td>{{ r.company_legal_name }}</td>
          <td>{{ r.balance_due_date }}</td>
          <td>{{ (r.balance_amount | money) ~ ' ' ~ (r.currency_code or '') if (r.balance_amount != null and sees.buyer_payments) else '—' }}</td>
          <td><a href="/orders/{{ r.order_id }}">View</a></td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
    {% if overdueFreight and overdueFreight.length > 0 %}
      <h3 style="font-size:0.9rem;color:var(--danger);">Freight payment overdue</h3>
      <table class="list">
        <tr><th>Order Ref</th><th>Client</th><th>FDN Issued</th><th></th></tr>
        {% for r in overdueFreight %}
        <tr>
          <td>{{ r.order_reference }}</td>
          <td>{{ r.company_legal_name }}</td>
          <td>{{ r.fdn_generated_at }}</td>
          <td><a href="/orders/{{ r.order_id }}">View</a></td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  {% endif %}
</div>

{% if complianceWarnings.lut or complianceWarnings.rcmc %}
<div class="card page-wide">
  <h2 style="margin-top:0;">Compliance Expiry Warnings</h2>
  <div class="stat-grid">
    {% if complianceWarnings.lut %}
    <div class="stat-tile {{ 'danger' if complianceWarnings.lut.days_left < 0 else 'warn' }}">
      <div class="num">{{ complianceWarnings.lut.days_left }}d</div>
      <div class="label">LUT expires {{ complianceWarnings.lut.expiry_date }}</div>
    </div>
    {% endif %}
    {% if complianceWarnings.rcmc %}
    <div class="stat-tile {{ 'danger' if complianceWarnings.rcmc.days_left < 0 else 'warn' }}">
      <div class="num">{{ complianceWarnings.rcmc.days_left }}d</div>
      <div class="label">RCMC expires {{ complianceWarnings.rcmc.expiry_date }}</div>
    </div>
    {% endif %}
  </div>
  <p class="muted">Update these in <a href="/settings">Company Settings</a>.</p>
</div>
{% endif %}
{% endif %}

{% if recentActivity and recentActivity.length > 0 %}
<div class="card page-wide">
  <h2 style="margin-top:0;">Recent Activity</h2>
  <table class="list">
    <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th></tr>
    {% for a in recentActivity %}
    <tr>
      <td>{{ a.created_at }}</td>
      <td>{{ a.user_name or 'System' }}</td>
      <td>{{ a.action_type }}</td>
      <td>{{ a.entity_type or '—' }}{% if a.entity_id %} #{{ a.entity_id }}{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
  <div class="btn-row">{% if permissions.view_audit_log %}<a class="btn-sm btn-secondary" href="/audit-log">Full Audit Log</a> {% endif %}<a class="btn-sm btn-secondary" href="/reports">Reports</a></div>
</div>
{% endif %}
