<div class="card page-wide">
  <p class="muted small"><a href="/port-routes">&larr; Port Routes</a></p>
  <h1>Edit Port Route</h1>
  <form method="post" action="/port-routes/{{ route.id }}/update">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field-grid">
      <label>Port of Loading *
        <select name="port_of_loading_id" required>
          {% for p in loadingPorts %}
            <option value="{{ p.id }}" {{ 'selected' if p.id == route.port_of_loading_id }}>{{ p.name }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Port of Discharge *
        <select name="port_of_discharge_id" required>
          {% for p in dischargePorts %}
            <option value="{{ p.id }}" {{ 'selected' if p.id == route.port_of_discharge_id }}>{{ p.name }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Sailing Days Min *
        <input type="number" min="0" name="sailing_days_min" required value="{{ route.sailing_days_min }}">
      </label>
      <label>Sailing Days Max *
        <input type="number" min="0" name="sailing_days_max" required value="{{ route.sailing_days_max }}">
      </label>
      <label class="full">Notes (optional)
        <input type="text" name="notes" value="{{ route.notes or '' }}" placeholder="e.g. Direct service, no transshipment">
      </label>
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top:8px;">Save</button>
  </form>
</div>
