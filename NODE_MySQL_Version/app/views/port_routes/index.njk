<div class="card page-wide">
  <p class="muted small"><a href="/ports">&larr; Ports</a></p>
  <h1>Port Routes — Sailing Days</h1>
  <p class="muted">A reference document of known port-to-port sailing times. Picking both ports on an order's Port of Loading/Discharge fields auto-suggests the Sailing Lead Time from a matching route here — staff can still freely override it on the order.</p>

  <div class="section">
    <div class="btn-row"><a href="/port-routes/create" class="btn-sm btn-accent" style="margin-left:auto;">Add Route</a></div>

    <table class="list">
      <tr><th>Port of Loading</th><th>Port of Discharge</th><th>Sailing Days</th><th>Notes</th><th>Status</th><th>Actions</th></tr>
      {% if routes.length == 0 %}
      <tr><td colspan="6" class="muted">No routes yet — add the first one above.</td></tr>
      {% endif %}
      {% for r in routes %}
      <tr>
        <td>{{ r.port_of_loading_name }}</td>
        <td>{{ r.port_of_discharge_name }}</td>
        <td>{{ r.sailing_days_min }}&ndash;{{ r.sailing_days_max }} days</td>
        <td class="muted small">{{ r.notes or '—' }}</td>
        <td><span class="badge {{ 'badge-active' if r.is_active else 'badge-inactive' }}">{{ 'Active' if r.is_active else 'Inactive' }}</span></td>
        <td>
          <a href="/port-routes/{{ r.id }}/edit" class="btn-sm btn-secondary">Edit</a>
          <form method="post" action="/port-routes/{{ r.id }}/toggle" style="display:inline" onsubmit="return confirm('{{ 'Deactivate' if r.is_active else 'Reactivate' }} this route? {{ 'It will no longer be offered as an auto-suggestion on new orders.' if r.is_active else '' }}');">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm {{ 'btn-danger' if r.is_active else 'btn-success' }}">{{ 'Deactivate' if r.is_active else 'Reactivate' }}</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
