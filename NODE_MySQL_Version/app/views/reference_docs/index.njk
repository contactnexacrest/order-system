<div class="card page-wide">
  <h1>Reference Library</h1>
  <p class="muted">Stage Gate conditions, hard-rules quick reference, the cross-verification checklist, and the sales-process SOPs — kept here so any staff member can look them up without asking around.</p>

  <table class="list">
    <tr><th>Document</th><th>Last Updated</th><th>Action</th></tr>
    {% for d in docs %}
      <tr>
        <td>{{ d.name }}</td>
        <td>{{ d.updated_at if d.updated_at else '' }}{% if not d.updated_at %}<span class="muted">not yet entered</span>{% endif %}</td>
        <td><a href="/reference-docs/{{ d.code }}" class="btn-sm">View</a></td>
      </tr>
    {% endfor %}
  </table>

  <div class="section">
    <h2>Other Reference Documents</h2>
    <p class="muted small">Freely add/edit/delete — for anything that isn't one of the fixed documents above. Each can carry typed content, an uploaded file (PDF/Word/Excel), or both.</p>
    <table class="list">
      <tr><th>Title</th><th>File</th><th>Last Updated</th><th>Action</th></tr>
      {% for d in customDocs %}
        <tr>
          <td>{{ d.title }}</td>
          <td>
            {% if d.file_path %}<a href="/reference-docs/custom/{{ d.id }}/download">{{ d.file_original_name }}</a>{% else %}<span class="muted">—</span>{% endif %}
          </td>
          <td>{{ d.updated_at }}{% if d.updated_by_name %} <span class="muted small">by {{ d.updated_by_name }}</span>{% endif %}</td>
          <td>
            <a href="/reference-docs/custom/{{ d.id }}" class="btn-sm">View</a>
            {% if permissions.manage_company_settings %}
            <a href="/reference-docs/custom/{{ d.id }}/edit" class="btn-sm btn-secondary">Edit</a>
            <form method="post" action="/reference-docs/custom/{{ d.id }}/delete" style="display:inline" onsubmit="return confirm('Delete \'{{ d.title }}\' from the Reference Library? Any uploaded file stays on disk, but this entry and its typed content are removed.');">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" class="btn-sm btn-danger">Delete</button>
            </form>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      {% if not customDocs or customDocs.length == 0 %}
        <tr><td colspan="4" class="muted">No other reference documents added yet.</td></tr>
      {% endif %}
    </table>
    {% if permissions.manage_company_settings %}
    <p><a href="/reference-docs/custom/create" class="btn-sm btn-success">+ Add Reference Document</a></p>
    {% endif %}
  </div>
</div>
