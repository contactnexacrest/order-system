<div class="card page-wide">
  <p><a href="/reference-docs/custom/{{ doc.id }}">&larr; {{ doc.title }}</a></p>
  <h1>Edit: {{ doc.title }}</h1>

  {% if doc.file_path %}
    <p class="muted small">Current file: <a href="/reference-docs/custom/{{ doc.id }}/download">{{ doc.file_original_name }}</a> — uploading a new one below replaces it here, but the old file is never deleted from disk.</p>
  {% endif %}

  <form method="post" action="/reference-docs/custom/{{ doc.id }}/update" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field-grid">
      <label>Title * <input type="text" name="title" value="{{ doc.title }}" placeholder="e.g., Incoterms 2020 Quick Reference" required></label>
      <label>Category <small class="muted">(optional — <a href="/reference-docs/categories">manage categories</a>. Leave blank to keep this visible to every staff member.)</small>
        <select name="category_id">
          <option value="">— None (visible to everyone) —</option>
          {% for c in categories %}
            <option value="{{ c.id }}" {{ 'selected' if doc.category_id == c.id }}>{{ c.name }}{% if c.required_permission %} (restricted){% endif %}</option>
          {% endfor %}
        </select>
      </label>
      <label class="full">Content
        <textarea name="content" rows="16" style="font-family:monospace" placeholder="A line starting with &quot;# &quot; is a heading, &quot;- &quot; a bullet, &quot;1. &quot; a numbered step, and a blank line starts a new paragraph.">{{ doc.content or '' }}</textarea>
      </label>
    </div>
    <p><label>{{ 'Replace file' if doc.file_path else 'Attach a file' }} (optional — PDF, Word, or Excel, max 15MB)<br>
      <input type="file" name="file">
    </label></p>
    <button type="submit" class="btn-sm btn-success">Save</button>
  </form>
</div>
