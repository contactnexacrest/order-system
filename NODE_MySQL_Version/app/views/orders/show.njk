{# Batch 3 #3 — each settlement leg carries its own exchange rate (advance/
   balance/freight each clear on their own date, at their own market
   rate), so the rate widget is rendered per-leg, right alongside that
   leg's own INR Actual widget, instead of one shared order-wide widget. #}
{# 90-item backlog "exchange-rate-at-clearing-time": this macro used to
   only ever render from inside inrActualWidget, which itself returns
   early until the leg is marked CLEARED — but ca-02-revenue-reports.md's
   own spec says the rate is "typically entered once that leg is about to
   clear, whenever your accounts team fixes a working rate for it" — i.e.
   BEFORE clearing, as an anticipatory estimate, not after. Gated on the
   leg's amount being on record (received) instead of cleared — the same
   point "about to clear" first becomes true. #}
{# Owner request (2026-10-26): a remittance is recorded together with the
   day's exchange rate, and once recorded the card reads it back as one
   statement — "we received X at today's exchange rate of Y". #}
{% macro remittanceRecordedNote(leg, nextStep) %}
  {% set amount = payment[leg ~ '_amount'] %}
  {% set rate = payment[leg ~ '_exchange_rate'] %}
  {% set receivedAt = payment[leg ~ '_remittance_received_at'] %}
  {% set clearedAt = payment[leg ~ '_cleared_at'] %}
  <p class="remit-recorded"><strong>&#10003; Received {{ order.currency_code or '' }} {{ amount | money }}{% if receivedAt %} on {{ receivedAt | shortDate }}{% endif %}{% if rate != null %} at today's exchange rate of &#8377;{{ rate | rate4 }} (= &#8377;{{ (amount * rate) | money }}).{% else %} — exchange rate not recorded yet (record it below).{% endif %}</strong> <span class="muted">{% if clearedAt %}Cleared on {{ clearedAt | shortDate }}.{% else %}{{ nextStep }}{% endif %}</span></p>
{% endmacro %}

{% macro exchangeRateWidget(leg, label) %}
  {% if canViewInrActual and payment[leg ~ '_amount'] != null %}
    {% set rate = payment[leg ~ '_exchange_rate'] %}
    {% set setBy = payment[leg ~ '_exchange_rate_set_by'] %}
    {% set lockMessage = caLockMessages[leg] %}
    <div style="margin-top:8px; padding-top:8px; border-top:1px solid rgba(0,0,0,0.08);">
      <strong style="font-size:0.85em;">{{ label }} Exchange Rate</strong><br>
      {# Owner decision (2026-10-26, t4): the rate is recorded with the remittance itself, so there is no separate "Record/Update Rate" box any more — only a collapsed, reasoned correction for a mistyped rate, for inr_actual_edit holders. #}
      {% if rate != null %}
        <span class="muted small">Received @ &#8377;{{ rate | rate4 }} per 1 {{ order.currency_code or '' }} — set {{ payment[leg ~ '_exchange_rate_set_at'] }}{% if setBy %} by {{ usersById[setBy] or ('User #' ~ setBy) }}{% endif %}. Used only to show forex gain/(loss) below once an INR actual is recorded — never to derive the INR actual itself.</span>
      {% else %}
        <span class="muted small">No exchange rate on record for this older entry.</span>
      {% endif %}
      {% if canEditInrActual and lockMessage != null and not canOverrideFyLock %}
        <br><span class="muted small">&#128274; {{ lockMessage }}</span>
      {% elif canEditInrActual %}
        <details class="rate-correction" style="margin-top:6px;">
          <summary class="muted small">{{ 'Correct a wrongly typed rate' if rate != null else 'Add the missing rate' }}</summary>
          {% if lockMessage != null %}
            <p class="muted small" style="margin:6px 0 0;">&#9888; {{ lockMessage }} You hold the override permission — submitting below will be logged.</p>
          {% endif %}
          <form method="post" action="/orders/{{ order.id }}/payment/{{ leg }}/exchange-rate" style="margin-top:6px;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>@ Exchange Rate * <small class="muted">(&#8377; per 1 {{ order.currency_code or '' }})</small><input type="number" step="0.0001" min="0.0001" name="{{ leg }}_exchange_rate" placeholder="e.g. 88.5000" required></label>
            {% if rate != null %}
            <label>Reason for the correction *<input type="text" name="correction_reason" required minlength="10" placeholder="e.g. typed 8.35 instead of 83.50"></label>
            {% endif %}
            <button type="submit" class="btn-sm">{{ 'Correct Rate' if rate != null else 'Save Rate' }}</button>
          </form>
        </details>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}

{% macro inrActualWidget(leg, label) %}
  {% set clearedAt = payment[leg ~ '_cleared_at'] %}
  {% if clearedAt and canViewInrActual %}
    {% set amount = payment[leg ~ '_inr_actual'] %}
    {% set recordedAt = payment[leg ~ '_inr_actual_recorded_at'] %}
    {% set recordedBy = payment[leg ~ '_inr_actual_recorded_by'] %}
    {% set legRate = payment[leg ~ '_exchange_rate'] %}
    {% set foreignAmount = payment[leg ~ '_amount'] %}
    {% set forexGainLoss = (amount - (foreignAmount * legRate)) if (amount != null and legRate != null and foreignAmount != null) else null %}
    {% set fircReference = payment[leg ~ '_firc_reference'] %}
    {% set fircReceivedAt = payment[leg ~ '_firc_received_at'] %}
    {% set lockMessage = caLockMessages[leg] %}
    <div class="review-banner info" style="margin-top:10px;">
      <div style="width:100%;">
        <strong>{{ label }} — INR Actual (CA/Accounting)</strong><br>
        {% if amount != null %}
          <span>&#8377;{{ amount | money }} credited — recorded {{ recordedAt }}{% if recordedBy %} by {{ usersById[recordedBy] or ('User #' ~ recordedBy) }}{% endif %}</span>
          {% if (lockMessage == null or canOverrideFyLock) and canDeleteInrActual %}
            {% if lockMessage != null %}
              <span class="muted small">(&#9888; override — logged)</span>
            {% endif %}
            <form method="post" action="/orders/{{ order.id }}/payment/{{ leg }}/inr-actual/delete" style="display:inline; margin-left:8px;" onsubmit="return confirm('Remove the recorded INR actual amount for this leg? Only do this to correct a mis-entry.');">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" class="btn-sm btn-danger">Remove</button>
            </form>
          {% endif %}
          {% if forexGainLoss != null %}
            <br><span class="muted small">Forex {{ 'gain' if forexGainLoss >= 0 else 'loss' }}: &#8377;{{ (forexGainLoss | abs) | money }} vs. this leg's own recorded rate.</span>
          {% endif %}
        {% elif lockMessage != null and not canOverrideFyLock %}
          <span class="muted">&#128274; {{ lockMessage }}</span>
        {% elif canEditInrActual %}
          {% if lockMessage != null %}
            <p class="muted small" style="margin:0 0 6px;">&#9888; {{ lockMessage }} You hold the override permission — submitting below will be logged.</p>
          {% endif %}
          <form method="post" action="/orders/{{ order.id }}/payment/{{ leg }}/inr-actual">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>INR Amount Actually Credited *<input type="text" name="{{ leg }}_inr_actual" required></label>
            <button type="submit" class="btn-sm">{{ 'Override & Record' if lockMessage != null else 'Record INR Actual' }}</button>
          </form>
        {% else %}
          <span class="muted">Not yet recorded — needs someone with the "Add/edit INR actual" permission.</span>
        {% endif %}

        <div style="margin-top:8px; padding-top:8px; border-top:1px solid rgba(0,0,0,0.08);">
          <strong style="font-size:0.85em;">FIRC / eBRC Reference</strong><br>
          {% if fircReference != null %}
            <span class="muted small">{{ fircReference }} (received {{ fircReceivedAt }})</span>
          {% elif lockMessage != null and not canOverrideFyLock %}
            <span class="muted small">&#128274; {{ lockMessage }}</span>
          {% elif canEditInrActual %}
            {% if lockMessage != null %}
              <p class="muted small" style="margin:0 0 6px;">&#9888; {{ lockMessage }} You hold the override permission — submitting below will be logged.</p>
            {% endif %}
            <form method="post" action="/orders/{{ order.id }}/payment/{{ leg }}/firc">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <label>FIRC/eBRC Reference *<input type="text" name="{{ leg }}_firc_reference" required></label>
              <label>Received On<input type="date" name="{{ leg }}_firc_received_at"></label>
              <button type="submit" class="btn-sm">{{ 'Override & Record' if lockMessage != null else 'Record FIRC/eBRC' }}</button>
            </form>
          {% else %}
            <span class="muted small">Not yet recorded.</span>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% endmacro %}

{% set stage1 = stageByNumber[1] %}
{% set stage2 = stageByNumber[2] %}
{% set stage3 = stageByNumber[3] %}
{% set stage4 = stageByNumber[4] %}
{% set stage5 = stageByNumber[5] %}
{% set stage6 = stageByNumber[6] %}
{% set stage7 = stageByNumber[7] %}
{% set stage8 = stageByNumber[8] %}
{% set stage9 = stageByNumber[9] %}

{% set hasQt = stage1 and stage1.status == 'gate_passed' %}
{% set hasBuyerPo = stage2 and stage2.status == 'gate_passed' %}
{% set advanceCleared = stage3 and stage3.status == 'gate_passed' %}
{# Step 5 payment-method fork: when this order's preset set payment_method
   = 'LC' (snapshotted onto the order at creation, never Amendment-updatable
   — see docs/schema.sql), the LC leg (Record LC Details / Confirm LC
   Usable) replaces the cash-advance leg (Record Advance Remittance / Mark
   Advance Cleared) entirely — only one of the two ever renders. #}
{% set isLcPayment = (order.payment_method or 'CASH_ADVANCE') == 'LC' %}
{% set lcConfirmed = orderLcDetails and orderLcDetails.lc_confirmed_at != null %}
{% set buyerAcknowledged = stage4 and stage4.status == 'gate_passed' %}
{% set supplierSigned = stage5 and stage5.status == 'gate_passed' %}
{% set isFob = (order.incoterm_code | upper) == 'FOB' %}
{% set freightCleared = stage6 and stage6.status == 'gate_passed' %}
{% set blIssued = stage7 and stage7.status == 'gate_passed' %}
{% set balanceCleared = stage8 and stage8.status == 'gate_passed' %}
{% set orderClosed = order.status == 'complete' %}

{# Payment Snapshot + Payment Ledger data, computed here (rather than down
   where they're displayed) so the Order Details at-a-glance summary below
   can also reference the same paymentLegs without a second pass. Amounts
   are gated per canViewPaymentAmounts (set further down, mirrored here) —
   everyone who can view the order sees the STATUS of each leg; only
   manage_payments/close_orders (Super Admin already covered transitively)
   see the actual figures. #}
{% set canViewPaymentAmounts = permissions.manage_payments or permissions.close_orders %}
{% set paymentLegs = [
  { label: 'Advance', amount: payment.advance_amount if payment else null, received_at: payment.advance_remittance_received_at if payment else null, cleared_at: payment.advance_cleared_at if payment else null },
  { label: 'Freight', amount: payment.freight_amount if payment else null, received_at: payment.freight_remittance_received_at if payment else null, cleared_at: payment.freight_cleared_at if payment else null },
  { label: 'Balance', amount: payment.balance_amount if payment else null, received_at: payment.balance_remittance_received_at if payment else null, cleared_at: payment.balance_cleared_at if payment else null }
] %}
{# Owner decision (2026-10-26): the full ledger (supplier payments, every
   expense, export benefits, INR values and the net) only for
   manage_order_financials holders — see orderLedgerService. #}
{% set ledgerEvents = ledger.rows %}
{% set ledgerTotals = ledger.totals %}
{% set paymentLegsResolved = 0 %}
{% set paymentLegsApplicable = 0 %}
{% for leg in paymentLegs %}
  {% if leg.cleared_at %}{% set paymentLegsResolved = paymentLegsResolved + 1 %}{% endif %}
  {% if leg.amount != null or leg.received_at %}{% set paymentLegsApplicable = paymentLegsApplicable + 1 %}{% endif %}
{% endfor %}

{# Order Details at-a-glance summary (redesign) — quick counts reused from
   data already loaded for other sections, so no extra queries. #}
{% set complianceApproved = 0 %}
{% for ct in (complianceTasks or []) %}
  {% if ct.status == 'approved' or ct.status == 'skipped' %}{% set complianceApproved = complianceApproved + 1 %}{% endif %}
{% endfor %}
{% set complianceTotal = (complianceTasks or []) | length %}
{% set complianceOutstanding = complianceTotal - complianceApproved %}
{% set currentStage = null %}
{% for s in stages %}
  {% if not currentStage and s.status != 'gate_passed' and s.status != 'skipped' %}{% set currentStage = s %}{% endif %}
{% endfor %}

{# Order detail page rebuild (approved design: "NexaCrest: Standard vs Kanban
   UI" canvas, KanbanDetail.dc.html/Main.dc.html) — the user's own numbered
   0-17 export process sequence, shown as collapsible step-cards instead of
   a sidebar-nav-switched single-panel-at-a-time page. The lettered
   sub-steps (stepBadge above) carry no DB-backed state of their own;
   stepStatusFn below computes done/current/locked purely from the SAME
   signals the page already reads for each stage, centralized here once
   instead of scattered per-section, and used only to badge/auto-open a
   card — it never gates an action (every existing permission/stage-gate
   check below is completely unchanged). #}
{% macro stepStatusFn(stage, pastSignal) %}{% if orderClosed %}done{% elif not stage %}{% if pastSignal %}done{% else %}locked{% endif %}{% elif stage.status == 'gate_passed' or stage.status == 'skipped' %}done{% elif stage.status == 'in_progress' %}current{% else %}locked{% endif %}{% endmacro %}
{# Steps 1/2/3 used to share stage1's single DB status (which auto-passes
   the instant a QT is generated), so all three opened/closed together
   even though sending and client-acceptance hadn't actually happened
   yet. Each now gets its own real signal: step 1 from whether a QT
   document exists at all, step 2 from that QT's own 'sent' status,
   step 3 from whether work on the next real action (the Buyer PO) has
   actually started — the same thing its own card text already tells
   staff to treat as "client accepted." #}
{% set hasQtDoc = docGenerated(documents, 'QT') %}
{% set qtSent = docStatus(documents, 'QT') == 'sent' %}
{% set hasBuyerPoDoc = docGenerated(documents, 'BUYERPO') %}
{# Once the Buyer PO stage gate has passed, the quotation was evidently
   sent and accepted, even if it went out by email outside the app (QT
   left 'draft') or no BUYERPO document was generated. Without this,
   steps 2/3 stayed current/locked on an order already far past them, and
   firstNonDoneStep (the card opened and scrolled to on every load) was
   stuck on Step 2. #}
{% set quotationAccepted = hasBuyerPoDoc or hasBuyerPo %}
{% macro step123Status(reached, done) %}{% if orderClosed %}done{% elif not reached %}locked{% elif done %}done{% else %}current{% endif %}{% endmacro %}
{# Step 13: Close Order passes Stage 9's gate, but Step 13 isn't finished
   until the order is marked fully settled (13h) — owner report 2026-10-26. #}
{# Owner request (2026-10-26, t4): s12 is also done once Step 12 is completed (12c) or skipped with a reason; 7c is done once the ack is on file or staff recorded the supplier did not acknowledge. #}
{% set stepStates = {
  's1': step123Status(true, hasQtDoc),
  's2': step123Status(hasQtDoc, qtSent or quotationAccepted),
  's3': step123Status(qtSent or quotationAccepted, quotationAccepted),
  's4': stepStatusFn(stage2, false),
  's5': stepStatusFn(stage3, false),
  's6': stepStatusFn(stage4, false),
  's7': stepStatusFn(stage5, false),
  's8': stepStatusFn(stage5, supplierSigned),
  's9': stepStatusFn(stage6, false),
  's10': stepStatusFn(stage7, false),
  's11': stepStatusFn(stage8, false),
  's12': ('done' if (order.financials_skipped_at or order.financials_completed_at) else stepStatusFn(stage9, false)),
  's13': ('done' if orderClosed else ('locked' if (not stage9 or stage9.status == 'locked') else 'current')),
  's14': 'done',
  's15': 'done',
  's16': 'done',
  's17': 'done',
  's18': 'done',
  's19': ('done' if orderClosed else 'locked')
} %}
{# Sub-step progress (owner request, 2026-10-25: "open the lock of one door,
   enter the next room"): each lettered sub-step's own done signal, from data
   this page already loads, in card order. 'optional' = no signal of its own
   (it just follows its step). Cascade / current step / current sub-step
   logic lives in helpers/stepFlow.js. #}
{% set piFormSkipped = order.pi_form_skipped_at %}
{# Owner request (2026-10-26): 4b (Buyer PO Action Link) is optional — done once sent, never locks 4c. #}
{% set subStepDone = {
  's4': {
    '4a': docComplete(documents, 'BUYERPO', mailSendingEnabled),
    '4b': (true if order.buyer_action_token_hash else 'optional'),
    '4c': (buyerPoDocuments and buyerPoDocuments.length > 0) if buyerPoCopyRequired else 'optional',
    '4d': hasBuyerPo
  },
  's5': {
    '5a': piIntake or piFormSkipped,
    '5b': (piIntake and piIntake.status == 'applied') or piFormSkipped,
    '5c': docComplete(documents, 'PI', mailSendingEnabled),
    '5d': ((orderLcDetails and orderLcDetails.lc_amount != null) if isLcPayment else (payment and payment.advance_remittance_received_at)),
    '5e': (lcConfirmed if isLcPayment else advanceCleared)
  },
  's6': {
    '6a': docComplete(documents, 'OC', mailSendingEnabled),
    '6b': docComplete(documents, 'OC', mailSendingEnabled) and order.buyer_action_token_hash,
    '6c': buyerAcknowledged
  },
  's7': {
    '7a': supplierPo,
    '7b': docComplete(documents, 'SUPPO', mailSendingEnabled),
    '7c': ((supplierPoDocuments and supplierPoDocuments.length > 0) or (supplierPo and supplierPo.ack_skipped_at)) if supplierPoCopyRequired else 'optional',
    '7d': supplierSigned,
    '7e': supplierPo and (supplierPo.advance_paid_at or (supplierPo.advance_amount_inr | float) <= 0)
  },
  's9': {
    '9a': freight,
    '9b': docComplete(documents, 'FDN', mailSendingEnabled),
    '9c': payment and payment.freight_remittance_received_at,
    '9d': freightCleared
  },
  's10': {
    '10a': supplierPo and supplierPo.balance_paid_at,
    '10b': packing,
    '10c': docComplete(documents, 'PL', mailSendingEnabled),
    '10d': shipping,
    '10e': docComplete(documents, 'BLI', mailSendingEnabled),
    '10f': blIssued
  },
  's11': {
    '11a': docComplete(documents, 'CI', mailSendingEnabled),
    '11b': shipping and shipping.scanned_bl_sent_to_buyer_at,
    '11c': payment and payment.balance_remittance_received_at,
    '11d': balanceCleared
  },
  's13': {
    '13a': docComplete(documents, 'COOPREP', mailSendingEnabled),
    '13b': shipping and shipping.bl_originals_received_at,
    '13c': blEndorsement,
    '13d': docComplete(documents, 'BLE', mailSendingEnabled),
    '13e': shipping and shipping.bl_endorsed_at,
    '13f': orderClosed or order.status == 'shipped_docs_sent',
    '13g': orderClosed or (order.status == 'shipped_docs_sent' and benefitSettlement.done),
    '13h': orderClosed
  }
} %}
{# Owner decision (2026-10-26): staff can skip the PI-stage form when the
   client won't use it (reason required) — offered on 5a and 5b until the
   form is applied or skipped. #}
{% macro piFormSkip() %}
  {% if piFormSkipped %}
    <p class="muted small">PI-stage form skipped on {{ order.pi_form_skipped_at | humanDate }} — {{ order.pi_form_skip_reason }}</p>
  {% elif permissions.manage_orders and not (piIntake and piIntake.status == 'applied') %}
    <details class="pi-form-skip" style="margin-top:8px;">
      <summary class="small">Client won't use the PI-stage form? Skip it</summary>
      <form method="post" action="/orders/{{ order.id }}/pi-form/skip" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-top:6px;">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label style="flex:1;min-width:240px;">Reason *<input type="text" name="skip_reason" required placeholder="e.g. Repeat buyer — details unchanged from the Quotation"></label>
        <button type="submit" class="btn-sm btn-secondary">Skip PI Form — go to Generate PI</button>
      </form>
    </details>
  {% endif %}
{% endmacro %}
{# Owner decisions (2026-10-27): bill first, then pay. Whoever asks NexaCrest
   for money — the supplier (7e advance, 10a balance) or a logistics partner
   (CHA, transport, freight forwarder) — sends a bill; staff add it with the
   bill attached, then record the payment against it (date, amount, mode,
   UTR). One table + pay form for both kinds. #}
{% macro vendorPayTo(bank, editUrl, canEditVendor) %}
  {% set editLink %}{% if canEditVendor %} <a href="{{ editUrl }}#bank-details" target="_blank" rel="noopener">Open the directory entry</a>{% endif %}{% endset %}
  {% if not bank or not bank.has_bank %}
    <p class="review-banner warn">&#9888; No bank details on file — add them in the directory, or send the Vendor Details Link.{{ editLink | safe }}</p>
  {% else %}
    <div class="pay-to"><strong>Pay to:</strong> {{ bank.bank_account_name }} · {{ bank.bank_name }}{% if bank.bank_branch %} ({{ bank.bank_branch }}){% endif %} · A/c <code>{{ bank.bank_account_number }}</code> · IFSC <code>{{ bank.bank_ifsc }}</code>{% if bank.bank_upi_id %} · UPI {{ bank.bank_upi_id }}{% endif %}{% if bank.bank_verified_at %} <span class="badge good">&#10003; Verified</span>{% else %} <span class="badge warn">&#9888; Not verified — check before paying</span>{{ editLink | safe }}{% endif %}</div>
  {% endif %}
{% endmacro %}
{% macro vendorBillTable(bills, showPartner, canPay, payBlocked) %}
  {% if not bills.length %}
    <p class="muted small">No bills added yet.</p>
    {% if canPay and payBlocked !== null %}<p class="review-banner warn">&#9888; {{ payBlocked }} Bills can still be added now.</p>{% endif %}
  {% else %}
  {% set t = vendorBillsView.totals(bills) %}
  <table class="list vendor-bills">
    <tr>{% if showPartner %}<th>Partner</th>{% endif %}<th>For</th>{% if showPartner %}<th>Payment</th>{% endif %}<th>Bill / invoice</th><th style="text-align:right">Taxable &#8377;</th><th style="text-align:right">GST &#8377;</th><th style="text-align:right">Bill total &#8377;</th><th>Paid</th></tr>
    {% for b in bills %}
    <tr id="vendor-bill-{{ b.id }}">
      {% if showPartner %}<td>{{ b.partner_name or '—' }}</td>{% endif %}
      <td>{{ (vendorBillLegs[b.bill_for] or b.bill_for) if b.vendor_kind == 'supplier' else (logisticsServices[b.bill_for] or b.bill_for) }}</td>
      {# Owner decision (2026-10-27): a logistics Advance bill is never held back; only the Final bill waits. #}
      {% set isAdvanceBill = b.vendor_kind == 'logistics' and b.payment_kind == 'advance' %}
      {% set rowBlocked = null if isAdvanceBill else payBlocked %}
      {% if showPartner %}<td><span class="badge {{ 'badge-advance' if isAdvanceBill else 'badge-final' }}">{{ 'Advance' if isAdvanceBill else 'Final' }}</span></td>{% endif %}
      <td>{{ b.bill_no }} · {{ b.bill_date | shortDate }}{% if b.bill_file_id %} · <a href="/file-store/{{ b.bill_file_id }}/download">bill</a>{% endif %}{% if b.note %}<br><small class="muted">{{ b.note }}</small>{% endif %}</td>
      <td style="text-align:right">{{ b.taxable_inr | money }}</td>
      <td style="text-align:right">{{ b.gst_inr | money }}</td>
      <td style="text-align:right">{{ b.total_inr | money }}</td>
      <td>
        {% if b.paid_at %}
          <span class="vendor-bill-paid">&#10003; &#8377;{{ b.paid_amount_inr | money }} on {{ b.paid_at | shortDate }}</span><br><small class="muted">{{ b.payment_mode }} · {{ b.payment_ref }}</small>
        {% else %}
          <span class="vendor-bill-due">Unpaid</span>
          {% if canPay and rowBlocked === null %}
          <details class="vendor-bill-pay">
            <summary class="btn-sm">Mark Paid</summary>
            {% if b.vendor_kind == 'supplier' %}{{ vendorPayTo(supplierBank, '/suppliers/' + (supplierPo.supplier_id or 0) + '/edit', permissions.manage_suppliers and supplierPo.supplier_id) }}{% else %}{{ vendorPayTo(logisticsBanks[b.logistics_partner_id], '/logistics-partners/' + b.logistics_partner_id + '/edit', permissions.manage_logistics_partners) }}{% endif %}
            <form method="post" action="/orders/{{ order.id }}/vendor-bills/{{ b.id }}/pay" class="field-grid">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <label>Amount paid (&#8377;) *<input type="number" step="0.01" min="0.01" name="paid_amount_inr" value="{{ b.total_inr }}" required></label>
              <label>Paid on *<input type="date" name="paid_at" value="{{ today() }}" max="{{ today() }}" required></label>
              <label>Mode *
                <select name="payment_mode" required>
                  {% for mode in paymentModes %}<option>{{ mode }}</option>{% endfor %}
                </select>
              </label>
              <label>UTR / reference *<input type="text" name="payment_ref" required placeholder="e.g. SBIN1234567890"></label>
              <div><button type="submit" class="btn-sm">Save Payment</button></div>
            </form>
          </details>
          <form method="post" action="/orders/{{ order.id }}/vendor-bills/{{ b.id }}/delete" data-confirm="Remove the unpaid bill {{ b.bill_no }}?" style="display:inline">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-link small">Remove</button>
          </form>
          {% endif %}
        {% endif %}
      </td>
    </tr>
    {% endfor %}
    <tr><td colspan="{{ 6 if showPartner else 4 }}"><strong>Total</strong></td><td style="text-align:right"><strong>{{ t.total | money }}</strong></td><td><span class="vendor-bill-paid">Paid &#8377;{{ t.paid | money }}</span>{% if t.due > 0 %}<br><span class="vendor-bill-due">Due &#8377;{{ t.due | money }}</span>{% endif %}</td></tr>
  </table>
  {% if canPay and payBlocked !== null %}
    <p class="review-banner warn">&#9888; {{ payBlocked }} Bills can still be added now.</p>
  {% endif %}
  {% endif %}
{% endmacro %}
{# The bill fields both kinds share (number, date, taxable, GST, the bill itself). #}
{% macro vendorBillFields(gstRates) %}
    <label>Bill / invoice no. *<input type="text" name="bill_no" required maxlength="100" placeholder="e.g. INV-120"></label>
    <label>Bill date *<input type="date" name="bill_date" required max="{{ today() }}"></label>
    <label>Taxable value (&#8377;) *<input type="number" step="0.01" min="0.01" name="taxable_inr" required data-gst-base></label>
    <label>GST rate (%) *
      <select name="gst_rate_pct" required data-gst-rate>
        {% for o in gstRates %}
          <option value="{{ o.option_value }}" {{ 'selected' if o.is_default else '' }}>{{ o.option_value }}%</option>
        {% endfor %}
      </select>
    </label>
    <label>GST (&#8377;) <small class="muted">(auto: Taxable &times; GST rate)</small><input type="text" readonly tabindex="-1" data-gst-amount value="0.00"></label>
    <label>Bill total (&#8377;) <small class="muted">(auto: Taxable + GST)</small><input type="text" readonly tabindex="-1" data-gst-total value="0.00"></label>
    <label>Attach bill *<input type="file" name="bill_file" required accept=".pdf,.jpg,.jpeg,.png"></label>
    <label>Note<input type="text" name="note" maxlength="500" placeholder="optional"></label>
{% endmacro %}
{# Owner request (2026-10-26): the supplier's advance (Step 7e) and balance
   (Step 10a — due before packing) are their own sub-steps; owner decisions
   (2026-10-27): each is now the supplier's bill, then the payment against it. #}
{% macro supplierPayment(leg) %}
  {% set label = 'Advance' if leg == 'advance' else 'Balance' %}
  {% if not supplierPo %}
    <p class="muted">Save the Supplier PO terms first (Step 7a).</p>
  {% else %}
    {% set legBills = vendorBillsView.supplierLeg(vendorBills, supplierPo.id, leg) %}
    <div class="plan-bar"><div>Supplier PO<b>{{ supplierPo.supplier_po_reference }}</b></div><div>PO total<b>{{ ('&#8377;' + (supplierPo.total_payable_inr | money)) | safe if supplierPo.total_payable_inr !== null else '—' }}</b></div><div>{{ label }} planned<b>{{ ('&#8377;' + (supplierPo[leg + '_amount_inr'] | money)) | safe if supplierPo[leg + '_amount_inr'] !== null else '—' }}</b></div>{% if supplierPo[leg + '_paid_at'] %}<div>{{ label }} paid<b class="vendor-bill-paid">&#8377;{{ (supplierPo[leg + '_paid_amount_inr'] or supplierPo[leg + '_amount_inr']) | money }} on {{ supplierPo[leg + '_paid_at'] | humanDate }}</b></div>{% endif %}</div>
    {% if supplierPo[leg + '_paid_at'] and not legBills.length %}
      {# Recorded before bills were kept — the payment stands as it is. #}
      <p class="muted small">Paid before supplier bills were recorded here.</p>
    {% else %}
      {# Owner report (2026-10-27): the balance waits for the advance whenever the terms plan one. #}
      {% set payBlocked = ('Pay the supplier advance first (Step 7e) — the Supplier PO terms plan an advance of ₹' + supplierPo.advance_amount_inr + '.') if (leg == 'balance' and (supplierPo.advance_amount_inr | float) > 0 and not supplierPo.advance_paid_at) else null %}
      {# Owner decision (2026-10-27): 0% advance — nothing to pay in 7e; the whole amount is the balance (10a). #}
      {% set noAdvance = leg == 'advance' and not supplierPo.advance_paid_at and (supplierPo.advance_amount_inr | float) <= 0 %}
      {% if noAdvance and not legBills.length %}
        <p class="review-banner ok">&#10003; <span><strong>No advance on this order</strong> — the Supplier PO terms plan no advance, so there is nothing to pay here. The full amount is paid as the supplier balance in <a href="#step-10a-supplier-balance-paid">Step 10a</a>.</span></p>
      {% else %}
        {{ vendorBillTable(legBills, false, permissions.manage_supplier_payments, payBlocked) }}
      {% endif %}
      {% if not permissions.manage_supplier_payments %}
        <p class="muted small">Bills and payments are recorded by Accounts (needs the "Manage supplier payments" permission).</p>
      {% else %}
      <details class="vendor-bill-add"{% if not legBills.length and not noAdvance %} open{% endif %}>
        <summary class="small"><strong>+ Add the supplier's {{ label | lower }} bill{{ ' anyway' if noAdvance else '' }}</strong> <span class="muted">({{ 'advance / proforma invoice' if leg == 'advance' else 'tax invoice' }})</span></summary>
        <form method="post" action="/orders/{{ order.id }}/vendor-bills/supplier" enctype="multipart/form-data" class="field-grid">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="bill_for" value="{{ leg }}">
          {{ vendorBillFields(gstRates) }}
          <div><button type="submit" class="btn-sm">Add Bill</button></div>
        </form>
      </details>
      {% endif %}
    {% endif %}
  {% endif %}
{% endmacro %}
{# Owner request (2026-10-26): the Compliance Checklist is split by when
   each task is done — "order" tasks (Due Diligence, ECGC Cover...) sit at
   the start of Step 7 alongside the Supplier PO; "shipment" tasks
   (Fumigation, Phytosanitary, Pre-Shipment Inspection...) at the start of
   Step 10. Both run alongside the other cards and never lock them. Each row
   saves on its own without reloading the page (public/js/app.js). #}
{% macro complianceCard(phase, step) %}
  {% if permissions.close_orders %}
  {% set tasks = complianceTasks | whereEq('phase', phase) %}
  {% if tasks.length %}
  {% set outstanding = tasks | whereNotIn('status', ['approved', 'skipped']) | length %}
  {% set status = 'done' if outstanding == 0 else ('locked' if stepStates[step] == 'locked' else 'current') %}
  <details class="step-card step-card-parallel" id="{{ 'compliance-checklist' if phase == 'order' else 'compliance-checklist-shipment' }}"{{ ' open' if (outstanding > 0 and step == currentUserStep) else '' }}>
    <summary>{{ stepStatusIcon(status) }}<h2>{{ 'Compliance — with the Supplier PO' if phase == 'order' else 'Compliance — before shipment' }}{% if outstanding > 0 %} <small class="muted">(<span data-compliance-outstanding>{{ outstanding }}</span> open)</small>{% endif %}</h2></summary>
    <p class="muted small">Runs alongside the steps below — it never locks them. Every task must be resolved (approved or skipped with a reason) before the order can be marked fully settled. The task list is managed from {% if permissions.manage_compliance_task_types %}<a href="/compliance-task-types">Compliance Task Types</a>{% else %}Compliance Task Types{% endif %} (Admin-only).</p>
    {# Owner request (2026-10-26): one Save for the whole card — every row is posted together and each is stored on its own task. #}
    <form method="post" action="/orders/{{ order.id }}/compliance-tasks" class="compliance-card-form" data-no-draft>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="phase" value="{{ phase }}">
      <table class="list">
        <tr><th>Task</th><th>Status</th><th>Reason <small class="muted">(Not Applicable fills it in; Skipped needs one)</small></th></tr>
        {% for ct in tasks %}
        {% set i = loop.index0 %}
        <tr data-compliance-row>
          <td>{{ ct.task_type_name }}
            <input type="hidden" name="tasks[{{ i }}][task_type_id]" value="{{ ct.task_type_id }}">
            {% if ct.resolved_at %}<br><span class="muted small">{{ ct.resolved_at }}{% if ct.resolved_by_name %} by {{ ct.resolved_by_name }}{% endif %}</span>{% endif %}
          </td>
          <td>
            <select name="tasks[{{ i }}][status]" data-compliance-status aria-label="{{ ct.task_type_name }} status" style="min-width:170px;">
              {# Owner request (2026-10-27): "Not Applicable" fills its reason in;
                 "Skipped" needs one typed. Both are saved as 'skipped'. #}
              {% set isNa = ct.status == 'skipped' and (ct.skip_reason or '') | trim == complianceNaReason %}
              {% for key, label in complianceStatuses %}
              {% if key == 'skipped' %}
              <option value="skipped" data-auto-reason="{{ complianceNaReason }}" {% if isNa %}selected{% endif %}>Not Applicable</option>
              <option value="skipped" {% if ct.status == 'skipped' and not isNa %}selected{% endif %}>Skipped (give a reason)</option>
              {% else %}
              <option value="{{ key }}" {% if ct.status == key %}selected{% endif %}>{{ label }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </td>
          <td><input type="text" name="tasks[{{ i }}][skip_reason]" class="compliance-skip-reason" data-compliance-reason value="{{ ct.skip_reason or '' }}" placeholder="Why is it not applicable?"></td>
        </tr>
        {% endfor %}
      </table>
      <button type="submit" class="btn-sm">Save Checklist</button>
      <span class="muted small">Saves every row at once — only the rows you changed are updated.</span>
    </form>
    {% if outstanding > 0 %}
    <form method="post" action="/orders/{{ order.id }}/compliance-tasks/mark-all-na" style="margin-top:10px;border-top:1px solid var(--line);padding-top:10px;" data-confirm="Mark every outstanding task in this checklist Not Applicable? Use this for a repeat order where these tasks genuinely do not apply.">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="phase" value="{{ phase }}">
      <label>Mark all remaining tasks here Not Applicable <small class="muted">(e.g. repeat order — reason required, applied to every outstanding task above)</small>
        <input type="text" name="skip_reason" placeholder="Reason (mandatory)" required style="min-width:260px;" value="{{ complianceNaReason }}">
      </label>
      <button type="submit" class="btn-sm">Mark All N/A</button>
    </form>
    {% endif %}
  </details>
  {% endif %}
  {% endif %}
{% endmacro %}
{# Owner report (2026-10-27): Step 7 waits for the supplier advance (7e), Step 8 for a real production / shipment entry ('Not yet commenced' is the column default, not an entry), Group C for Group B (helpers/stepFlow.js). #}
{% set flow = computeStepFlow(stepStates, subStepDone, {
  orderClosed: orderClosed,
  supplierAdvancePending: (supplierPo and (supplierPo.advance_amount_inr | float) > 0 and not supplierPo.advance_paid_at),
  productionUpdated: ((order.production_status_text and (order.production_status_text | trim) != 'Not yet commenced') or order.est_shipment_date_text or order.est_shipment_date),
  freightSkipped: (stage6 and stage6.status == 'skipped')
}) %}
{% set stepStates = flow.stepStates %}
{% set currentUserStep = flow.currentUserStep %}
{% macro stepCardOpen(step) %}{{ flow.stepCardOpen(step) }}{% endmacro %}
{# Owner request (2026-10-26): one of the five major sections' header —
   ph comes from flow.phase(key) (helpers/stepFlow). #}
{% macro phaseSummary(ph, badges = '') %}<summary>{% if ph.state == 'any' %}<span class="step-card-icon any" aria-hidden="true">&#8634;</span>{% else %}{{ stepStatusIcon(ph.state) }}{% endif %}<span class="phase-tag">{{ ph.letter }}</span><span class="phase-heading"><h2>{{ ph.title }}{{ badges | safe }}</h2><span class="phase-sub">{{ ph.sub }}</span></span>{% if ph.total %}<span class="phase-progress">{{ ph.done }} of {{ ph.total }} steps done<span class="phase-bar"><i style="width:{{ (100 * ph.done / ph.total) | round }}%"></i></span></span>{% else %}<span class="phase-progress">available any time</span>{% endif %}</summary>{% endmacro %}
{% macro stepStatusIcon(status) %}{% if status == 'done' %}<span class="step-card-icon done" aria-hidden="true">&#10003;</span>{% elif status == 'current' %}<span class="step-card-icon current" aria-hidden="true">&#9679;</span>{% else %}<span class="step-card-icon locked" aria-hidden="true">&#9675;</span>{% endif %}{% endmacro %}

<div class="card page-wide">
  {% if query.from == 'kanban' %}
  <p class="muted small"><a href="/orders">&larr; Back to Board</a></p>
  {% else %}
  <p class="muted small"><a href="/orders">&larr; Back to Orders</a></p>
  {% endif %}
  <h1>{{ order.order_reference }}
    {% if order.status != 'active' %}<span class="badge badge-{{ order.status }}">{{ order.status }}</span>{% endif %}
  </h1>
  <p class="muted">
    {{ order.company_legal_name }} &nbsp;&middot;&nbsp;
    Buyer Inquiry Ref: {{ order.buyer_inquiry_ref }} &nbsp;&middot;&nbsp;
    {{ order.incoterm_code }} {{ order.port_of_loading_city or order.port_of_loading_name or '' }}
    {% if permissions.view_reports %}&nbsp;&middot;&nbsp; <a href="/reports/order/{{ order.id }}">Full Report</a>{% endif %}
    {% if permissions.manage_orders %}&nbsp;&middot;&nbsp; <a href="/orders/{{ order.id }}/edit">Edit Order Details</a>{% endif %}
    {% if seesAllOrders %}&nbsp;&middot;&nbsp; Assigned to: <strong>{{ order.assignee_names or 'Unassigned' }}</strong>{% endif %}
  </p>
  {% if canAssignOwner %}
  <div class="btn-row" style="margin-top:-6px;align-items:center;flex-wrap:wrap;">
    {% for a in assignees %}
      <form method="post" action="/orders/{{ order.id }}/assignees/{{ a.user_id }}/remove" style="display:inline" onsubmit="return confirm('Remove {{ a.name }} as an assignee on this order?');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <span class="tag tag-navy">{{ a.name }} <button type="submit" class="btn-sm btn-danger" style="padding:0 4px;margin-left:4px;" title="Remove">&times;</button></span>
      </form>
    {% endfor %}
  </div>
  <form method="post" action="/orders/{{ order.id }}/assignees" class="btn-row" style="margin-top:4px;margin-bottom:16px;align-items:center;">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label class="muted small" style="margin:0;">Add assignee
      <select name="user_id" style="margin-left:4px;">
        {% for u in activeUsers %}
          {% if u.id not in assignedUserIds %}
            <option value="{{ u.id }}">{{ u.name }} ({{ u.role_name or '—' }})</option>
          {% endif %}
        {% endfor %}
      </select>
    </label>
    <button type="submit" class="btn-sm">Add</button>
  </form>
  {% endif %}
  {% if duplicatedFromOrder %}
    <p class="notice notice-info">This order was created as a repeat order from <a href="/orders/{{ duplicatedFromOrder.id }}">{{ duplicatedFromOrder.order_reference }}</a>.{% if supplierPo and supplierPo.status == 'draft' %} Its Supplier PO terms were carried over below as a draft — review and confirm once Stage 5 is reached.{% endif %}</p>
  {% endif %}
  {% if duplicatedIntoOrders.length > 0 %}
    <p class="notice notice-info">Repeat order{{ 's' if duplicatedIntoOrders.length != 1 else '' }} placed from this order:
      {% for d in duplicatedIntoOrders %}{{ ', ' if not loop.first }}<a href="/orders/{{ d.id }}">{{ d.order_reference }}</a>{% endfor %}.
    </p>
  {% endif %}
  {% if permissions.manage_orders %}
    <form method="post" action="/orders/{{ order.id }}/duplicate" style="display:inline" onsubmit="return confirm('Create a new order copying this one\'s client, commercial terms, and product lines? Nothing about this order changes.');">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-sm btn-secondary" title="Repeat order — copies client, commercial terms, and product lines into a brand-new order">Duplicate Order</button>
    </form>
  {% endif %}
  {% if order.status == 'lost' %}
    <p class="muted small">Marked lost{% if order.lost_at %} on {{ order.lost_at }}{% endif %}{% if order.lost_reason %} — reason: {{ order.lost_reason }}{% endif %}</p>
  {% endif %}
  {% if order.is_archived %}
    <p class="muted small">Archived{% if order.archived_at %} on {{ order.archived_at }}{% endif %} — hidden from the main Orders list. Nothing was deleted.</p>
    {% if permissions.manage_orders %}
    <form method="post" action="/orders/{{ order.id }}/unarchive" style="display:inline" onsubmit="return confirm('Restore {{ order.order_reference }} to the main Orders list?');">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-sm btn-success">Restore from Archive</button>
    </form>
    {% endif %}
  {% elif permissions.manage_orders %}
    <form method="post" action="/orders/{{ order.id }}/archive" style="display:inline" onsubmit="return confirm('Archive {{ order.order_reference }}? It will no longer appear in the main Orders list, but nothing is deleted and it can be restored any time.');">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-sm btn-secondary">Archive Order</button>
    </form>
  {% endif %}
  {% if order.status == 'active' and permissions.close_orders %}
  <form method="post" action="/orders/{{ order.id }}/mark-lost" style="display:inline" onsubmit="return confirmMarkLost(this);">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="reason" class="mark-lost-reason">
    <button type="button" class="btn-sm btn-danger" onclick="promptMarkLost(this)">Mark as Lost</button>
  </form>
  <script>
    function promptMarkLost(btn) {
      var form = btn.closest('form');
      var reason = promptForReason('Why is this order lost? (required — recorded in the audit log)');
      if (!reason) { return; }
      form.querySelector('.mark-lost-reason').value = reason.trim();
      form.requestSubmit ? form.requestSubmit() : form.submit();
    }
    function confirmMarkLost(form) {
      var reason = form.querySelector('.mark-lost-reason').value;
      if (!reason) { return false; }
      return confirm('Mark {{ order.order_reference }} as LOST? This locks the order (same as closing it) and cannot be undone from this screen.');
    }
  </script>
  {% endif %}

  {# External QA report M-09: formal cancellation workflow, distinct from
     Mark as Lost above (which only ever applies pre-money, while this
     order is still 'active' with no BL on file). A request here never
     changes the order's own status; only an approval does. #}
  {% if order.status == 'cancelled' %}
    <p class="muted small">
      Cancelled{% if approvedCancellation and approvedCancellation.decided_at %} on {{ approvedCancellation.decided_at }} by {{ approvedCancellation.decided_by_name or 'unknown' }}{% endif %}
      {% if approvedCancellation %} — reason: {{ approvedCancellation.reason }}{% endif %}
      {% if approvedCancellation and approvedCancellation.refund_status != 'not_applicable' %}
        <br>Refund: {{ approvedCancellation.refund_status | replace('_', ' ') }}{% if approvedCancellation.refund_amount != null %} — {{ order.currency_code }} {{ approvedCancellation.refund_amount | money }}{% endif %}
        {% if approvedCancellation.refund_status == 'pending' and permissions.close_orders %}
          <form method="post" action="/orders/{{ order.id }}/cancellation/{{ approvedCancellation.id }}/complete-refund" style="display:inline" onsubmit="return confirm('Mark this refund as completed? Record this only once the money has actually been sent back.');">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="text" name="refund_notes" placeholder="Refund reference / notes (optional)" style="width:260px">
            <button type="submit" class="btn-sm btn-secondary">Mark Refund Completed</button>
          </form>
        {% endif %}
      {% endif %}
    </p>
  {% elif pendingCancellation %}
    <div class="review-banner" style="flex-direction:column;align-items:stretch;gap:6px">
      <span>Cancellation requested by {{ pendingCancellation.requested_by_name or 'unknown' }} on {{ pendingCancellation.requested_at }} — awaiting approval.<br>Reason: {{ pendingCancellation.reason }}</span>
      {% if permissions.edit_locked_data %}
        <form method="post" action="/orders/{{ order.id }}/cancellation/{{ pendingCancellation.id }}/approve" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap" onsubmit="return confirm('Approve this cancellation? The order will be locked as CANCELLED and this cannot be undone from this screen.');">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <select name="refund_status">
            <option value="not_applicable">No refund applicable</option>
            <option value="pending">Refund pending</option>
            <option value="completed">Refund already completed</option>
          </select>
          <input type="text" name="refund_amount" placeholder="Refund amount (optional)" style="width:160px">
          <input type="text" name="decision_notes" placeholder="Approval notes (optional)" style="width:220px">
          <button type="submit" class="btn-sm btn-success">Approve Cancellation</button>
        </form>
        <form method="post" action="/orders/{{ order.id }}/cancellation/{{ pendingCancellation.id }}/reject" style="display:flex;gap:6px;align-items:center" onsubmit="return confirmRejectCancellation(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="decision_notes" class="reject-cancellation-notes">
          <button type="button" class="btn-sm btn-danger" onclick="promptRejectCancellation(this)">Reject Cancellation</button>
        </form>
        <script>
          function promptRejectCancellation(btn) {
            var form = btn.closest('form');
            var notes = promptForReason('Why is this cancellation request being rejected? (required — recorded in the audit log)');
            if (!notes) { return; }
            form.querySelector('.reject-cancellation-notes').value = notes.trim();
            form.requestSubmit ? form.requestSubmit() : form.submit();
          }
          function confirmRejectCancellation(form) {
            var notes = form.querySelector('.reject-cancellation-notes').value;
            if (!notes) { return false; }
            return confirm('Reject this cancellation request? The order is unaffected.');
          }
        </script>
      {% endif %}
    </div>
  {% elif permissions.close_orders and order.status not in ['complete', 'lost'] %}
    <form method="post" action="/orders/{{ order.id }}/cancellation/request" style="display:inline" onsubmit="return confirmRequestCancellation(this);">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="reason" class="request-cancellation-reason">
      <button type="button" class="btn-sm btn-danger" onclick="promptRequestCancellation(this)">Request Cancellation</button>
    </form>
    <script>
      function promptRequestCancellation(btn) {
        var form = btn.closest('form');
        var reason = promptForReason('Why is cancellation being requested? (required — recorded in the audit log; a privileged second person still has to approve this)');
        if (!reason) { return; }
        form.querySelector('.request-cancellation-reason').value = reason.trim();
        form.requestSubmit ? form.requestSubmit() : form.submit();
      }
      function confirmRequestCancellation(form) {
        var reason = form.querySelector('.request-cancellation-reason').value;
        if (!reason) { return false; }
        return confirm('Request cancellation for {{ order.order_reference }}? This does not cancel the order by itself — a privileged second person still has to approve it.');
      }
    </script>
  {% endif %}

  {# Point 2 (2026-10-01): a quick-glance horizontal line-with-dots
     indicator of where this order stands in the 9-stage pipeline. This
     used to sit above a second, more detailed "Stage N" chip grid that
     repeated the exact same 9-stage status in box form — removed (QA
     feedback: showing the same status three times, once here and again
     via every step-card's own status icon, reads as duplication rather
     than detail) so the dots are now the only stage-level indicator.
     The connecting line segment left of a step is colored via CSS purely
     off that step's own status class (in_progress/gate_passed/skipped
     all mean "the process has reached this far"), so no extra
     per-segment markup is needed. #}
  <div class="process-stepper" role="list" aria-label="Order stage sequence">
    {% for s in stages %}
      <div class="process-step {{ s.status }}" role="button" tabindex="0" data-stage="{{ s.stage_number }}" aria-label="Jump to Stage {{ s.stage_number }} — {{ s.stage_name }}" {% if s.status == 'in_progress' %}aria-current="step"{% endif %}>
        <div class="process-step-dot">{{ s.stage_number }}</div>
        <div class="process-step-label">{{ s.stage_name }}</div>
      </div>
    {% endfor %}
  </div>
  {# External QA report U-12: on a phone the progress line only shows the
     first few stages with no hint that it scrolls sideways for the rest.
     CSS-only, shown just at the same <=900px width everything else on
     this page already switches to a mobile layout at. #}
  <p class="muted small stepper-scroll-hint">&larr;&rarr; Swipe to see all stages</p>

  <div class="order-layout" id="order-layout">
    <div class="step-sequence" id="order-panels">

  <details class="step-card" id="step-products">
    <summary><h2>Products</h2></summary>
    {% set canEditProducts = permissions.manage_orders and (not isLockedOrder or canOverrideLockEdit) and (not isPostConfirmationOrder or canOverrideOrderEdit) %}
    {% if not canEditProducts %}
      <table class="list">
        <tr><th>#</th><th>Description</th><th>Qty</th><th>Unit</th><th>Unit Price</th><th>Amount</th></tr>
        {% for p in products %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ p.description }}{% if p.dimensions or p.finish %}<br><span class="muted small">{{ p.dimensions or '' }} {{ p.finish or '' }}</span>{% endif %}</td>
          <td>{{ 'To Be Confirmed' if p.quantity_is_tbc else p.quantity }}</td>
          <td>{{ p.unit or '' }}</td>
          <td>{{ (p.unit_price | money) if p.unit_price != null else 'To Be Confirmed' }}</td>
          <td>{{ (p.fob_value | money) if p.fob_value != null else 'To Be Confirmed' }}</td>
        </tr>
        {% endfor %}
      </table>
      {% if isLockedOrder and permissions.manage_orders %}
        <p class="notice notice-error">This order is LOCKED (closed or marked lost) — editing or duplicating a product line now needs the "Override locked data" permission.</p>
      {% elif isPostConfirmationOrder and permissions.manage_orders %}
        <p class="notice notice-error">This order has already reached Order Confirmation — editing or duplicating a product line now needs the "Edit an order after confirmation" permission.</p>
      {% endif %}
    {% else %}
      {% if isLockedOrder %}
        <p class="notice notice-warning">This order is LOCKED (closed or marked lost). Adding, editing, duplicating, or removing a product line will be logged as a locked-order edit override — a reason is required below.</p>
      {% elif isPostConfirmationOrder %}
        <p class="notice notice-warning">This order has already reached Order Confirmation. Adding, editing, duplicating, or removing a product line will be logged as a post-confirmation edit — a reason is required below.</p>
      {% endif %}
      {% set productReasonRequired = isLockedOrder or isPostConfirmationOrder %}
      {% for p in products %}
        <div class="card-nested">
          <form method="post" action="/orders/{{ order.id }}/products/{{ p.id }}">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <div class="kv-grid">
              <label>Description *<input type="text" name="description" value="{{ p.description }}" required></label>
              <label>Dimensions<input type="text" name="dimensions" value="{{ p.dimensions or '' }}"></label>
              <label>Finish
                <select name="finish">
                  <option value="">—</option>
                  {% for o in surfaceFinishes %}
                    <option value="{{ o.option_value }}" {% if p.finish == o.option_value %}selected{% endif %}>{{ o.option_value }}</option>
                  {% endfor %}
                </select>
              </label>
              <label>Qty<input type="text" name="quantity" value="{{ p.quantity or '' }}"></label>
              <label><input type="checkbox" name="quantity_is_tbc" value="1" style="display:inline-block;width:auto;" {{ 'checked' if p.quantity_is_tbc }}> Qty To Be Confirmed</label>
              <label>Unit
                <select name="unit">
                  {% for o in units %}
                    <option value="{{ o.option_value }}" {% if p.unit == o.option_value %}selected{% endif %}>{{ o.option_value }}</option>
                  {% endfor %}
                </select>
              </label>
              <label>Unit Price<input type="text" name="unit_price" value="{{ p.unit_price or '' }}"></label>
              <label>HS Code<input type="text" name="hs_code" value="{{ p.hs_code }}" list="hs_code_list_edit" required></label>
            </div>
            {% if productReasonRequired %}
              <label>Reason *<textarea name="reason" rows="2" required minlength="10" placeholder="Why is this line changing?"></textarea></label>
            {% endif %}
            <button type="submit" class="btn-sm">{{ 'Override & Save' if productReasonRequired else 'Save' }}</button>
          </form>
          <form method="post" action="/orders/{{ order.id }}/products/{{ p.id }}/duplicate" style="display:inline">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            {% if productReasonRequired %}<input type="text" name="reason" placeholder="Reason (required)" required minlength="10" style="display:inline-block;width:auto;">{% endif %}
            <button type="submit" class="btn-sm btn-secondary" title="Clone this line — handy when only the name or dimensions differ">Duplicate</button>
          </form>
          <form method="post" action="/orders/{{ order.id }}/products/{{ p.id }}/delete" style="display:inline" onsubmit="return confirm('Remove this product line?');">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            {% if productReasonRequired %}<input type="text" name="reason" placeholder="Reason (required)" required minlength="10" style="display:inline-block;width:auto;">{% endif %}
            <button type="submit" class="btn-sm btn-danger">Remove</button>
          </form>
        </div>
      {% endfor %}
      {% if not products or products.length == 0 %}<p class="muted">No product lines yet.</p>{% endif %}

      <div class="card-nested">
        <strong>Add Product Line</strong>
        <form method="post" action="/orders/{{ order.id }}/products">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <div class="kv-grid">
            <label>Description *<input type="text" name="description" required></label>
            <label>Dimensions<input type="text" name="dimensions"></label>
            <label>Finish
              <select name="finish">
                <option value="">—</option>
                {% for o in surfaceFinishes %}
                  <option value="{{ o.option_value }}" {% if o.is_default %}selected{% endif %}>{{ o.option_value }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Qty<input type="text" name="quantity"></label>
            <label><input type="checkbox" name="quantity_is_tbc" value="1" style="display:inline-block;width:auto;"> Qty To Be Confirmed</label>
            <label>Unit
              <select name="unit">
                {% for o in units %}
                  <option value="{{ o.option_value }}" {% if o.is_default %}selected{% endif %}>{{ o.option_value }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Unit Price<input type="text" name="unit_price"></label>
            <label>HS Code<input type="text" name="hs_code" list="hs_code_list_edit" required></label>
          </div>
          {% if productReasonRequired %}
            <label>Reason *<textarea name="reason" rows="2" required minlength="10" placeholder="Why is a new line being added?"></textarea></label>
          {% endif %}
          <button type="submit">{{ 'Override & Add' if productReasonRequired else 'Add Product Line' }}</button>
        </form>
      </div>
      <datalist id="hs_code_list_edit">
        {% for hc in hsCodes %}
          <option value="{{ hc.code }}">{{ hc.description or '' }}</option>
        {% endfor %}
      </datalist>
    {% endif %}
  </details>

  <details class="step-card step-card-reference" id="payment-overview">
    <summary><h2>Payment Overview <small class="muted">(reference — every leg, always current)</small></h2></summary>
    <p class="muted small">Pinned here at the top rather than wherever it happened to sit in the sequence, since it's referenced from every payment step below and staff need it at a glance regardless of which step they're on.</p>

    <div class="tabs" data-tabs>
      <div class="tabs-nav" role="tablist">
        <button type="button" class="tab-btn" data-tab-target="payment-overview-snapshot" aria-selected="true">Snapshot</button>
        <button type="button" class="tab-btn" data-tab-target="payment-overview-ledger" aria-selected="false">Ledger</button>
        <button type="button" class="tab-btn" data-tab-target="payment-overview-full-status" aria-selected="false">Full Status</button>
      </div>

      <div class="tab-panel" id="payment-overview-snapshot" data-tab-panel>
        <h3>Snapshot</h3>
      <div class="kv-grid">
        {% for leg in paymentLegs %}
        <div>
          <span class="k">{{ leg.label }}</span>
          <span class="v">
            {% if leg.amount == null and leg.received_at == null %}
              Not applicable / not yet recorded
            {% elif canViewPaymentAmounts %}
              {{ (leg.amount | money) ~ ' ' ~ (order.currency_code or '') if leg.amount != null else '—' }}
              — {{ 'Cleared' if leg.cleared_at else ('Received, pending clearance' if leg.received_at else 'Not yet received') }}
            {% else %}
              {{ 'Cleared' if leg.cleared_at else ('Received, pending clearance' if leg.received_at else 'Not yet received') }}
            {% endif %}
          </span>
        </div>
        {% endfor %}
      </div>
      {% if not canViewPaymentAmounts %}
      <p class="muted small">Amounts are only shown to Accounts/Logistics/Export staff who can manage or close this order.</p>
      {% endif %}
      </div>

      <div class="tab-panel" id="payment-overview-ledger" data-tab-panel>
        <h3>Ledger</h3>
      <p class="muted">A single, read-only history of every money event recorded against this order{% if ledgerTotals %} — received from the buyer, paid to the supplier, every expense and any export benefit{% endif %}. Nothing here can be edited; use the forms in each step to record new events.</p>
      {% if ledgerEvents.length == 0 %}
      <p class="muted small">No payment events recorded yet.</p>
      {% else %}
      {% set showLedgerAmounts = canViewPaymentAmounts or ledgerTotals %}
      <div class="table-scroll" style="overflow-x:auto;">
      <table class="list ledger-table">
        <tr><th>Date</th><th>Event</th>{% if showLedgerAmounts %}<th>Amount</th>{% endif %}{% if ledgerTotals %}<th>In (&#8377;)</th><th>Out (&#8377;)</th>{% endif %}<th>Source</th></tr>
        {% for ev in ledgerEvents %}
        <tr class="ledger-{{ ev.direction }}">
          <td>{{ ev.date | truncate(10, true, '') }}</td>
          <td>{{ ev.event }}{% if ledgerTotals and ev.rate != null %}<br><span class="muted small">at &#8377;{{ ev.rate | rate4 }} per {{ ev.currency }}{% if ev.inr_basis == 'actual' %} — INR actual recorded{% endif %}</span>{% endif %}</td>
          {% if showLedgerAmounts %}
          <td>{{ (ev.amount | money) ~ ' ' ~ ev.currency if ev.amount != null else '—' }}</td>
          {% endif %}
          {% if ledgerTotals %}
          <td>{% if ev.direction == 'in' and ev.inr != null %}{{ ev.inr | money }}{% elif ev.direction == 'in' %}<span class="muted small">no rate</span>{% endif %}</td>
          <td>{% if ev.direction == 'out' %}{{ ev.inr | money }}{% endif %}</td>
          {% endif %}
          <td>{{ ev.source }}</td>
        </tr>
        {% endfor %}
      </table>
      </div>
      {% endif %}
      {% if ledgerTotals %}
      <div class="kv-grid ledger-totals">
        <div><span class="k">Received from buyer</span><span class="v">{{ ledgerTotals.buyer_foreign | money }} {{ order.currency_code or '' }} = &#8377;{{ ledgerTotals.buyer_inr | money }}</span></div>
        <div><span class="k">Export benefits received</span><span class="v">&#8377;{{ ledgerTotals.benefits_inr | money }}</span></div>
        <div><span class="k">Paid to supplier</span><span class="v">&#8377;{{ ledgerTotals.supplier_inr | money }}</span></div>
        <div><span class="k">Paid to logistics partners</span><span class="v">&#8377;{{ ledgerTotals.logistics_inr | money }}</span></div>
        <div><span class="k">Expenses</span><span class="v">&#8377;{{ ledgerTotals.expenses_inr | money }}</span></div>
        <div class="full"><span class="k">Net so far</span><span class="v"><strong>&#8377;{{ ledgerTotals.net_inr | money }}</strong></span></div>
      </div>
      <p class="muted small">INR uses each remittance's INR actual when recorded, otherwise the exchange rate recorded with it{% if ledgerTotals.buyer_without_rate > 0 %} — {{ ledgerTotals.buyer_without_rate }} remittance(s) have no rate yet and are left out of the INR totals{% endif %}. Shown only to staff with the Order Financials permission.</p>
      {% endif %}
      </div>

      <div class="tab-panel" id="payment-overview-full-status" data-tab-panel>
        <h3>Full Status</h3>
      {% if payment %}
      <div class="kv-grid">
        <div><span class="k">Advance Amount</span><span class="v">{% if not canViewPaymentAmounts %}Only shown to Accounts/Logistics/Export staff{% else %}{{ (payment.advance_amount | money) ~ ' ' ~ (order.currency_code or '') if payment.advance_amount != null else '—' }}{% endif %}</span></div>
        <div><span class="k">Advance T/T Received</span><span class="v">{{ payment.advance_remittance_received_at or '—' }}</span></div>
        <div><span class="k">Advance Cleared</span><span class="v">{{ payment.advance_cleared_at or '—' }}</span></div>
        <div><span class="k">Balance Amount</span><span class="v">{% if not canViewPaymentAmounts %}Only shown to Accounts/Logistics/Export staff{% else %}{{ (payment.balance_amount | money) ~ ' ' ~ (order.currency_code or '') if payment.balance_amount != null else '—' }}{% endif %}</span></div>
        <div><span class="k">Balance Due</span><span class="v">{{ payment.balance_due_date or 'event-triggered' }}</span></div>
        <div><span class="k">Balance T/T Received</span><span class="v">{{ payment.balance_remittance_received_at or '—' }}</span></div>
        <div><span class="k">Balance Cleared</span><span class="v">{{ payment.balance_cleared_at or '—' }}</span></div>
        {% if payment.freight_amount != null or payment.freight_remittance_received_at %}
        <div><span class="k">Freight Amount</span><span class="v">{% if not canViewPaymentAmounts %}Only shown to Accounts/Logistics/Export staff{% else %}{{ (payment.freight_amount | money) ~ ' ' ~ (order.currency_code or '') if payment.freight_amount != null else '—' }}{% endif %}</span></div>
        <div><span class="k">Freight Cleared</span><span class="v">{{ payment.freight_cleared_at or '—' }}</span></div>
        {% endif %}
        {% if canViewPaymentAmounts or ledgerTotals %}
        {% for leg, legLabel in { advance: 'Advance', freight: 'Freight', balance: 'Balance' } %}
        {% if payment[leg ~ '_exchange_rate'] != null %}
        <div><span class="k">{{ legLabel }} Exchange Rate</span><span class="v">&#8377;{{ payment[leg ~ '_exchange_rate'] | rate4 }} per {{ order.currency_code or '' }}</span></div>
        {% endif %}
        {% endfor %}
        {% endif %}
        {% if ledgerTotals %}
        <div><span class="k">Supplier Advance Paid</span><span class="v">{% if supplierPo and supplierPo.advance_paid_at %}&#8377;{{ (supplierPo.advance_paid_amount_inr if supplierPo.advance_paid_amount_inr != null else (supplierPo.advance_amount_inr or 0)) | money }} on {{ supplierPo.advance_paid_at }}{% else %}—{% endif %}</span></div>
        <div><span class="k">Supplier Balance Paid</span><span class="v">{% if supplierPo and supplierPo.balance_paid_at %}&#8377;{{ (supplierPo.balance_paid_amount_inr if supplierPo.balance_paid_amount_inr != null else (supplierPo.balance_amount_inr or 0)) | money }} on {{ supplierPo.balance_paid_at }}{% else %}—{% endif %}</span></div>
        <div><span class="k">Expenses Recorded</span><span class="v">&#8377;{{ ledgerTotals.expenses_inr | money }}</span></div>
        <div><span class="k">Net So Far</span><span class="v">&#8377;{{ ledgerTotals.net_inr | money }}</span></div>
        {% endif %}
      </div>
      {% endif %}
      <p class="muted small">Advance (or LC) is recorded from Step 5 above; Freight and Balance are recorded from their own steps below.</p>

      {% if clientPaymentReports and clientPaymentReports.length > 0 %}
        <h3 style="margin-top:16px">Client-Reported Payments</h3>
        <p class="muted small">Purely informational — the client submitted these themselves. Always verify against the actual bank statement before recording a payment above.</p>
        <table class="list">
          <tr><th>Payment</th><th>Transaction ID / UTR</th><th>Amount</th><th>Date</th><th>Bank / Payer Details</th><th>Attachment</th><th>Reported</th><th>Status</th><th></th></tr>
          {% for r in clientPaymentReports %}
          <tr>
            <td>{{ r.payment_type | capitalize }}</td>
            <td>{{ r.transaction_ref }}</td>
            <td>{{ (r.amount | money) ~ ' ' ~ (order.currency_code or '') if r.amount != null else '—' }}</td>
            <td>{{ r.payment_date or '—' }}</td>
            <td>{{ r.payer_bank_details or '—' }}</td>
            <td>
              {% if r.screenshot_file_id %}
                {% set screenshotUrl = '/file-store/' ~ r.screenshot_file_id ~ '/download' %}
                {% if r.screenshot_mime_type and r.screenshot_mime_type.startsWith('image/') %}
                  <a href="{{ screenshotUrl }}" target="_blank"><img src="{{ screenshotUrl }}" alt="Payment screenshot" class="asset-preview" style="max-height:60px;"></a>
                {% else %}
                  <a href="{{ screenshotUrl }}" target="_blank">View attachment</a>
                {% endif %}
              {% else %}
                <span class="muted small">—</span>
              {% endif %}
            </td>
            <td>{{ r.reported_at | humanDate }}</td>
            <td>{{ ('Reviewed by ' + (r.reviewed_by_name or '—')) if r.status == 'reviewed' else 'New' }}</td>
            <td>
              {% if r.status != 'reviewed' %}
              <form method="post" action="/orders/{{ order.id }}/payment-reports/{{ r.id }}/reviewed">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button type="submit" class="btn-sm">Mark Reviewed</button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </table>
      {% endif %}
      </div>
    </div>
  </details>

  {% set pendingDocActions = docPendingActions(documents, mailSendingEnabled) %}
  {# Owner decision (2026-10-26): opens by itself only when a document is waiting on someone; otherwise a slim bar with the count. #}
  <details class="step-card step-card-reference" id="document-review-approval"{{ ' open' if pendingDocActions.length else '' }}>
    <summary><h2>Document Review &amp; Approval <small class="muted">(reference &mdash; every document, every step)</small>{% if pendingDocActions.length %} <span class="nav-badge doc-pending-badge">{{ pendingDocActions.length }} need{{ 's' if pendingDocActions.length == 1 else '' }} action</span>{% elif documents and documents.length %} <span class="phase-pill">{{ documents.length }} document{{ '' if documents.length == 1 else 's' }}</span>{% endif %}</h2></summary>
    {% if pendingDocActions.length %}
    <div class="review-banner warn doc-pending-actions">
      <div><strong>Waiting on someone — don't move on without these:</strong>
        <ul style="margin:4px 0 0 18px;padding:0;">
          {% for item in pendingDocActions %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}
    <h3 style="font-size:0.95em;">All Documents</h3>
    <table class="list">
      <tr><th>Type</th><th>Reference</th><th>Rev. (internal / client-facing)</th><th>Generated</th><th>Status</th><th>Download</th><th></th></tr>
      {% for d in documents %}
      <tr>
        <td>{{ d.document_type_code }}</td>
        <td>{{ d.document_reference or '—' }}</td>
        <td>{{ d.revision_number }}{% if d.client_revision_number != null %} <span class="muted small">(client: {{ d.client_revision_number }})</span>{% endif %}</td>
        <td>{{ d.generated_at }}</td>
        <td>
          {% if d.status == 'superseded' %}
          <span class="badge badge-danger" title="A newer revision of this document was approved — this copy is no longer valid and is watermarked INVALID DOCUMENT.">INVALID — SUPERSEDED</span>
          {% else %}
          {{ d.status | replace('_', ' ') }}
          {% endif %}
          {% if d.drift_flagged_at %}
          <br><span class="badge badge-sensitive" title="{{ d.drift_flagged_reason or '' }}">&#9888; DATA MAY BE STALE</span>
          {% endif %}
        </td>
        <td>
          {% if d.pdf_file_id %}<a href="/documents/{{ d.id }}/download?format=pdf">PDF</a>{% endif %}
          {% if d.docx_file_id %} &middot; <a href="/documents/{{ d.id }}/download?format=docx">DOCX (internal)</a>{% endif %}
        </td>
        <td>
          {% if d.status == 'draft' %}
          <form method="post" action="/orders/{{ order.id }}/documents/{{ d.id }}/delete" onsubmit="return confirmDeleteDraft(this);">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="reason" class="delete-draft-reason">
            <button type="button" class="btn-sm btn-danger" onclick="promptDeleteDraft(this)">Delete Draft</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      {% if not documents or documents.length == 0 %}
      <tr><td colspan="7" class="muted">No documents generated yet.</td></tr>
      {% endif %}
    </table>
    <script>
      function promptDeleteDraft(btn) {
        var form = btn.closest('form');
        var reason = promptForReason('Why is this draft document being deleted? (required, at least 10 characters — recorded in the audit log)');
        if (!reason) { return; }
        form.querySelector('.delete-draft-reason').value = reason.trim();
        form.requestSubmit ? form.requestSubmit() : form.submit();
      }
      function confirmDeleteDraft(form) {
        var reason = form.querySelector('.delete-draft-reason').value;
        if (!reason) { return false; }
        return confirm('Delete this draft document? This cannot be undone.');
      }
    </script>

    <p class="muted small" style="margin-top:18px;">Free-form additional documents (not one of the fixed document types above) are attached from <a href="#step-additional-documents">Step 14 — Additional Documents</a> below.</p>
    <h3 style="font-size:0.95em; margin-top:18px;">Review &amp; Approval</h3>
    <p class="muted">A document generated above starts life <strong>draft</strong> with the DRAFT watermark. Assign at least one reviewer to move it to review; once every assigned reviewer approves (minimum required per document type), it's re-watermarked as final and can be sent to the buyer. The buyer only ever receives that final watermarked PDF — never the internal DOCX, never an unwatermarked copy.</p>
    {% for d in documents %}
      {% set reviews = reviewsByDocument[d.id] or [] %}
      {% set crossVerifications = crossVerificationsByDocument[d.id] or [] %}
      {% set myPendingReview = null %}
      {% set anyRejected = false %}
      {% for r in reviews %}
        {% if r.reviewer_id == currentUser.id and r.status == 'pending' %}{% set myPendingReview = r %}{% endif %}
        {% if r.status == 'rejected' %}{% set anyRejected = true %}{% endif %}
      {% endfor %}
      {% if d.status == 'superseded' %}
        {# Point 1 (2026-10-01): a newer revision of this (order, type) was
           approved after this one — this copy is now invalid regardless of
           what its old reviews say, and must never be offered a "Send to
           Buyer" action below. #}
        {% set reviewState = 'superseded' %}
      {% elif not reviews or reviews.length == 0 %}
        {% set reviewState = 'not_sent' %}
      {% elif anyRejected and d.status == 'draft' %}
        {% set reviewState = 'rejected' %}
      {% elif d.status == 'approved' or d.status == 'sent' %}
        {% set reviewState = 'approved' %}
      {% else %}
        {% set reviewState = 'under_review' %}
      {% endif %}
      {# 90-item backlog #12: "Send to Buyer" must apply to every document
         type, generically — driven by document_types.category rather than
         a hardcoded per-type list, so a type added later (or any existing
         internal/procurement type not yet on a hand-maintained exclusion
         list) is correctly included/excluded without a code change here. #}
      {% set sendApplies = d.document_type_category == 'customer_facing' %}
      {% set emailLogs = emailLogByDocument[d.id] or [] %}
      {% set hasPendingSend = false %}
      {% for log in emailLogs %}
        {% if log.status == 'pending_approval' or log.status == 'approved' %}{% set hasPendingSend = true %}{% endif %}
      {% endfor %}
      <details>
        <summary>
          {{ d.document_type_code }} {{ d.document_reference or '—' }} Rev.{{ d.revision_number }} — {{ d.status | replace('_', ' ') }}
          {% if reviewState == 'superseded' %}<span class="review-pill bad">⚠ INVALID — superseded by a newer revision</span>
          {% elif reviewState == 'not_sent' %}<span class="review-pill warn">⚠ Not sent for review</span>
          {% elif reviewState == 'under_review' %}<span class="review-pill info">Under review</span>
          {% elif reviewState == 'rejected' %}<span class="review-pill bad">Rejected — back to draft</span>
          {% elif reviewState == 'approved' %}<span class="review-pill good">✓ Approved</span>
          {% endif %}
        </summary>

        <div class="review-steps">
          <!-- Step 1: Assign Reviewers -->
          <div class="review-step">
            <div class="review-step-num {{ 'is-warn' if (not reviews or reviews.length == 0) else 'is-done' }}">1</div>
            <div class="review-step-body">
              <h3>Assign Reviewers{% if reviews and reviews.length > 0 %}<span class="review-pill info">Assigned</span>{% endif %}</h3>
              {% if not reviews or reviews.length == 0 %}
                <form method="post" action="/documents/{{ d.id }}/reviewers">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <label>Assign reviewer(s) * (minimum required: {{ d.min_reviewers_default or 1 }})
                    <select name="reviewer_ids[]" multiple size="4" required style="min-width:220px">
                      {% for u in activeUsers %}
                        <option value="{{ u.id }}">{{ u.name }} ({{ u.role_name or '—' }})</option>
                      {% endfor %}
                    </select>
                  </label>
                  <button type="submit" class="btn-sm">Assign Reviewers</button>
                </form>
              {% else %}
                <table class="list">
                  <tr><th>Reviewer</th><th>Status</th><th>Comments</th><th>Reviewed</th></tr>
                  {% for r in reviews %}
                    <tr>
                      <td>{{ r.reviewer_name }}</td>
                      <td>{{ r.status }}</td>
                      <td>{{ r.comments or '' }}</td>
                      <td>{{ r.reviewed_at or '—' }}</td>
                    </tr>
                  {% endfor %}
                </table>
              {% endif %}
            </div>
          </div>

          <!-- Step 2: Approval Status -->
          <div class="review-step">
            <div class="review-step-num {{ 'is-done' if reviewState == 'approved' else ('is-bad' if reviewState == 'rejected' else ('is-warn' if reviewState == 'not_sent' else '')) }}">2</div>
            <div class="review-step-body">
              <h3>Approval Status</h3>
              {% if reviewState == 'superseded' %}
                <div class="review-banner bad">✕ <span><strong>INVALID — superseded.</strong> A newer revision of this document was approved after this one, so this copy no longer counts as valid and has been re-watermarked INVALID DOCUMENT — SUPERSEDED. It can no longer be sent to the buyer; use the latest revision instead.</span></div>
              {% elif reviewState == 'not_sent' %}
                <div class="review-banner warn">⚠ <span><strong>Not yet sent for review.</strong> This document cannot be finalized or sent to the buyer until at least one reviewer is assigned above. Assign one now, before moving on to your next task.</span></div>
              {% elif reviewState == 'under_review' %}
                {% set pendingNames = [] %}
                {% for r in reviews %}{% if r.status == 'pending' %}{% set pendingNames = (pendingNames.push(r.reviewer_name), pendingNames) %}{% endif %}{% endfor %}
                <div class="review-banner info">◔ <span><strong>Under review{% if pendingNames.length > 0 %} — with {{ pendingNames | join(', ') }}{% endif %}.</strong> If this sits too long, follow up with them directly.</span></div>
              {% elif reviewState == 'rejected' %}
                <div class="review-banner bad">✕ <span><strong>Rejected — back to draft.</strong> Fix the issue raised and regenerate this document.</span></div>
              {% elif reviewState == 'approved' %}
                <div class="review-banner good">✓ <span><strong>Approved.</strong> The FINAL watermarked PDF has been generated — clear to proceed to Send to Buyer below.</span></div>
              {% endif %}

              {% if myPendingReview %}
                <form method="post" action="/reviews/{{ myPendingReview.id }}/approve" style="display:inline">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="text" name="comments" placeholder="Comments (optional)">
                  <button type="submit" class="btn-sm btn-success">Approve</button>
                </form>
                <form method="post" action="/reviews/{{ myPendingReview.id }}/reject" style="display:inline" onsubmit="return confirm('Reject this document? It goes back for rework.');">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="text" name="comments" placeholder="Reason (mandatory)" required>
                  <button type="submit" class="btn-sm btn-danger">Reject</button>
                </form>
              {% endif %}

              <form method="post" action="/documents/{{ d.id }}/cross-verify" style="margin-top:6px">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <select name="result" required>
                  <option value="pass">Cross-verify: Pass</option>
                  <option value="fail">Cross-verify: Fail</option>
                </select>
                <input type="text" name="comments" placeholder="Comments (optional)">
                <button type="submit" class="btn-sm">Record Cross-Verification</button>
              </form>
              {% if crossVerifications and crossVerifications.length > 0 %}
                <p class="muted small">
                  {% for cv in crossVerifications %}
                    {{ cv.verified_by_name }}: {{ cv.result }} ({{ cv.verified_at }})<br>
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </div>

          <!-- Step 3: Send to Buyer -->
          {% if sendApplies %}
          <div class="review-step">
            <div class="review-step-num {{ 'is-done' if d.status == 'sent' else '' }}">3</div>
            <div class="review-step-body">
              <h3>Send to Buyer</h3>
              {% if emailLogs.length > 0 %}
                <table class="list" style="margin-top:6px">
                  <tr><th>Sent To</th><th>Status</th><th>Requested</th><th>Detail</th></tr>
                  {% for log in emailLogs %}
                    <tr>
                      <td>{{ log.recipient_email }}</td>
                      <td>{{ log.status | replace('_', ' ') }}</td>
                      <td>{{ log.created_at }}</td>
                      <td>
                        {% if log.status == 'sent' %}
                          Sent {{ log.sent_at or '' }}
                        {% elif log.status == 'rejected' %}
                          Rejected: {{ log.rejection_reason or '' }}
                        {% elif log.status == 'failed' %}
                          Dispatch failed — check mail server configuration and retry.
                        {% elif log.status == 'cancelled' %}
                          Cancelled: {{ log.cancellation_reason or '' }}
                        {% elif log.status == 'approved' %}
                          Approved — will send once its scheduled time arrives.
                          {% if permissions.approve_email_send or log.requested_by == currentUser.id %}
                          <form method="post" action="/email-log/{{ log.id }}/cancel" style="margin-top:4px" onsubmit="return confirm('Cancel this send? It will never go out.');">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                            <input type="hidden" name="order_id" value="{{ order.id }}">
                            <input type="text" name="reason" placeholder="Cancel reason (mandatory)" required style="width:200px">
                            <button type="submit" class="btn-sm btn-warning">Cancel Send</button>
                          </form>
                          {% endif %}
                        {% else %}
                          Awaiting Level-2 approval.
                          {% if permissions.approve_email_send or log.requested_by == currentUser.id %}
                          <form method="post" action="/email-log/{{ log.id }}/cancel" style="margin-top:4px" onsubmit="return confirm('Cancel this send? It will never go out.');">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                            <input type="hidden" name="order_id" value="{{ order.id }}">
                            <input type="text" name="reason" placeholder="Cancel reason (mandatory)" required style="width:200px">
                            <button type="submit" class="btn-sm btn-warning">Cancel Send</button>
                          </form>
                          {% endif %}
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </table>
              {% endif %}

              {% if d.status == 'approved' and not mailSendingEnabled %}
                <p class="muted">Email sending is turned off (Settings), so there is no Send to Buyer — documents approved from now on count as sent automatically. Send this PDF to the buyer yourself.</p>
              {% elif d.status == 'approved' %}
                {% if hasPendingSend %}
                  <p class="muted">A send to the buyer is already in progress for this document (see above) — no new send can be submitted until it's sent, rejected, or fails.</p>
                {% else %}
                  <p><a href="/orders/{{ order.id }}/documents/{{ d.id }}/send" class="btn-sm btn-accent">Send to Buyer (deferred, 2-level approval)</a></p>
                {% endif %}
              {% elif d.status == 'sent' %}
                <p class="muted">{{ 'Already sent to buyer.' if (mailSendingEnabled or emailLogs.length > 0) else 'Counted as sent on approval (email sending is off) — send the PDF to the buyer yourself.' }}</p>
              {% elif d.status == 'superseded' %}
                <p class="muted small">This revision is INVALID — superseded. It can no longer be sent; see the latest revision instead.</p>
              {% else %}
                <p class="muted small">Waiting on approval above before this document can be sent.</p>
              {% endif %}
            </div>
          </div>
          {% endif %}
        </div>
      </details>
    {% endfor %}
  </details>

  {# Owner decision (2026-10-26, t4): pinned open above the five sections — the client conversation is needed at every step. #}
  <details class="step-card step-card-reference" id="order-updates" open>
    <summary><h2>Order Communication <small class="muted">(with the client — any time)</small>{% if comments.length %} <span class="phase-pill">{{ comments.length }} message{{ '' if comments.length == 1 else 's' }}</span>{% endif %}</h2></summary>
    <p class="muted">A running conversation with the client for this order. Anything you post here is emailed to the client immediately, with any attached images/videos (a large file becomes a secure download link instead of a raw attachment). Anything the client posts appears here too and notifies staff — nothing from either side is ever deleted.{% if permissions.generate_documents %} Need something more formal — a payment reminder, a one-off notice? <a href="/orders/{{ order.id }}/email/compose">Compose an email from a template</a>.{% endif %}</p>
    <div class="chat-thread">
      {% if comments.length == 0 %}
        <p class="chat-empty">No updates posted yet.</p>
      {% endif %}
      {% for c in comments %}
        {% set isStaff = c.author_type == 'staff' %}
        <div class="chat-bubble-row {{ 'staff' if isStaff else 'client' }}">
          <div class="chat-bubble {{ 'staff' if isStaff else 'client' }}">
            <div class="chat-bubble-meta">
              <span class="who">{{ 'Staff' if isStaff else 'Client' }} — {{ (c.staff_name if isStaff else c.client_name) or 'Unknown' }}</span>
              <span>{{ c.created_at | humanDate }}{% if isStaff %}{{ ' · emailed' if c.email_sent else ' · not emailed (no client email on file)' }}{% endif %}</span>
            </div>
            {% if c.body %}<div class="chat-bubble-body">{{ c.body }}</div>{% endif %}
            {% if c.attachments.length > 0 %}
              <div class="chat-attachments">
                {% for att in c.attachments %}
                  {% set url = '/orders/' ~ order.id ~ '/comment-attachments/' ~ att.file_id ~ '/download' %}
                  {% if att.mime_type and (att.mime_type | startswith('image/')) %}
                    <a href="{{ url }}" target="_blank"><img class="chat-attachment-image" src="{{ url }}" alt="{{ att.original_filename }}"></a>
                  {% elif att.mime_type and (att.mime_type | startswith('video/')) %}
                    <video class="chat-attachment-video" controls src="{{ url }}"></video>
                  {% else %}
                    <a class="chat-attachment-file" href="{{ url }}">{{ att.original_filename }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <form class="chat-post-form" method="post" action="/orders/{{ order.id }}/comments#order-updates" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <textarea name="body" placeholder="Write an update for the client…"></textarea>
      <div class="chat-post-form-row">
        <input type="file" name="attachments" multiple accept="image/*,video/*,.pdf">
        <button type="submit" class="btn-sm" data-loading-text="Posting…">Post &amp; email client</button>
      </div>
    </form>
  </details>

  {% set ph = flow.phase('booking') %}
  <details class="phase-group" id="phase-booking"{{ ' open' if ph.open else '' }}>
    {{ phaseSummary(ph) }}

  <details class="step-card" id="step-1-quotation-prepare"{{ stepCardOpen('s1') }}>
    <summary>{{ stepStatusIcon(stepStates['s1']) }}<span class="step-group-num">STEP 1</span><h2>Prepare Quotation</h2></summary>
    <div class="btn-row">
      {% if stage1 and stage1.status != 'locked' %}
        <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="document_type" value="QT">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
          {{ stepBadge('1a') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'QT') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">{{ 'Regenerate Quotation (new revision)' if hasQt else 'Generate Quotation' }}</button>{{ docAlreadyNote(documents, 'QT') }}
        </form>
      {% endif %}

      {# Task #36 — each stage's own "Generate X" button now lives inside
         that stage's own section (right next to its other actions), not
         bunched here — the user's own "no back and forth, every step
         generates its own document" ask. Only Quotation (step 1,
         genuinely first) and the optional Annexure A stay in this
         top-of-page spot. #}

      {% if order.include_annexure_a %}
        <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="document_type" value="ANNEXA">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
          <button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'ANNEXA') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Annexure A</button>{{ docAlreadyNote(documents, 'ANNEXA') }}
        </form>
      {% endif %}
    </div>
    {% if permissions.manage_orders %}
    <p class="muted small"><a href="/orders/{{ order.id }}/annexure">{% if order.include_annexure_a %}Manage Annexure A product entries &amp; images{% else %}Enable / manage Annexure A{% endif %}</a></p>
    {% endif %}
    <p class="muted small">Review, approval, and sending to the buyer happen in <a href="#document-review-approval">Document Review &amp; Approval</a> below, once generated.</p>
  </details>

  <details class="step-card step-card-reference" id="step-2-quotation-send"{{ stepCardOpen('s2') }}>
    <summary>{{ stepStatusIcon(stepStates['s2']) }}<span class="step-group-num">STEP 2</span><h2>Send Quotation to Client</h2></summary>
    <p class="muted small">Sending happens through the shared <a href="#document-review-approval">Document Review &amp; Approval</a> workflow below &mdash; every generated document (not just the Quotation) is assigned a reviewer, approved, and dispatched from that one place, regardless of which step generated it. {{ 'Once the Quotation is approved there, use its own "Send to Buyer" action.' if mailSendingEnabled else 'Email sending is turned off, so the Quotation counts as sent as soon as it is approved there &mdash; send the PDF to the client yourself.' | safe }}</p>
  </details>

  <details class="step-card step-card-reference" id="step-3-quotation-accept"{{ stepCardOpen('s3') }}>
    <summary>{{ stepStatusIcon(stepStates['s3']) }}<span class="step-group-num">STEP 3</span><h2>Client Accepts Quotation</h2></summary>
    <p class="muted small">There's no separate "accepted" button to click &mdash; the buyer's acceptance happens outside the system (a reply email, a call, a signed copy). Once your team is satisfied the client has accepted, move on to <a href="#step-4a-buyer-po-generate">Step 4a &middot; Buyer's PO</a>.</p>
  </details>


{# Owner request (2026-10-26): the Buyer Action Link is sent at Step 4b (the
   buyer downloads the Buyer PO, uploads it signed with their PO number and
   Step 4 completes) and again at 6b for the OC acknowledgement — one link,
   rendered by this one macro in both places. #}
{% macro buyerActionLinkWidget(badge, anchor) %}
      {% if buyerActionLinkValid %}
        <div class="review-banner info" style="flex-direction:column;align-items:stretch;gap:6px">
          <span>Current link (valid until {{ order.buyer_action_token_expires_at | humanDate }}) — copy and send however you like, no need to regenerate:</span>
          <div style="display:flex;gap:6px;align-items:center">
            <input type="text" readonly value="{{ buyerActionFullLink }}" onclick="this.select()" style="flex:1;font-family:monospace;font-size:12px" aria-label="Buyer Action Link">
            <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText('{{ buyerActionFullLink }}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 1500);">Copy Link</button>
          </div>
        </div>
      {% else %}
        <p class="muted small">No active link — generate one below.</p>
      {% endif %}
      {% if canManageOrders %}
      <form method="post" action="/orders/{{ order.id }}/buyer-action-link" style="display:inline">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="return_to" value="{{ anchor }}">
        {{ stepBadge(badge) | safe }}<button type="submit" class="btn-sm">{{ 'Regenerate Buyer Action Link' if buyerActionLinkValid else 'Generate Buyer Action Link' }}</button>
      </form>
      {% endif %}
{% endmacro %}
{# Owner request (2026-10-27): the Payment Action Link — optional, never locks a
   step. The client sends payment details there (screenshot, transaction ID,
   amount, date); staff still verify and record below. #}
{% macro paymentActionLinkWidget(documentName, anchor) %}
    <div class="pay-link-box">
      <p class="small"><strong>Payment Action Link</strong> <span class="muted">(optional)</span> — the client uploads the payment screenshot and transaction details there, no login needed. It also goes out automatically inside the {{ documentName }} email.</p>
      {% if paymentActionFullLink %}
        <div style="display:flex;gap:6px;align-items:center">
          <input type="text" readonly value="{{ paymentActionFullLink }}" onclick="this.select()" style="flex:1;font-family:monospace;font-size:12px" aria-label="Payment Action Link">
          <button type="button" class="btn-sm btn-secondary" onclick="navigator.clipboard.writeText('{{ paymentActionFullLink }}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 1500);">Copy Link</button>
        </div>
      {% endif %}
      {% if canManageOrders %}
      <form method="post" action="/orders/{{ order.id }}/payment-action-link" style="display:inline">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="return_to" value="{{ anchor }}">
        <button type="submit" class="btn-sm btn-secondary">{{ 'Regenerate &amp; Email Payment Link' | safe if paymentActionFullLink else 'Generate &amp; Email Payment Link' | safe }}</button>
      </form>
      {% endif %}
    </div>
{% endmacro %}
  <details class="step-group" id="step-group-stage-2"{{ stepCardOpen('s4') }}>
    <summary>{{ stepStatusIcon(stepStates['s4']) }}<span class="step-group-num">STEP 4</span><h3>Buyer's PO</h3></summary>

    <details class="step-card" id="step-4a-buyer-po-generate"{{ flow.subCardOpen('s4', '4a') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s4', '4a')) }}<h2>Step 4a &middot; Generate Buyer's PO</h2></summary>
      {% if stage2 and stage2.status != 'locked' %}
        <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="document_type" value="BUYERPO">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
          {{ stepBadge('4a') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'BUYERPO') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Buyer PO</button>{{ docAlreadyNote(documents, 'BUYERPO') }}
        </form>
      {% endif %}
    </details>

    <div class="step-group-connector">send the buyer their PO to sign</div>

    <details class="step-card" id="step-4b-buyer-po-link"{{ flow.subCardOpen('s4', '4b') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s4', '4b')) }}<h2>Step 4b &middot; Send Buyer PO Action Link <small class="muted">(optional)</small></h2></summary>
      {% if stage2 and stage2.status != 'locked' %}
        <p class="muted small">A no-login link for the buyer: they <strong>download the Buyer PO</strong> generated in 4a, sign it, and <strong>upload the signed copy with their PO number</strong> — Step 4 then completes by itself and you're notified. Emailed to the client when they have an email on file. If the buyer can't, attach and confirm it yourself in 4c/4d as before.</p>
        {% if not docComplete(documents, 'BUYERPO', mailSendingEnabled) %}
          <p class="review-banner warn">&#9888; The Buyer PO (4a) isn't approved{{ '/sent' if mailSendingEnabled else '' }} yet — the buyer can't download it until it is.</p>
        {% endif %}
        {{ buyerActionLinkWidget('4b', 'step-4b-buyer-po-link') }}
      {% else %}
        <p class="muted">Generate the Quotation first to unlock this gate.</p>
      {% endif %}
    </details>

    <div class="step-group-connector">once the buyer sends their signed PO back</div>

    {# Owner decision (2026-10-25): attach the buyer's signed PO copy BEFORE
       confirming receipt — the confirm gate already refuses without one
       (wetSignatureGuardService.buyerPoBlocked(), on by default), so the
       old order (confirm first, attach after) walked staff straight into
       that error. #}
    <details class="step-card" id="step-4c-buyer-po-attach"{{ flow.subCardOpen('s4', '4c') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s4', '4c')) }}<h2>Step 4c &middot; Attach Buyer's PO Copy{% if not buyerPoCopyRequired %} <small class="muted">(optional)</small>{% endif %}</h2></summary>
      {% if stage2 and stage2.status != 'locked' %}
        <p class="muted small">Upload the copy the buyer emailed you — or the buyer can upload it themselves through the <a href="#step-4b-buyer-po-link">Buyer Action Link (4b)</a> or their client portal; it then appears here.</p>
        {% if buyerPoDocuments and buyerPoDocuments.length > 0 %}
          <table class="list" style="margin-top:8px">
            <tr><th>File</th><th>Uploaded</th><th>By</th><th></th></tr>
            {% for bd in buyerPoDocuments %}
              <tr>
                <td>{{ bd.original_filename }}</td>
                <td>{{ bd.uploaded_at }}</td>
                <td>{{ 'The buyer (self-uploaded)' if bd.uploaded_by === null else 'Staff' }}</td>
                <td><a href="/file-store/{{ bd.file_id }}/download">Download</a></td>
              </tr>
            {% endfor %}
          </table>
        {% endif %}
        <form method="post" action="/orders/{{ order.id }}/buyer-po/documents" enctype="multipart/form-data" style="margin-top:6px">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="file" name="document" required>
          {{ stepBadge('4c') | safe }}<button type="submit" class="btn-sm">{{ 'Attach Another Copy' if (buyerPoDocuments and buyerPoDocuments.length > 0) else 'Attach Buyer PO Copy' }}</button>
        </form>
      {% else %}
        <p class="muted">Generate the Quotation first to unlock this gate.</p>
      {% endif %}
    </details>

    <div class="step-group-connector">then confirm it to complete Step 4</div>

    <details class="step-card" id="step-4d-buyer-po-confirm"{{ flow.subCardOpen('s4', '4d') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s4', '4d')) }}<h2>Step 4d &middot; Confirm Buyer's PO Received</h2></summary>
      {% if hasBuyerPo %}
        <p>Buyer PO recorded: <strong>{{ order.buyers_po_ref }}</strong></p>
      {% elif not (stage2 and stage2.status != 'locked') %}
        <p class="muted">Generate the Quotation first to unlock this gate.</p>
      {% elif buyerPoCopyRequired and not (buyerPoDocuments and buyerPoDocuments.length > 0) %}
        <p class="muted">Attach the buyer's signed PO copy in Step 4c first &mdash; this step completes Step 4 and needs it on file.</p>
      {% else %}
        <form method="post" action="/orders/{{ order.id }}/buyer-po">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Buyer's PO / Reference Number *<input type="text" name="buyers_po_ref" required></label>
          {{ stepBadge('4d') | safe }}<button type="submit" class="btn-sm">Confirm Buyer PO Received</button>
        </form>
      {% endif %}
    </details>
  </details>

  <details class="step-group" id="step-group-stage-3"{{ stepCardOpen('s5') }}>
    <summary>{{ stepStatusIcon(stepStates['s5']) }}<span class="step-group-num">STEP 5</span><h3>Proforma Invoice &amp; Payment</h3></summary>

    <details class="step-card" id="step-5a-pi-form-link"{{ flow.subCardOpen('s5', '5a') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5a')) }}<h2>Step 5a &middot; Generate PI Form Link</h2></summary>
      <p class="muted small">A separate form from the Quotation-stage request — sent to the client to confirm consignee/notify-party/payment-terms details before the PI is issued.</p>
      {% if piIntake %}
        <p>
          Status: <strong>{{ piIntake.status | replace('_', ' ') | capitalize }}</strong>
          {% if piIntake.status == 'pending_review' %}
            &nbsp;&middot;&nbsp; <a href="/pi-intake-review">Review in PI Intake Review</a>
          {% elif piIntake.status == 'applied' %}
            &nbsp;&middot;&nbsp; Applied by {{ piIntake.reviewed_by_name or '—' }} on {{ piIntake.reviewed_at }}
          {% endif %}
        </p>
        {% if piFormFullLink %}
          <div class="review-banner info" style="flex-direction:column;align-items:stretch;gap:6px">
            <span>Current link (valid until {{ piIntake.access_token_expires_at | humanDate }}) — copy and send however you like, no need to regenerate:</span>
            <div style="display:flex;gap:6px;align-items:center">
              <input type="text" readonly value="{{ piFormFullLink }}" onclick="this.select()" style="flex:1;font-family:monospace;font-size:12px">
              <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText('{{ piFormFullLink }}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 1500);">Copy Link</button>
            </div>
          </div>
        {% elif piIntake.status == 'awaiting_client' %}
          <p class="muted small">This link has expired — use Regenerate below to issue a fresh one.</p>
        {% endif %}
        {% if piIntake.status == 'applied' %}
          <div class="kv-grid">
            <div><span class="k">Confirmed Incoterm</span><span class="v">{{ piIntake.incoterm_confirmed or '—' }}</span></div>
            <div><span class="k">Confirmed Port of Discharge</span><span class="v">{{ piIntake.port_of_discharge_text or '—' }}</span></div>
            <div><span class="k">Confirmed COO Type</span><span class="v">{{ piIntake.coo_type or '—' }}</span></div>
            <div><span class="k">Payment Terms Confirmation</span><span class="v">{{ piIntake.payment_terms_confirmation or '—' }}</span></div>
            <div><span class="k">Quotation Acceptance Reference</span><span class="v">{{ piIntake.quotation_acceptance_reference or '—' }}</span></div>
            {% if piIntake.changes_from_quotation %}<div><span class="k">Changes from Quotation</span><span class="v">{{ piIntake.changes_from_quotation }}</span></div>{% endif %}
            {% if piIntake.special_document_requirements %}<div><span class="k">Special Document Requirements</span><span class="v">{{ piIntake.special_document_requirements }}</span></div>{% endif %}
          </div>
        {% endif %}
      {% else %}
        <p class="muted">No PI-stage form has been sent to this client yet.</p>
      {% endif %}
      {% if permissions.manage_orders %}
      <form method="post" action="/orders/{{ order.id }}/pi-form-link" style="display:inline">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ stepBadge('5a') | safe }}<button type="submit" class="btn-sm">{{ 'Regenerate PI Form Link' if piIntake else 'Generate PI Form Link' }}</button>
      </form>
      {% endif %}
      {{ piFormSkip() }}
    </details>

    <div class="step-group-connector">client replies</div>

    <details class="step-card step-card-reference" id="step-5b-pi-intake-apply"{{ flow.subCardOpen('s5', '5b') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5b')) }}<h2>Step 5b &middot; Apply the Client's PI-Stage Confirmation</h2></summary>
      <p class="muted small">Once the client submits the PI-stage form, review and apply it at <a href="/pi-intake-review">PI Intake Review</a> &mdash; applying it overwrites the live client record with exactly what the buyer confirmed.</p>
      {{ piFormSkip() }}
    </details>

    <div class="step-group-connector">now the real PI can be issued</div>

    <details class="step-card" id="step-5c-pi-generate"{{ flow.subCardOpen('s5', '5c') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5c')) }}<h2>Step 5c &middot; Generate Proforma Invoice</h2></summary>
      {% if stage3 and stage3.status != 'locked' %}
        <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="document_type" value="PI">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
          {{ stepBadge('5c') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'PI') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Proforma Invoice</button>{{ docAlreadyNote(documents, 'PI') }}
        </form>
      {% else %}
        <p class="muted">Record the Buyer PO first to unlock this gate.</p>
      {% endif %}
    </details>

    <div class="step-group-connector">payment method for this order: <strong>{{ 'Letter of Credit' if isLcPayment else 'Cash Advance' }}</strong></div>

    {% if isLcPayment %}
    <details class="step-card" id="step-5d-payment-record"{{ flow.subCardOpen('s5', '5d') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5d')) }}<h2>Step 5d &middot; Record LC Details</h2></summary>
      {% if stage3 and stage3.status != 'locked' and not lcConfirmed and (orderLcDetails == null or orderLcDetails.lc_amount == null) %}
        {% if not permissions.manage_payments %}
          <p class="muted">Only Accounts/Export can record this payment.</p>
        {% else %}
        <form method="post" action="/orders/{{ order.id }}/payment/lc" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Issuing Bank<input type="text" name="lc_bank_name"></label>
          <label>LC Number<input type="text" name="lc_number"></label>
          <label>LC Amount * <small class="muted">(in {{ order.currency_code or '' }})</small><input type="text" name="lc_amount" required></label>
          <label>LC Charges <small class="muted">(billed to the client, in {{ order.currency_code or '' }})</small><input type="text" name="lc_charges_amount"></label>
          <label>LC Document (optional)<input type="file" name="lc_file"></label>
          {{ stepBadge('5d') | safe }}<button type="submit" class="btn-sm">Record LC Details</button>
        </form>
        {% endif %}
      {% elif not stage3 or stage3.status == 'locked' %}
        <p class="muted">Record the Buyer PO first to unlock this gate.</p>
      {% elif orderLcDetails and orderLcDetails.lc_amount != null %}
        <p class="muted">Already recorded — see Step 5e to confirm it usable.</p>
      {% endif %}
    </details>

    <div class="step-group-connector">once the advising bank confirms</div>

    <details class="step-card" id="step-5e-payment-confirm"{{ flow.subCardOpen('s5', '5e') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5e')) }}<h2>Step 5e &middot; Confirm LC Usable</h2></summary>
      {% if stage3 and stage3.status != 'locked' and not lcConfirmed and orderLcDetails and orderLcDetails.lc_amount != null %}
        {% if not permissions.clear_payments %}
          <p class="muted">LC details recorded — awaiting Accounts to confirm it usable.</p>
        {% else %}
        <form method="post" action="/orders/{{ order.id }}/payment/lc/confirm-usable" onsubmit="return confirm('Confirm this LC usable? This unlocks Stage 4 and auto-provisions the client portal login — confirm the advising bank has actually confirmed first.');">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {{ stepBadge('5e') | safe }}<button type="submit" class="btn-sm btn-success">Confirm LC Usable (unlocks Stage 4)</button>
        </form>
        {% endif %}
      {% elif not stage3 or stage3.status == 'locked' %}
        <p class="muted">Record the Buyer PO first to unlock this gate.</p>
      {% elif lcConfirmed %}
        <p class="muted">LC already confirmed usable.</p>
      {% else %}
        <p class="muted">Record the LC details first (Step 5d).</p>
      {% endif %}
    </details>
    {% else %}
    <details class="step-card" id="step-5d-payment-record"{{ flow.subCardOpen('s5', '5d') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5d')) }}<h2>Step 5d &middot; Record Advance Remittance</h2></summary>
      {% if not advanceCleared %}{{ paymentActionLinkWidget('Proforma Invoice', 'step-5d-payment-record') }}{% endif %}
      {% if stage3 and stage3.status != 'locked' and not advanceCleared and (not payment or payment.advance_remittance_received_at == null) %}
        {% if not permissions.manage_payments %}
          <p class="muted">Only Accounts/Export can record this payment.</p>
        {% else %}
        <form method="post" action="/orders/{{ order.id }}/payment/advance">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {% set advanceDue = ((fobTotal | float) * (order.advance_pct | float) / 100) | round(2) %}
          <p class="advance-due-note">Advance due on this order: <strong>{{ order.currency_code or '' }} {{ advanceDue | money }}</strong> ({{ (order.advance_pct | float) }}% of the order value {{ order.currency_code or '' }} {{ (fobTotal or 0) | money }}). Enter what the bank actually received.</p>
          <label>Advance Amount Received * <small class="muted">(in {{ order.currency_code or '' }})</small><input type="text" name="advance_amount" required data-remit-amount value="{{ advanceDue.toFixed(2) if advanceDue > 0 else '' }}"></label>
          <label class="checkbox-row small" style="font-weight:normal;"><input type="checkbox" name="confirm_amount_differs" value="1"> The amount received differs from the advance due (e.g. bank charges deducted) — record it anyway</label>
          <label>Received On<input type="date" name="advance_received_at"></label>
          <label>@ Exchange Rate * <small class="muted">(&#8377; per 1 {{ order.currency_code or '' }})</small><input type="number" step="0.0001" min="0.0001" name="advance_exchange_rate" data-remit-rate required placeholder="e.g. 83.2500"></label>
          <p class="muted small remit-statement" data-remit-statement data-currency="{{ order.currency_code or '' }}"></p>
          {{ stepBadge('5d') | safe }}<button type="submit" class="btn-sm">Record Advance Remittance</button>
        </form>
        {% endif %}
      {% elif not stage3 or stage3.status == 'locked' %}
        <p class="muted">Record the Buyer PO first to unlock this gate.</p>
      {% elif payment and payment.advance_remittance_received_at != null %}
        {{ remittanceRecordedNote('advance', 'Next: Step 5e — mark it cleared once the bank confirms.') }}
      {% endif %}

      {{ inrActualWidget('advance', 'Advance Payment') }}
      {{ exchangeRateWidget('advance', 'Advance Payment') }}
    </details>

    <div class="step-group-connector">once the bank confirms the funds landed</div>

    <details class="step-card" id="step-5e-payment-confirm"{{ flow.subCardOpen('s5', '5e') }}>
      <summary>{{ stepStatusIcon(flow.subStepStatus('s5', '5e')) }}<h2>Step 5e &middot; Mark Advance Cleared</h2></summary>
      {% if stage3 and stage3.status != 'locked' and not advanceCleared and payment and payment.advance_remittance_received_at != null %}
        {% if not permissions.clear_payments %}
          <p class="muted">Advance remittance recorded — awaiting Accounts to confirm it cleared.</p>
        {% else %}
        <form method="post" action="/orders/{{ order.id }}/payment/advance/clear" onsubmit="return confirm('Mark the advance payment cleared? This unlocks Stage 4 and auto-provisions the client portal login — confirm the funds have actually landed first.');">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Cleared On<input type="date" name="advance_cleared_at"></label>
          {{ stepBadge('5e') | safe }}<button type="submit" class="btn-sm btn-success">Mark Advance Cleared (unlocks Stage 4)</button>
        </form>
        {% endif %}
      {% elif not stage3 or stage3.status == 'locked' %}
        <p class="muted">Record the Buyer PO first to unlock this gate.</p>
      {% elif advanceCleared %}
        <p class="muted">Advance already cleared.</p>
      {% else %}
        <p class="muted">Record the advance remittance first (Step 5d).</p>
      {% endif %}
    </details>
    {% endif %}
  </details>

  {% if isLcPayment %}
  <details class="step-card step-card-reference" id="step-5-lc-bank-loan">
    <summary><h2>Letter of Credit &amp; Bank Loan <small class="muted">(steps 5-1a/5-2a/5-3a &mdash; financing cost, not the LC leg above)</small></h2></summary>
    <p class="muted small">If the client financed their LC (Step 5d/5e above) with a bank loan, record that loan's amount/interest here — separate from the LC leg itself, since this is about the cost of financing it, not confirming it usable.</p>
    {% if canManageOrderFinancials %}
    <p class="muted small">Recorded in full under <a href="#order-financials">Order Financials</a> (Step 12) alongside this order's other costs — the Bank Loan Interest you record there is automatically kept in sync as an order expense.</p>
    {% else %}
    <p class="muted small">Recorded by Accounts/Export staff alongside this order's other costs.</p>
    {% endif %}
  </details>
  {% endif %}

  <details class="step-group" id="step-group-stage-4"{{ stepCardOpen('s6') }}>
    <summary>{{ stepStatusIcon(stepStates['s6']) }}<span class="step-group-num">STEP 6</span><h3>Order Confirmation</h3></summary>

  <details class="step-card" id="step-6a-oc-generate"{{ flow.subCardOpen('s6', '6a') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s6', '6a')) }}<h2>Step 6a &middot; Generate Order Confirmation</h2></summary>
    {% if permissions.close_orders %}
    <p class="muted small">ECGC Cover is tracked on the <a href="#compliance-checklist">Compliance Checklist</a>.{% if canManageOrderFinancials %} The premium paid is recorded under <a href="#order-financials">Order Financials</a> (Step 12) as an "ECGC insurance" cost entry — filed here, once the order is confirmed, so the fee is never paid before the order is certain to proceed.{% endif %}</p>
    {% elif canManageOrderFinancials %}
    <p class="muted small">The ECGC insurance premium paid is recorded under <a href="#order-financials">Order Financials</a> (Step 12) once the order is confirmed.</p>
    {% endif %}
    {% if stage4 and stage4.status != 'locked' %}
      <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="document_type" value="OC">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
        {{ stepBadge('6a') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'OC') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Order Confirmation</button>{{ docAlreadyNote(documents, 'OC') }}
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">send the buyer their action link</div>

  <details class="step-card" id="step-6b-buyer-action-link"{{ flow.subCardOpen('s6', '6b') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s6', '6b')) }}<h2>Step 6b &middot; Send Buyer Action Link (OC acknowledgement)</h2></summary>
      <p class="muted small">The same Buyer Action Link the buyer used for their PO (Step 4b) also lets them acknowledge this Order Confirmation — send it again, or regenerate it if it has expired.</p>
      {{ buyerActionLinkWidget('6b', 'step-6b-buyer-action-link') }}
  </details>

  <div class="step-group-connector">the buyer acknowledges (link or portal) — or staff record it</div>

  <details class="step-card" id="step-6c-oc-acknowledge"{{ flow.subCardOpen('s6', '6c') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s6', '6c')) }}<h2>Step 6c &middot; Record Buyer's Acknowledgement</h2></summary>
    {% if buyerAcknowledged %}
      {% if ocAcknowledgment and ocAcknowledgment.acknowledged_via == 'client_portal' %}
        <p>Buyer acknowledged the Order Confirmation themselves in the client portal on {{ ocAcknowledgment.acknowledged_at | humanDate }}.</p>
      {% elif ocAcknowledgment and ocAcknowledgment.acknowledged_via == 'staff_recorded_email' %}
        <p>Acknowledgement recorded from the buyer's email reply on {{ ocAcknowledgment.acknowledged_at | humanDate }}.</p>
        <p class="muted small">Evidence/note: {{ (ocAcknowledgment.acknowledged_note or '') | nl2br }}</p>
      {% elif ocAcknowledgment and ocAcknowledgment.acknowledged_via == 'auto_48h' %}
        <p>No response from the buyer within 48 hours of the Order Confirmation being emailed — auto-confirmed on {{ ocAcknowledgment.acknowledged_at | humanDate }}.</p>
      {% else %}
        <p>Buyer has acknowledged the Order Confirmation.</p>
      {% endif %}
    {% elif stage4 and stage4.status != 'locked' %}
      {% if ocAcknowledgment and ocAcknowledgment.acknowledged_at == null %}
        <div class="review-banner info">
          ℹ <span>Order Confirmation emailed to the buyer on {{ ocAcknowledgment.sent_at | humanDate }}. Awaiting their acknowledgement — the client can confirm it directly in their portal, or reply to the email (record that below). If there's no response by {{ ocAcknowledgment.due_at | humanDate }}, it auto-confirms and Step 7 (Supplier PO) unlocks on its own.</span>
        </div>
        <form method="post" action="/orders/{{ order.id }}/oc-acknowledgment">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Buyer replied by email? Record the evidence here (quote the reply) *<textarea name="acknowledged_note" rows="3" required></textarea></label>
          {{ stepBadge('6c') | safe }}<button type="submit" class="btn-sm btn-success">Record Buyer's Email Acknowledgement (unlocks Step 7)</button>
        </form>
      {% elif ocDocGenerated %}
        <div class="review-banner info">
          ℹ <span>Order Confirmation has been generated but hasn't gone out by email yet (still awaiting send/approval, or mail sending isn't configured). If the buyer has confirmed by phone, in person, or any channel other than the portal/email, record it below — Step 7 (Supplier PO) unlocks immediately.</span>
        </div>
        <form method="post" action="/orders/{{ order.id }}/oc-acknowledgment">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Describe how the buyer confirmed (quote their reply, or note the call/meeting) *<textarea name="acknowledged_note" rows="3" required></textarea></label>
          {{ stepBadge('6c') | safe }}<button type="submit" class="btn-sm btn-success">Record Buyer's Acknowledgement (unlocks Step 7)</button>
        </form>
      {% else %}
        <p class="muted">Generate the Order Confirmation above and send it to the buyer — once sent, they can acknowledge it from their portal (or reply by email, which you can record here), and it auto-confirms after 48 hours with no response.</p>
      {% endif %}
    {% else %}
      <p class="muted">Clear the advance payment first to unlock this gate.</p>
    {% endif %}
  </details>

  {% set supplierPoLocked = (not stage5) or stage5.status == 'locked' %}

  </details>

  </details>

  {% set ph = flow.phase('production') %}
  <details class="phase-group" id="phase-production"{{ ' open' if ph.open else '' }}>
    {{ phaseSummary(ph) }}

  <details class="step-group" id="step-group-stage-5"{{ stepCardOpen('s7') }}>
    <summary>{{ stepStatusIcon(stepStates['s7']) }}<span class="step-group-num">STEP 7</span><h3>Supplier PO</h3></summary>

  {{ complianceCard('order', 's7') }}

  <details class="step-card" id="step-7a-supplier-po-terms"{{ flow.subCardOpen('s7', '7a') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s7', '7a')) }}<h2>Step 7a &middot; Save Supplier PO Terms</h2></summary>
    {% if supplierPoLocked %}
      <p class="muted">Confirm buyer acknowledgement first to unlock this gate.</p>
    {% elif supplierPo %}
        <div class="kv-grid">
          <div><span class="k">Supplier</span><span class="v">{{ supplierPo.supplier_legal_name }}</span></div>
          <div><span class="k">Supplier Type</span><span class="v">{{ supplierPo.supplier_type or '—' }}</span></div>
          <div><span class="k">Supplier PO Ref</span><span class="v">{{ supplierPo.supplier_po_reference }}</span></div>
          <div><span class="k">Material</span><span class="v">{{ supplierPo.material_stone_type or '—' }}</span></div>
          <div><span class="k">Total Payable (INR)</span><span class="v">{{ supplierPo.total_payable_inr or '—' }}</span></div>
          <div><span class="k">Status</span><span class="v">{{ supplierPo.status }}</span></div>
        </div>
      <p class="muted small">Terms already saved — see Step 7b to generate the document.</p>
    {% else %}
        <p class="muted small">
          Suppliers come from the Suppliers directory{% if permissions.manage_suppliers %} — <a href="/suppliers" target="_blank" rel="noopener">add or manage suppliers</a> (opens in a new tab; reload this page afterwards){% else %} — ask an Admin/MD/ED to add a new supplier there{% endif %}.
          The supplier's details (and factory addresses) are copied onto this order when you save the terms, so later edits in the directory never change this order. Factory addresses are added or removed only on the supplier's own page in the directory.
        </p>
        {% if not suppliers.length %}
          <p class="small" style="color:var(--danger);font-weight:600;">No active suppliers yet. {% if permissions.manage_suppliers %}<a href="/suppliers/create" target="_blank" rel="noopener">Add the first supplier</a>, then reload this page.{% else %}Ask an Admin/MD/ED to add one in the Suppliers directory.{% endif %}</p>
        {% endif %}

        <form method="post" action="/orders/{{ order.id }}/supplier-po" id="supplier-po-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <div class="field-grid">
          <label>Supplier *
            <select name="supplier_id" id="spo-supplier-select" required>
              <option value="">Select supplier…</option>
              {% for sup in suppliers %}
                <option value="{{ sup.id }}" data-addresses="{{ (supplierFactoryAddressTextsBySupplier[sup.id] or []) | json }}" data-types="{{ sup.types | json }}">{{ sup.supplier_legal_name }}{{ (' — ' + (sup.types | join(', '))) if sup.types.length else '' }}</option>
              {% endfor %}
            </select>
          </label>
          <label id="spo-supplier-type-field" style="display:none">Supplier Type for this order *
            <select name="supplier_type" id="spo-supplier-type-select"></select>
            <small class="muted">This supplier has more than one type — pick the one that applies to this order. It prints on the Supplier PO.</small>
          </label>
          <label>Material / Stone Type<input type="text" name="material_stone_type" placeholder="e.g., Black Granite"></label>
          <label>Grade<input type="text" name="grade" value="Grade A"></label>
          <label>Surface Finish
            <select name="surface_finish">
              <option value="">—</option>
              {% for o in surfaceFinishes %}
                <option value="{{ o.option_value }}" {% if o.is_default %}selected{% endif %}>{{ o.option_value }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Dimensions<input type="text" name="dimensions" placeholder="e.g., 600 x 600 x 20 mm"></label>
          <label>Dimensional Tolerance
            <select name="dimensional_tolerance">
              <option value="">—</option>
              {% for o in dimensionalTolerances %}
                <option value="{{ o.option_value }}" {% if o.is_default %}selected{% endif %}>{{ o.option_value }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Quantity<input type="text" name="quantity" data-spo-calc="quantity" placeholder="e.g., 500"></label>
          <label>Unit
            <select name="unit">
              {% for o in units %}
                <option value="{{ o.option_value }}" {% if o.is_default %}selected{% endif %}>{{ o.option_value }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Colour Reference<input type="text" name="colour_reference" placeholder="e.g., Jet Black"></label>
          <label>Special Requirements/Instructions<input type="text" name="special_requirements" placeholder="e.g., Polished finish, edge chamfer"></label>
          <label>Unit Price (INR) <small class="muted">(auto-calculates Basic Value when multiplied by Quantity)</small><input type="text" name="unit_price_inr" data-spo-calc="unit_price_inr" placeholder="e.g., 450.00"></label>
          <label>Basic Value (INR) <small class="muted">(auto: Unit Price &times; Quantity)</small><input type="text" name="basic_value_inr" data-spo-calc="basic_value_inr" placeholder="e.g., 225000.00"></label>
          <label>GST Rate (%)
            <select name="gst_rate_pct" data-spo-calc="gst_rate_pct">
              <option value="">—</option>
              {% for o in gstRates %}
                <option value="{{ o.option_value }}" {% if o.is_default %}selected{% endif %}>{{ o.option_value }}%</option>
              {% endfor %}
            </select>
          </label>
          <label>GST Amount (INR) <small class="muted">(auto: Basic Value &times; GST Rate)</small><input type="text" name="gst_amount_inr" data-spo-calc="gst_amount_inr"></label>
          <label>Total Payable (INR) <small class="muted">(auto: Basic Value + GST Amount)</small><input type="text" name="total_payable_inr" data-spo-calc="total_payable_inr"></label>
          <label>Advance (%)<input type="text" name="advance_pct" data-spo-calc="advance_pct" placeholder="e.g., 30"></label>
          <label>Advance Amount (INR) <small class="muted">(auto: Total Payable &times; Advance %)</small><input type="text" name="advance_amount_inr" data-spo-calc="advance_amount_inr"></label>
          <label>Balance Amount (INR) <small class="muted">(auto: Total Payable &minus; Advance Amount)</small><input type="text" name="balance_amount_inr" data-spo-calc="balance_amount_inr"></label>
          <label>Delivery Location
            <select id="spo-delivery-location-select">
              <option value="">— Select —</option>
              <option value="__other__">Other (not listed) — specify</option>
            </select>
            <input type="text" id="spo-delivery-location-input" name="delivery_location" placeholder="Select a supplier first, or specify" style="display:none">
          </label>
          <label>Required Delivery Date<input type="date" name="required_delivery_date"></label>
          <label>Packing Requirement<input type="text" name="packing_requirement" placeholder="e.g., Wooden crates, export packing"></label>
          </div>
          {{ stepBadge('7a') | safe }}<button type="submit" class="btn-sm">Save Supplier PO Terms</button>
        </form>
        <script>
        (function () {
          var form = document.getElementById('supplier-po-form');
          if (!form) { return; }
          var f = function (name) { return form.querySelector('[data-spo-calc="' + name + '"]'); };
          var num = function (el) { var v = parseFloat(el && el.value); return isNaN(v) ? 0 : v; };
          function recalc() {
            var unitPrice = num(f('unit_price_inr'));
            var quantity = num(f('quantity'));
            var basicValue = unitPrice * quantity;
            f('basic_value_inr').value = basicValue ? basicValue.toFixed(2) : '';

            var gstRatePct = num(f('gst_rate_pct'));
            var gstAmount = basicValue * (gstRatePct / 100);
            f('gst_amount_inr').value = basicValue ? gstAmount.toFixed(2) : '';

            var totalPayable = basicValue + gstAmount;
            f('total_payable_inr').value = basicValue ? totalPayable.toFixed(2) : '';

            // Owner decision (2026-10-27): 0% advance is a real choice — advance
            // 0.00 and the whole amount as the balance — not a blank field.
            var advancePct = num(f('advance_pct'));
            var pctEntered = !!f('advance_pct') && f('advance_pct').value.trim() !== '';
            var advanceAmount = totalPayable * (advancePct / 100);
            f('advance_amount_inr').value = totalPayable && pctEntered ? advanceAmount.toFixed(2) : '';
            f('balance_amount_inr').value = totalPayable && pctEntered ? (totalPayable - advanceAmount).toFixed(2) : '';
          }
          ['quantity', 'unit_price_inr', 'gst_rate_pct', 'advance_pct'].forEach(function (name) {
            var el = f(name);
            if (el) {
              el.addEventListener('input', recalc);
              el.addEventListener('change', recalc);
            }
          });

          // User-reported batch item 12: Delivery Location offers the
          // selected supplier's own factory addresses, repopulated here
          // whenever the Supplier changes, plus an "Other" free-text
          // fallback — same dropdown-with-other-fallback pattern as the
          // Incoterm fields on the client-facing intake forms.
          var supplierSelect = document.getElementById('spo-supplier-select');

          // A supplier can hold several types: when the selected one has
          // more than one, staff pick which applies to this order (it
          // prints on the Supplier PO). With one type it's recorded
          // automatically.
          var typeField = document.getElementById('spo-supplier-type-field');
          var typeSelect = document.getElementById('spo-supplier-type-select');
          if (supplierSelect && typeField && typeSelect) {
            function repopulateTypeOptions() {
              var opt = supplierSelect.options[supplierSelect.selectedIndex];
              var types = [];
              try { types = opt && opt.dataset.types ? JSON.parse(opt.dataset.types) : []; } catch (e) { types = []; }
              typeSelect.innerHTML = '';
              if (types.length > 1) {
                var blank = document.createElement('option');
                blank.value = '';
                blank.textContent = '— Select —';
                typeSelect.appendChild(blank);
              }
              types.forEach(function (t) {
                var o = document.createElement('option');
                o.value = t;
                o.textContent = t;
                typeSelect.appendChild(o);
              });
              var multiple = types.length > 1;
              typeField.style.display = multiple ? '' : 'none';
              typeSelect.required = multiple;
            }
            supplierSelect.addEventListener('change', repopulateTypeOptions);
            repopulateTypeOptions();
          }

          var deliverySelect = document.getElementById('spo-delivery-location-select');
          var deliveryInput = document.getElementById('spo-delivery-location-input');
          if (supplierSelect && deliverySelect && deliveryInput) {
            function applyDeliveryInput() {
              var isOther = deliverySelect.value === '__other__';
              deliveryInput.style.display = isOther ? '' : 'none';
              deliveryInput.readOnly = !isOther;
              if (!isOther) { deliveryInput.value = deliverySelect.value; }
            }
            function repopulateDeliveryOptions() {
              var opt = supplierSelect.options[supplierSelect.selectedIndex];
              var addresses = [];
              try { addresses = opt && opt.dataset.addresses ? JSON.parse(opt.dataset.addresses) : []; } catch (e) { addresses = []; }
              deliverySelect.innerHTML = '';
              var blank = document.createElement('option');
              blank.value = '';
              blank.textContent = '— Select —';
              deliverySelect.appendChild(blank);
              addresses.forEach(function (addr) {
                var o = document.createElement('option');
                o.value = addr;
                o.textContent = addr;
                deliverySelect.appendChild(o);
              });
              var other = document.createElement('option');
              other.value = '__other__';
              other.textContent = 'Other (not listed) — specify';
              deliverySelect.appendChild(other);
              applyDeliveryInput();
            }
            supplierSelect.addEventListener('change', repopulateDeliveryOptions);
            deliverySelect.addEventListener('change', applyDeliveryInput);
            repopulateDeliveryOptions();
          }
        })();
        </script>
    {% endif %}
  </details>

  <div class="step-group-connector">generate the actual Supplier PO document</div>

  <details class="step-card" id="step-7b-supplier-po-generate"{{ flow.subCardOpen('s7', '7b') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s7', '7b')) }}<h2>Step 7b &middot; Generate Supplier PO</h2></summary>
    {% if supplierPoLocked %}
      <p class="muted">Confirm buyer acknowledgement first to unlock this gate.</p>
    {% elif supplierPo %}
        <div class="kv-grid">
          <div><span class="k">Supplier</span><span class="v">{{ supplierPo.supplier_legal_name }}</span></div>
          <div><span class="k">Supplier Type</span><span class="v">{{ supplierPo.supplier_type or '—' }}</span></div>
          <div><span class="k">Supplier PO Ref</span><span class="v">{{ supplierPo.supplier_po_reference }}</span></div>
          <div><span class="k">Material</span><span class="v">{{ supplierPo.material_stone_type or '—' }}</span></div>
          <div><span class="k">Total Payable (INR)</span><span class="v">{{ supplierPo.total_payable_inr or '—' }}</span></div>
          <div><span class="k">Status</span><span class="v">{{ supplierPo.status }}</span></div>
        </div>
        <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="document_type" value="SUPPO">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
          {{ stepBadge('7b') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'SUPPO') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Supplier PO</button>{{ docAlreadyNote(documents, 'SUPPO') }}
        </form>
    {% else %}
      <p class="muted">Save Supplier PO Terms first (Step 7a).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">once the supplier signs and returns it</div>

  {# Owner decision (2026-10-25), same as Step 4: attach the supplier's
     signed acknowledgment BEFORE confirming the signature — the confirm
     gate already refuses without one (wetSignatureGuardService.
     supplierPoBlocked(), on by default). #}
  <details class="step-card" id="step-7c-supplier-po-attach"{{ flow.subCardOpen('s7', '7c') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s7', '7c')) }}<h2>Step 7c &middot; Attach Supplier PO Acknowledgment{% if not supplierPoCopyRequired %} <small class="muted">(optional)</small>{% endif %}</h2></summary>
    {% if supplierPoLocked %}
      <p class="muted">Confirm buyer acknowledgement first to unlock this gate.</p>
    {% elif supplierPo %}
        {% if supplierPoDocuments and supplierPoDocuments.length > 0 %}
          <table class="list" style="margin-top:8px">
            <tr><th>File</th><th>Uploaded</th><th></th></tr>
            {% for sd in supplierPoDocuments %}
              <tr>
                <td>{{ sd.original_filename }}</td>
                <td>{{ sd.uploaded_at }}</td>
                <td><a href="/file-store/{{ sd.file_id }}/download">Download</a></td>
              </tr>
            {% endfor %}
          </table>
        {% endif %}
        <form method="post" action="/orders/{{ order.id }}/supplier-po/documents" enctype="multipart/form-data" style="margin-top:6px">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="file" name="document" required>
          {{ stepBadge('7c') | safe }}<button type="submit" class="btn-sm">Attach Supplier PO Acknowledgment</button>
        </form>
        {# Owner request (2026-10-26, t4): the supplier can upload it themselves through a no-login link (like the Buyer Action Link), and when they never acknowledge, staff record that with a reason. #}
        <div class="supplier-action-link" style="margin-top:10px;border-top:1px solid var(--line);padding-top:8px;">
          <p class="muted small"><strong>Or let the supplier upload it:</strong> a direct link (no login) where the supplier uploads their signed PO / acknowledgment — emailed to them when the PO has their email{% if supplierPo.supplier_email %} ({{ supplierPo.supplier_email }}){% endif %}. You'll be notified when they upload.</p>
          {% if supplierActionFullLink %}
            <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px">
              <input type="text" readonly value="{{ supplierActionFullLink }}" onclick="this.select()" style="flex:1;font-family:monospace;font-size:12px" aria-label="Supplier Action Link">
              <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText('{{ supplierActionFullLink }}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 1500);">Copy Link</button>
            </div>
            <p class="muted small">Valid until {{ supplierPo.supplier_action_token_expires_at | humanDate }}.</p>
          {% endif %}
          <form method="post" action="/orders/{{ order.id }}/supplier-po/supplier-link" style="display:inline">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm btn-secondary">{{ 'Regenerate Supplier Link' if supplierActionFullLink else 'Generate Supplier Link' }}</button>
          </form>
        </div>
        {% if supplierPo.ack_skipped_at %}
          <p class="small" style="margin-top:8px;">&#10003; Recorded that the supplier did not acknowledge — {{ supplierPo.ack_skip_reason }} <span class="muted">({{ supplierPo.ack_skipped_at }})</span></p>
        {% elif not (supplierPoDocuments and supplierPoDocuments.length > 0) and supplierPo.status != 'signed' %}
          <form method="post" action="/orders/{{ order.id }}/supplier-po/ack-skip" style="margin-top:8px;" data-confirm="Record that the supplier did not acknowledge this PO? Step 7d then opens without an acknowledgment on file.">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Skip — supplier did not acknowledge <small class="muted">(reason required)</small>
              <input type="text" name="skip_reason" required minlength="10" placeholder="e.g. supplier confirmed by phone, will not sign">
            </label>
            <button type="submit" class="btn-sm">Skip Acknowledgment</button>
          </form>
        {% endif %}
    {% else %}
      <p class="muted">Save Supplier PO Terms first (Step 7a).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">then confirm it to complete Step 7</div>

  <details class="step-card" id="step-7d-supplier-po-signed"{{ flow.subCardOpen('s7', '7d') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s7', '7d')) }}<h2>Step 7d &middot; Confirm Supplier Signed &amp; Returned PO</h2></summary>
    {% if supplierPoLocked %}
      <p class="muted">Confirm buyer acknowledgement first to unlock this gate.</p>
    {% else %}
      {% if supplierPo and supplierPo.status != 'signed' and suppoDocGenerated and supplierPoCopyRequired and not (supplierPoDocuments and supplierPoDocuments.length > 0) and not supplierPo.ack_skipped_at %}
        <p class="muted">Attach the supplier's signed acknowledgment in Step 7c first (or send them the Supplier Link, or record that they did not acknowledge) &mdash; this step completes Step 7 and needs it on file.</p>
      {% elif supplierPo and supplierPo.status != 'signed' and suppoDocGenerated %}
        <form method="post" action="/orders/{{ order.id }}/supplier-po/signed">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {{ stepBadge('7d') | safe }}<button type="submit" class="btn-sm btn-success">Confirm Supplier Signed &amp; Returned PO (unlocks Stage 6)</button>
        </form>
      {% elif supplierPo and supplierPo.status != 'signed' %}
        <p class="muted small">Generate the Supplier PO document above before confirming the supplier's signature — they can't have signed and returned a document that was never sent.</p>
      {% elif supplierPo %}
        <p>Supplier has signed and returned the PO.</p>
      {% endif %}
    {% endif %}

  </details>

  <div class="step-group-connector">pay the supplier's advance</div>

  <details class="step-card" id="step-7e-supplier-advance-paid"{{ flow.subCardOpen('s7', '7e') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s7', '7e')) }}<h2>Step 7e &middot; Supplier Advance Paid</h2></summary>
    {{ supplierPayment('advance') }}
  </details>

  </details>

  <details class="step-group" id="step-group-stage-production"{{ stepCardOpen('s8') }}>
    <summary>{{ stepStatusIcon(stepStates['s8']) }}<span class="step-group-num">STEP 8</span><h3>Production &amp; Estimated Shipment</h3></summary>

  <details class="step-card" id="step-production"{{ stepCardOpen('s8') }}>
    <summary>{{ stepStatusIcon(stepStates['s8']) }}<h2>Step 8a &middot; Production &amp; Estimated Shipment</h2></summary>
    <div class="kv-grid">
      <div><span class="k">Production Status</span><span class="v">{{ order.production_status_text or 'Not yet commenced' }}</span></div>
      <div><span class="k">Est. Shipment</span><span class="v">{{ order.est_shipment_date_text or 'To Be Confirmed' }}</span></div>
    </div>
    <p class="muted small">Every update here is logged{% if permissions.view_audit_log %} — <a href="/orders/{{ order.id }}/audit-log">view update history</a>{% endif %}. Changing either field notifies the client (order update + portal).</p>
    {% if stage4 and stage4.status != 'locked' %}
      <form method="post" action="/orders/{{ order.id }}/production-status">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Production Status<input type="text" name="production_status_text" placeholder="e.g. Cutting and finishing in progress — 30% complete"></label>
        <label>Estimated Shipment<input type="text" name="est_shipment_date_text" placeholder="e.g. Week of 15 October 2026"></label>
        <label>Estimated Shipment Date <small class="muted">(drives the 7-day pre-shipment inspection reminder below)</small><input type="date" name="est_shipment_date" value="{{ order.est_shipment_date or '' }}"></label>
        <button type="submit" class="btn-sm">Update</button>
      </form>
    {% endif %}

    {% if pendingInspectionTask and canManageOrderFinancials %}
      <h3 style="font-size:0.95em; margin-top:14px;">3rd-Party Pre-Shipment Inspection (step 8a)</h3>
      <p class="muted small">This order has a Pre-Shipment Inspection on its Compliance Checklist (not marked not-applicable) — staff get reminded starting 7 days before the estimated shipment date above.</p>
      <p class="muted small">Recorded under <a href="#order-financials">Order Financials</a> (Step 12) → Costs, alongside this order's other costs.</p>
    {% endif %}
  </details>


  </details>

  </details>

  {% set ph = flow.phase('shipment') %}
  <details class="phase-group" id="phase-shipment"{{ ' open' if ph.open else '' }}>
    {{ phaseSummary(ph) }}

  {# Owner decisions (2026-10-27): the logistics partners' bills — CHA,
     transport, freight forwarder — on every incoterm. Runs alongside Steps
     9-11 and never locks them; on CFR/CIF orders a bill can be paid only once
     the buyer's Debit Note payment has cleared (9d). #}
  {% set logisticsBillsList = vendorBillsView.logistics(vendorBills) %}
  {% set logisticsUnpaid = vendorBillsView.unpaid(logisticsBillsList) | length %}
  {% set inGroupC = currentUserStep in ['s9', 's10', 's11'] %}
  {% set logisticsStatus = 'done' if (logisticsBillsList.length and logisticsUnpaid == 0) else ('current' if inGroupC else 'locked') %}
  {% if permissions.manage_supplier_payments or permissions.manage_order_financials %}
  <details class="step-card step-card-parallel" id="logistics-bills"{% if inGroupC and (not logisticsBillsList.length or logisticsUnpaid > 0) %} open{% endif %}>
    <summary>{{ stepStatusIcon(logisticsStatus) }}<h2>Logistics Partner Bills &amp; Payments — CHA · Transport · Freight Forwarder{% if logisticsUnpaid > 0 %} <small class="muted">({{ logisticsUnpaid }} unpaid)</small>{% endif %}</h2></summary>
    <p class="muted small">One row per bill from the partner — a partner doing both CHA and transport can send one combined bill or separate bills. Runs alongside Steps 9–11 and never locks them.{% if not isFob %} On this {{ order.incoterm_code }} order an Advance bill can be paid any time; the Final bill once the buyer's Debit Note payment has cleared (Step 9d).{% endif %} Bills go into the order's financials (Step 12) automatically.</p>
    {{ vendorBillTable(logisticsBillsList, true, permissions.manage_supplier_payments, logisticsPaymentBlocked) }}
    {% if permissions.manage_supplier_payments %}
    {% set activePartners = logisticsPartners | whereEq('is_active', 1) %}
    <details class="vendor-bill-add"{% if not logisticsBillsList.length %} open{% endif %}>
      <summary class="small"><strong>+ Add a bill</strong></summary>
      {% if not activePartners.length %}
        <p class="muted small">No logistics partners in the directory yet — <a href="/logistics-partners/create" target="_blank" rel="noopener">add one</a>.</p>
      {% else %}
      <form method="post" action="/orders/{{ order.id }}/vendor-bills/logistics" enctype="multipart/form-data" class="field-grid">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Logistics partner *
          <select name="logistics_partner_id" required>
            <option value="">Select…</option>
            {% for lp in activePartners %}
              <option value="{{ lp.id }}">{{ lp.partner_name }} ({{ logisticsServiceTypes[lp.service_type] or lp.service_type }})</option>
            {% endfor %}
          </select>
        </label>
        <label>For *
          <select name="bill_for" required>
            {% for key, svcLabel in logisticsServices %}<option value="{{ key }}">{{ svcLabel }}</option>{% endfor %}
          </select>
        </label>
        {# Owner decision (2026-10-27): an Advance can be paid any time; the Final bill waits for Step 9d on CFR/CIF. #}
        <label>Payment *
          <select name="payment_kind" required>
            <option value="advance">Advance — paid before the service</option>
            <option value="final" selected>Final — against the completed service</option>
          </select>
          <small class="muted">{{ 'Advance and Final bills can both be paid any time on an FOB order.' if isFob else 'An Advance bill can be paid any time; a Final bill waits for Step 9d.' }}</small>
        </label>
        {{ vendorBillFields(gstRates) }}
        <div><button type="submit" class="btn-sm">Add Bill</button></div>
      </form>
      {% endif %}
    </details>
    {% endif %}
  </details>
  {% endif %}

  {% if isFob %}
  {# FOB: the buyer arranges and pays freight, so this whole step never applies — shown greyed out, with nothing to expand. #}
  <div class="step-group step-group-disabled" id="step-group-stage-6" aria-disabled="true" title="Not applicable — FOB order: the buyer arranges and pays freight directly.">
    <div class="step-group-head">{{ stepStatusIcon(stepStates['s9']) }}<span class="step-group-num">STEP 9</span><h3>Freight Payment</h3><span class="step-group-na">Not applicable — FOB</span></div>
  </div>
  {% else %}
  {% set freightLocked = (not stage6) or stage6.status == 'locked' %}

  <details class="step-group" id="step-group-stage-6"{{ stepCardOpen('s9') }}>
    <summary>{{ stepStatusIcon(stepStates['s9']) }}<span class="step-group-num">STEP 9</span><h3>Freight Payment</h3></summary>

  <details class="step-card" id="step-9a-freight-terms"{{ flow.subCardOpen('s9', '9a') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s9', '9a')) }}<h2>Step 9a &middot; Save Freight Terms</h2></summary>
    {% if freightLocked %}
      <p class="muted">Confirm the Supplier PO is signed first to unlock this gate.</p>
    {% elif not freight %}
      <form method="post" action="/orders/{{ order.id }}/freight-terms">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Confirmed Freight Rate<input type="text" name="confirmed_freight_rate"></label>
        <label>Insurance Amount (CIF only)<input type="text" name="insurance_amount"></label>
        {# Owner request (2026-10-27): the forwarder comes from the Logistics Partners directory, like the supplier in 7a. #}
        <label>Freight Forwarder (Logistics Partner) *
          <select name="freight_forwarder_partner_id" required>
            <option value="">Select logistics partner…</option>
            {% for lp in logisticsPartners %}
              <option value="{{ lp.id }}">{{ lp.partner_name }} ({{ logisticsServiceTypes[lp.service_type] or lp.service_type }})</option>
            {% endfor %}
          </select>
        </label>
        <p class="muted small">Partners come from the Logistics Partners directory{% if permissions.manage_logistics_partners %} — <a href="/logistics-partners/create" target="_blank" rel="noopener">add one</a> (opens in a new tab; reload this page afterwards){% else %} — ask an Admin/MD/ED to add one there{% endif %}. Their name and contact are copied onto this order.</p>
        {{ stepBadge('9a') | safe }}<button type="submit" class="btn-sm">Save Freight Terms</button>
      </form>
    {% else %}
      <div class="kv-grid">
        <div><span class="k">Confirmed Rate</span><span class="v">{{ (freight.confirmed_freight_rate ~ ' ' ~ (order.currency_code or '')) if freight.confirmed_freight_rate != null else '—' }}</span></div>
        <div><span class="k">Insurance</span><span class="v">{{ (freight.insurance_amount ~ ' ' ~ (order.currency_code or '')) if freight.insurance_amount != null else 'NIL' }}</span></div>
        <div><span class="k">Forwarder</span><span class="v">{{ freight.freight_forwarder_name or '—' }}</span></div>
        <div><span class="k">Forwarder Contact</span><span class="v">{{ freight.freight_forwarder_contact or '—' }}</span></div>
      </div>
      <p class="muted small">Terms already saved — see Step 9b to generate the debit note.</p>
    {% endif %}
  </details>

  <div class="step-group-connector">generates the debit note for the buyer</div>

  <details class="step-card" id="step-9b-freight-debit-note"{{ flow.subCardOpen('s9', '9b') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s9', '9b')) }}<h2>Step 9b &middot; Generate Debit Note</h2></summary>
    {% if freightLocked %}
      <p class="muted">Confirm the Supplier PO is signed first to unlock this gate.</p>
    {% elif not freight %}
      <p class="muted">Save Freight Terms first (Step 9a).</p>
    {% else %}
      <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="document_type" value="FDN">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
        {{ stepBadge('9b') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'FDN') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Debit Note</button>{{ docAlreadyNote(documents, 'FDN') }}
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">once their payment lands</div>

  <details class="step-card" id="step-9c-freight-remittance"{{ flow.subCardOpen('s9', '9c') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s9', '9c')) }}<h2>Step 9c &middot; Record Freight Remittance</h2></summary>
    {% if not freightCleared %}{{ paymentActionLinkWidget('Debit Note', 'step-9c-freight-remittance') }}{% endif %}
    {% if freightLocked %}
      <p class="muted">Confirm the Supplier PO is signed first to unlock this gate.</p>
    {% elif not freight %}
      <p class="muted">Save Freight Terms first (Step 9a).</p>
    {% elif not freightCleared and (not payment or payment.freight_remittance_received_at == null) %}
      <form method="post" action="/orders/{{ order.id }}/payment/freight">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Freight Amount Received * <small class="muted">(in {{ order.currency_code or '' }})</small><input type="text" name="freight_amount" required data-remit-amount></label>
        <label>Received On<input type="date" name="freight_received_at"></label>
          <label>@ Exchange Rate * <small class="muted">(&#8377; per 1 {{ order.currency_code or '' }})</small><input type="number" step="0.0001" min="0.0001" name="freight_exchange_rate" data-remit-rate required placeholder="e.g. 83.2500"></label>
          <p class="muted small remit-statement" data-remit-statement data-currency="{{ order.currency_code or '' }}"></p>
        {{ stepBadge('9c') | safe }}<button type="submit" class="btn-sm">Record Freight Remittance</button>
      </form>
    {% else %}
      {{ remittanceRecordedNote('freight', 'Next: Step 9d — mark it cleared once the bank confirms.') }}
      {{ inrActualWidget('freight', 'Freight Payment') }}
      {{ exchangeRateWidget('freight', 'Freight Payment') }}
    {% endif %}
  </details>

  <div class="step-group-connector">after funds are confirmed cleared</div>

  <details class="step-card" id="step-9d-freight-clear"{{ flow.subCardOpen('s9', '9d') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s9', '9d')) }}<h2>Step 9d &middot; Mark Freight Cleared</h2></summary>
    {% if freightLocked %}
      <p class="muted">Confirm the Supplier PO is signed first to unlock this gate.</p>
    {% elif not freight %}
      <p class="muted">Save Freight Terms first (Step 9a).</p>
    {% elif freightCleared %}
      <p>Freight payment already cleared.</p>
    {% elif payment and payment.freight_remittance_received_at != null %}
      <form method="post" action="/orders/{{ order.id }}/payment/freight/clear" onsubmit="return confirm('Mark the freight payment cleared? This unlocks Stage 7 — confirm the funds have actually landed first.');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Cleared On<input type="date" name="freight_cleared_at"></label>
        {{ stepBadge('9d') | safe }}<button type="submit" class="btn-sm btn-success">Mark Freight Cleared (unlocks Stage 7)</button>
      </form>
    {% else %}
      <p class="muted">Record the freight remittance first (Step 9c).</p>
    {% endif %}
  </details>

  </details>
  {% endif %}

  {% set packingLocked = (not stage7) or stage7.status == 'locked' %}

  <details class="step-group" id="step-group-stage-7"{{ stepCardOpen('s10') }}>
    <summary>{{ stepStatusIcon(stepStates['s10']) }}<span class="step-group-num">STEP 10</span><h3>Packing &amp; BL Instruction</h3></summary>

  {{ complianceCard('shipment', 's10') }}

  <details class="step-card" id="step-10a-supplier-balance-paid"{{ flow.subCardOpen('s10', '10a') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s10', '10a')) }}<h2>Step 10a &middot; Supplier Balance Paid <small class="muted">(before packing)</small></h2></summary>
    {{ supplierPayment('balance') }}
  </details>

  <div class="step-group-connector">material paid for — pack it</div>

  <details class="step-card" id="step-10b-packing"{{ flow.subCardOpen('s10', '10b') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s10', '10b')) }}<h2>Step 10b &middot; Save Packing &amp; Crates</h2></summary>
    {% if packingLocked %}
      <p class="muted">{{ 'Confirm the Supplier PO is signed first' if isFob else 'Clear the freight payment first' }} to unlock this gate.</p>
    {% else %}
      {% if orderedQuantitySummary.comparable %}
        <p class="muted small">Ordered quantity: <strong>{{ orderedQuantitySummary.total | qty }} {{ orderedQuantitySummary.unit }}</strong> &middot; Shortfall tolerance: <strong>{{ shortfallTolerance }}%</strong> — the shortfall below is computed automatically from this. A shortfall over tolerance is blocked until the buyer's written approval is uploaded.</p>
      {% else %}
        <p class="muted small">Ordered quantity can't be automatically compared for this order (mixed units across product lines, or quantity not yet confirmed) — enter Shortfall % manually below.</p>
      {% endif %}
      {% if packing.buyer_approval_file_id %}
        <p class="muted small">&#9989; Buyer's written approval of the quantity shortfall is on file (recorded {{ packing.shortfall_notice_recorded_at or '' }}).</p>
      {% endif %}
      <form method="post" action="/orders/{{ order.id }}/packing" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="kv-grid">
          <label>Actual Quantity Packed<input type="text" name="actual_quantity_packed" value="{{ packing.actual_quantity_packed or '' }}"></label>
          <label>Actual Quantity Unit
            {% set packingUnit = packing.actual_quantity_unit or (orderedQuantitySummary.comparable and orderedQuantitySummary.unit) or '' %}
            <select name="actual_quantity_unit">
              <option value="">— Select —</option>
              {% for u in units %}
                <option value="{{ u.option_value }}" {% if packingUnit == u.option_value %}selected{% endif %}>{{ u.option_value }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Crate Count<input type="text" name="crate_count" value="{{ packing.crate_count or '' }}"></label>
          <label>Total Net Weight (kg)<input type="text" name="total_net_weight_kg" value="{{ packing.total_net_weight_kg or '' }}"></label>
          <label>Total Gross Weight (kg)<input type="text" name="total_gross_weight_kg" value="{{ packing.total_gross_weight_kg or '' }}"></label>
          <label>Total CBM (m&sup3;)<input type="text" name="total_cbm" value="{{ packing.total_cbm or '' }}"></label>
          <label>Packing Date<input type="date" name="packing_date" value="{{ packing.packing_date or '' }}"></label>
          <label>Shortfall % {% if orderedQuantitySummary.comparable %}(auto-computed — this field is ignored when the ordered quantity is comparable){% endif %}<input type="text" name="shortfall_pct" value="{{ packing.shortfall_pct or '' }}" {% if orderedQuantitySummary.comparable %}readonly{% endif %}></label>
          <label>Buyer's Written Approval of Shortfall <small class="muted">(required only if the shortfall exceeds tolerance)</small><input type="file" name="buyer_approval" accept=".pdf,.jpg,.jpeg,.png,.eml,.msg"></label>
        </div>

        <p class="muted small">Crate-level breakdown (add one row per physical crate). Pick the crate's product from this order — its HS code comes from the product record and cannot be typed here.</p>
        <table class="list">
          <tr><th>Crate No.</th><th>Marks &amp; Numbers</th><th>Product</th><th>L&times;W&times;H (cm)</th><th>Pcs</th><th>Net (kg)</th><th>Gross (kg)</th><th>CBM</th><th>HS Code</th></tr>
          {% set existingCrates = crates if crates and crates.length > 0 else [{}, {}, {}] %}
          {% for c in existingCrates %}
          <tr>
            <td><input type="text" name="crate_no[]" value="{{ c.crate_no or '' }}" style="width:70px;"></td>
            <td><input type="text" name="crate_marks_numbers[]" value="{{ c.marks_numbers or '' }}" style="width:130px;"></td>
            <td>{% set crateProduct = c.product_description or '' %}{% set crateKnown = (products | whereEq('description', crateProduct) | length) > 0 %}
              <select name="crate_product_description[]" data-crate-product style="width:160px;">
                <option value="" data-hs="">— Product —</option>
                {% for p in products %}
                <option value="{{ p.description }}" data-hs="{{ p.hs_code }}" {% if crateProduct == p.description %}selected{% endif %}>{{ p.description | truncate(60, true, '…') }}</option>
                {% endfor %}
                {% if crateProduct and not crateKnown %}<option value="{{ crateProduct }}" data-hs="{{ c.hs_code or '' }}" selected>{{ crateProduct }} (earlier entry)</option>{% endif %}
              </select></td>
            <td><input type="text" name="crate_dimensions[]" value="{{ c.dimensions_lwh_cm or '' }}" style="width:80px;"></td>
            <td><input type="text" name="crate_pcs[]" value="{{ c.pcs or '' }}" style="width:50px;"></td>
            <td><input type="text" name="crate_net_weight_kg[]" value="{{ c.net_weight_kg or '' }}" style="width:70px;"></td>
            <td><input type="text" name="crate_gross_weight_kg[]" value="{{ c.gross_weight_kg or '' }}" style="width:70px;"></td>
            <td><input type="text" name="crate_cbm[]" value="{{ c.cbm or '' }}" style="width:60px;"></td>
            <td><input type="text" value="{{ c.hs_code or '' }}" data-crate-hs readonly tabindex="-1" title="Taken from the product's HS code" style="width:70px;"></td>
          </tr>
          {% endfor %}
        </table>
        {{ stepBadge('10b') | safe }}<button type="submit" class="btn-sm">Save Packing &amp; Crates</button>
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">generate the Packing List from those figures</div>

  <details class="step-card" id="step-10c-packing-list"{{ flow.subCardOpen('s10', '10c') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s10', '10c')) }}<h2>Step 10c &middot; Generate Packing List</h2></summary>
    {% if packingLocked %}
      <p class="muted">{{ 'Confirm the Supplier PO is signed first' if isFob else 'Clear the freight payment first' }} to unlock this gate.</p>
    {% elif packing %}
        <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="document_type" value="PL">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
          <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
          {{ stepBadge('10c') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'PL') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Packing List</button>{{ docAlreadyNote(documents, 'PL') }}
        </form>
    {% else %}
      <p class="muted">Save Packing &amp; Crates first (Step 10b).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">once the vessel/sailing is confirmed</div>

  <details class="step-card" id="step-10d-shipping-details"{{ flow.subCardOpen('s10', '10d') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s10', '10d')) }}<h2>Step 10d &middot; Save Shipping Details</h2></summary>
    {% if packingLocked %}
      <p class="muted">{{ 'Confirm the Supplier PO is signed first' if isFob else 'Clear the freight payment first' }} to unlock this gate.</p>
    {% else %}
      <form method="post" action="/orders/{{ order.id }}/shipping">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="kv-grid">
          <label>Shipping Line<input type="text" name="shipping_line" value="{{ shipping.shipping_line or '' }}"></label>
          <label>Vessel Name<input type="text" name="vessel_name" value="{{ shipping.vessel_name or '' }}"></label>
          <label>Voyage Number<input type="text" name="voyage_number" value="{{ shipping.voyage_number or '' }}"></label>
          <label>ETD <small class="muted">(Estimated Time of Departure)</small><input type="date" name="etd" value="{{ shipping.etd or '' }}"></label>
          <label>ETA <small class="muted">(Estimated Time of Arrival)</small><input type="date" name="eta" value="{{ shipping.eta or '' }}"></label>
          <label>Container Type
            {% set shipContainerType = shipping.container_type or order.container_type or '' %}
            <select name="ship_container_type">
              <option value="">— To Be Confirmed —</option>
              {% for o in containerTypes %}
                <option value="{{ o.option_value }}" {{ 'selected' if shipContainerType == o.option_value else '' }}>{{ o.option_value }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Number of Containers<input type="number" name="container_count" min="1" step="1" value="{{ shipping.container_count or '' }}"></label>
          <label>Container No.<input type="text" name="container_no" value="{{ shipping.container_no or '' }}"></label>
          <label>Seal No.<input type="text" name="seal_no" value="{{ shipping.seal_no or '' }}"></label>
        </div>
        {{ stepBadge('10d') | safe }}<button type="submit" class="btn-sm">Save Shipping Details</button>
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">tell the CHA / shipping line how to issue the BL</div>

  <details class="step-card" id="step-10e-bl-instruction"{{ flow.subCardOpen('s10', '10e') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s10', '10e')) }}<h2>Step 10e &middot; Generate BL Instruction Sheet</h2></summary>
    {% if packingLocked %}
      <p class="muted">{{ 'Confirm the Supplier PO is signed first' if isFob else 'Clear the freight payment first' }} to unlock this gate.</p>
    {% elif shipping %}
      <h3 style="font-size:0.95em; margin-top:14px;">BL Instruction Sheet (for your CHA / shipping line)</h3>
      <p class="muted small">Generates the shipping-booking worksheet your CHA or shipping line needs before confirming the BL booking — shipper, consignee/notify party, shipment and container details from above, cargo description from the order's products, and the mandatory BL-type instruction from Settings. Review the Shipping and Packing details above first; anything left blank there shows as "To Be Confirmed" on the sheet.</p>
      <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="document_type" value="BLI">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
        {{ stepBadge('10e') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'BLI') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate BL Instruction Sheet</button>{{ docAlreadyNote(documents, 'BLI') }}
      </form>
    {% else %}
      <p class="muted">Save Shipping Details first (Step 10d).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">after the CHA draft-review loop below</div>

  <details class="step-card" id="step-10f-bl-issued"{{ flow.subCardOpen('s10', '10f') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s10', '10f')) }}<h2>Step 10f &middot; Confirm BL Issued <small class="muted">(after the CHA draft-review loop)</small></h2></summary>
    {% if packingLocked %}
      <p class="muted">{{ 'Confirm the Supplier PO is signed first' if isFob else 'Clear the freight payment first' }} to unlock this gate.</p>
    {% else %}
      {% if not blIssued %}
      <p class="muted small">After sending the BL Instruction Sheet and packing list above to your CHA, log each draft BL they send back here. Approve it, or request a revision with notes — the CHA's corrected draft is then logged as the next round. At most one round can be awaiting your decision at a time.</p>
      {% set latestDraftRound = draftBlReviews[0] %}
      {% if draftBlReviews.length == 0 %}
        <p class="muted">No draft BL logged yet.</p>
      {% else %}
        <table class="list">
          <tr><th>Round</th><th>Received</th><th>Draft</th><th>Status</th><th>Reviewed</th><th></th></tr>
          {% for round in draftBlReviews %}
          <tr>
            <td>{{ round.round_number }}</td>
            <td>{{ round.uploaded_at }}</td>
            <td><a href="/file-store/{{ round.draft_file_id }}/download" target="_blank">View draft</a></td>
            <td>
              {% if round.status == 'pending' %}<span class="badge badge-inactive">Pending Review</span>
              {% elif round.status == 'approved' %}<span class="badge badge-active">Approved</span>
              {% else %}<span class="badge">Revision Requested</span>{% endif %}
              {% if round.review_notes %}<br><small class="muted">{{ round.review_notes }}</small>{% endif %}
            </td>
            <td>{{ (round.reviewed_by_name + ' — ' + round.reviewed_at) if round.reviewed_by_name else '—' }}</td>
            <td>
              {% if round.status == 'pending' %}
                <details>
                  <summary class="small">Review</summary>
                  <form method="post" action="/orders/{{ order.id }}/draft-bl/{{ round.id }}/review">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <label>Decision
                      <select name="decision" required>
                        <option value="approved">Approve</option>
                        <option value="revision_requested">Request Revision</option>
                      </select>
                    </label>
                    <label>Notes <small class="muted">(required if requesting a revision)</small><input type="text" name="notes"></label>
                    <button type="submit" class="btn-sm">Submit Review</button>
                  </form>
                </details>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </table>
      {% endif %}
      {% if not latestDraftRound or latestDraftRound.status != 'pending' %}
        <form method="post" action="/orders/{{ order.id }}/draft-bl" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Draft BL from CHA *<input type="file" name="draft_bl" accept=".pdf,.doc,.docx,.xls,.xlsx,.odt,.ods,.rtf,.txt,.csv,.jpg,.jpeg,.png,.gif,.webp,.bmp,.tif,.tiff,.heic,.eml,.msg,.zip" required></label>
          <button type="submit" class="btn-sm">Log Draft BL for Review</button>
        </form>
      {% endif %}

        <form method="post" action="/orders/{{ order.id }}/bl-issued" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>BL Number *<input type="text" name="bl_number" required></label>
          <label>BL Date<input type="date" name="bl_date"></label>
          <label>Scanned BL Copy <small class="muted">(optional — can be attached later)</small><input type="file" name="bl_copy" accept=".pdf,.doc,.docx,.xls,.xlsx,.odt,.ods,.rtf,.txt,.csv,.jpg,.jpeg,.png,.gif,.webp,.bmp,.tif,.tiff,.heic,.eml,.msg,.zip"></label>
          {{ stepBadge('10f') | safe }}<button type="submit" class="btn-sm btn-success">Confirm BL Issued (unlocks Stage 8)</button>
        </form>
      {% else %}
        <p>Bill of Lading recorded: <strong>{{ shipping.bl_number }}</strong> ({{ shipping.bl_date }})</p>
        {% if shipping.bl_copy_file_id %}
          <p class="muted small"><a href="/file-store/{{ shipping.bl_copy_file_id }}/download">Download scanned BL copy</a></p>
        {% else %}
          <form method="post" action="/orders/{{ order.id }}/bl-copy" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Scanned BL Copy<input type="file" name="bl_copy" accept=".pdf,.doc,.docx,.xls,.xlsx,.odt,.ods,.rtf,.txt,.csv,.jpg,.jpeg,.png,.gif,.webp,.bmp,.tif,.tiff,.heic,.eml,.msg,.zip" required></label>
            <button type="submit" class="btn-sm">Attach Scanned BL Copy</button>
          </form>
        {% endif %}
      {% endif %}
    {% endif %}
  </details>

  </details>

  {% set ciBalanceLocked = (not stage8) or stage8.status == 'locked' %}

  <details class="step-group" id="step-group-stage-8"{{ stepCardOpen('s11') }}>
    <summary>{{ stepStatusIcon(stepStates['s11']) }}<span class="step-group-num">STEP 11</span><h3>Commercial Invoice &amp; Balance</h3></summary>

  <details class="step-card" id="step-ci-generate"{{ flow.subCardOpen('s11', '11a') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s11', '11a')) }}<h2>Step 11a &middot; Generate Commercial Invoice{{ ' (before shipment)' if isFob else ' (against BL)' }}</h2></summary>
    {% if ciBalanceLocked %}
      <p class="muted">Confirm BL issuance first to unlock this gate.</p>
    {% else %}
      {# Owner request (2026-10-26, t4): the CI is made against the BL, so the scanned BL copy goes in first (FOB raises its CI before shipment, so no BL yet). #}
      {% if isFob %}
      {% elif not (shipping and shipping.bl_copy_file_id) %}
        <p class="review-banner warn bl-copy-first">&#9888; <strong>Upload the scanned BL copy first</strong> — attach it in <a href="#step-10f-bl-issued">Step 10f</a> (Attach Scanned BL Copy), then generate the Commercial Invoice against it.</p>
      {% else %}
        <p class="muted small">Scanned BL copy is on file (<a href="/file-store/{{ shipping.bl_copy_file_id }}/download">download</a>) — generate the Commercial Invoice against it.</p>
      {% endif %}
      <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="document_type" value="CI">
        {# Owner request (2026-10-27): the CI can be dated today or earlier, e.g. to match the BL. #}
        <label class="ci-date-field">Invoice date (printed on the CI) *<input type="date" name="document_date" required value="{{ today() }}" max="{{ today() }}" min="{{ (order.created_at or '') | string | truncate(10, true, '') }}"><small class="muted">Today by default. To match the BL, pick the BL date here — today or any earlier date.</small></label>
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
        {{ stepBadge('11a') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'CI') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate Commercial Invoice</button>{{ docAlreadyNote(documents, 'CI') }}
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">timed with sending the scanned BL</div>

  <details class="step-card" id="step-ci-scanned-bl-sent"{{ flow.subCardOpen('s11', '11b') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s11', '11b')) }}<h2>Step 11b &middot; Mark Scanned BL Copy Sent to Buyer</h2></summary>
    {% if ciBalanceLocked %}
      <p class="muted">Confirm BL issuance first to unlock this gate.</p>
    {% elif shipping and not shipping.scanned_bl_sent_to_buyer_at %}
      <form method="post" action="/orders/{{ order.id }}/scanned-bl-sent">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ stepBadge('11b') | safe }}<button type="submit" class="btn-sm">Mark Scanned BL Copy Sent to Buyer</button>
      </form>
    {% elif shipping %}
      <p class="muted small">Scanned BL copy sent to buyer.</p>
    {% endif %}
  </details>

  <div class="step-group-connector">once the buyer's balance payment lands</div>

  <details class="step-card" id="step-balance-record"{{ flow.subCardOpen('s11', '11c') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s11', '11c')) }}<h2>Step 11c &middot; Record Balance Remittance</h2></summary>
    {% if not balanceCleared %}{{ paymentActionLinkWidget('Commercial Invoice', 'step-balance-record') }}{% endif %}
    {% if ciBalanceLocked %}
      <p class="muted">Confirm BL issuance first to unlock this gate.</p>
    {% elif not balanceCleared and (not payment or payment.balance_remittance_received_at == null) %}
      {% if not ciDocGenerated %}
        <p class="muted small">Generate the Commercial Invoice first — the buyer can't be remitting against an invoice they were never sent.</p>
      {% elif not permissions.manage_payments %}
        <p class="muted">Only Accounts/Export can record this payment.</p>
      {% else %}
      <form method="post" action="/orders/{{ order.id }}/payment/balance">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Balance Amount Received * <small class="muted">(in {{ order.currency_code or '' }})</small><input type="text" name="balance_amount" required data-remit-amount value="{{ payment.balance_amount or '' }}"></label>
        <label>Received On<input type="date" name="balance_received_at"></label>
          <label>@ Exchange Rate * <small class="muted">(&#8377; per 1 {{ order.currency_code or '' }})</small><input type="number" step="0.0001" min="0.0001" name="balance_exchange_rate" data-remit-rate required placeholder="e.g. 83.2500"></label>
          <p class="muted small remit-statement" data-remit-statement data-currency="{{ order.currency_code or '' }}"></p>
        {{ stepBadge('11c') | safe }}<button type="submit" class="btn-sm">Record Balance Remittance</button>
      </form>
      {% endif %}
    {% else %}
      {{ remittanceRecordedNote('balance', 'Next: mark it cleared once the bank confirms.') }}
    {% endif %}
    {% if not ciBalanceLocked %}
      {{ inrActualWidget('balance', 'Balance Payment') }}
      {{ exchangeRateWidget('balance', 'Balance Payment') }}
    {% endif %}
  </details>

  <div class="step-group-connector">after funds are confirmed cleared</div>

  <details class="step-card" id="step-balance-clear"{{ flow.subCardOpen('s11', '11d') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s11', '11d')) }}<h2>Step 11d &middot; Mark Balance Cleared</h2></summary>
    {% if ciBalanceLocked %}
      <p class="muted">Confirm BL issuance first to unlock this gate.</p>
    {% elif balanceCleared %}
      <p>Balance payment cleared.</p>
    {% elif payment and payment.balance_remittance_received_at != null %}
      {% if not permissions.clear_payments %}
        <p class="muted">Balance remittance recorded — awaiting Accounts to confirm it cleared.</p>
      {% else %}
      <form method="post" action="/orders/{{ order.id }}/payment/balance/clear" onsubmit="return confirm('Mark the balance payment cleared? This unlocks Stage 9 (final closure) — confirm the funds have actually landed first, and that the BL hasn\'t been released early if this is a post-BL preset.');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Cleared On<input type="date" name="balance_cleared_at"></label>
        {{ stepBadge('11d') | safe }}<button type="submit" class="btn-sm btn-success">Mark Balance Cleared (unlocks Stage 9)</button>
      </form>
      {% endif %}
    {% else %}
      <p class="muted">Record the balance remittance first.</p>
    {% endif %}
  </details>

  </details>

  </details>

  {% set ph = flow.phase('closure') %}
  <details class="phase-group" id="phase-closure"{{ ' open' if ph.open else '' }}>
    {{ phaseSummary(ph) }}

  {% if canManageOrderFinancials %}
  {# Owner decision (2026-10-26): Step 12 as guided sub-steps (Option A) — 12a costs, 12b scheme eligibility,
     12c review & complete (benefits moved to Step 13g, owner decision 2026-10-27) — with the order's money picture on top
     (status from helpers/financialsStep). #}
  {% set fin = financialsStep(order, exportBenefitEligibility, orderBenefitClaims, orderCostEntries, payment) %}
  {% set benefitsDisabled = '' if fin.benefitsApplicable else ' disabled' %}
  <details class="step-group" id="order-financials"{{ stepCardOpen('s12') }}>
    <summary>{{ stepStatusIcon(stepStates['s12']) }}<span class="step-group-num">STEP 12</span><h3>Closure &mdash; Financials, Benefits &amp; Costs</h3><span class="fin-progress">{{ fin.doneCount }} of 3 done</span></summary>
    <p class="muted small">Everything financial about this order, in three short parts (government benefits are recorded later, in Step 13g) — visible only to Super Admin and roles granted "Manage order financials". Work top to bottom; the next unfinished part opens by itself.</p>

    <div class="fin-kpis">
      <div class="fin-kpi"><span class="l">Received from buyer{{ ' (estimated)' if profitability and profitability.revenue_is_estimated else '' }}</span><span class="v">{% if profitability %}&#8377;{{ profitability.revenue_inr | money }}{% else %}—{% endif %}</span></div>
      <div class="fin-kpi"><span class="l">Total costs</span><span class="v">{% if profitability %}&#8377;{{ profitability.total_cost_inr | money }}{% else %}—{% endif %}</span></div>
      <div class="fin-kpi"><span class="l">Govt benefits received</span><span class="v">&#8377;{{ fin.receivedBenefits | money }}{% if fin.claimedBenefits > fin.receivedBenefits %} <small class="muted">of &#8377;{{ fin.claimedBenefits | money }} claimed</small>{% endif %}</span></div>
      <div class="fin-kpi good"><span class="l">Net profit</span><span class="v">{% if profitability %}&#8377;{{ profitability.profit_inr | money }}{% if profitability.margin_pct != null %} · {{ profitability.margin_pct | round(1) }}%{% endif %}{% else %}—{% endif %}</span></div>
    </div>

    <details class="step-card" id="financials-12a"{{ fin.open('12a') }}>
      <summary>{{ stepStatusIcon(fin.icon('12a')) }}<h2>Step 12a &middot; Order Costs</h2><span class="fin-sub-summary">{{ orderCostEntries.length }} cost{{ '' if orderCostEntries.length == 1 else 's' }} · &#8377;{{ fin.costTotal | money }}</span></summary>
      <p class="muted small">Every cost this order carried besides the supplier, freight and insurance (those come in automatically). All amounts in INR.</p>
        {% if orderCostEntries.length == 0 %}
          <p class="muted">No other costs recorded for this order yet.</p>
        {% else %}
          <table class="list">
            <tr><th>Date</th><th>Category</th><th>Description</th><th>Amount (INR)</th><th>Recorded By</th><th></th></tr>
            {% for c in orderCostEntries %}
            <tr>
              <td>{{ c.incurred_at or '—' }}</td>
              <td>{{ costEntryCategories[c.category] or c.category }}</td>
              <td>{{ c.description or '—' }}</td>
              <td>{{ c.amount_inr | money }}</td>
              <td>{{ c.recorded_by_name }}</td>
              <td>
                <form method="post" action="/orders/{{ order.id }}/cost-entries/{{ c.id }}/delete" onsubmit="return confirm('Remove this cost entry?');">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn-sm btn-danger">Remove</button>
                </form>
              </td>
            </tr>
            {% endfor %}
          </table>
        {% endif %}
      {# Owner decisions (2026-10-27): the order's actual expenses, each with
         its receipt (or a reason when no bill exists). The travel % of FOB stays
         the provisional figure until real travel expenses are recorded. #}
      {% set logisticsTotalForFin = vendorBillsView.totals(vendorBillsView.logistics(vendorBills)).total %}
      <div class="order-expenses" id="order-expenses">
        <h3 style="font-size:0.95em; margin-top:10px;">Order Expenses — travel &amp; other</h3>
        <div class="plan-bar">
          <div>Travel budget{% if orderTravelExpenses %} ({{ orderTravelExpenses.expense_pct | money }}% of FOB){% endif %}<b>{% if orderTravelExpenses %}&#8377;{{ orderTravelExpenses.expense_amount | money }}{% else %}—{% endif %}</b></div>
          <div>Actual travel<b>&#8377;{{ expenseSummary.travel | money }}</b></div>
          <div>All expenses<b>&#8377;{{ expenseSummary.total | money }}</b></div>
          <div>Receipts attached<b>{{ expenseSummary.with_receipt }} of {{ expenseSummary.count }}</b></div>
          {% if expenseSummary.to_reimburse > 0 %}<div>Paid by staff, to reimburse<b class="vendor-bill-due">&#8377;{{ expenseSummary.to_reimburse | money }}</b></div>{% endif %}
        </div>
        <p class="muted small">{{ 'Travel cost now uses the actual travel expenses below; the travel % stays only as the budget to compare against.' if expenseSummary.has_travel else 'Until real travel expenses are recorded, travel cost uses the travel % of FOB (provisional).' }}
          A voucher can be added later with its real date — unless the CA has locked that financial year.
          {% if logisticsTotalForFin > 0 %}Logistics partner bills (&#8377;{{ logisticsTotalForFin | money }}) come in automatically from <a href="#logistics-bills">Group C</a>.{% endif %}</p>
        {% if orderExpenses.length %}
        <table class="list">
          <tr><th>Date</th><th>Category</th><th>Details</th><th style="text-align:right">&#8377;</th><th>Paid by</th><th>Receipt</th><th></th></tr>
          {% for e in orderExpenses %}
          <tr>
            <td>{{ e.expense_date | shortDate }}{% if e.added_later | int %}<br><small class="muted">added later (entered {{ e.created_at | shortDate }})</small>{% endif %}</td>
            <td>{{ expenseCategories[e.category] or e.category }}</td>
            <td>{{ e.details }}</td>
            <td style="text-align:right">{{ e.amount_inr | money }}</td>
            <td>{{ expensePaidBy[e.paid_by] or e.paid_by }}{% if e.paid_by == 'staff' and e.staff_name %} — {{ e.staff_name }}{% endif %}</td>
            <td>{% if e.receipt_file_id %}<a href="/file-store/{{ e.receipt_file_id }}/download">receipt</a>{% else %}<span class="vendor-bill-due">No bill — {{ e.no_receipt_reason }}</span>{% endif %}</td>
            <td>
              <form method="post" action="/orders/{{ order.id }}/expenses/{{ e.id }}/delete" data-confirm="Remove this expense?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button type="submit" class="btn-sm btn-danger">Remove</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </table>
        {% endif %}
        <details class="vendor-bill-add"{% if not orderExpenses.length %} open{% endif %}>
          <summary class="small"><strong>+ Add an expense</strong></summary>
          <form method="post" action="/orders/{{ order.id }}/expenses" enctype="multipart/form-data" class="field-grid">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Date *<input type="date" name="expense_date" required max="{{ today() }}"></label>
            <label>Category *
              <select name="category" required>
                {% for key, catLabel in expenseCategories %}<option value="{{ key }}">{{ catLabel }}</option>{% endfor %}
              </select>
            </label>
            <label>Amount (&#8377;) *<input type="number" step="0.01" min="0.01" name="amount_inr" required></label>
            <label>Paid by *
              <select name="paid_by" required>
                {% for key, byLabel in expensePaidBy %}<option value="{{ key }}">{{ byLabel }}</option>{% endfor %}
              </select>
            </label>
            <label>Staff member to reimburse<input type="text" name="staff_name" maxlength="150" data-required-if="paid_by=staff" placeholder="only when staff paid"></label>
            <label class="full">Details *<input type="text" name="details" required maxlength="255" placeholder="e.g. Factory visit 2 — Kota"></label>
            <label>Receipt / bill<input type="file" name="receipt" accept=".pdf,.jpg,.jpeg,.png"></label>
            <label>No receipt? Reason<input type="text" name="no_receipt_reason" maxlength="255" minlength="10" data-required-unless="receipt" placeholder="only if no bill exists"></label>
            <div><button type="submit" class="btn-sm">Add Expense</button></div>
          </form>
        </details>
      </div>
      <details class="fin-zoho">
        <summary class="muted small">Linked from Zoho Books ({{ linkedCaExpenses.length }}) — for reference</summary>
        {% if linkedCaExpenses.length == 0 %}
          <p class="muted">Nothing linked to this order yet — link an expense from <a href="/ca/expenses">the Expenses register</a> if one belongs here.</p>
        {% else %}
          <table class="list">
            <tr><th>Date</th><th>Category</th><th>Vendor</th><th>Amount</th></tr>
            {% for e in linkedCaExpenses %}
            <tr>
              <td>{{ e.expense_date }}</td>
              <td>{{ e.category }}</td>
              <td>{{ e.vendor_name or '—' }}</td>
              <td>{{ e.amount | money }} {{ e.currency_code }}</td>
            </tr>
            {% endfor %}
          </table>
        {% endif %}
      </details>
      <details class="fin-add-cost">
        <summary class="small"><strong>+ Add a cost</strong></summary>
        <label class="fin-add-cost-pick">Type of cost
          <select data-fin-cost-type aria-label="Type of cost">
            <option value="other">Other cost (CHA, port, courier, bank charges…)</option>
            <option value="travel">Travel budget — % of FOB (provisional until real travel expenses are recorded)</option>
            {% if pendingInspectionTask %}<option value="inspection">Pre-shipment inspection fee</option>{% endif %}
            {% if isLcPayment %}<option value="lc">LC / bank loan interest</option>{% endif %}
          </select>
        </label>
        <div data-fin-cost-form="other">
          <form method="post" action="/orders/{{ order.id }}/cost-entries">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Category *
              <select name="category" required>
                {% for key, label in costEntryCategories %}
                  <option value="{{ key }}">{{ label }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Amount (INR) *<input type="text" name="amount_inr" required></label>
            <label>Date<input type="date" name="incurred_at" value="{{ today() }}"></label>
            <label>Description<input type="text" name="description"></label>
            <button type="submit" class="btn-sm">Record Cost</button>
          </form>
        </div>
        <div data-fin-cost-form="travel">
        <h3 style="font-size:0.95em; margin-top:10px;">Travel Expenses — Factory Visits</h3>
        <p class="muted small">Every order needs 3-4 trips to the factory; record the distance (for reference) and the percentage of the order's FOB value to charge as travel expenses.</p>
        {% set savedPct = (orderTravelExpenses.expense_pct | string) if orderTravelExpenses else '' %}
        <div class="kv-grid">
          <div><span class="k">Factory Distance</span><span class="v">{{ (orderTravelExpenses.factory_distance_km ~ ' km') if orderTravelExpenses and orderTravelExpenses.factory_distance_km != null else '—' }}</span></div>
          <div><span class="k">Percentage</span><span class="v">{{ (orderTravelExpenses.expense_pct ~ '%') if orderTravelExpenses else 'Not yet recorded' }}</span></div>
          <div><span class="k">Amount</span><span class="v">{{ orderTravelExpenses.expense_amount | money if orderTravelExpenses else '—' }}</span></div>
        </div>
          <form method="post" action="/orders/{{ order.id }}/travel-expenses">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Factory Distance (km) <small class="muted">(min 175km — for reference only)</small><input type="text" name="factory_distance_km" value="{{ orderTravelExpenses.factory_distance_km if orderTravelExpenses and orderTravelExpenses.factory_distance_km != null else '' }}"></label>
            <label>Travel Expense % of FOB Value *
              <select name="expense_pct" required>
                {% for pct in ['5', '7', '10', '15'] %}
                  <option value="{{ pct }}" {{ 'selected' if savedPct == pct }}>{{ pct }}%</option>
                {% endfor %}
                <option value="other" {{ 'selected' if savedPct and savedPct not in ['5', '7', '10', '15'] }}>Other — specify</option>
              </select>
            </label>
            <label>Custom % <small class="muted">(only used when "Other" is selected above)</small><input type="text" name="expense_pct_other" value="{{ savedPct if savedPct and savedPct not in ['5', '7', '10', '15'] else '' }}"></label>
            <button type="submit" class="btn-sm">Save</button>
          </form>
        </div>
        {% if pendingInspectionTask %}
        <div data-fin-cost-form="inspection">
        <h3 style="font-size:0.95em; margin-top:14px;">3rd-Party Pre-Shipment Inspection (step 8a)</h3>
        <p class="muted small">This order has a Pre-Shipment Inspection on its Compliance Checklist (not marked not-applicable) — staff get reminded starting 7 days before the estimated shipment date (Step 8a). If NexaCrest pays the inspection fee, record it below so it's included as an order expense; if the client pays it directly, there's nothing to record.</p>
        <div class="kv-grid">
          <div><span class="k">Fee Payer</span><span class="v">{{ (('NexaCrest' if orderInspectionFee.fee_payer == 'nexacrest' else 'Client')) if orderInspectionFee else 'Not yet recorded' }}</span></div>
          <div><span class="k">Fee Amount</span><span class="v">{{ orderInspectionFee.fee_amount | money if orderInspectionFee and orderInspectionFee.fee_amount != null else '—' }}</span></div>
        </div>
        <details>
          <summary>{{ 'Edit inspection fee' if orderInspectionFee else 'Record inspection fee' }}</summary>
          <form method="post" action="/orders/{{ order.id }}/inspection-fee">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Who pays the inspection fee? *
              <select name="fee_payer" required>
                <option value="nexacrest" {{ 'selected' if orderInspectionFee and orderInspectionFee.fee_payer == 'nexacrest' }}>NexaCrest</option>
                <option value="client" {{ 'selected' if orderInspectionFee and orderInspectionFee.fee_payer == 'client' }}>Client</option>
              </select>
            </label>
            <label>Fee Amount (INR) <small class="muted">(only recorded as an expense when NexaCrest pays)</small><input type="text" name="fee_amount" value="{{ orderInspectionFee.fee_amount if orderInspectionFee and orderInspectionFee.fee_amount != null else '' }}"></label>
            <button type="submit" class="btn-sm">Save</button>
          </form>
        </details>
        </div>
        {% endif %}
        {% if isLcPayment %}
        <div data-fin-cost-form="lc">
        {# Only an order whose payment preset is a Letter of Credit has an LC / bank loan to record. #}
        {% set lcDetails = orderLcDetails or { lc_number: null, lc_file_id: null, bank_loan_amount: null, bank_loan_interest_rate: null, bank_loan_interest_paid: null } %}
        <h3 style="font-size:0.95em; margin-top:0;">Letter of Credit &amp; Bank Loan</h3>
        <p class="muted small">Export process steps 5-1a/5-2a/5-3a: only relevant if the client opted for payment by LC. Recording an interest-paid amount below automatically keeps a matching "Bank Loan Interest" row in Other Order Costs below in sync — editing it there directly isn't needed.</p>
        <div class="kv-grid">
          <div><span class="k">LC Number</span><span class="v">{{ lcDetails.lc_number or '—' }}</span></div>
          <div><span class="k">LC Document</span><span class="v">{% if lcDetails.lc_file_id %}<a href="/file-store/{{ lcDetails.lc_file_id }}/download" target="_blank">View LC</a>{% else %}—{% endif %}</span></div>
          <div><span class="k">Bank Loan Amount</span><span class="v">{{ lcDetails.bank_loan_amount | money if lcDetails.bank_loan_amount != null else '—' }}</span></div>
          <div><span class="k">Interest Rate</span><span class="v">{{ (lcDetails.bank_loan_interest_rate + '%') if lcDetails.bank_loan_interest_rate != null else '—' }}</span></div>
          <div><span class="k">Interest Paid</span><span class="v">{{ lcDetails.bank_loan_interest_paid | money if lcDetails.bank_loan_interest_paid != null else '—' }}</span></div>
        </div>
        <details>
          <summary>{{ 'Edit LC / bank loan details' if orderLcDetails else 'Record LC / bank loan details for this order' }}</summary>
          <form method="post" action="/orders/{{ order.id }}/lc-details" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>LC Number<input type="text" name="lc_number" value="{{ lcDetails.lc_number or '' }}"></label>
            <label>Final LC Document<input type="file" name="lc_file" accept=".pdf,.jpg,.jpeg,.png"></label>
            <label>Bank Loan Amount<input type="text" name="bank_loan_amount" value="{{ lcDetails.bank_loan_amount if lcDetails.bank_loan_amount != null else '' }}"></label>
            <label>Interest Rate (%)<input type="text" name="bank_loan_interest_rate" value="{{ lcDetails.bank_loan_interest_rate if lcDetails.bank_loan_interest_rate != null else '' }}"></label>
            <label>Total Interest Paid<input type="text" name="bank_loan_interest_paid" value="{{ lcDetails.bank_loan_interest_paid if lcDetails.bank_loan_interest_paid != null else '' }}"></label>
            <button type="submit" class="btn-sm">Save LC / Loan Details</button>
          </form>
        </details>
        </div>
        {% endif %}
      </details>
      <form method="post" action="/orders/{{ order.id }}/financials/costs-confirmed" class="fin-confirm">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if order.financials_costs_confirmed_at %}
          <span class="small">&#10003; Costs marked complete on {{ order.financials_costs_confirmed_at }}.</span>
          <input type="hidden" name="action" value="reopen">
          <button type="submit" class="btn-sm btn-secondary">Reopen costs</button>
        {% else %}
          <button type="submit" class="btn-sm">Costs are complete &rarr; next: 12b</button>
          <span class="muted small">You can still add a cost later.</span>
        {% endif %}
      </form>
    </details>

    <div class="step-group-connector">then answer which government schemes apply</div>

    <details class="step-card" id="financials-12b"{{ fin.open('12b') }}>
      <summary>{{ stepStatusIcon(fin.icon('12b')) }}<h2>Step 12b &middot; Export Benefit Eligibility</h2><span class="fin-sub-summary">{{ (fin.pending ~ ' still to answer') if fin.pending > 0 else (fin.eligible.length ~ ' eligible') }}</span></summary>
        <p class="muted small">Not every order qualifies for every scheme — resolve each one explicitly (never leave it "pending") so a report never has to guess whether "no claim" meant ineligible or forgotten. Marking the order fully settled (Step 13h) is blocked while any scheme here is still Pending.</p>
        <form method="post" action="/orders/{{ order.id }}/export-benefit-schemes">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <table class="list">
            <tr><th>Scheme</th><th>Eligibility</th><th>Reason <small class="muted">(filled in when Not Eligible — edit if needed)</small></th></tr>
            {% for sch in exportBenefitEligibility %}
            <tr>
              <td>{{ sch.scheme_name }}
                <input type="hidden" name="schemes[{{ loop.index0 }}][scheme_name]" value="{{ sch.scheme_name }}">
                {% if sch.resolved_at %}
                <br><span class="muted small">{{ sch.resolved_at }}{% if sch.resolved_by_name %} by {{ sch.resolved_by_name }}{% endif %}</span>
                {% endif %}
              </td>
              <td>
                <select name="schemes[{{ loop.index0 }}][status]" data-scheme-status style="min-width:140px;">
                  {% for key, label in exportBenefitEligibilityStatuses %}
                  <option value="{{ key }}" {% if sch.status == key %}selected{% endif %}{% if key == 'not_eligible' %} data-auto-reason="{{ schemeNotEligibleReason }}"{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
              </td>
              <td><input type="text" name="schemes[{{ loop.index0 }}][reason]" value="{{ sch.reason or '' }}" placeholder="Why it doesn't apply to this order" data-scheme-reason></td>
            </tr>
            {% endfor %}
          </table>
          <button type="submit" class="btn-sm">Save All Schemes</button>
          <span class="muted small">Saves every row at once — only the rows you changed are updated.</span>
        </form>
    </details>

    <div class="step-group-connector">then review the profit and complete Step 12</div>

    <details class="step-card" id="financials-12c"{{ fin.open('12c') }}>
      <summary>{{ stepStatusIcon(fin.icon('12c')) }}<h2>Step 12c &middot; Review Profit &amp; Complete Step 12</h2><span class="fin-sub-summary">{% if profitability %}Net profit &#8377;{{ profitability.profit_inr | money }}{% endif %}</span></summary>
        {% if profitability %}
          <h3 style="font-size:0.95em; margin-top:0;">Profitability Summary</h3>
          <div class="kv-grid">
            <div><span class="k">Revenue (INR){% if profitability.revenue_is_estimated %} — estimated{% endif %}</span><span class="v">{{ profitability.revenue_inr | money }}</span></div>
            <div><span class="k">Govt. Export Benefits (INR){% if profitability.export_benefits_is_estimated %} — claimed, not yet received{% endif %}</span><span class="v">{{ profitability.export_benefits_inr | money }}</span></div>
            <div><span class="k">Supplier Cost (INR)</span><span class="v">{{ profitability.supplier_cost_inr | money }}</span></div>
            <div><span class="k">Ocean Freight (INR){{ " — from the forwarder's bills" if profitability.freight_from_bills else '' }}</span><span class="v">{{ profitability.freight_cost_inr | money }}</span></div>
            <div><span class="k">Insurance (INR)</span><span class="v">{{ profitability.insurance_cost_inr | money }}</span></div>
            <div><span class="k">Logistics Bills — CHA / Transport (INR)</span><span class="v">{{ profitability.logistics_cost_inr | money }}</span></div>
            <div><span class="k">Order Expenses (INR)</span><span class="v">{{ profitability.expenses_inr | money }}</span></div>
            <div><span class="k">Other Costs (INR){{ '' if profitability.travel_is_provisional else ' — travel % replaced by actual travel' }}</span><span class="v">{{ profitability.other_costs_inr | money }}</span></div>
            <div><span class="k">Total Order Cost (INR)</span><span class="v">{{ profitability.total_cost_inr | money }}</span></div>
            <div><span class="k">Order Profit (INR)</span><span class="v">{{ profitability.profit_inr | money }}</span></div>
            <div><span class="k">Order Margin %</span><span class="v">{% if profitability.margin_pct != null %}{{ profitability.margin_pct | money }}%{% else %}—{% endif %}</span></div>
          </div>
          {% if profitability.revenue_is_estimated %}
            <p class="muted small">Revenue is estimated using the order's assumed exchange rate — it becomes the exact figure once both the advance and balance legs clear with their INR actual recorded. See <a href="/reports/order-profitability">the Order Profitability report</a> for every order side by side.</p>
          {% endif %}
        {% else %}
          <p class="muted">Not enough data recorded yet to compute profitability for this order.</p>
        {% endif %}
      <p class="muted small">The internal financial annexure (CAFIN) is generated from <a href="#order-cafin">the CAFIN box at the top of this page</a> — available at any stage.</p>
      <form method="post" action="/orders/{{ order.id }}/financials/complete" class="fin-confirm">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if order.financials_completed_at %}
          <span class="small">&#10003; Step 12 completed on {{ order.financials_completed_at }}{% if order.financials_completed_by %} by {{ usersById[order.financials_completed_by] or ('User #' ~ order.financials_completed_by) }}{% endif %}.</span>
          <input type="hidden" name="action" value="reopen">
          <button type="submit" class="btn-sm btn-secondary">Reopen Step 12</button>
        {% elif not fin.skipped %}
          <button type="submit" class="btn-sm btn-success">Mark Step 12 complete</button>
          <span class="muted small">Needs 12a marked complete and every scheme answered in 12b. Government benefits are recorded later, in Step 13g — just before the order is marked fully settled.</span>
        {% endif %}
      </form>
      {# Owner request (2026-10-26, t4): skip Step 12 with a reason — figures stay blank, never 0. #}
      <div class="financials-skip" style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px;">
        {% if order.financials_skipped_at %}
          <p class="small">&#10003; <strong>Step 12 marked complete without financial figures</strong> on {{ order.financials_skipped_at }}{% if order.financials_skipped_by %} by {{ usersById[order.financials_skipped_by] or ('User #' ~ order.financials_skipped_by) }}{% endif %} — {{ order.financials_skip_reason }}. Nothing was recorded as 0; you can still add figures above.</p>
          <form method="post" action="/orders/{{ order.id }}/financials/skip/undo" style="display:inline">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm btn-secondary">Reopen Step 12</button>
          </form>
        {% else %}
          <form method="post" action="/orders/{{ order.id }}/financials/skip" data-confirm="Mark Step 12 complete without recording these figures? Nothing will be saved as 0.">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Skip financials — mark Step 12 complete <small class="muted">(nothing to record here, or figures will come later — reason required; nothing is written as 0, and export-benefit schemes still need answering before Mark Fully Settled)</small>
              <input type="text" name="skip_reason" required minlength="10" placeholder="Reason (mandatory)">
            </label>
            <button type="submit" class="btn-sm">Skip &amp; Mark Step 12 Complete</button>
          </form>
        {% endif %}
      </div>
    </details>
  </details>
  {% endif %}

  {% set despatchLocked = (not stage9) or stage9.status == 'locked' %}

  <details class="step-group" id="step-group-stage-9"{{ stepCardOpen('s13') }}>
    <summary>{{ stepStatusIcon(stepStates['s13']) }}<span class="step-group-num">STEP 13</span><h3>Closure &mdash; Documents &amp; Settlement</h3></summary>

  <details class="step-card" id="step-11a-coo-prep"{{ flow.subCardOpen('s13', '13a') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13a')) }}<h2>Step 13a &middot; Generate COO Prep Sheet</h2></summary>
    {% if despatchLocked %}
      <p class="muted">Clear the balance payment first to unlock this gate.</p>
    {% else %}
      <h3 style="font-size:0.95em; margin-top:0;">COO Prep Sheet (internal — for the Chamber of Commerce application)</h3>
      <p class="muted small">Generates an internal worksheet summarizing everything needed to apply for the Certificate of Origin with the Chamber of Commerce — shipper, consignee, shipment, and cargo details, the same source data as the BL Instruction Sheet. Never shown to the client.</p>
      <form method="post" action="/orders/{{ order.id }}/documents/generate" style="display:inline" onsubmit="return confirmDocumentRegeneration(this);">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="document_type" value="COOPREP">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_pdf" value="1" checked disabled> PDF</label><input type="hidden" name="generate_pdf" value="1">
        <label class="checkbox-row" style="display:inline-block; margin:0 6pt 0 0; font-weight:normal;"><input type="checkbox" name="generate_docx" value="1"> DOCX</label>
        {{ stepBadge('13a') | safe }}<button type="submit" class="{{ 'btn-sm btn-doc-regenerate' if docGenerated(documents, 'COOPREP') else 'btn-sm btn-doc-new' }}" data-loading-text="Generating…">Generate COO Prep Sheet</button>{{ docAlreadyNote(documents, 'COOPREP') }}
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">once the CHA delivers the original BLs</div>

  <details class="step-card" id="step-11b-bl-originals-received"{{ flow.subCardOpen('s13', '13b') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13b')) }}<h2>Step 13b &middot; Record Original BLs Received from CHA</h2></summary>
    {% if despatchLocked %}
      <p class="muted">Clear the balance payment first to unlock this gate.</p>
    {% elif not permissions.manage_shipping %}
      <p class="muted">Only Logistics can record the original BLs.</p>
    {% elif not shipping or not shipping.bl_originals_received_at %}
      <form method="post" action="/orders/{{ order.id }}/bl-originals-received">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>No. of Original BL Copies Received<input type="number" name="bl_originals_count" value="3"></label>
        {{ stepBadge('13b') | safe }}<button type="submit" class="btn-sm">Record Original BLs Received from CHA</button>
      </form>
    {% else %}
      <p class="muted small">Original BLs received ({{ shipping.bl_originals_received_count }}).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">write up the endorsement</div>

  <details class="step-card" id="step-11d-bl-endorsement-save"{{ flow.subCardOpen('s13', '13c') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13c')) }}<h2>Step 13c &middot; Save BL Endorsement Details</h2></summary>
    {% if despatchLocked %}
      <p class="muted">Clear the balance payment first to unlock this gate.</p>
    {% elif permissions.manage_shipping and shipping and shipping.bl_originals_received_at %}
      <p class="muted small">Save these details, then generate the printable endorsement — it states who to endorse the BL to ("Pay to the order of"), the BL/vessel/voyage, both ports, the latest PI/CI references, and the authorised signatory, exactly as it should be written or stamped on the reverse of each original BL.</p>
      <form method="post" action="/orders/{{ order.id }}/bl-endorsement">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>BL Number<input type="text" name="bl_number" value="{{ blEndorsement.bl_number or shipping.bl_number or '' }}"></label>
        <label>Vessel / Voyage<input type="text" name="vessel_voyage" placeholder="e.g. MSC MAYA / 012W" value="{{ blEndorsement.vessel_voyage or ((shipping.vessel_name or '') + ' / ' + (shipping.voyage_number or '')) | trim }}"></label>
        <label>Port of Loading<input type="text" name="port_of_loading" value="{{ blEndorsement.port_of_loading or order.port_of_loading_name or 'Chennai, India' }}"></label>
        <label>Port of Discharge<input type="text" name="port_of_discharge" value="{{ blEndorsement.port_of_discharge or order.port_of_discharge_name or order.port_of_discharge_text or '' }}"></label>
        <label>Date of Endorsement<input type="date" name="date_of_endorsement" value="{{ blEndorsement.date_of_endorsement or today() }}"></label>
        {{ stepBadge('13c') | safe }}<button type="submit" class="btn-sm">Save BL Endorsement Details</button>
      </form>
    {% else %}
      <p class="muted">Record the original BLs received first (Step 13b).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">print the endorsement for the courier pack</div>

  <details class="step-card" id="step-11f-bl-endorsement-generate"{{ flow.subCardOpen('s13', '13d') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13d')) }}<h2>Step 13d &middot; Generate / Print BL Endorsement</h2></summary>
    {% if despatchLocked %}
      <p class="muted">Clear the balance payment first to unlock this gate.</p>
    {% elif blEndorsement %}
      <form method="post" action="/orders/{{ order.id }}/bl-endorsement/generate" style="margin-top:8px;">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ stepBadge('13d') | safe }}<button type="submit" class="btn-sm btn-success">Generate / Print BL Endorsement</button>
      </form>
      {% if blEndorsementDoc %}
        <p class="small" style="margin-top:6px;">
          Latest: <a href="/documents/{{ blEndorsementDoc.id }}/download?format=pdf">{{ blEndorsementDoc.document_reference }}</a>
          (generated {{ blEndorsementDoc.generated_at }})
        </p>
      {% endif %}
    {% else %}
      <p class="muted">Save BL Endorsement Details first (Step 13c).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">endorse the original BLs over to the buyer's bank</div>

  <details class="step-card" id="step-11c-bl-endorsed-mark"{{ flow.subCardOpen('s13', '13e') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13e')) }}<h2>Step 13e &middot; Mark Original BLs Endorsed by NexaCrest</h2></summary>
    {% if despatchLocked %}
      <p class="muted">Clear the balance payment first to unlock this gate.</p>
    {% elif permissions.manage_shipping and shipping and shipping.bl_originals_received_at and not shipping.bl_endorsed_at %}
      <form method="post" action="/orders/{{ order.id }}/bl-endorsed">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ stepBadge('13e') | safe }}<button type="submit" class="btn-sm">Mark Original BLs Endorsed by NexaCrest</button>
      </form>
    {% elif shipping and shipping.bl_endorsed_at %}
      <p class="muted small">Original BLs endorsed.</p>
    {% else %}
      <p class="muted">Record the original BLs received first (Step 13b).</p>
    {% endif %}
  </details>

  <div class="step-group-connector">once documents are despatched to the buyer</div>

  <details class="step-card" id="step-11g-close-order"{{ flow.subCardOpen('s13', '13f') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13f')) }}<h2>Step 13f &middot; Close Order (Document Despatch)</h2></summary>
    {% if orderClosed or order.status == 'shipped_docs_sent' %}
      <p><strong>&#10003; Documents despatched.</strong> Courier tracking: {{ shipping.courier_tracking_number or '—' }} — see Step 13g (government benefits) and 13h to mark this order fully settled.</p>
    {% elif despatchLocked %}
      <p class="muted">Clear the balance payment first to unlock this gate.</p>
    {% elif not permissions.close_orders %}
      <p class="muted">Only Export/Logistics can close this order.</p>
    {% elif closeBlockedBy.length %}
      <p class="notice notice-error">⚠ Before closing: generate and get approval for {{ closeBlockedBy | join(' and ') }} above. Close Order is blocked until then{{ ' — or override below with a reason.' if permissions.edit_locked_data else '.' }}</p>
      {% if permissions.edit_locked_data %}
      <form method="post" action="/orders/{{ order.id }}/close" onsubmit="return confirmFieldOverride(this, 'closing this order without both required documents approved');" style="border:1px solid #D9822B; padding:10px; border-radius:4px;">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="override_gate" value="1">
        <label>Courier Tracking Number *<input type="text" name="courier_tracking_number" required></label>
        <label>Reason for this override * <small class="muted">(minimum 10 characters — recorded in the audit log)</small>
          <textarea class="override-reason" name="override_reason" rows="2" required minlength="10"></textarea>
        </label>
        {{ stepBadge('13f') | safe }}<button type="submit" class="btn-sm btn-danger">Override &amp; Close Order</button>
      </form>
      {% endif %}
    {% else %}
      <form method="post" action="/orders/{{ order.id }}/close">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Courier Tracking Number *<input type="text" name="courier_tracking_number" required></label>
        {{ stepBadge('13f') | safe }}<button type="submit" class="btn-sm btn-success">Close Order — Complete Document Set Couriered to Buyer</button>
      </form>
    {% endif %}
  </details>

  <div class="step-group-connector">then the government benefits — they usually arrive after the buyer has paid</div>

  <details class="step-card" id="step-13g-benefits"{{ flow.subCardOpen('s13', '13g') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13g')) }}<h2>Step 13g &middot; Government Benefits &mdash; Claimed &amp; Received</h2><span class="fin-sub-summary">{% if benefitSettlement.waiting.length %}<span class="phase-pill warn">{{ benefitSettlement.waiting.length }} waiting for money</span>{% elif benefitSettlement.unclaimed.length %}{{ benefitSettlement.unclaimed.length }} not claimed yet{% elif benefitSettlement.undecided.length %}eligibility not answered (12b){% else %}all received or skipped{% endif %}</span></summary>
    {% if not orderClosed and order.status != 'shipped_docs_sent' %}
      <p class="muted">Not applicable until the order is complete — claims are recorded here once the documents are sent to the buyer (Step 13f) and the balance has landed.</p>
    {% else %}
    {% if benefitSettlement.undecided.length %}
      <p class="review-banner warn">&#9888; Answer the scheme eligibility first (Step 12b): {{ benefitSettlement.undecided | join(', ') }}.</p>
    {% endif %}
    {% if not canManageOrderFinancials %}
      {% set settlementLabels = { 'undecided': 'Eligibility not answered', 'skipped': 'Skipped', 'received': 'Received', 'waiting': 'Claimed — waiting for money', 'unclaimed': 'Not claimed yet' } %}
      <table class="list">
        <tr><th>Scheme</th><th>Status</th></tr>
        {% for sch in benefitSettlement.schemes %}{% if sch.settlement != 'not_eligible' %}
          <tr><td>{{ sch.scheme_name }}</td><td>{{ settlementLabels[sch.settlement] }}</td></tr>
        {% endif %}{% endfor %}
      </table>
      <p class="muted small">Recorded by users with the "Manage order financials" permission.</p>
    {% else %}
      {% set fin = financialsStep(order, exportBenefitEligibility, orderBenefitClaims, orderCostEntries, payment) %}
      {% set benefitsDisabled = '' if fin.benefitsApplicable else ' disabled' %}
      <p class="muted small">The government benefits usually arrive after the buyer has paid in full. One row per claim, plus an empty row for each eligible scheme not claimed yet: fill in the claim when you file it and the <strong>received amount when the money lands</strong>, then <strong>Save Benefits</strong> — or skip a scheme you will not claim (reason required). The order can be marked fully settled (13h) once every eligible scheme is received or skipped.</p>
      {% if not fin.benefitsApplicable %}
        <p class="review-banner warn">&#9888; Not applicable until the order is complete and the CI (balance) remittance has been received — claims are recorded here once the documents are sent to the buyer (13f) and the balance has landed.</p>
      {% elif fin.eligible.length == 0 and orderBenefitClaims.length == 0 %}
        <p class="muted">{{ 'Answer the eligibility in 12b first — eligible schemes appear here.' if fin.pending > 0 else 'No scheme is eligible on this order — nothing to claim.' }}</p>
      {% else %}
      <form method="post" action="/orders/{{ order.id }}/export-benefits/save-all">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <table class="list fin-benefits">
          <tr><th>Scheme</th><th>Claimed (&#8377;)</th><th>Received (&#8377;)</th></tr>
          {% set row = 0 %}
          {% for b in orderBenefitClaims %}
          <tr>
            <td><strong>{{ b.scheme_name }}</strong><input type="hidden" name="benefits[{{ row }}][benefit_id]" value="{{ b.id }}"><br>{% if b.received_amount != null %}<span class="badge good">Received</span>{% else %}<span class="badge">Claimed — waiting</span>{% endif %}</td>
            <td>{{ b.claimed_amount | money }}<br><span class="muted small">{{ b.reference_number or 'no ref.' }} · {{ b.claimed_at }}</span></td>
            {% if b.received_amount != null %}
            <td>{{ b.received_amount | money }}<br><span class="muted small">on {{ b.received_at }}</span></td>
            {% else %}
            <td class="fin-claim-cell">
              <input type="number" step="0.01" min="0" name="benefits[{{ row }}][received_amount]" placeholder="Amount received" aria-label="{{ b.scheme_name }} received amount">
              <input type="date" name="benefits[{{ row }}][received_at]" value="{{ today() }}" aria-label="{{ b.scheme_name }} received on">
            </td>
            {% endif %}
          </tr>
          {% set row = row + 1 %}
          {% endfor %}
          {% for sch in fin.eligible %}
            {% if sch.scheme_name not in fin.claimedNames %}
          <tr>
            <td><strong>{{ sch.scheme_name }}</strong><input type="hidden" name="benefits[{{ row }}][scheme_name]" value="{{ sch.scheme_name }}"><br><span class="badge warn">Not claimed</span></td>
            <td class="fin-claim-cell">
              <input type="number" step="0.01" min="0" name="benefits[{{ row }}][claimed_amount]" placeholder="Amount claimed" aria-label="{{ sch.scheme_name }} claimed amount"{{ benefitsDisabled }}>
              <input type="text" name="benefits[{{ row }}][reference_number]" placeholder="Shipping bill / scroll no." aria-label="{{ sch.scheme_name }} claim reference"{{ benefitsDisabled }}>
              <input type="date" name="benefits[{{ row }}][claimed_at]" value="{{ today() }}" aria-label="{{ sch.scheme_name }} claimed on"{{ benefitsDisabled }}>
            </td>
            <td class="fin-claim-cell">
              <input type="number" step="0.01" min="0" name="benefits[{{ row }}][received_amount]" placeholder="If already received" aria-label="{{ sch.scheme_name }} received amount"{{ benefitsDisabled }}>
              <input type="date" name="benefits[{{ row }}][received_at]" value="{{ today() }}" aria-label="{{ sch.scheme_name }} received on"{{ benefitsDisabled }}>
            </td>
          </tr>
          {% set row = row + 1 %}
            {% endif %}
          {% endfor %}
        </table>
        <button type="submit" class="btn-sm"{{ '' if (fin.benefitsApplicable or fin.waiting > 0) else ' disabled' }}>Save Benefits</button>
      </form>
      {% endif %}
      {# Owner request (2026-10-27): a wrongly typed claim can be corrected or deleted (reason required, audit-logged). #}
      {% if orderBenefitClaims.length and fin.benefitsApplicable %}
      <details class="fin-more-claim" id="step-13g-corrections">
        <summary class="muted small">Correct or delete a recorded claim (typed a wrong amount? fix it here — a reason is required)</summary>
        {% for b in orderBenefitClaims %}
          <div class="card-nested fin-correct-claim">
            <strong>{{ b.scheme_name }}</strong> <span class="muted small">— claimed &#8377;{{ b.claimed_amount | money }} on {{ b.claimed_at }}{% if b.received_amount != null %}, received &#8377;{{ b.received_amount | money }}{% endif %}</span>
            <form method="post" action="/orders/{{ order.id }}/export-benefits/{{ b.id }}/correct" class="field-grid">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <label>Claimed (&#8377;) *<input type="number" step="0.01" min="0.01" name="claimed_amount" required value="{{ b.claimed_amount }}"></label>
              <label>Claimed On *<input type="date" name="claimed_at" required value="{{ b.claimed_at }}"></label>
              <label>Claim Ref.<input type="text" name="reference_number" value="{{ b.reference_number or '' }}"></label>
              <label>Received (&#8377;) <small class="muted">(empty = not received yet)</small><input type="number" step="0.01" min="0" name="received_amount" value="{{ b.received_amount if b.received_amount != null else '' }}"></label>
              <label>Received On<input type="date" name="received_at" value="{{ b.received_at or today() }}"></label>
              <label class="full">Reason for the correction *<input type="text" name="reason" required minlength="10" placeholder="e.g. Typed 50,000 instead of 5,000"></label>
              <div><button type="submit" class="btn-sm">Save Correction</button></div>
            </form>
            <form method="post" action="/orders/{{ order.id }}/export-benefits/{{ b.id }}/delete" class="fin-delete-claim" onsubmit="return confirm('Delete this {{ b.scheme_name }} claim? This cannot be undone (it stays in the audit log).');">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="text" name="reason" required minlength="10" placeholder="Reason for deleting (e.g. recorded twice by mistake)" aria-label="Reason for deleting the {{ b.scheme_name }} claim">
              <button type="submit" class="btn-sm btn-danger">Delete Claim</button>
            </form>
          </div>
        {% endfor %}
      </details>
      {% endif %}
      {% if fin.benefitsApplicable %}
      <details class="fin-more-claim">
        <summary class="muted small">Record another claim (a second claim on the same scheme, or a scheme not listed above)</summary>
          <form method="post" action="/orders/{{ order.id }}/export-benefits">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Scheme *
              <select name="scheme_name" required>
                {% for opt in exportBenefitSchemes %}
                  <option value="{{ opt.option_value }}">{{ opt.option_value }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Reference Number (shipping bill / scroll no.)<input type="text" name="reference_number"></label>
            <label>Claimed Amount *<input type="text" name="claimed_amount" required></label>
            <label>Claimed On *<input type="date" name="claimed_at" value="{{ today() }}" required></label>
            <label>Currency<input type="text" name="currency_code" value="INR"></label>
            <label>Notes<input type="text" name="notes"></label>
            <button type="submit" class="btn-sm">Record Claim</button>
          </form>
      </details>
      {% endif %}

      {# Owner decision (2026-10-27): skip a scheme the company won't claim (or whose money will never come). #}
      {% set skippable = benefitSettlement.unclaimed.concat(benefitSettlement.waiting) %}
      {% if benefitSettlement.skipped.length %}
        <table class="list">
          <tr><th>Skipped scheme</th><th>Reason</th><th></th></tr>
          {% for sch in benefitSettlement.schemes %}{% if sch.settlement == 'skipped' %}
          <tr>
            <td><strong>{{ sch.scheme_name }}</strong><br><span class="badge">Skipped</span></td>
            <td class="small">{{ sch.claim_skip_reason }}</td>
            <td>
              <form method="post" action="/orders/{{ order.id }}/export-benefits/skip">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="undo">
                <input type="hidden" name="scheme_name" value="{{ sch.scheme_name }}">
                <button type="submit" class="btn-sm btn-secondary">Undo skip</button>
              </form>
            </td>
          </tr>
          {% endif %}{% endfor %}
        </table>
      {% endif %}
      {% if skippable.length %}
      <details class="fin-more-claim" id="step-13g-skip">
        <summary class="muted small">Not claiming a scheme, or its money will never come? Skip it here (reason required)</summary>
        <form method="post" action="/orders/{{ order.id }}/export-benefits/skip" class="field-grid">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Scheme
            <select name="scheme_name">
              {% for name in skippable %}<option value="{{ name }}">{{ name }}</option>{% endfor %}
              {% if skippable.length > 1 %}<option value="">All {{ skippable.length }} still open</option>{% endif %}
            </select>
          </label>
          <label class="full">Reason *<input type="text" name="reason" required minlength="10" placeholder="e.g. Below the minimum claim amount — not worth filing"></label>
          <div><button type="submit" class="btn-sm btn-secondary">Skip — not claiming</button></div>
        </form>
      </details>
      {% endif %}
    {% endif %}
    {% if not benefitSettlement.done and order.status == 'shipped_docs_sent' and permissions.close_orders and permissions.edit_locked_data %}
      <details>
        <summary class="small">Override &amp; fully settle anyway (a benefit genuinely never arriving)</summary>
        <form method="post" action="/orders/{{ order.id }}/mark-fully-settled" onsubmit="return confirmFieldOverride(this, 'fully settling this order with a benefit claim still outstanding');" style="border:1px solid #D9822B; padding:10px; border-radius:4px;">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="override_gate" value="1">
          <label>Reason for this override * <small class="muted">(minimum 10 characters — recorded in the audit log)</small>
            <textarea class="override-reason" name="override_reason" rows="2" required minlength="10"></textarea>
          </label>
          <button type="submit" class="btn-sm btn-danger">Override &amp; Mark Fully Settled</button>
        </form>
      </details>
    {% endif %}
    {% endif %}
  </details>

  <div class="step-group-connector">last — once every benefit is received or skipped</div>

  <details class="step-card" id="step-despatch"{{ flow.subCardOpen('s13', '13h') }}>
    <summary>{{ stepStatusIcon(flow.subStepStatus('s13', '13h')) }}<h2>Step 13h &middot; Mark Fully Settled</h2></summary>
    {% if orderClosed %}
      <p><strong>&#10003; Order fully settled and closed.</strong> Courier tracking: {{ shipping.courier_tracking_number or '—' }}</p>
    {% elif order.status == 'shipped_docs_sent' %}
      <p><strong>&#10003; Documents sent to buyer.</strong> Courier tracking: {{ shipping.courier_tracking_number or '—' }} — this order now shows as done to the client, but stays open internally for government export benefits (see Order Financials above).</p>
      {% if permissions.close_orders %}
      <form method="post" action="/orders/{{ order.id }}/mark-fully-settled" onsubmit="return confirm('Mark this order fully settled and close it? This is the final, locked close.');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ stepBadge('13h') | safe }}<button type="submit" class="btn-sm btn-success">Mark Fully Settled</button>
      </form>
      <p class="muted small">Blocked until Step 13g is done — every eligible government export benefit received, or skipped with a reason.</p>
      {# Owner decision (2026-10-27): unpaid supplier / logistics bills are a warning here, not a block — accounts may settle vendor bills later. #}
      {% set unpaidBills = vendorBillsView.unpaid(vendorBills) %}
      {% if unpaidBills.length %}
        <p class="review-banner warn" id="unpaid-vendor-bills-warning">&#9888; {{ unpaidBills.length }} vendor bill{{ '' if unpaidBills.length == 1 else 's' }} still unpaid: &#8377;{{ vendorBillsView.totals(unpaidBills).total | money }}
          ({% for b in unpaidBills %}{{ 'Supplier' if b.vendor_kind == 'supplier' else (b.partner_name or 'Logistics') }} {{ b.bill_no }}{% if not loop.last %}, {% endif %}{% endfor %}) — you can still mark the order fully settled.</p>
      {% endif %}
      {% if permissions.edit_locked_data %}
      <details>
        <summary class="small">Override &amp; fully settle anyway (benefit genuinely never arriving)</summary>
        <form method="post" action="/orders/{{ order.id }}/mark-fully-settled" onsubmit="return confirmFieldOverride(this, 'fully settling this order with a benefit claim still outstanding');" style="border:1px solid #D9822B; padding:10px; border-radius:4px;">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="override_gate" value="1">
          <label>Reason for this override * <small class="muted">(minimum 10 characters — recorded in the audit log)</small>
            <textarea class="override-reason" name="override_reason" rows="2" required minlength="10"></textarea>
          </label>
          <button type="submit" class="btn-sm btn-danger">Override &amp; Mark Fully Settled</button>
        </form>
      </details>
      {% endif %}
      {% else %}
      <p class="muted">Only Export/Logistics can mark this order fully settled.</p>
      {% endif %}
    {% else %}
      <p class="muted">Close the order first (Step 13f).</p>
    {% endif %}
  </details>

  </details>

  <details class="step-card" id="step-complete"{{ stepCardOpen('s19') }}>
    <summary>{{ stepStatusIcon(stepStates['s19']) }}<span class="step-group-num">STEP 19</span><h2>Order Complete</h2></summary>
    {% if orderClosed %}
    <p><strong>&#10003; This order is fully settled and closed.</strong> Nothing further is needed.</p>
