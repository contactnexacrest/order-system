    {% endif %}
  </details>

  </details>

  {% set aftersalesBadges %}{% if openComplaintCount > 0 %}<span class="phase-pill warn">{{ openComplaintCount }} open complaint{{ '' if openComplaintCount == 1 else 's' }}</span>{% endif %}{% if openDisputeCount > 0 %}<span class="phase-pill warn">{{ openDisputeCount }} open dispute{{ '' if openDisputeCount == 1 else 's' }}</span>{% endif %}{% endset %}
  {% set ph = flow.phase('aftersales') %}
