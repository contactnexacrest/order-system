{#
  Owner decision D-273 (point 17): one row of the order page's compact products table (goods,
  or a charge / service line). In: p (the line), plus the order page's context.
  Port of the $__row closure in views/orders/_products_table.php.
#}
{% set lc = linePricing.lines[p.id] %}{% set rowChips = lineChips[p.id] or [] %}{% set rowCopyOf = copyOf[p.id] %}
<tr id="line-{{ p.id }}" class="{{ 'line-copied' if p.id == copiedLineId else '' }}">
  <td>{{ p.line_no }}</td>
  <td class="line-desc">
    <strong>{{ p.description }}</strong>{% if rowCopyOf %} <span class="muted">— copy of line {{ rowCopyOf }}</span>{% endif %}
    {% if (p.line_type or 'goods') != 'goods' %} <span class="muted small">({{ lineTypes[p.line_type] }})</span>{% endif %}
    {% if rowChips.length %}
      <div class="option-chips">{% for chip in rowChips %}<span class="chip{{ ' chip-gone' if chip.gone else '' }}">{{ chip.name }}</span>{% endfor %}</div>
    {% endif %}
    {% if p.finish and not rowChips.length %}<div class="muted small">{{ p.finish }}</div>{% endif %}
  </td>
  <td>{% if p.as_per_annexure and p.as_per_annexure != '0' %}<span class="muted">As per annexure</span>{% else %}{{ p.dimensions or '' }}{% endif %}{% if p.pieces_count %}<div class="muted small">{{ (p.pieces_count | int).toLocaleString('en-US') }} pcs</div>{% endif %}{% if p.size_note %}<div class="muted small">{{ p.size_note }}</div>{% endif %}</td>
  <td class="num">{{ 'To Be Confirmed' if p.quantity_is_tbc else (p.quantity if p.quantity != null else '') }}</td>
  <td>{{ p.unit or '' }}</td>
  {% if sees.selling %}
    <td class="num">{{ (p.unit_price | money) if p.unit_price != null else 'To Be Confirmed' }}{% if pricedAt and pricedAt[p.id] %}<div class="muted small priced-at">{{ pricedAt[p.id] }}</div>{% endif %}</td>
    <td class="num">{{ (p.fob_value | money) if p.fob_value != null else 'To Be Confirmed' }}</td>
    <td class="line-check">{% include "orders/_line_price.njk" %}
      {# Owner decision D-374: today's price differs from the line's — one click takes it (only while prices are not fixed). #}
      {% if canEditProducts and not pricesFixed and lc and not lc.fixed and lc.figures and (p.unit_price == null or ((p.unit_price | float) - (lc.figures.quote | float | round(2))) | abs > 0.004) %}
        <form method="post" action="/orders/{{ order.id }}/products/{{ p.id }}/todays-price" class="inline-form todays-price">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {% if productReasonRequired %}<input type="text" name="reason" placeholder="Reason (required)" required minlength="10" aria-label="Reason">{% endif %}
          <button type="submit" class="btn-sm btn-secondary" title="Today's rate gives this price; nothing changes until you click">Use today's price ({{ lc.figures.quote | money }})</button>
        </form>
      {% endif %}
    </td>
  {% endif %}
  {% if canEditProducts %}
    <td class="line-actions">
      <button type="button" class="btn-sm btn-secondary" data-open-panel="line-panel-{{ p.id }}">Edit</button>
      <form method="post" action="/orders/{{ order.id }}/products/{{ p.id }}/duplicate" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if productReasonRequired %}<input type="text" name="reason" placeholder="Reason (required)" required minlength="10" aria-label="Reason">{% endif %}
        <button type="submit" class="btn-sm btn-secondary" title="An exact copy right below — every option, the size, the product; the MD's approval is not copied">Duplicate</button>
      </form>
      <form method="post" action="/orders/{{ order.id }}/products/{{ p.id }}/delete" class="inline-form" data-confirm="Remove line {{ p.line_no }}?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if productReasonRequired %}<input type="text" name="reason" placeholder="Reason (required)" required minlength="10" aria-label="Reason">{% endif %}
        <button type="submit" class="btn-sm btn-danger">Delete</button>
      </form>
    </td>
  {% endif %}
</tr>
