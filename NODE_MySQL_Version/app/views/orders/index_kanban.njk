{# Owner hard rule 2026-11-01: the same filters and the same cards as the Standard list (orders/_filters.njk, orders/_card.njk). #}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Orders — Kanban Board</h1>
      <p class="muted" style="margin:0;">{{ counts.all }} total &middot; {{ totalActive }} active &middot; every order where it actually sits in the pipeline.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn btn-accent" href="/clients">Go to Clients to start a new order</a>
      <a class="btn-sm btn-secondary" href="/orders?view=list&amp;status={{ statusFilter or 'all' }}">Switch to list view</a>
      {% if permissions.view_archived_orders %}<a class="btn-sm btn-secondary" href="/orders/archived">View Archived Orders</a>{% endif %}
    </div>
  </div>

  {% set listOfBoard = false %}{% include "orders/_filters.njk" %}

  <div class="kanban-board">
    {% for col in columns %}
      <div class="kanban-column" data-column="{{ col.key }}">
        <div class="kanban-column-header">
          <span class="kanban-column-title">{% if col.stage %}Stage {{ col.stage }} &middot; {% endif %}{{ col.title }}</span>
          <span class="kanban-column-count">{{ col.orders.length }}</span>
        </div>
        {% if not col.orders.length %}
          <p class="kanban-column-empty">No orders here</p>
        {% else %}
          {% for o in col.orders %}{% set kanbanCard = true %}{% include "orders/_card.njk" %}{% endfor %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
