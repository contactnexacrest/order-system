{#
  "Pick from Products" on an order line (D-240). Owner decision D-245 P2: picking a product
  fills the description, HS code, unit and — on a USD order, for people who may see selling
  prices — the quote price of whoever sells the order (staff, or the client's associate at
  their commission level). The price stays editable; its floor travels with it as data-floor.
  In: pickerProducts, pickerPrices (empty for people who may not see selling prices),
      pickerName, pickerSelected, sees, optional pickerCurrency and pickerKey ("staff" /
      "L<level id>"); on the New Order form the currency and client selects are read instead.
  Port of views/orders/_product_picker.php.
#}
<label class="full">Pick from Products <small class="muted">{{ '(needed for a goods line on a USD order — fills the line; you can still change anything)' if pickRequiredWhen else '(optional — fills the line; you can still change anything)' }}</small>
  <select name="{{ pickerName }}" class="product-picker"{% if pickerOrderId %} data-order-id="{{ pickerOrderId }}"{% endif %}{% if pickerCurrency %} data-order-currency="{{ pickerCurrency }}"{% endif %}{% if pickerKey %} data-price-key="{{ pickerKey }}"{% endif %}{% if sees.selling %} data-selling="1"{% endif %}{% if pickRequiredWhen %} data-required-when="{{ pickRequiredWhen }}" data-required-when-message="Pick this goods line from Products — on a USD order goods lines cannot be typed by hand (service and charge lines can)."{% endif %}>
    <option value="">— Type the line by hand —</option>
    {# D-435: grouped by brand › main category › sub-category when there is more than one group (the list is sorted by group). #}
    {% set grouped = pickerProducts and pickerProducts.length > 1 and (pickerProducts[0].group or '') != (pickerProducts[pickerProducts.length - 1].group or '') %}
    {% for pp in pickerProducts %}
      {% set prevGroup = (pickerProducts[loop.index0 - 1].group or '') if loop.index0 > 0 else null %}
      {% if grouped and (loop.first or (pp.group or '') != prevGroup) %}{% if not loop.first %}</optgroup>{% endif %}<optgroup label="{{ pp.group if pp.group else 'Other products' }}">{% endif %}
      {% set ppPrices = pickerPrices[pp.id] if pickerPrices else null %}
      <option value="{{ pp.id }}"
        data-name="{{ pp.name }}"
        data-hs="{{ pp.hs_code }}"
        data-specs="{{ (pp.specifications or '') | truncate(200, true, '') }}"
        data-unit="{{ pp.reference_unit or '' }}"
        {% if ppPrices %}data-prices="{{ ppPrices | dump }}"{% endif %}
        {% if pickerSpecs and pickerSpecs[pp.id] %}data-spec-options="{{ pickerSpecs[pp.id] | dump }}"{% endif %}
        {# D-385: the product's "Sold as" ticks (none = every specification). #}
        {% if pickerSoldAs and pickerSoldAs[pp.id] and pickerSoldAs[pp.id].length %}data-sold-as="{{ pickerSoldAs[pp.id] | dump }}"{% endif %}
        {{ 'selected' if (pickerSelected | int) == pp.id }}>{{ pp.name }} (HS {{ pp.hs_code }})</option>
    {% endfor %}
    {% if grouped %}</optgroup>{% endif %}
    {# D-361 (mockup p7): products not offered yet stay findable, greyed, with the reason. #}
    {% if pickerBlocked and pickerBlocked.length %}
      <optgroup label="Not offered yet">
        {% for bp in pickerBlocked %}<option value="" disabled data-not-quotable="{{ bp.id }}">{{ bp.name }} — {{ bp.reason }}</option>{% endfor %}
      </optgroup>
    {% endif %}
  </select>
  <span class="muted small product-picker-hint" aria-live="polite"></span>
</label>
{# Owner decision D-255: the product's specification options (names only — never values or cost) and the chosen ones. #}
{% if not pickerNoSpecBox %}{# D-273: the side panel shows the options in its own step 2 #}
<div class="full spec-options" aria-live="polite"></div>
{% endif %}
<input type="hidden" name="{{ 'product_spec_json[]' if (pickerName | string).endsWith('[]') else 'spec_json' }}" class="spec-json" value="{{ pickerSpecSel or '' }}">
