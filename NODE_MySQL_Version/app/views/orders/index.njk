<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Orders</h1>
      <p class="muted" style="margin:0;">{{ counts.all }} total &middot; a card for every order, not a spreadsheet row.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn btn-accent" href="/clients">Go to Clients to start a new order</a>
      {% if kanbanUser %}<a class="btn-sm btn-secondary" href="/orders">Switch to board view</a>{% endif %}
      {% if permissions.view_archived_orders %}<a class="btn-sm btn-secondary" href="/orders/archived">View Archived Orders</a>{% endif %}
    </div>
  </div>

  {% set listOfBoard = kanbanUser %}{% include "orders/_filters.njk" %}

  {% if not orders or orders.length == 0 %}
    <p class="muted">No orders match this filter.</p>
  {% else %}
  <div class="card-grid">
    {% for o in orders %}{% set kanbanCard = false %}{% include "orders/_card.njk" %}{% endfor %}
  </div>
  {% if totalPages > 1 %}
  <div class="btn-row" style="justify-content:center; margin-top:16px;">
    {% if page > 1 %}<a class="btn-sm btn-secondary" href="/orders?status={{ statusFilter }}&amp;page={{ page - 1 }}{{ '&amp;view=list' | safe if kanbanUser else '' }}">&larr; Previous</a>{% endif %}
    <span class="muted small">Page {{ page }} of {{ totalPages }} ({{ totalFiltered }} orders)</span>
    {% if page < totalPages %}<a class="btn-sm btn-secondary" href="/orders?status={{ statusFilter }}&amp;page={{ page + 1 }}{{ '&amp;view=list' | safe if kanbanUser else '' }}">Next &rarr;</a>{% endif %}
  </div>
  {% endif %}
  {% endif %}
</div>
