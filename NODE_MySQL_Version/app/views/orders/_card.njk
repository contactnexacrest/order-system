{# One order card, shared by the Standard list (orders/index.njk) and the Kanban board (orders/index_kanban.njk) — owner hard rule 2026-11-01: both templates show exactly the same. Expects o, seesAllOrders, sees, kanbanCard. #}
      {% set stageTotal = 9 %}
      {% set stageNumber = o.current_stage_number or 0 %}
      {% set isLost = o.status == 'lost' %}
      {% set isShippedDocsSent = o.status == 'shipped_docs_sent' %}
      {% set isComplete = o.status == 'complete' %}
      {% set isCancelled = o.status == 'cancelled' %}
      {% set filledSegments = o.filled_segments %}
    <a class="entity-card{{ ' kanban-card' if kanbanCard else '' }}{{ ' entity-card-overdue' if o.is_overdue else '' }}" href="/orders/{{ o.id }}{{ '?from=kanban' if kanbanCard else '' }}">
      <div class="entity-card-header">
        <span class="entity-card-title">{{ o.order_reference }}</span>
        {% if o.incoterm_code %}<span class="tag tag-gold">{{ o.incoterm_code }}</span>{% endif %}
        {% if seesAllOrders and o.assignee_names %}<span class="tag tag-navy">{{ o.assignee_names }}</span>{% endif %}
      </div>
      <div class="entity-card-sub">{{ o.company_legal_name }}</div>
      <div>
        <div class="mini-stage-track">
          {% for i in range(1, stageTotal + 1) %}
            <div class="mini-stage-seg{{ ' filled' if i <= filledSegments else '' }}{{ ' lost' if ((isLost or isCancelled) and i <= filledSegments) else '' }}"></div>
          {% endfor %}
        </div>
        <div class="mini-stage-label">
          {% if isCancelled %}
            Cancelled
          {% elif isLost %}
            {{ (o.lost_reason | truncate(46)) if o.lost_reason else 'Marked lost' }}
          {% elif isComplete %}
            Stage 9 of 9 &middot; Closed
          {% elif isShippedDocsSent %}
            Stage 9 of 9 &middot; Docs Sent &mdash; Awaiting Benefits
          {% else %}
            Stage {{ stageNumber or 1 }} of {{ stageTotal }} &middot; {{ o.current_stage_name or 'Quotation' }}
          {% endif %}
        </div>
      </div>
      <div class="entity-card-footer">
        {% if o.is_overdue %}
          <span class="badge badge-lost">Overdue</span>
        {% elif isCancelled %}
          <span class="badge badge-lost">Cancelled</span>
        {% elif isLost %}
          <span class="badge badge-lost">Lost</span>
        {% elif isComplete %}
          <span class="badge badge-complete">Complete</span>
        {% elif isShippedDocsSent %}
          <span class="badge badge-complete">Docs Sent</span>
        {% else %}
          <span class="badge badge-active">Active</span>
        {% endif %}
        {% if sees.selling %}<span class="entity-card-amount">{{ o.currency_code }} {{ o.total_fob_value | money }}</span>{% endif %}
      </div>
    </a>
