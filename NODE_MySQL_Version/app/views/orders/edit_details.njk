<div class="card page-wide">
  <p class="muted small"><a href="/orders/{{ order.id }}">&larr; Back to Order</a></p>
  <h1>Edit Order Details — {{ order.order_reference }}</h1>

  {% if isPostConfirmation %}
    {% if canOverride %}
      <p class="notice notice-warning">
        This order has already reached Order Confirmation. Saving a change here will be logged as a
        post-confirmation edit — a reason is required below.
      </p>
    {% else %}
      <p class="notice notice-error">
        This order has already reached Order Confirmation — editing it now needs the
        "Edit an order after confirmation" permission. Contact an Admin, Managing Director, or
        Executive Director if this genuinely needs to change (e.g. the client requested it).
      </p>
    {% endif %}
  {% endif %}

  {% if not isPostConfirmation or canOverride %}
  <form method="post" action="/orders/{{ order.id }}/edit">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <fieldset>
      <legend>Commercial Terms</legend>
      <label>Incoterm *
        <select name="incoterm_id" required>
          {% for i in incoterms %}
            <option value="{{ i.id }}" {{ 'selected' if i.id == order.incoterm_id }}>{{ i.code }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Currency *
        <select name="currency_id" required>
          {% for cur in currencies %}
            <option value="{{ cur.id }}" {{ 'selected' if cur.id == order.currency_id }}>{{ cur.code }} — {{ cur.name }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Certificate of Origin Type
        <select name="coo_type">
          <option value="">— TBC —</option>
          {% for o in cooTypes %}
            <option value="{{ o.option_value }}" {{ 'selected' if o.option_value == order.coo_type }}>{{ o.option_value }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Buyer's Own PO Ref <small class="muted">("NIL" if none)</small>
        <input type="text" name="buyers_po_ref" value="{{ order.buyers_po_ref or '' }}">
      </label>
    </fieldset>

    <fieldset>
      <legend>Shipping</legend>
      <label>Port of Loading
        <select name="port_of_loading_id">
          <option value="">—</option>
          {% for p in loadingPorts %}
            <option value="{{ p.id }}" {{ 'selected' if p.id == order.port_of_loading_id }}>{{ p.name }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Port of Discharge <small class="muted">(select if it's a repeat port, or type a new one below)</small>
        <select name="port_of_discharge_id">
          <option value="">— Type below instead —</option>
          {% for p in dischargePorts %}
            <option value="{{ p.id }}" {{ 'selected' if p.id == order.port_of_discharge_id }}>{{ p.name }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Port of Discharge (new / not listed)
        <input type="text" name="port_of_discharge_text" value="{{ order.port_of_discharge_text or '' }}" placeholder="Buyer's nominated discharge port">
      </label>
      <label>Container Type
        <select name="container_type">
          <option value="">— TBC —</option>
          {% for o in containerTypes %}
            <option value="{{ o.option_value }}" {{ 'selected' if o.option_value == order.container_type }}>{{ o.option_value }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Est. Lead Time <small class="muted">(free text, shown on the Quotation)</small>
        <input type="text" name="est_lead_time_text" value="{{ order.est_lead_time_text or '' }}">
      </label>
    </fieldset>

    <fieldset>
      <legend>Estimated Weight &amp; Volume <small class="muted">(shown on QT/PI — actuals confirmed later at Packing List)</small></legend>
      <label>Total CBM (m&sup3;)<input type="text" name="estimated_total_cbm" value="{{ order.estimated_total_cbm or '' }}"></label>
      <label>Gross Weight (kg)<input type="text" name="estimated_gross_weight_kg" value="{{ order.estimated_gross_weight_kg or '' }}"></label>
      <label>Net Weight (kg)<input type="text" name="estimated_net_weight_kg" value="{{ order.estimated_net_weight_kg or '' }}"></label>
      <label>No. of Packages / Crates<input type="text" name="estimated_package_count" value="{{ order.estimated_package_count or '' }}"></label>
      <label>Package Type<input type="text" name="estimated_package_type" value="{{ order.estimated_package_type or '' }}"></label>
    </fieldset>

    <fieldset>
      <legend>Indicative Freight / Insurance <small class="muted">(only relevant when Incoterm is not FOB)</small></legend>
      <label>Freight — low<input type="text" name="indicative_freight_low" value="{{ order.indicative_freight_low or '' }}"></label>
      <label>Freight — high<input type="text" name="indicative_freight_high" value="{{ order.indicative_freight_high or '' }}"></label>
      <label>Insurance (indicative)<input type="text" name="indicative_insurance_amount" value="{{ order.indicative_insurance_amount or '' }}"></label>
    </fieldset>

    <fieldset>
      <legend>Special Requirements</legend>
      <textarea name="special_requirements" rows="2">{{ order.special_requirements or '' }}</textarea>
    </fieldset>

    <p class="muted small">
      Payment terms (advance/balance %, balance trigger, balance days) aren't edited here — use
      <a href="/orders/{{ order.id }}/amendments">Amendments</a> for those.
    </p>

    {% if isPostConfirmation %}
      <fieldset>
        <legend>Reason <small class="muted">(required — this order has already reached Order Confirmation)</small></legend>
        <textarea name="reason" rows="2" placeholder="Why is this changing now, after confirmation? (e.g. client requested a change)" required minlength="10"></textarea>
      </fieldset>
    {% endif %}

    <button type="submit">{{ 'Override & Save' if isPostConfirmation else 'Save Changes' }}</button>
  </form>
  {% endif %}
</div>
