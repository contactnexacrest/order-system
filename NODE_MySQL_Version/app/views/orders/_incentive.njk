{#
  Port of _incentive.php. Step 12d · Team Incentive. Owner decision 2026-10-30; reworked by D-245 P4
  (4 Nov 2026, mockup q2): the order's team incentive (global rule, % of profit or a fixed amount set by
  the MD with a reason), who gets it, the state Open → Ready to lock → Locked → Paid (the MD locks;
  nothing locks by itself) and the history of every change. Shown to manage_incentives and (read-only)
  view_price_buildup; only manage_pricing (incentiveCanEdit) changes or locks it.
#}
{% set inc = incentiveRow %}
{% set calc = incentiveCalc %}
{% set teamOn = incentiveProgramOn if incentiveProgramOn is defined else true %}
{% set st = calc.state %}
{% set locked = st == 'locked' or st == 'paid' %}
{% set edit = incentiveCanEdit and not locked %}
{% set stateText = { 'open': 'Open — can be changed', 'ready': 'Ready to lock', 'locked': 'Locked', 'paid': 'Paid — can never change' } %}
{% set stateClass = { 'open': 'badge-info', 'ready': 'badge-warning', 'locked': 'badge-success', 'paid': 'badge-success' } %}
{% set est = ' <small class="muted">(estimated)</small>' if (calc.estimated and not locked) else '' %}
{% set rule = calc.rule %}
<details class="step-card" id="financials-12d">
  <summary><h2>Step 12d &middot; Team Incentive</h2>
    <span class="fin-sub-summary">&#8377;{{ (inc.team_total_inr if locked else calc.team_total) | money }} · {{ stateText[st] }}</span></summary>
  <p class="muted small">Only the MD, the ED and people with "Manage team incentives" see this box{{ ' (read-only for you — only the MD changes or locks it)' if not incentiveCanEdit }}. The team sees only their own amounts, once the order is locked.{{ ' The team incentive program is off: no global incentive — the MD may still set one by hand for this order.' if not teamOn }}</p>
  <p><span class="badge {{ stateClass[st] }}">{{ stateText[st] }}</span>
    {% if st == 'open' %}<small class="muted">{{ incentiveReadyReason }}</small>{% endif %}</p>

  {% if locked %}
    <div class="kv-grid">
      <div><span class="k">Locked</span><span class="v">{{ inc.locked_at | shortDate }}</span></div>
      <div><span class="k">Buyer fully paid on</span><span class="v">{{ inc.fully_paid_on | shortDate }}</span></div>
      <div><span class="k">Staff payout run</span><span class="v">{{ incentive.monthLabel(inc.incentive_month) }}</span></div>
      <div><span class="k">Profit used for the incentive</span><span class="v">&#8377;{{ inc.profit_basis_inr | money }}</span></div>
      <div><span class="k">Team incentive</span><span class="v">&#8377;{{ inc.team_total_inr | money }}</span></div>
      {% if inc.associate_id %}
        <div><span class="k">Associate commission</span><span class="v">{{ inc.associate_currency }} {{ inc.associate_amount_fc | money }} (&#8377;{{ inc.associate_amount_inr | money }})</span></div>
      {% endif %}
    </div>
    <table class="list" style="margin-top:10px">
      <tr><th>Person</th><th>Role</th><th>Amount (&#8377;)</th><th>Status</th></tr>
      {% for p in incentivePayouts %}
        <tr>
          <td>{{ p.user_name or p.associate_name or '—' }}</td>
          <td>{{ incentive.roleLabel(p.role) }}</td>
          <td>{% if p.amount_fc !== null %}{{ p.currency_code }} {{ p.amount_fc | money }} · {% endif %}{{ p.amount_inr | money }}</td>
          <td>{% if p.status == 'paid' %}Paid {{ p.paid_on | shortDate }}{% else %}Due{% if p.payout_run_on %} — {{ p.payout_run_on | shortDate }} run{% endif %}{% endif %}</td>
        </tr>
      {% endfor %}
      {% if incentivePayouts.length == 0 %}<tr><td colspan="4" class="muted">No incentive on this order.</td></tr>{% endif %}
    </table>
    {# D-259 #}
    {% if incentiveKept and incentiveKept.length %}
      <table class="list" style="margin-top:6px">
        <tr><th>Person</th><th>Role</th><th>By share (&#8377;)</th><th>Gets (&#8377;)</th><th>Kept by company</th></tr>
        {% for k in incentiveKept %}
          <tr><td>{{ k.user_name }}</td><td>{{ incentive.roleLabel(k.role) }}</td>
            <td>{{ k.by_share_inr | money }}</td><td>{{ k.paid_inr | money }}</td>
            <td>{{ k.kept_inr | money }} &mdash; {{ k.kept_note }}</td></tr>
        {% endfor %}
        <tr><td colspan="4"><strong>Kept by company</strong></td><td><strong>{{ ((inc.kept_not_eligible_inr | float) + (inc.kept_capped_inr | float)) | money }}</strong> (not eligible {{ inc.kept_not_eligible_inr | money }} &middot; capped {{ inc.kept_capped_inr | money }})</td></tr>
      </table>
    {% endif %}
    {% if calc.associate %}{% set c = calc.associate %}
      <details style="margin-top:8px"><summary class="small">Associate commission statement</summary>{% include "associate_portal/_statement.njk" %}</details>
    {% endif %}
    {% if incentiveCanEdit and st == 'locked' %}
      <form method="post" action="/orders/{{ order.id }}/incentive/recalculate" style="margin-top:8px">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Reason for unlocking * <input type="text" name="unlock_reason" required minlength="10" maxlength="500" placeholder="e.g. A buyer claim came in after locking; the amount must change"></label>
        <button type="submit" class="btn-sm btn-secondary">Unlock</button>
        <span class="muted small">Possible until anything of this order is paid.</span>
      </form>
    {% endif %}
  {% else %}
    <div class="kv-grid">
      <div><span class="k">Order profit before incentives{{ est | safe }}</span><span class="v">&#8377;{{ calc.profit_before | money }}</span></div>
      {% if calc.associate %}{% set a = calc.associate %}
        <div><span class="k">&minus; Associate commission ({{ a.name }}, {{ a.level_label }}{{ ' — none: not paid in full' if a.state == 'unpaid' }})</span><span class="v">&#8377;{{ a.amount_inr | money }}</span></div>
      {% endif %}
      <div><span class="k">Profit used for the incentive{{ est | safe }}</span><span class="v">&#8377;{{ calc.basis | money }}{% if calc.basis_raw < 0 %} <small class="muted">(never below 0; &#8377;{{ calc.basis_raw | money }} so far)</small>{% endif %}</span></div>
      <div><span class="k">Global rule</span><span class="v">{% if teamOn %}{{ calc.global_text }} → &#8377;{{ calc.global_amount | money }}{% else %}program off — none{% endif %}</span></div>
      <div><span class="k"><strong>Team incentive for this order</strong></span><span class="v"><strong>&#8377;{{ calc.amount | money }}</strong> <small class="muted">{{ incentiveRuleText }}</small></span></div>
      <div><span class="k">Profit left for NexaCrest</span><span class="v">&#8377;{{ calc.left_for_company | money }}{% if calc.margin_after_pct !== null %} <small class="muted">(margin {{ calc.margin_after_pct | money }}%)</small>{% endif %}</span></div>
    </div>
    {% if calc.over_profit %}
      <p class="review-banner bad">The team incentive is more than the order's profit after the associate's commission — lower it; the order cannot be locked like this.</p>
    {% elif calc.margin_warning %}
      <p class="review-banner warn">&#9888; Margin after the incentive is {{ calc.margin_after_pct | money }}%, below your minimum margin of {{ calc.min_margin_pct | money }}% — allowed, but check it.</p>
    {% endif %}
    {% if calc.incentive_cut_usd > 0 %}
      <p class="muted small">Lines the MD approved below the floor lowered this order's profit (USD {{ calc.incentive_cut_usd | money }} of incentive reserve on the price check). The incentive is a % of the actual profit, so that is already counted — it is not taken off a second time.</p>
    {% endif %}
    {% if calc.associate %}{% set c = calc.associate %}
      <details style="margin-top:8px"><summary class="small">Associate commission statement</summary>{% include "associate_portal/_statement.njk" %}</details>
    {% endif %}

    {% if edit %}
    <form method="post" action="/orders/{{ order.id }}/incentive" style="margin-top:10px">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <h3 style="font-size:.95em">Change for this order only</h3>
      <div class="row">
        <label>How it is set
          <select name="incentive_mode">
            <option value="global"{{ ' selected' if rule.mode == 'global' }}>Global rule{{ '' if teamOn else ' (program off: none)' }}</option>
            <option value="pct"{{ ' selected' if rule.mode == 'pct' }}>% of this order's profit</option>
            <option value="fixed"{{ ' selected' if rule.mode == 'fixed' }}>Fixed amount (&#8377;)</option>
          </select></label>
        <label>% or amount <input type="number" name="incentive_value" min="0" step="0.01" value="{{ rule.value | pct2 if rule.value !== null else '' }}" placeholder="e.g. 25 or 100000" data-required-when="incentive_mode=fixed" data-required-when-message="Enter the amount for this order."></label>
      </div>
      <label>Reason <small class="muted">(needed when the amount changes; at least 10 characters)</small>
        <input type="text" name="incentive_reason" minlength="10" maxlength="500" value="{{ rule.reason or '' }}" placeholder="e.g. Large first order, the team worked weekends on samples"></label>
      {% if incentiveHasAssociate or (inc and inc.associate_id) %}
      <label>Associate commission on this order
        <select name="associate_mode">
          {% for v, l in { 'auto': 'Automatic (10 days from the client\'s first PO)', 'yes': 'Yes — MD only, with a reason', 'no': 'No' } %}
            <option value="{{ v }}"{{ ' selected' if ((inc.associate_mode if inc else 'auto') or 'auto') == v }}>{{ l }}</option>
          {% endfor %}
        </select>
      </label>
      {# Owner decision D-245 P3: forcing commission on (a repeat order) is the MD's decision, with a written reason. #}
      <label>Reason for forcing "Yes" <small class="muted">(MD only; at least 10 characters)</small>
        <input type="text" name="associate_mode_reason" minlength="10" maxlength="300" value="{{ (inc.associate_mode_reason if inc else '') or '' }}" placeholder="e.g. Buyer introduced before the registration was recorded" data-required-when="associate_mode=yes" data-required-when-message="Say why commission is forced on for this order (at least 10 characters)."></label>
      {% else %}{# owner point 10 (2 Nov): no associate select, but Save keeps the saved mode #}
      <input type="hidden" name="associate_mode" value="{{ (inc.associate_mode if inc else 'auto') or 'auto' }}">
      {% endif %}
      <button type="submit" class="btn-sm">Save</button>
    </form>
    {% endif %}

    <h3 style="font-size:.95em">Who gets it</h3>
    <form method="post" action="/orders/{{ order.id }}/incentive/people">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <table class="list">
        <tr><th>Gets it?</th><th>Role</th><th>Usual share</th><th>Person(s)</th><th>Share on this order</th><th>Amount (&#8377;)</th></tr>
        {% for r in incentiveRoleList %}
          <tr>
            <td><input type="checkbox" name="gets_it[{{ r.key }}]" value="1"{{ ' checked' if r.ticked }}{{ '' if edit else ' disabled' }} aria-label="{{ r.label }} gets it"></td>
            <td>{{ r.label }}</td>
            <td>{{ r.usual_pct | pct2 }}%</td>
            <td>{% if r.people.length == 0 %}<span class="muted">nobody — its share goes to the others</span>{% else %}{{ r.people | pluck('name') | join(', ') }}{% endif %}</td>
            <td>{% if edit %}<input type="number" name="share_pct[{{ r.key }}]" min="0" max="100" step="0.01" style="width:6em" value="{{ (r.custom_pct if r.custom_pct !== null else r.pct) | pct2 }}" aria-label="{{ r.label }} share on this order" placeholder="e.g. 30">{% else %}{{ ((r.pct | pct2) + '%') if r.gets_it else '—' }}{% endif %}</td>
            <td>{% if r.gets_it %}{{ r.amount | money }}{% if r.people.length > 1 %} ({{ r.each | money }} each){% endif %}{% else %}—{% endif %}</td>
          </tr>
        {% endfor %}
        <tr><td colspan="5"><strong>Total paid to the team</strong></td><td><strong>{{ calc.team_total | money }}</strong></td></tr>
      </table>
      {% if calc.per_person.length %}
        <p class="small"><strong>Per person:</strong> {% for p in calc.per_person %}{{ p.name }} &#8377;{{ p.amount | money }}{{ ' · ' if not loop.last }}{% endfor %}</p>
      {% endif %}
      {# D-259 (owner approval 6 Nov 2026): each person's share, what they get and what the company keeps. #}
      {% if calc.lines and calc.team_by_share > 0 %}
        <table class="list" style="margin-top:6px" id="incentive-kept-{{ order.id }}">
          <tr><th>Person</th><th>Role</th><th>By share (&#8377;)</th><th>Gets (&#8377;)</th><th>Kept by company</th></tr>
          {% for l in calc.lines %}{% if l.by_share > 0 %}
            <tr><td>{{ l.name }}</td><td>{{ l.role_label }}</td>
              <td>{{ l.by_share | money }}</td><td>{{ l.gets | money }}</td>
              <td>{% if l.kept > 0 %}{{ l.kept | money }} &mdash; {{ l.note }}{% else %}&mdash;{% endif %}</td></tr>
          {% endif %}{% endfor %}
          <tr><td colspan="2"><strong>Total</strong></td><td><strong>{{ (calc.team_by_share or 0) | money }}</strong></td><td><strong>{{ calc.team_total | money }}</strong></td>
            <td><strong>{{ (calc.kept_total or 0) | money }} kept by company</strong>{% if calc.kept_total > 0 %} (not eligible {{ calc.kept_not_eligible | money }} &middot; capped {{ calc.kept_capped | money }}){% endif %}</td></tr>
        </table>
        {% if calc.kept_total > 0 %}<p class="muted small">The company's incentive cost on this order is &#8377;{{ calc.team_total | money }}, not &#8377;{{ calc.team_by_share | money }}. Other people's amounts are not raised.</p>{% endif %}
      {% endif %}
      {% if calc.unallocated > 0 %}<p class="small">&#8377;{{ calc.unallocated | money }} has nobody to go to and is not paid. Tick a role with people, or give staff their incentive roles in Team Incentives.</p>{% endif %}
      {% if edit %}
        <label><input type="checkbox" name="shares_customised" value="1"{{ ' checked' if calc.shares_customised }}> Use the shares typed above (they must add up to 100% over the ticked roles); otherwise unticked shares spread over the ticked roles in proportion.</label>
        <details style="margin-top:6px">
          <summary class="small">Change who did each role on this order</summary>
          <table class="list">
            <tr><th>Person</th>{% for r in incentiveRoleList %}<th>{{ r.label }}</th>{% endfor %}</tr>
            {% for u in incentiveUsers %}
              <tr><td>{{ u.name }}</td>
                {% for r in incentiveRoleList %}
                  <td><input type="checkbox" name="people[{{ r.key }}][]" value="{{ u.id }}"{{ ' checked' if (u.id in (r.people | pluck('id'))) }} aria-label="{{ u.name }} — {{ r.label }}"></td>
                {% endfor %}
              </tr>
            {% endfor %}
          </table>
        </details>
        <label>Note <small class="muted">(optional)</small> <input type="text" name="people_note" maxlength="500" placeholder="e.g. Export Executive handled sales and documents alone"></label>
        <label><input type="checkbox" name="reset" value="1"> Go back to the usual roles, shares and people</label>
        <button type="submit" class="btn-sm">Save who gets it</button>
      {% endif %}
    </form>

    {% if incentiveCanEdit and st == 'ready' %}
      <form method="post" action="/orders/{{ order.id }}/incentive/lock" data-confirm="Lock this order's incentive? The team is paid in the next payout run." style="margin-top:8px">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm">Lock incentive</button>
      </form>
    {% endif %}
  {% endif %}

  {% set actionText = { 'amount': 'Amount', 'people': 'Who gets it', 'lock': 'Locked', 'unlock': 'Unlocked', 'associate_mode': 'Associate commission' } %}
  {% if incentiveHistory and incentiveHistory.length %}
    <h3 style="font-size:.95em">History</h3>
    <table class="list">
      <tr><th>When</th><th>Who</th><th>What</th><th>Before → after</th><th>Reason</th></tr>
      {% for h in incentiveHistory %}
        <tr><td>{{ h.changed_at | shortDate }} {{ h.changed_at | timeHm }}</td>
          <td>{{ h.changed_by_name or '' }}</td>
          <td>{{ actionText[h.action] or h.action }}</td>
          <td>{% if h.before_value %}{{ h.before_value }} → {% endif %}{{ h.after_value or '' }}</td>
          <td>{{ h.reason or '' }}</td></tr>
      {% endfor %}
    </table>
  {% endif %}
  <p class="muted small">Open: changes any time. Ready to lock: the buyer has fully paid and no claim is open. Locked by the MD: fixed and added to the order's costs; unlock with a reason until anything is paid. Paid: never changes.</p>
</details>
