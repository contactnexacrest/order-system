{# Owner decision D-257 Phase 4: one merchant trade deal — stages, the deal, the goods (buy and sell), the BL / switch BL, money on both legs and the margin, the RBI checks and the AD bank's document checklist. #}
<div class="card page-wide" data-testid="mtt-show">
  <p><a href="/merchant">&larr; Merchant trade deals</a></p>
  <h1>{{ d.reference }} <span class="badge">{{ stageLabel }}</span></h1>
  <p class="muted">{{ d.supplier_name }} ({{ d.supplier_country }}, in {{ d.purchase_currency }}) → {{ d.buyer_name }} ({{ d.buyer_country }}, in {{ d.sale_currency }}) · goods from {{ d.origin_country }} · PO {{ d.po_no }}{% if d.sale_invoice_no %} · invoice {{ d.sale_invoice_no }}{% endif %}</p>

  <ol class="stage-strip" data-testid="mtt-stages" style="display:flex;flex-wrap:wrap;gap:6px 18px;padding-left:18px;">
    {% for st in stages %}<li{% if st.cls == 'current' %} style="font-weight:700"{% elif st.cls == 'done' %} style="color:#2D7D56"{% else %} style="color:#8A94A6"{% endif %}>{{ st.label }}</li>{% endfor %}
  </ol>

  {% if next %}
  <div class="section" data-testid="mtt-next">
    {% if blockers.length %}
      <p><strong>Before moving on to {{ nextLabel }}:</strong></p>
      <ul>{% for b in blockers %}<li>{{ b }}</li>{% endfor %}</ul>
    {% elif canEdit %}
      <form method="post" action="/merchant/{{ id }}/advance"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="from_stage" value="{{ stage }}">
        <button type="submit" class="btn">Move on to {{ nextLabel }}</button>
      </form>
    {% endif %}
  </div>
  {% endif %}

  <div class="section" id="mtt-rbi" data-testid="mtt-rbi">
    <h2>RBI checks</h2>
    <p class="muted">Limits from the Merchant Trade settings, to be confirmed with the AD bank and the CA.</p>
    <ul>
      {% for c in checks %}<li data-check="{{ c.key }}" data-level="{{ c.level }}"><strong>{{ c.label }}:</strong> <span style="{{ c.style }}">{{ c.text }}</span></li>{% endfor %}
    </ul>
  </div>

  <div class="section" id="mtt-deal">
    <h2>Deal</h2>
    {% if canEdit and stage == 'contracted' %}
    <form method="post" action="/merchant/{{ id }}/deal" class="field-grid">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% include "merchant/_deal_fields.njk" %}
      <p><button type="submit" class="btn-secondary">Save</button></p>
    </form>
    {% else %}
    <p>Deal date {{ d.deal_date }} · buy {{ d.purchase_incoterm or '—' }} · sell {{ d.sale_incoterm or '—' }} · {{ d.port_of_loading or '—' }} → {{ d.port_of_discharge or '—' }}</p>
    {% endif %}
    <form method="post" action="/merchant/{{ id }}/document" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="kind" value="po"><button type="submit" class="btn-secondary">Download purchase order (PDF)</button></form>
    <span class="muted">{% if d.po_generated_at %}Generated {{ d.po_generated_at }}.{% else %}Not generated yet.{% endif %}</span>
  </div>

  <div class="section" id="mtt-lines">
    <h2>Goods</h2>
    <table class="list" data-testid="mtt-lines">
      <tr><th>#</th><th>Description</th><th>HS code</th><th>Qty</th><th>Unit</th><th>Buy {{ d.purchase_currency }}</th><th>Buy amount</th><th>Sell {{ d.sale_currency }}</th><th>Sell amount</th><th></th></tr>
      {% for l in lines %}
      <tr>
        <td>{{ loop.index }}</td><td>{{ l.description }}</td><td>{{ l.hsn_code }}</td><td>{{ l.qty_fmt }}</td><td>{{ l.unit }}</td>
        <td>{{ l.buy_fmt }}</td><td>{{ l.buy_amount_fmt }}</td><td>{{ l.sell_fmt }}</td><td>{{ l.sell_amount_fmt }}</td>
        <td>{% if canEdit and stage == 'contracted' %}<form method="post" action="/merchant/{{ id }}/lines/{{ l.id }}/delete" data-confirm="Remove this line?"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-link">Remove</button></form>{% endif %}</td>
      </tr>
      {% endfor %}
      {% if lines.length == 0 %}<tr><td colspan="10" class="muted">No goods yet.</td></tr>{% endif %}
    </table>
    <p data-testid="mtt-totals">Purchase {{ d.purchase_currency }} {{ f.purchase_fmt }} · sale {{ d.sale_currency }} {{ f.sale_fmt }}{% if f.contract_margin_fmt !== null %} · contract margin {{ d.sale_currency }} {{ f.contract_margin_fmt }}{% endif %}</p>
    {% if canEdit and stage == 'contracted' %}
    <form method="post" action="/merchant/{{ id }}/lines" class="field-grid" data-testid="mtt-add-line">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Description *<input type="text" name="description" required maxlength="500" placeholder="e.g. White marble slabs, 2 cm, polished"></label>
      <label>HS code *<input type="text" name="hsn_code" required minlength="4" maxlength="8" pattern="[0-9]{4,8}" placeholder="e.g. 68022100"></label>
      <label>Quantity *<input type="number" name="quantity" required min="0.001" step="0.001" placeholder="e.g. 500"></label>
      <label>Unit *<input type="text" name="unit" required maxlength="20" placeholder="e.g. SQM"></label>
      <label>Buy price per unit ({{ d.purchase_currency }}) *<input type="number" name="buy_price_fc" required min="0.01" step="0.01" placeholder="e.g. 32.00"></label>
      <label>Sell price per unit ({{ d.sale_currency }}) *<input type="number" name="sell_price_fc" required min="0.01" step="0.01" placeholder="e.g. 38.50"></label>
      <p><button type="submit" class="btn-secondary">Add line</button></p>
    </form>
    {% endif %}
  </div>

  <div class="section" id="mtt-shipment">
    <h2>Shipment</h2>
    {% if canEdit and (stage == 'contracted' or stage == 'shipped') %}
    <form method="post" action="/merchant/{{ id }}/bl" class="field-grid">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>BL number *<input type="text" name="bl_no" required maxlength="40" value="{{ d.bl_no }}" placeholder="e.g. MSCUIZ1234567"></label>
      <label>BL date *<input type="date" name="bl_date" required max="{{ today }}" value="{{ d.bl_date }}"></label>
      <label>Vessel<input type="text" name="vessel" maxlength="100" value="{{ d.vessel }}" placeholder="e.g. MSC Aurora / 245E"></label>
      <label><input type="checkbox" name="switch_bl" value="1" {{ 'checked' if d.switch_bl == 1 else '' }}> A switch BL is issued (only where the AD bank allows it)</label>
      <label>Switch BL number<input type="text" name="switch_bl_no" maxlength="40" value="{{ d.switch_bl_no }}" placeholder="e.g. MSCUIZ1234567-S"></label>
      <label>Switch BL issued by / bank's consent<input type="text" name="switch_bl_ref" maxlength="255" value="{{ d.switch_bl_ref }}" placeholder="e.g. MSC Dubai agent; SBI letter MT/2026/118"></label>
      <p><button type="submit" class="btn-secondary">Save BL</button></p>
    </form>
    {% else %}<p>BL {{ d.bl_no or '—' }} dated {{ d.bl_date or '—' }} · {{ d.vessel or '—' }}{% if d.switch_bl == 1 %} · switch BL {{ d.switch_bl_no }} ({{ d.switch_bl_ref }}){% endif %}</p>{% endif %}
    <form method="post" action="/merchant/{{ id }}/document" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="kind" value="invoice"><button type="submit" class="btn-secondary">Download sale invoice (PDF)</button></form>
    <span class="muted">{% if d.sale_invoice_no %}Invoice {{ d.sale_invoice_no }} dated {{ d.invoice_date }}.{% else %}The invoice number is fixed the first time it is generated (after the BL).{% endif %}</span>
  </div>

  <div class="section" id="mtt-payments">
    <h2>Money on both legs</h2>
    <table class="list" data-testid="mtt-payments">
      <tr><th>Date</th><th>Leg</th><th>Amount</th><th>Rate</th><th>₹</th><th>Bank reference</th><th>Description</th></tr>
      {% for p in payments %}<tr><td>{{ p.moved_on }}</td><td>{{ p.leg_label }}</td><td>{{ p.cur }} {{ p.amount_fmt }}</td><td>{{ p.fx_rate }}</td><td>{{ p.inr_fmt }}</td><td>{{ p.bank_reference }}</td><td>{{ p.description }}</td></tr>{% endfor %}
      {% if payments.length == 0 %}<tr><td colspan="7" class="muted">None yet.</td></tr>{% endif %}
    </table>
    <p data-testid="mtt-margin">Received from the buyer {{ d.sale_currency }} {{ f.received_fmt }} of {{ f.sale_fmt }} (₹{{ f.received_inr_fmt }}{% if f.sell_rate !== null %} at {{ f.sell_rate }}{% endif %})
      · paid to the supplier {{ d.purchase_currency }} {{ f.paid_fmt }} of {{ f.purchase_fmt }} (₹{{ f.paid_inr_fmt }}{% if f.buy_rate !== null %} at {{ f.buy_rate }}{% endif %})
      · <strong>margin ₹{{ f.margin_inr_fmt }} = USD {{ f.margin_usd_fmt }}</strong>{% if f.margin_pct !== null %} ({{ f.margin_pct }}%){% endif %} {{ '(final, at the realised rates)' if f.final else '(so far)' }}</p>
    <p class="muted">Advance backing: {{ backingLabel }}{% if d.backing_ref %} {{ d.backing_ref }}{% endif %}.</p>
    {% if canEdit and stage != 'closed' %}
    <form method="post" action="/merchant/{{ id }}/backing" class="field-grid">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Advance backed by *<select name="advance_backing" required>{% for b in backings %}<option value="{{ b.key }}" {{ 'selected' if d.advance_backing == b.key else '' }}>{{ b.label }}</option>{% endfor %}</select></label>
      <label>LC / bank guarantee number<input type="text" name="backing_ref" maxlength="60" value="{{ d.backing_ref }}" placeholder="e.g. 0123SBLC000789"></label>
      <p><button type="submit" class="btn-secondary">Save backing</button></p>
    </form>
    {% endif %}
    {% if canPay and stage != 'closed' %}
    <form method="post" action="/merchant/{{ id }}/payments" class="field-grid">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Leg *<select name="leg" required><option value="">Choose…</option>{% for l in legs %}<option value="{{ l.key }}">{{ l.label }}</option>{% endfor %}</select></label>
      <label>Date *<input type="date" name="moved_on" required max="{{ today }}"></label>
      <label>Amount (the leg's currency) *<input type="number" name="amount_fc" required min="0.01" step="0.01" placeholder="e.g. 16000.00"></label>
      <label>Bank's rate (₹ per unit of the leg's currency) *<input type="number" name="fx_rate" required min="0.0001" max="999.9999" step="0.0001" placeholder="e.g. 84.9200"></label>
      <label>SWIFT / UTR reference *<input type="text" name="bank_reference" required maxlength="60" placeholder="e.g. SBININBB OUTWARD 556677"></label>
      <label>Note<input type="text" name="note" maxlength="255" placeholder="e.g. 50% advance against proforma"></label>
      <p><button type="submit" class="btn-secondary">Record</button></p>
    </form>
    {% endif %}
    {% if canZoho and d.sale_invoice_no %}
    <form method="post" action="/merchant/{{ id }}/zoho"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-secondary">Send to Zoho Books</button> <span class="muted small">the sale invoice, the supplier's bill and both payment legs — whatever is waiting</span></form>
    <p class="small"><a href="/merchant/{{ id }}/zoho-check">Check this deal against Zoho Books &rarr;</a> <span class="muted">(reads only)</span></p>
    {% endif %}
  </div>

  <div class="section" id="mtt-bank">
    <h2>AD bank's document checklist</h2>
    <table class="list" data-testid="mtt-bank">
      <tr><th>Document</th><th>With the bank</th><th></th></tr>
      {% for doc in docs %}
      <tr><td>{{ doc.label }}</td><td>{{ doc.received or '—' }}</td>
        <td>{% if canEdit and stage != 'closed' %}<form method="post" action="/merchant/{{ id }}/bank-documents" style="display:flex;gap:6px;align-items:center;"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="doc_key" value="{{ doc.key }}">
          <input type="date" name="received_on" aria-label="Received on" max="{{ today }}" value="{{ doc.received }}"><button type="submit" class="btn-link">Save</button></form>{% endif %}</td></tr>
      {% endfor %}
    </table>
    <p class="muted">The list is the Merchant Trade setting <code>mtt_bank_documents</code> (to be confirmed with the AD bank). Clear the date to untick a document.</p>
  </div>
</div>
