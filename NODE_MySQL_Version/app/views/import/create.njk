{# Owner decision D-257 Phase 3: a new import — the foreign supplier and the import PO in the supplier's currency. #}
<div class="card page-wide">
  <p><a href="/import">&larr; Imports</a></p>
  <h1>New import</h1>
  {% if not active %}
    <p class="muted" data-testid="imp-not-active">Import &amp; Distribution is not active yet. The MD activates it in Admin › Divisions when it is ready.</p>
  {% else %}
  <p class="muted">A purchase from a supplier abroad, in the supplier's currency. The PO number is given when you save.</p>
  <form method="post" action="/import" class="field-grid" data-testid="imp-create-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label>Supplier *<input type="text" name="supplier_name" required maxlength="255" value="{{ old.supplier_name }}" placeholder="e.g. Xiamen Stone Industries Co., Ltd."></label>
    <label>Country *<input type="text" name="supplier_country" required maxlength="80" value="{{ old.supplier_country }}" placeholder="e.g. China"></label>
    <label>Supplier address<textarea name="supplier_address" rows="3" maxlength="1000" placeholder="e.g. No. 8 Shuitou Road, Nan'an, Fujian 362342">{{ old.supplier_address }}</textarea></label>
    <label>Currency *
      <select name="currency_code" required>
        <option value="">Choose…</option>
        {% for c in currencies %}<option value="{{ c }}" {{ 'selected' if old.currency_code == c else '' }}>{{ c }}</option>{% endfor %}
      </select>
    </label>
    <label>Incoterm
      <select name="incoterm">
        <option value="">—</option>
        {% for t in incoterms %}<option value="{{ t }}" {{ 'selected' if old.incoterm == t else '' }}>{{ t }}</option>{% endfor %}
      </select>
    </label>
    <label>PO date *<input type="date" name="po_date" required max="{{ today }}" value="{{ old.po_date or today }}"></label>
    <label>Payment terms<input type="text" name="payment_terms" maxlength="255" value="{{ old.payment_terms }}" placeholder="e.g. 30% advance by TT, 70% by LC at sight"></label>
    <p><button type="submit" class="btn">Create import</button></p>
  </form>
  {% endif %}
</div>
