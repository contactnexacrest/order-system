<div class="card card-narrow">
  <h1>Buyer sign-in</h1>
  <p class="muted small">This page is for NexaCrest buyers who have an order with us. When we receive your advance payment, we e-mail you a link to set up your login.</p>
  <form method="post" action="/client/login">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label>Email
      <input type="email" name="email" required autofocus placeholder="e.g. name@company.com">
    </label>
    <label>Password
      <input type="password" name="password" required placeholder="Your password">
    </label>
    <button type="submit">Sign in</button>
  </form>
  <p class="muted small"><a href="/client/forgot-password">Forgot your password?</a></p>
</div>
