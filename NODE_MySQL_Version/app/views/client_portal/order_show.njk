<div class="card page-wide">
  <h1>Order {{ order.order_reference or ('#' ~ order.id) }}</h1>
  <p class="muted small"><a href="/client">&larr; Back to My Orders</a> &nbsp;&middot;&nbsp; <a href="/client/orders/{{ order.id }}/reorder">Reorder This</a></p>

  {% if ocAcknowledgment and ocAcknowledgment.acknowledged_at == null %}
  <div class="section">
    <h2>Please confirm your order</h2>
    <p>Please check your order details below. If they are correct, press the button to confirm.</p>
    <table class="list">
      <tr><th>Order Reference</th><td>{{ order.order_reference }}</td></tr>
      <tr><th>Product(s)</th><td>
        {% for p in products %}{{ p.description }} (Qty: {{ p.quantity }} {{ p.unit or '' }}){% if not loop.last %}<br>{% endif %}{% else %}—{% endfor %}
      </td></tr>
      <tr><th>Total Order Value</th><td>{{ order.currency_code or '' }} {{ totalFobValue | money }}</td></tr>
      <tr><th>Delivery terms (Incoterm)</th><td>{{ order.incoterm_code or '—' }}</td></tr>
      <tr><th>Port where the goods arrive</th><td>{{ order.port_of_discharge_name or order.port_of_discharge_city or order.port_of_discharge_text or '—' }}</td></tr>
    </table>
    {% if not downloadsHidden %}<p class="muted small">The full Order Confirmation document is available to download above under Documents.</p>{% endif %}
    <form method="post" action="/client/orders/{{ order.id }}/acknowledge-oc">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-success">Yes, this is correct — please go ahead</button>
    </form>
  </div>
  {% endif %}

  {# External QA report M-02: global + per-client document-download visibility. #}
  {% if not downloadsHidden %}
  <div class="section">
    <h2>Documents</h2>
    <p class="muted small">Every document we've finalized for your order so far — download any time.</p>
    <table class="list">
      <tr><th>Document</th><th>Reference</th><th>Date</th><th></th></tr>
      {% for d in documents %}
      <tr>
        <td>{{ d.document_type_name }}</td>
        <td>{{ d.document_reference or '—' }}</td>
        <td>{{ d.generated_at | humanDate }}</td>
        <td><a href="/client/documents/{{ d.id }}/download">Download PDF</a></td>
      </tr>
      {% else %}
        <tr><td colspan="4" class="muted">No documents available yet — check back once your order progresses.</td></tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  <div class="section">
    <h2>Your purchase order</h2>
    {% if order.status != 'cancelled' and order.status != 'lost' and not advanceCleared %}{# D-269, D-330: no upload invitation once upload is closed (cancelled, did not go ahead, or advance received) #}
      <p class="muted small">After you sign your purchase order, upload a scan of it here. You can upload a corrected copy later. We keep every copy you upload.</p>
    {% endif %}
    {% if buyerPoDocuments.length > 0 %}
      <table class="list">
        <tr><th>File</th><th>Uploaded</th></tr>
        {% for doc in buyerPoDocuments %}
        <tr>
          <td>{{ doc.original_filename }}</td>
          <td>{{ doc.uploaded_at | humanDate }}</td>
        </tr>
        {% endfor %}
      </table>
    {% else %}
      <p class="muted">You have not uploaded your purchase order yet.</p>
    {% endif %}
    {% if order.status == 'cancelled' or order.status == 'lost' %}
      <p class="muted small">{{ 'This order did not go ahead' if order.status == 'lost' else 'This order was cancelled' }}, so you can no longer upload a purchase order.</p>
    {% elif advanceCleared %}
      <p class="muted small">We have received your advance payment, so you can no longer upload here. If you need to send us a new copy, please contact your NexaCrest contact person.</p>
    {% else %}
      <form method="post" action="/client/orders/{{ order.id }}/buyer-po" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Your PO number <small class="muted">(needed the first time you upload)</small><input type="text" name="buyers_po_ref" placeholder="e.g., PO-2026-0142"></label>
        <label>Your signed purchase order (file) <input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.eml,.msg" required></label>
        <button type="submit" class="btn-sm">Upload</button>
      </form>
    {% endif %}
  </div>

  <div class="section" id="order-updates">
    <h2>Order Updates</h2>
    <p class="muted">A running conversation with our team about this order. Post a message any time — you can attach photos or videos too.</p>
    <div class="chat-thread">
      {% if comments.length == 0 %}
        <p class="chat-empty">No updates yet.</p>
      {% endif %}
      {% for c in comments %}
        {% set isStaff = c.author_type == 'staff' %}
        <div class="chat-bubble-row {{ 'client' if isStaff else 'staff' }}">
          <div class="chat-bubble {{ 'client' if isStaff else 'staff' }}">
            <div class="chat-bubble-meta">
              <span class="who">{{ 'Our Team' if isStaff else 'You' }}</span>
              <span>{{ c.created_at | humanDate }}</span>
            </div>
            {% if c.body %}<div class="chat-bubble-body">{{ c.body }}</div>{% endif %}
            {% if c.attachments.length > 0 %}
              <div class="chat-attachments">
                {% for att in c.attachments %}
                  {% set url = '/client/orders/' ~ order.id ~ '/comment-attachments/' ~ att.file_id ~ '/download' %}
                  {% if att.mime_type and (att.mime_type | startswith('image/')) %}
                    <a href="{{ url }}" target="_blank"><img class="chat-attachment-image" src="{{ url }}" alt="{{ att.original_filename }}"></a>
                  {% elif att.mime_type and (att.mime_type | startswith('video/')) %}
                    <video class="chat-attachment-video" controls src="{{ url }}"></video>
                  {% else %}
                    <a class="chat-attachment-file" href="{{ url }}">{{ att.original_filename }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <form class="chat-post-form" method="post" action="/client/orders/{{ order.id }}/comments#order-updates" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <textarea name="body" placeholder="Write a message…" aria-label="Write a message">{{ oldCommentBody }}</textarea>
      <div class="chat-post-form-row">
        <input type="file" name="attachments" multiple accept="image/*,video/*,.pdf" aria-label="Attachments">
        <button type="submit" class="btn-sm" data-loading-text="Sending…">Send</button>
      </div>
    </form>
  </div>

  <div class="section">
    <h2>Report a Payment</h2>
    {% if paymentReportRefusal %}
    <p class="muted"><strong>{{ paymentReportRefusal }}</strong></p>
    {% else %}
    <p class="muted">Have you paid for this order? Tell us the payment details below. We will check our bank statement and then update your order.</p>
    <form method="post" action="/client/orders/{{ order.id }}/report-payment" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Which Payment? *
          <select name="payment_type" required>
            <option value="">Select…</option>
            <option value="advance">Advance Payment</option>
            <option value="balance">Balance Payment</option>
            <option value="freight">Freight Payment</option>
          </select>
        </label>
        <label>Bank reference number (transaction ID, UTR or SWIFT reference) *<input type="text" name="transaction_ref" required placeholder="e.g. HDFCN26304123456"></label>
        <label>Amount Paid<input type="number" name="amount" min="0.01" max="999999999999.99" step="0.01" placeholder="e.g. 12500.00"></label>
        <label>Date Paid<input type="date" name="payment_date" max="{{ today() }}"></label>
        <label>Paid from (bank and account)<input type="text" name="payer_bank_details" placeholder="e.g. Sent from HSBC UK, account ending 4321"></label>
        <label>Payment Screenshot / Proof of Payment (optional)<input type="file" name="screenshot" accept=".pdf,.jpg,.jpeg,.png"></label>
      </div>
      <button type="submit">Submit Payment Details</button>
    </form>
    {% endif %}

    {% if paymentReports and paymentReports.length > 0 %}
      <h3 style="margin-top:20px">Payments you have told us about</h3>
      <table class="list">
        <tr><th>Payment</th><th>Bank reference number (transaction ID, UTR or SWIFT reference)</th><th>Amount</th><th>Date</th><th>Status</th><th>Attachment</th></tr>
        {% for r in paymentReports %}
        <tr>
          <td>{{ r.payment_type | capitalize }}</td>
          <td>{{ r.transaction_ref }}</td>
          <td>{{ (r.amount | money) ~ ' ' ~ (order.currency_code or '') if r.amount != null else '—' }}</td>
          <td>{{ r.payment_date or '—' }}</td>
          <td>{{ 'Reviewed by our team' if r.status == 'reviewed' else 'Received — we are checking it' }}</td>
          <td>
            {% if r.screenshot_file_id %}
              {% set screenshotUrl = '/client/orders/' ~ order.id ~ '/payment-reports/' ~ r.id ~ '/screenshot' %}
              {% if r.screenshot_mime_type and r.screenshot_mime_type.startsWith('image/') %}
                <a href="{{ screenshotUrl }}" target="_blank"><img src="{{ screenshotUrl }}" alt="Payment screenshot" class="asset-preview" style="max-height:60px;"></a>
              {% else %}
                <a href="{{ screenshotUrl }}" target="_blank">View attachment</a>
              {% endif %}
            {% else %}
              <span class="muted small">—</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  </div>

  {% if order.dispute_button_visible_to_client == 1 %}
  <div class="section">
    <h2>Ask to cancel this order</h2>
    <p class="muted">Do you want to cancel this order? Tell us here. We will reply within the time given in your order terms.</p>
    <form method="post" action="/client/orders/{{ order.id }}/disputes">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Describe the issue *<textarea name="description" rows="4" required placeholder="Describe the issue"></textarea></label>
      <button type="submit">Ask to cancel this order</button>
    </form>
  </div>
  {% endif %}

  <div class="section" id="order-complaints">
    <h2>Tell us what we could do better</h2>
    <p class="muted">Something about this order we could do better next time? Tell us here and a NexaCrest team member will reply.</p>
    {% for c in orderComplaints %}
      <div class="card-nested" style="margin-bottom:0.75rem">
        <p class="muted small" style="margin:0 0 0.4rem;">Raised {{ c.created_at | humanDate }} — {{ c.status | capitalize }}</p>
        <p style="margin:0 0 0.5rem;">{{ c.description | nl2br }}</p>
        {% for r in c.replies %}
          <div style="border-top:1px solid var(--line, #EFE6D2);padding:0.4rem 0;">
            <p class="muted small" style="margin:0;">{{ 'Our Team' if r.author_type == 'staff' else 'You' }} — {{ r.created_at | humanDate }}</p>
            <p style="margin:0;">{{ r.body | nl2br }}</p>
          </div>
        {% endfor %}
        <form method="post" action="/client/orders/{{ order.id }}/complaints/{{ c.id }}/replies" style="margin-top:0.5rem">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <textarea name="body" rows="2" placeholder="Reply…" required aria-label="Reply"></textarea>
          <button type="submit" class="btn-sm">Send</button>
        </form>
      </div>
    {% endfor %}
    <form method="post" action="/client/orders/{{ order.id }}/complaints">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Describe the issue *<textarea name="description" rows="3" required placeholder="e.g. packaging could be sturdier, or a delay in replies"></textarea></label>
      <button type="submit">Report This Issue</button>
    </form>
  </div>

  <div class="section">
    <h2>Order Feedback</h2>
    {# External QA report N-12: step 14 is a post-shipment step — rating work that isn't finished yet doesn't make sense. #}
    {% if order.status == 'shipped_docs_sent' or order.status == 'complete' %}
      <p class="muted">Let us know how we did on this order — your rating and comments are visible to our team.</p>
      <form method="post" action="/client/orders/{{ order.id }}/feedback">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label>Rating *
          <select name="rating" required>
            <option value="">Choose a rating</option>
            {% for i in [5, 4, 3, 2, 1] %}
              <option value="{{ i }}" {{ 'selected' if orderFeedback and orderFeedback.rating == i }}>{% for s in range(0, i) %}★{% endfor %}{% for s in range(0, 5 - i) %}☆{% endfor %} ({{ i }}/5)</option>
            {% endfor %}
          </select>
        </label>
        <label>Your review<textarea name="comments" rows="5" placeholder="Type your comments">{% if orderFeedback %}{{ orderFeedback.comments or '' }}{% else %}{{ testimonialSuggestion or '' }}{% endif %}</textarea></label>
        <p class="muted small">{% if orderFeedback %}This is the review you left. You can change it above.{% else %}To help you start, we wrote a suggested review based on your order. You can change it above.{% endif %}</p>
        <button type="submit">{{ 'Update Feedback' if orderFeedback else 'Submit Feedback' }}</button>
      </form>
      {% if orderFeedback %}
        <p class="muted small">Last submitted: {{ orderFeedback.submitted_at | humanDate }}</p>
      {% endif %}
    {% else %}
      <p class="muted">You can leave a review after we send you the shipping documents for this order.</p>
    {% endif %}
  </div>
</div>
