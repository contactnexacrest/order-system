{# Short, factual one-liner per status group — a client who already has an
   order in a given bucket benefits from knowing what it means; a group
   with no orders is simply never rendered, so nothing hypothetical shows. #}
{% set groupDescriptions = {
  "Active": "Currently moving through our pipeline.",
  "Complete": "Shipped and finished.",
  "Disputed": "Being reviewed by our team.",
  "Lost": "Did not go ahead.",
  "Cancelled": "Called off."
} %}
<div class="card page-wide">
  <h1>My Orders</h1>
  {% if historyHidden %}
    <p class="muted">Welcome, {{ client.company_legal_name }}. Below are your current orders with NexaCrest.</p>
  {% else %}
    <p class="muted">Welcome, {{ client.company_legal_name }}. Below are all your orders with NexaCrest.</p>
  {% endif %}

  {% if not orderGroups or orderGroups.length == 0 %}
    <p class="muted">No orders yet.</p>
  {% else %}
    {% for group in orderGroups %}
    <div class="section">
      <h2>{{ group.label }} ({{ group.orders.length }})</h2>
      {% if groupDescriptions[group.label] %}
        <p class="muted small">{{ groupDescriptions[group.label] }}</p>
      {% endif %}
      <table class="list">
        <tr><th>Order Ref</th><th>Stage</th><th>Created</th><th></th></tr>
        {% for o in group.orders %}
        <tr>
          <td>{{ o.order_reference or ('#' ~ o.id) }}</td>
          <td>{{ o.current_stage_name or '—' }}</td>
          <td>{{ o.created_at | humanDate }}</td>
          <td><a href="/client/orders/{{ o.id }}">View documents</a></td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endfor %}
  {% endif %}
</div>
