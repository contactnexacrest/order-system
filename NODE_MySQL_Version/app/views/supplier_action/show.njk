<div class="card">
  <h1>Purchase Order {{ supplierPo.supplier_po_reference }}</h1>
  <p class="muted">From {{ companyName }} to {{ supplierPo.supplier_legal_name or 'you' }}</p>

  <div class="section">
    <h2>Signed PO / Acknowledgment</h2>
    <p>Please upload the purchase order signed and stamped by you, or your written acknowledgment of it. You can upload more than one file.</p>
    {% if documents.length %}
      <p class="small"><strong>Received so far:</strong></p>
      <ul class="small">
        {% for d in documents %}
          <li>{{ d.original_filename }} — {{ d.uploaded_at }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    <form method="post" action="/supplier-action/{{ token }}/acknowledgment" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Signed PO or acknowledgment <input type="file" name="document" required></label>
      <button type="submit" class="btn-sm">Upload</button>
    </form>
  </div>
</div>
