{% set protected = preset.is_protected == 1 %}
<div class="card">
  <p class="muted small"><a href="/payment-presets">&larr; Back to Payment Presets</a></p>
  <h1>Edit Payment Preset</h1>

  {% if protected %}
    <div class="review-banner bad" style="margin-bottom:14px">
      &#128274; <span><strong>This preset is protected</strong> — it drives where money is actually sent/received, so it can't be edited until unlocked. Submit an unlock request via <a href="/admin/field-protection">Field Protection</a> first.</span>
    </div>
  {% endif %}
  {% if inUse %}
    <div class="review-banner warn" style="margin-bottom:14px">
      &#8505; <span>At least one order is currently assigned to this preset — changes here affect every document generated for those orders from now on.</span>
    </div>
  {% endif %}

  <form method="post" action="/payment-presets/{{ preset.id }}/update">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <fieldset {{ 'disabled' if protected }}>
      <legend>Preset</legend>
      <label>Preset Name *<input type="text" name="preset_name" required value="{{ preset.preset_name }}"></label>
      <label><input type="checkbox" name="is_default" value="1" {{ 'checked' if preset.is_default == 1 }}> Default preset (pre-selected on the order-creation form)</label>
      <label><input type="checkbox" name="requires_md_approval" value="1" {{ 'checked' if preset.requires_md_approval == 1 }}> Requires MD approval before an order can use this preset</label>
    </fieldset>

    <fieldset {{ 'disabled' if protected }}>
      <legend>Advance Payment</legend>
      <label>Advance % *<input type="number" name="advance_pct" step="0.01" min="0.01" max="99.99" required value="{{ preset.advance_pct }}"></label>
      <label>Advance Trigger Text *<input type="text" name="advance_trigger_text" required value="{{ preset.advance_trigger_text }}"></label>
      <p class="muted small">Printed as "{advance_pct}% advance T/T on FOB Value {advance_trigger_text}" — this is the second half of that sentence.</p>
    </fieldset>

    <fieldset {{ 'disabled' if protected }}>
      <legend>Balance Payment</legend>
      <label>Balance % *<input type="number" name="balance_pct" step="0.01" min="0.01" max="99.99" required value="{{ preset.balance_pct }}"></label>
      <p class="muted small">Advance % + Balance % must add up to 100.</p>
      <label>Balance Trigger Option *
        <select name="balance_trigger_option" required>
          {% for key, label in triggerOptions %}
            <option value="{{ key }}" {{ 'selected' if preset.balance_trigger_option == key }}>{{ label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Balance Days *<input type="number" name="balance_days" min="1" required value="{{ preset.balance_days }}"></label>
      <label>Balance Trigger Wording
        <textarea name="balance_trigger_wording" rows="3">{{ preset.balance_trigger_wording or '' }}</textarea>
      </label>
      <p class="muted small">Printed as-is on the Quotation, Proforma Invoice, and Buyer PO — the only 3 documents whose balance clause varies by preset. Must include the literal token <code>{days}</code>, substituted with Balance Days above. Leave blank to use the built-in default sentence for the Balance Trigger Option selected.</p>
    </fieldset>

    <fieldset {{ 'disabled' if protected }}>
      <legend>Currency</legend>
      <label>Currency *
        <select name="currency_id" required>
          {% for c in currencies %}
            <option value="{{ c.id }}" {{ 'selected' if preset.currency_id == c.id }}>{{ c.code }} — {{ c.name }}</option>
          {% endfor %}
        </select>
      </label>
    </fieldset>

    <button type="submit" {{ 'disabled' if protected }}>Save Changes</button>
  </form>
</div>
