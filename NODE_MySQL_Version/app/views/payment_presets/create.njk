<div class="card">
  <p class="muted small"><a href="/payment-presets">&larr; Back to Payment Presets</a></p>
  <h1>New Payment Preset</h1>
  <form method="post" action="/payment-presets">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <fieldset>
      <legend>Preset</legend>
      <label>Preset Name *<input type="text" name="preset_name" required placeholder="e.g. Trial Order — 20% Advance"></label>
      <label><input type="checkbox" name="is_default" value="1"> Default preset (pre-selected on the order-creation form)</label>
      <label><input type="checkbox" name="requires_md_approval" value="1"> Requires MD approval — MD/ED approve an order's terms before its Quotation can be generated or sent</label>
      <label><input type="checkbox" name="show_bl_instructions" value="1" checked> Include BL Type / BL Consignee Instruction on the generated BL Instruction Sheet <small class="muted">(uncheck for payment terms that don't need NexaCrest to retain the BL as leverage, e.g. balance paid before shipment)</small></label>
    </fieldset>

    <fieldset>
      <legend>Advance Payment</legend>
      <div class="field-grid">
        <label class="full">Advance Trigger Text *
          <input type="text" name="advance_trigger_text" required value="against Proforma Invoice before production commences"
            placeholder="against Proforma Invoice before production commences">
        </label>
        <label>Advance % *
          <input type="number" name="advance_pct" step="0.01" min="0.01" max="99.99" required value="40.00" placeholder="e.g., 40.00">
        </label>
        <label>Payment Method *
          <select name="payment_method" required>
            {% for key, label in paymentMethodOptions %}
              <option value="{{ key }}" {{ 'selected' if key == 'CASH_ADVANCE' }}>{{ label }}</option>
            {% endfor %}
          </select>
        </label>
      </div>
      <p class="muted small">Printed as "{advance_pct}% advance T/T on FOB Value {advance_trigger_text}" — this is the second half of that sentence.</p>
      <p class="muted small">Payment Method controls which actions the order-detail page shows for this leg: <strong>Cash Advance</strong> shows "Record Advance Remittance" / "Mark Advance Cleared"; <strong>Letter of Credit</strong> shows "Record LC Details" / "Confirm LC Usable" instead — the LC leg replaces the cash advance entirely, the Balance leg afterward is unaffected either way.</p>
    </fieldset>

    <fieldset>
      <legend>Balance Payment</legend>
      <div class="field-grid">
        <label class="full">Balance Trigger Wording
          <textarea name="balance_trigger_wording" rows="3" placeholder="Payable before shipment — within {days} Calendar Days of receiving Shipment Readiness Confirmation from NexaCrest."></textarea>
        </label>
        <label>Balance % *
          <input type="number" name="balance_pct" step="0.01" min="0.01" max="99.99" required value="60.00" placeholder="e.g., 60.00">
        </label>
        <label>Balance Trigger Option *
          <select name="balance_trigger_option" required>
            <option value="">— Select —</option>
            {% for key, label in triggerOptions %}
              <option value="{{ key }}">{{ label }}</option>
            {% endfor %}
          </select>
        </label>
        <label>Balance Days *
          <input type="number" name="balance_days" min="1" required value="3" placeholder="e.g., 3">
        </label>
      </div>
      <p class="muted small">Advance % + Balance % must add up to 100.</p>
      <p class="muted small">Printed as-is on the Quotation, Proforma Invoice, and Buyer PO — the only 3 documents whose balance clause varies by preset. Must include the literal token <code>{days}</code>, substituted with Balance Days above. Leave blank to use the built-in default sentence for the Balance Trigger Option selected.</p>
    </fieldset>

    <fieldset>
      <legend>Currency</legend>
      <label>Currency *
        <select name="currency_id" required>
          {% for c in currencies %}
            <option value="{{ c.id }}" {{ 'selected' if c.is_default }}>{{ c.code }} — {{ c.name }}</option>
          {% endfor %}
        </select>
      </label>
    </fieldset>

    <button type="submit">Create Preset</button>
  </form>
</div>
