{# Owner hard rule 2026-11-01: the same filters and the same cards as the Standard list (complaints/_filters.njk, complaints/_card.njk). #}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Complaints — Kanban Board</h1>
      <p class="muted" style="margin:0;">A process issue or flaw the client flagged for us to fix next time — not a Dispute. {{ shownCount }} shown.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn-sm btn-secondary" href="/complaints?view=list{{ ('&amp;status=' + statusFilter) | safe if statusFilter else '' }}">Switch to list view</a>
    </div>
  </div>

  {% set listOfBoard = false %}{% include "complaints/_filters.njk" %}

  <div class="kanban-board">
    {% for statusValue, complaints in columns %}
      <div class="kanban-column">
        <div class="kanban-column-header">
          <span class="kanban-column-title">{% if statusValue == 'acknowledged' %}Acknowledged{% elif statusValue == 'resolved' %}Resolved{% else %}Open{% endif %}</span>
          <span class="kanban-column-count">{{ complaints.length }}</span>
        </div>
        {% if not complaints.length %}
          <p class="kanban-column-empty">No complaints here</p>
        {% else %}
          {% for c in complaints %}{% set kanbanCard = true %}{% include "complaints/_card.njk" %}{% endfor %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
