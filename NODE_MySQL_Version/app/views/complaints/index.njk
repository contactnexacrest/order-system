<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Complaints (All Orders)</h1>
      <p class="muted" style="margin:0;">A process issue or flaw the client flagged for us to fix next time — not a Dispute. {{ complaints.length }} shown.</p>
    </div>
    {% if kanbanUser %}<div class="btn-row" style="margin-top:0;"><a class="btn-sm btn-secondary" href="/complaints">Switch to board view</a></div>{% endif %}
  </div>

  {% set listOfBoard = kanbanUser %}{% include "complaints/_filters.njk" %}

  {% if not complaints or complaints.length == 0 %}
    <p class="muted">No complaints recorded.</p>
  {% else %}
  <div class="card-grid">
    {% for c in complaints %}{% set kanbanCard = false %}{% include "complaints/_card.njk" %}{% endfor %}
  </div>
  {% endif %}
</div>
