{# Owner decision D-257 Phase 2: Admin › GST rates for Domestic Trade sales (to be confirmed by the CA). #}
<div class="card page-wide">
  <p><a href="/admin/divisions">&larr; Divisions</a></p>
  <h1>GST rates (Domestic Trade)</h1>
  <p class="muted">A domestic order line takes the rate of the longest HSN below that its HSN starts with, else its product category's rate, else the default rate <strong>{{ defaultRate }}%</strong> (Domestic Trade setting <code>dom_default_gst_rate</code>). These are standard rates as a start — <strong>to be confirmed by the CA</strong>. A line's rate can also be typed on the line.</p>
  <table class="list" data-testid="gst-rates">
    <tr><th>HSN starts with</th><th>Category</th><th>GST</th><th>Note</th><th>In use</th><th></th></tr>
    {% for r in rates %}
    <tr>
      <td>{{ r.hsn_prefix or '—' }}</td><td>{{ r.category_name or '—' }}</td><td>{{ r.rate_pct }}%</td><td>{{ r.note }}</td>
      <td>{{ 'Yes' if r.is_active == 1 else 'No' }}</td>
      <td><form method="post" action="/admin/gst-rates/{{ r.id }}/toggle"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="active" value="{{ '0' if r.is_active == 1 else '1' }}"><button type="submit" class="btn-link">{{ 'Stop using' if r.is_active == 1 else 'Use again' }}</button></form></td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="muted">None yet: every line takes the default rate.</td></tr>
    {% endfor %}
  </table>
  <h2>Add a rate</h2>
  <form method="post" action="/admin/gst-rates" class="field-grid">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label>HSN starts with<input type="text" name="hsn_prefix" maxlength="8" pattern="[0-9]{2,8}" placeholder="e.g. 6802"></label>
    <label>or Category
      <select name="category_id">
        <option value="">—</option>
        {% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
      </select>
    </label>
    <label>GST rate *
      <select name="rate_pct" required>
        <option value="">Choose…</option>
        {% for r in rateOptions %}<option value="{{ r.value }}">{{ r.label }}</option>{% endfor %}
      </select>
    </label>
    <label>Note<input type="text" name="note" maxlength="255" placeholder="e.g. Polished granite slabs — confirmed by the CA on 10 Nov"></label>
    <p><button type="submit" class="btn">Add rate</button></p>
  </form>
</div>
