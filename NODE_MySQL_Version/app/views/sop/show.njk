<div class="card page-wide">
  <div class="sop-layout">
    <nav class="sop-nav">
      <p class="muted small" style="margin-top:0;"><a href="/sop">&larr; SOP Home</a></p>
      <ul class="sop-chapter-list">
        {% for ch in chapters %}
          {% if ch.category == 'main' %}<li><a href="/sop/{{ ch.slug }}" class="{{ 'active' if ch.slug == currentSlug else '' }}">{{ ch.title }}</a></li>{% endif %}
        {% endfor %}
      </ul>
      {% if chapters | selectattr('category', 'equalto', 'ca') | list | length > 0 %}
        <p class="muted small">CA / Accounting</p>
        <ul class="sop-chapter-list">
          {% for ch in chapters %}
            {% if ch.category == 'ca' %}<li><a href="/sop/{{ ch.slug }}" class="{{ 'active' if ch.slug == currentSlug else '' }}">{{ ch.title }}</a></li>{% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
    <div class="sop-content">
      {{ contentHtml | safe }}
    </div>
  </div>
</div>
