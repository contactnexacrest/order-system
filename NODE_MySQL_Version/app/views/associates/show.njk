{# One associate.
   Expects: a, statuses, canManage, canBank, canChangeLink, clients (with first_order_on), and when canManage or canBank:
   orders (with stage, fob_value, buyer_paid_in_full, commission{state,label,rate,source,amount}), payouts (with order_reference, note, hold_reason),
   invitations, banks (each with b.masked, first_checked_by_name, verified_by_name), usableBankMasked (string|null), documents, events, messages (with user_name),
   unlinkedClients, commissionNow ({label, count, set, runLabel, gstText, threshold}), rm, codeLink, tdsPct, invoiceByPayout (map payoutId → {id, reference}),
   docKinds (KINDS map), invitationStatuses (map), allAssociates (all associates, for the MD move-to select), csrfToken. #}
{% set id = a.id %}
{% set full = canManage or canBank %}
{% set __sourceLabel = {'link': 'buyer registration link', 'code': 'personal code', 'staff': 'linked by NexaCrest', 'md_change': 'changed by the MD'} %}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>{{ a.name }} {% set __st = a.status %}{% include "associates/_status_badge.njk" %}</h1>
      <p class="muted" style="margin:0">{% if a.based_in == 'india' %}India{% else %}Abroad{% if a.country %} — {{ a.country }}{% endif %}{% endif %}
        · paid in {{ a.currency_code }}{% if a.personal_code %} · personal code <b>{{ a.personal_code }}</b>{% endif %}
        {% if a.status_reason %} · {{ a.status_reason }}{% endif %}</p>
    </div>
    <div class="btn-row" style="margin-top:0">
      <a class="btn-sm btn-secondary" href="/associates">All associates</a>
      {% if canManage %}<a class="btn-sm" href="/associates/{{ id }}/edit">Edit</a> <a class="btn-sm btn-secondary" href="/associates/{{ id }}/view-as">View their portal (read-only)</a>{% endif %}{# D-255 #}{% if permissions.manage_pricing %} <a class="btn-sm btn-secondary" href="/associates/{{ id }}/price-access">Price access</a>{% endif %}
    </div>
  </div>

  {% if canManage %}
  <div class="section" id="profile">
    <h2>Profile and agreement</h2>
    <table class="kv">
      <tr><th>E-mail / phone</th><td>{{ a.email or '—' }} · {{ a.phone or '—' }}</td></tr>
      {% set __tax = [a.pan, a.gstin, a.tax_id] | select | join(' · ') %}
      <tr><th>PAN / GSTIN / tax ID</th><td>{{ __tax or '—' }}</td></tr>
      <tr><th>Address</th><td>{{ (a.address or '—') | nl2br }}</td></tr>
      <tr><th>Reports to</th><td>{{ rm.name if rm else '—' }}</td></tr>
      <tr><th>GST on commission</th><td>{% if a.gstin %}GST-registered — GST {{ commissionNow.gstText }}% is added on top of each commission once their tax invoice is on file{% else %}Not GST-registered — no GST on commission{% endif %}</td></tr>
      <tr><th>Agreement</th><td>signed {{ (a.agreement_signed_on | shortDate) if a.agreement_signed_on else '—' }}, ends {{ (a.agreement_ends_on | shortDate) if a.agreement_ends_on else '—' }}{% if a.agreement_file_id %} · <a href="/associates/{{ id }}/agreement" class="small">Signed copy</a>{% endif %}</td></tr>
      <tr><th>Commission</th><td>
        {% if a.no_commission == 1 %}<b>No commission</b> (introductions only){% else %}
          On the invoiced FOB of the goods, line by line, at the level fixed on each order when its Proforma Invoice is issued; earned once the buyer has paid in full,
          due {{ commissionNow.set.due_days }} days later and paid in the payout run ({{ commissionNow.runLabel }}).
        {% endif %}</td></tr>
      {# D-291 / D-292 (11 Nov 2026): the rule, level and progress are in the Commission section below. #}
    </table>
    <form method="post" action="/associates/{{ id }}/status" class="inline-form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Change status <select name="status" required><option value="">Choose…</option>
        {% for k, l in statuses %}{% if k != 'inactive' and k != a.status %}<option value="{{ k }}">{{ l }}</option>{% endif %}{% endfor %}
      </select></label>
      <label>Reason <input type="text" name="reason" required minlength="10" maxlength="300" placeholder="At least 10 characters — say why"></label>
      <button type="submit" class="btn-sm">Change status</button>
    </form>
  </div>

  <div class="section" id="portal">
    <h2>Portal login link and personal code</h2>
    <p>Portal: <b>{{ 'on' if a.portal_enabled == 1 else 'off' }}</b>{% if a.last_login_at %} · last login {{ a.last_login_at | shortDate }}{% endif %}
      {% if codeLink %}<br>Quotation link (with their code): <code>{{ codeLink }}</code>{% endif %}</p>
    <div class="btn-row">
      <form method="post" action="/associates/{{ id }}/portal/invite" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm">{{ 'Resend portal login link' if a.portal_enabled == 1 else 'Send portal login link' }}</button></form>
      {% if a.portal_enabled == 1 %}<form method="post" action="/associates/{{ id }}/portal/disable" style="display:inline" data-confirm="Switch off this associate's portal?"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm btn-secondary">Switch portal off</button></form>{% endif %}
    </div>
    {# Owner decision D-254: old codes keep bringing buyers to the associate unless blocked here (e.g. after a leak). #}
    <form method="post" action="/associates/{{ id }}/code" class="inline-form" data-confirm="Set a new personal code for this associate?">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>New personal code — readable part *<input type="text" name="readable" required minlength="3" maxlength="12" pattern="[A-Za-z0-9 ]{3,12}" placeholder="e.g. DEMO"></label>
      <label class="checkbox-label"><input type="checkbox" name="block_old" value="1"> Block the old code (e.g. it leaked)</label>
      <input type="text" name="block_reason" maxlength="300" minlength="10" placeholder="Why it is blocked (needed when blocking)" aria-label="Why the old code is blocked" data-required-when="block_old=1" data-required-when-message="Say why the old code is blocked (at least 10 characters).">
      <button type="submit" class="btn-sm btn-secondary">Set code</button>
    </form>
    {% if codes and codes.length %}
      <table class="list"><tr><th>Code</th><th>From</th><th>To</th><th>Status</th></tr>
        {% for c in codes %}<tr><td style="font-family:monospace">{{ c.code }}</td><td>{{ (c.issued_at | shortDate) if c.issued_at else '—' }}</td><td>{{ (c.retired_at | shortDate) if c.retired_at else '—' }}</td>
          <td>{% if c.blocked_at %}Blocked — {{ c.blocked_reason }}{% elif c.code == a.personal_code %}Current{% else %}Still accepted (old links){% endif %}</td></tr>{% endfor %}
      </table>
    {% endif %}
  </div>
  {% if portalAccess %}{% include "associates/_portal_access.njk" %}{% endif %}{# D-261 #}
  {% endif %}

  {% include "associates/_commission_rule.njk" %}{# D-291 / D-292 #}

  <div class="section" id="clients">
    <h2>Clients introduced ({{ clients.length }})</h2>
    <table class="list">
      <tr><th>Client</th><th>Country</th><th>Registered</th><th>Came via</th><th>Protected until</th><th>Orders</th>{% if canChangeLink %}<th>Change (MD only)</th>{% endif %}</tr>
      {% for c in clients %}
        <tr>
          <td><a href="/clients/{{ c.id }}">{{ c.company_legal_name }}</a> <small class="muted">{{ c.client_unique_number }}</small></td>
          <td>{{ c.country_of_destination or '' }}</td>
          <td>{{ (c.associate_registered_on | shortDate) if c.associate_registered_on else '—' }}</td>
          <td>{{ c.came_via or __sourceLabel[c.associate_source] or 'linked earlier' }}</td>
          <td>{{ (c.associate_locked_until | shortDate) if c.associate_locked_until else '—' }}</td>
          <td>{% if c.order_refs and c.order_refs.length %}{{ c.order_refs | join(', ') }}{% else %}<span class="muted">none yet</span>{% endif %}</td>
          {% if canChangeLink %}<td>
            <form method="post" action="/associates/{{ id }}/clients/{{ c.id }}/unlink" class="inline-form" data-confirm="Change this client's associate? The associate is told at once.">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <select name="move_to" aria-label="Move to another associate"><option value="">Remove the link</option>
                {% for o in allAssociates %}{% if o.id != id %}<option value="{{ o.id }}">Move to {{ o.name }}</option>{% endif %}{% endfor %}
              </select>
              <input type="text" name="reason" required minlength="10" maxlength="300" placeholder="Reason (shown to the associate)" aria-label="Reason">
              <button type="submit" class="btn-sm btn-secondary">Change</button>
            </form></td>{% endif %}
        </tr>
      {% endfor %}
      {% if clients.length == 0 %}<tr><td colspan="7" class="muted">No clients yet.</td></tr>{% endif %}
    </table>
    {% if canManage %}
      <form method="post" action="/associates/{{ id }}/clients" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <select name="client_id" required aria-label="Client introduced by {{ a.name }}">
          <option value="">Link a client already on file…</option>
          {% for c in unlinkedClients %}<option value="{{ c.id }}">{{ c.company_legal_name }} ({{ c.client_unique_number }})</option>{% endfor %}
        </select>
        <input type="date" name="registered_on" required max="{{ today() }}" value="{{ today() }}" aria-label="Introduced on">
        <input type="text" name="reason" required minlength="10" maxlength="300" placeholder="How they introduced the client" aria-label="How they introduced the client">
        <button type="submit" class="btn-sm">Link</button>
      </form>
      <p class="muted small">Normally the buyer registers through the associate's buyer registration link or quotation link (personal code) and confirms the introduction themselves; this is for clients already on file. Once linked, only the MD can change it.</p>
    {% endif %}
  </div>

  {% if full %}
  {% if canManage %}
  <div class="section" id="invitations">
    <h2>Buyer registration links and codes used</h2>
    <table class="list">
      <tr><th>Created</th><th>For</th><th>Kind</th><th>Status</th><th>Expires</th></tr>
      {% for i in invitations %}
        <tr><td>{{ (i.created_at | shortDate) if i.created_at else '—' }}</td><td>{{ i.company_name }}{% if i.country %} ({{ i.country }}){% endif %}</td>
          <td>{% if i.kind == 'personal_code' %}Personal code{% if i.code_used %} {{ i.code_used }}{% endif %}{% else %}Buyer registration link (one buyer){% endif %}</td><td>{{ invitationStatuses[i.status] or i.status }}</td><td>{{ (i.expires_at | shortDate) if i.expires_at else '—' }}</td></tr>
      {% endfor %}
      {% if invitations.length == 0 %}<tr><td colspan="5" class="muted">None yet.</td></tr>{% endif %}
    </table>
  </div>

  <div class="section" id="commission">
    <h2>Orders and commission</h2>
    <table class="list">
      <tr><th>Order</th><th>Client</th><th>Stage</th><th>FOB value</th><th>Buyer paid in full</th>{% if rule %}<th>Level</th>{% endif %}<th>Commission</th></tr>
      {% for o in orders %}{% set cm = o.commission %}
        <tr><td><a href="/orders/{{ o.id }}">{{ o.order_reference }}</a></td><td>{{ o.company_legal_name }}</td><td>{{ o.stage }}</td>
          <td>{{ o.currency_code }} {{ o.fob_value | money }}</td><td>{{ 'Yes' if o.buyer_paid_in_full else 'No' }}</td>
          {% if rule %}<td>{{ cm.level or '—' }}</td>{% endif %}{# D-292: levels only with "See associate commission rules" #}
          <td>{% if cm.amount !== null and cm.amount !== undefined %}{{ o.currency_code }} {{ cm.amount | money }}<br>{% endif %}<small>{{ cm.label }}</small></td></tr>
      {% endfor %}
      {% if orders.length == 0 %}<tr><td colspan="7" class="muted">No orders yet.</td></tr>{% endif %}
    </table>
    <h3>Payouts</h3>
    <table class="list">
      <tr><th>Due / payout run</th><th>Order</th><th>Amount INR</th><th>Status</th><th>Paid</th><th>Invoice</th><th>Action</th></tr>
      {% for p in payouts %}{% set inv = invoiceByPayout[p.id] %}
        <tr><td>{% if p.due_on %}due {{ p.due_on | shortDate }}<br><small class="muted">run {{ p.payout_run_on | shortDate }}</small>{% else %}{{ p.incentive_month }}{% endif %}</td><td>{{ p.order_reference }}{% if p.note %}<br><small class="muted">{{ p.note }}</small>{% endif %}</td>
          <td>{{ p.amount_inr | money }}{% if (p.gst_inr | float) > 0 %}<br><small class="muted">+ GST ₹{{ p.gst_inr | money }}</small>{% endif %}</td><td>{{ p.status | capitalize }}{% if p.hold_reason %}<br><small>{{ p.hold_reason }}</small>{% endif %}{% if p.block %}<br><small class="muted">{{ p.block }}</small>{% endif %}</td>
          <td>{% if p.status == 'paid' %}{{ p.paid_on | shortDate }} · ₹{{ p.paid_inr | money }}{% if (p.tds_inr | float) > 0 %} (TDS ₹{{ p.tds_inr | money }}){% endif %}{% if p.paid_reference %}<br><small>{{ p.paid_reference }}</small>{% endif %}{% else %}—{% endif %}</td>
          <td>{% if inv %}<a href="/associates/{{ id }}/documents/{{ inv.id }}">{{ inv.reference or 'Invoice' }}</a>{% else %}—{% endif %}</td>
          <td>
            {% if p.status == 'due' and (p.amount_inr | float) > 0 %}
              <form method="post" action="/associates/payouts/{{ p.id }}/hold" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="text" name="reason" required minlength="10" maxlength="300" placeholder="Reason" aria-label="Reason for the hold"><button type="submit" class="btn-sm btn-secondary">Hold</button></form>
            {% elif p.status == 'held' %}
              <form method="post" action="/associates/payouts/{{ p.id }}/release" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm">Release</button></form>
            {% elif p.status == 'paid' and (p.amount_inr | float) > 0 %}
              {# Owner decision D-245 P3: taken back only for the associate's fraud or breach, with a reason — never for a later buyer claim or refund. #}
              <form method="post" action="/associates/payouts/{{ p.id }}/clawback" class="inline-form" data-confirm="Take this amount back from the associate's next payout?"><input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <select name="takeback_kind" required aria-label="Why it is taken back"><option value="">Choose…</option><option value="fraud">Fraud</option><option value="breach">Breach of the agreement</option></select>
                <input type="number" name="amount_inr" required min="0.01" step="0.01" max="{{ p.paid_inr }}" placeholder="₹" aria-label="Amount to take back">
                <input type="text" name="reason" required minlength="10" maxlength="300" placeholder="What happened" aria-label="What the fraud or breach was"><button type="submit" class="btn-sm btn-secondary">Take back</button></form>
            {% endif %}
          </td></tr>
      {% endfor %}
      {% if payouts.length == 0 %}<tr><td colspan="7" class="muted">No payouts yet. Commission is earned once the buyer has paid an order in full.</td></tr>{% endif %}
    </table>
    <p class="muted small">Accounts pay due payouts on <a href="/incentives/payouts">Incentive payouts</a>, only into a verified bank account. TDS (India, section 194H): {{ tdsPct | pct2 }}% unless the CA advises otherwise; abroad: Form 15CA/15CB.</p>
  </div>
  {% endif %}

  {% include "associates/_bank_section.njk" %}{# D-293 #}

  <div class="section" id="documents">
    <h2>KYC and documents</h2>
    {# Owner decision D-252 (A3): the KYC checklist; commission cannot be marked paid until every item is accepted. #}
    <table class="list"><tr><th>KYC item</th><th>Status</th><th>Document</th></tr>
      {% for i in kyc %}
        <tr><td>{{ i.label }}</td>
          <td><span class="badge {{ {'accepted': 'badge-success', 'rejected': 'badge-danger', 'pending': 'badge-warning'}[i.status] or '' }}">{{ kycLabels[i.status] }}</span></td>
          <td>{% if i.doc %}{{ docKinds[i.doc.kind] or i.doc.kind }}{% if i.doc.id_doc_type %} — {{ idDocTypes[i.doc.id_doc_type] or i.doc.id_doc_type }}{% endif %}{% if i.doc.reference %} · {{ i.doc.reference }}{% endif %}{% elif i.by_nexacrest %}Agreement on the associate record{% else %}—{% endif %}</td></tr>
      {% endfor %}
    </table>
    {% set __kycOk = true %}{% for i in kyc %}{% if i.status != 'accepted' %}{% set __kycOk = false %}{% endif %}{% endfor %}
    <p class="{{ 'muted' if __kycOk else 'review-banner bad' }} small">{{ 'KYC complete — commission can be paid.' if __kycOk else 'KYC not complete — commission cannot be marked paid until every item is accepted.' }}</p>
    {% if addressGrace %}<p class="small" data-address-grace>{{ addressGrace }}</p>{% endif %}{# D-290: 60 days for an associate accepted before 11 Nov 2026 #}
    <p class="muted small">ID proof and address proof are separate items, each checked on its own. The same document (e.g. a passport showing the address) may be uploaded under each; the app names the files "ID proof — name — date" and "Address proof — name — date".</p>
    <table class="list">
      <tr><th>Added</th><th>Document</th><th>Number / reference</th><th>From</th><th>Status</th>{% if canManage %}<th>Check</th>{% endif %}</tr>
      {% for d in documents %}
        <tr><td>{{ d.created_at | shortDate }}</td><td><a href="/associates/{{ id }}/documents/{{ d.id }}">{{ docKinds[d.kind] or d.kind }}</a>{% if d.id_doc_type %} <small class="muted">{{ idDocTypes[d.id_doc_type] or d.id_doc_type }}</small>{% endif %}</td><td>{{ d.reference or '' }}</td><td>{{ 'Associate' if d.uploaded_by_associate == 1 else 'NexaCrest' }}</td>
          <td>{{ {'accepted': 'Accepted', 'rejected': 'Rejected', 'received': 'Not checked yet'}[d.status] or d.status }}{% if d.reviewed_at %}<br><small class="muted">{{ d.reviewed_by_name or '' }}, {{ d.reviewed_at | shortDate }}{% if d.review_reason %} — {{ d.review_reason }}{% endif %}</small>{% endif %}</td>
          {% if canManage %}<td>
            <form method="post" action="/associates/{{ id }}/documents/{{ d.id }}/review" class="inline-form">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <select name="decision" required aria-label="Accept or reject"><option value="">Choose…</option><option value="accept">Accept</option><option value="reject">Reject</option></select>
              <input type="text" name="reason" maxlength="300" placeholder="Reason (needed to reject)" aria-label="Reason" data-required-when="decision=reject" data-required-when-message="Say why it is rejected (at least 10 characters) — the associate sees it." minlength="10">
              <button type="submit" class="btn-sm btn-secondary">Save</button>
            </form></td>{% endif %}</tr>
      {% endfor %}
      {% if documents.length == 0 %}<tr><td colspan="6" class="muted">None yet.</td></tr>{% endif %}
    </table>
    <form method="post" action="/associates/{{ id }}/documents" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        {% set docUploadKinds = allDocKinds %}{% include "associates/_doc_upload_fields.njk" %}
      </div>
      <button type="submit" class="btn-sm">Upload</button>
    </form>
  </div>

  {% if canManage %}
  <div class="section" id="messages">
    <h2>Messages</h2>
    {% for m in messages %}
      <div class="comment"><b>{{ a.name if m.from_associate == 1 else (m.user_name or 'NexaCrest') }}</b> <small class="muted">{{ m.created_at | shortDate }}</small><br>{{ m.body | nl2br }}</div>
    {% endfor %}
    <form method="post" action="/associates/{{ id }}/messages">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <textarea name="body" required maxlength="4000" rows="3" aria-label="Reply" placeholder="Type your message"></textarea>
      <button type="submit" class="btn-sm">Send</button>
    </form>
  </div>

  <div class="section" id="history">
    <h2>History <small class="muted">(nobody can edit it)</small></h2>
    <table class="list">
      {% for e in events %}<tr><td>{{ e.created_at }}</td><td>{{ e.message }}</td></tr>{% endfor %}
    </table>
  </div>
  {% endif %}
  {% endif %}
</div>

{% include "agreements/_party_card.njk" %}
