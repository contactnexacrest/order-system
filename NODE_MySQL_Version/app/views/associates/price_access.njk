{# Owner decision D-255 (5 Nov 2026): what an associate may price (MD — manage_pricing). PHP twin: price_access.php. #}
<div class="card page-mid">
  <div class="page-header-row">
    <h1>Price access — {{ associate.name }}</h1>
    <div class="btn-row" style="margin-top:0"><a class="btn-sm btn-secondary" href="/associates/{{ associate.id }}">Back to the associate</a></div>
  </div>
  <form method="post" action="/associates/{{ associate.id }}/price-access" id="price-access-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <fieldset>
      <legend>Categories and forms open to them</legend>
      <p class="muted small">Tick a category to let them get prices in it. Tick forms to limit them to those forms; no form ticked means every form of the product.</p>
      {% for c in categories %}
        {% set on = access[c.id] !== undefined %}
        <div class="price-access-cat">
          <label class="checkbox"><input type="checkbox" name="category[{{ c.id }}]" value="1"{% if on %} checked{% endif %}> <b>{{ c.name }}</b></label>
          <span class="muted small">— forms:</span>
          {% for fk, fl in forms %}
            <label class="checkbox"><input type="checkbox" name="forms[{{ c.id }}][]" value="{{ fk }}"{% if on and fk in access[c.id] %} checked{% endif %}> {{ fl }}</label>
          {% endfor %}
        </div>
      {% endfor %}
    </fieldset>
    <div class="form-row">
      <label>Price requests per day<input type="number" name="price_request_daily_limit" min="0" max="1000" step="1" value="{{ associate.price_request_daily_limit if associate.price_request_daily_limit !== null else '' }}" placeholder="empty = global ({{ globalLimit }})"></label>
      <label>A price stays valid for (days)<input type="number" name="price_valid_days" min="1" max="365" step="1" value="{{ associate.price_valid_days if associate.price_valid_days !== null else '' }}" placeholder="empty = global ({{ globalDays }})"></label>
    </div>
    <p class="muted small">Global defaults: {{ globalLimit }} a day, {{ globalDays }} days (Pricing › Settings). Every request is logged; prices are shown on screen only (no download or export); supplier names and costs are never shown. Requests our team prices by hand do not count toward the daily limit.</p>
    <button type="submit">Save</button>
  </form>
</div>
