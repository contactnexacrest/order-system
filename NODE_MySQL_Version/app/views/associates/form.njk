{# Add / edit an associate.
   Expects: editing (associate row or null), currencies (rows with code or currency_code), users (active users {id, name}) #}
{% set a0 = editing or {} %}
<div class="card" id="associate-form">
  <h1>{{ ('Edit ' ~ a0.name) if editing else 'Add an associate' }}</h1>
  <p class="muted">The associate's e-mail is their portal login. A new associate starts as <b>Invited</b>; they become <b>Active</b> once Accounts have verified their bank details.</p>
  <form method="post" action="{{ ('/associates/' ~ editing.id ~ '/update') if editing else '/associates' }}" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field-grid">
      <label>Name *<input type="text" name="name" required maxlength="150" value="{{ a0.name }}" placeholder="e.g. Full name as on PAN card"></label>
      <label>Based in *<select name="based_in" required><option value="india"{{ ' selected' if (a0.based_in or 'india') == 'india' else '' }}>India</option><option value="abroad"{{ ' selected' if a0.based_in == 'abroad' else '' }}>Abroad</option></select></label>
      <label>Country<input type="text" name="country" maxlength="80" value="{{ a0.country }}" placeholder="e.g. Netherlands"></label>
      <label>Paid in (currency) *<select name="currency_code" required>
        {% for cur in currencies %}{% set __code = cur.code or cur.currency_code or '' %}
          <option value="{{ __code }}"{{ ' selected' if (a0.currency_code or 'INR') == __code else '' }}>{{ __code }}</option>
        {% endfor %}
      </select></label>
      <label>E-mail (portal login)<input type="email" name="email" maxlength="190" value="{{ a0.email }}" placeholder="e.g. name@company.com"></label>
      <label>Phone<input type="tel" name="phone" maxlength="40" value="{{ a0.phone }}" placeholder="e.g. +91 98765 43210"></label>
      <label>PAN (India)<input type="text" name="pan" maxlength="10" pattern="[A-Za-z]{5}[0-9]{4}[A-Za-z]" title="As on the PAN card, e.g. ABCDE1234F" value="{{ a0.pan }}" placeholder="e.g. ABCDE1234F"></label>
      <label>GSTIN<input type="text" name="gstin" maxlength="15" pattern="[0-9]{2}[A-Za-z0-9]{13}" title="15 characters" value="{{ a0.gstin }}" placeholder="e.g. 29ABCDE1234F1Z5"></label>
      <label>Tax ID (abroad)<input type="text" name="tax_id" maxlength="50" value="{{ a0.tax_id }}" placeholder="e.g. NL123456789B01"></label>
      <label>Reports to <small class="muted">(their sales manager — for information)</small><select name="relationship_manager_id"><option value="">— none —</option>
        {% for u in users %}<option value="{{ u.id }}"{{ ' selected' if a0.relationship_manager_id == u.id else '' }}>{{ u.name }}</option>{% endfor %}
      </select></label>
      <label style="grid-column:1/-1">Address<textarea name="address" maxlength="1000" rows="2" placeholder="e.g. 12 MG Road, Bengaluru 560001">{{ a0.address }}</textarea></label>
      <label>Agreement signed on<input type="date" name="agreement_signed_on" max="{{ today() }}" value="{{ a0.agreement_signed_on }}"{% if a0.agreement_file_id %} required{% else %} data-required-if="agreement_file" data-required-if-message="Enter the date the agreement was signed."{% endif %}></label>
      <label>Agreement ends on<input type="date" name="agreement_ends_on" value="{{ a0.agreement_ends_on }}"></label>
      <label>Signed agreement (PDF){% if a0.agreement_file_id %} &middot; <a href="/associates/{{ a0.id }}/agreement">copy on file</a>, choose a file only to replace it{% endif %}<input type="file" name="agreement_file" accept=".pdf,application/pdf"{% if not a0.agreement_file_id %} data-required-if="agreement_signed_on" data-required-if-message="Attach the signed agreement (PDF) with its signing date."{% endif %}></label>
    </div>
    <fieldset><legend>Commission (on the invoiced FOB of the goods of the client's first orders, paid once the buyer has paid in full)</legend>
      <p class="muted small">D-245: the rate comes from the commission level below — a fixed level, or the ladder. When commission is paid, GST and the registration period: <a href="/associates/ladder">Commission settings</a>.</p>
      <label class="checkbox"><input type="checkbox" name="no_commission" value="1"{{ ' checked' if a0.no_commission == 1 else '' }}> No commission for this associate (introductions only)</label>
    </fieldset>
    {# Owner decision D-245 (4 Nov 2026): a fixed commission level or the ladder (Admin → Pricing → Commission levels). Used for commission from phase P3. #}
    <fieldset><legend>Commission level (D-245)</legend>
      {% set cmode = a0.commission_mode or 'ladder' %}{% set clid = (a0.commission_level_id or '') | string %}
      {% if canPricing %}
        <div class="field-grid">
          <label>How the commission is set *
            <select name="commission_mode" required>
              <option value="ladder"{{ ' selected' if cmode == 'ladder' }}>Ladder (moves up with counting orders)</option>
              <option value="fixed"{{ ' selected' if cmode == 'fixed' }}>Fixed level (stays until you change it)</option>
            </select></label>
          <label>Level (for a fixed level)
            <select name="commission_level_id" data-required-if="commission_mode=fixed" data-required-if-message="Choose the commission level.">
              <option value="">Choose…</option>
              {% for l in commissionLevels %}{% if l.is_active == 1 or (l.id | string) == clid %}
                <option value="{{ l.id }}"{{ ' selected' if (l.id | string) == clid }}>{{ l.name }} — {{ l.label }}{{ '' if l.is_active == 1 else ' (inactive)' }}</option>
              {% endif %}{% endfor %}
            </select></label>
        </div>
        <p class="muted small">Commission is built into this associate's price. A change applies to new quotes only. <a href="/pricing/commission-levels">Commission levels and ladder</a></p>
      {% else %}
        <p class="muted small">Set by the MD: {{ 'fixed level' if cmode == 'fixed' else 'ladder' }}.</p>
      {% endif %}
    </fieldset>
    <label>Notes<input type="text" name="notes" maxlength="500" value="{{ a0.notes }}" placeholder="Optional notes"></label>
    <div class="btn-row"><button type="submit">{{ 'Save' if editing else 'Add associate' }}</button> <a href="{{ ('/associates/' ~ editing.id) if editing else '/associates' }}">Cancel</a></div>
  </form>
</div>
