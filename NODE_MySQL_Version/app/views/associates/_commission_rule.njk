{# Port of _commission_rule.php. Owner decisions 11 Nov 2026, points 8 and 9 (D-291 / D-292): the commission rule on
   the associate's staff page. With "See associate commission rules": the rule, the % and level of the next order,
   the counting orders so far ("3 of 5"), the steps and the plain counting rule; the MD (manage_pricing) changes it.
   Everyone else: "Set by the MD." Expects a, id, rule (null without the permission), canPricing. #}
  <div class="section" id="commission-rule">
    <h2>Commission{% if rule %} — {{ a.name }}{% endif %}</h2>
    {% if a.no_commission == 1 %}
      <p><b>No commission</b> (introductions only).</p>
    {% elif not rule %}
      <p data-commission-rule-hidden>Set by the MD. <small class="muted">(rule, levels and rates not shown)</small></p>
    {% else %}
      <table class="kv" data-commission-rule>
        <tr><th>Rule</th><td><b>{{ rule.rule }}</b>{% if rule.changed_at %} <small class="muted">(set {{ rule.changed_at | shortDate }}{% if rule.changed_by %} by {{ rule.changed_by }}{% endif %}{% if rule.reason %} — reason: "{{ rule.reason }}"{% endif %})</small>{% endif %}
          {% if rule.mode == 'ladder' %}<br><small class="muted">{{ rule.standard }}</small>{% endif %}</td></tr>
        <tr><th>Next order earns</th><td><b class="stat-value">{{ rule.rate }}</b>{% if rule.level_name %} — {{ rule.level_name }}{% endif %}</td></tr>
        {% if rule.mode != 'fixed' %}
        <tr><th>Orders counted so far</th><td><b>{{ rule.count }}{% if rule.of !== null %} of {{ rule.of }}{% endif %}</b>{% if rule.next_rate !== null %} — {{ rule.more }} more counting order{{ '' if rule.more == 1 else 's' }} to reach {{ rule.next_rate }}{% else %} — the top step{% endif %}</td></tr>
        {% endif %}
      </table>
      {% if rule.mode != 'fixed' %}
        <div class="stat-row" data-ladder-steps>
          {% for s in rule.steps %}
            <div class="stat{{ ' stat-current' if s.current }}"{% if s.current %} style="border:2px solid var(--accent, #c9962b)"{% endif %}><div class="stat-label">{{ s.label }}</div>
              <div class="stat-value">{{ s.rate }}</div><small>{{ s.level_name }}{{ ' · ← now' if s.current }}</small></div>
          {% endfor %}
        </div>
        <p class="muted small">An order counts once the buyer has paid in full and its invoiced FOB value is ₹{{ rule.threshold_inr | money0 }} or more. A smaller order earns the current % but does not count.</p>
      {% endif %}
      {% if canPricing %}
        <div class="btn-row">
          {% if rule.mode == 'own_ladder' %}
            <a class="btn-sm" href="/associates/{{ id }}/commission-rule?rule=own_ladder">Edit own ladder</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=ladder">Remove own ladder — use the standard ladder</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=fixed">Set a fixed %</a>
          {% elif rule.mode == 'fixed' %}
            <a class="btn-sm" href="/associates/{{ id }}/commission-rule?rule=fixed">Change the fixed %</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=ladder">Use the standard ladder</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=own_ladder">+ Add own ladder for this associate</a>
          {% else %}
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=own_ladder">+ Add own ladder for this associate</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=fixed">Set a fixed %</a>
          {% endif %}
        </div>
        <p class="muted small">"Add own ladder" only when needed: it opens a copy of the standard ladder to change. Changes apply to new orders only (an order keeps the % fixed at its Proforma Invoice); a reason is needed and kept in the Audit Log.</p>
      {% endif %}
    {% endif %}
  </div>
