{# Port of _commission_rule.php. Owner decisions 11 Nov 2026, points 8 and 9 (D-291 / D-292): the commission rule on
   the associate's staff page. With "See associate commission rules": the rule, the % and level of the next order,
   the counting orders so far ("3 of 5"), the steps and the plain counting rule; "Manage associate rules" (D-411: MD, ED, others given it) changes it.
   Everyone else: "Set by the MD / ED." Expects a, id, rule (null without the permission), canPricing.
   D-410 (24 Nov 2026): "Ladder steps so far" with the new counting text, what the client's price includes for this
   associate (company setting or their own, MD with a reason), the "Right now" line and "Paid from our margin so far".
   Also expects priceRule, rightNow, marginSoFar, priceRules, priceRuleText, groupDays, minOrderInr. #}
  <div class="section" id="commission-rule">
    <h2>Commission{% if rule %} — {{ a.name }}{% endif %}</h2>
    {% if a.no_commission == 1 %}
      <p><b>No commission</b> (introductions only).</p>
    {% elif not rule %}
      <p data-commission-rule-hidden>Set by the MD / ED. <small class="muted">(rule, levels and rates not shown)</small></p>
    {% else %}
      <table class="kv" data-commission-rule>
        <tr><th>Rule</th><td><b>{{ rule.rule }}</b>{% if rule.changed_at %} <small class="muted">(set {{ rule.changed_at | shortDate }}{% if rule.changed_by %} by {{ rule.changed_by }}{% endif %}{% if rule.reason %} — reason: "{{ rule.reason }}"{% endif %})</small>{% endif %}
          {% if rule.mode == 'ladder' %}<br><small class="muted">{{ rule.standard }}</small>{% endif %}</td></tr>
        <tr><th>Next order earns</th><td><b class="stat-value">{{ rule.rate }}</b>{% if rule.level_name %} — {{ rule.level_name }}{% endif %}</td></tr>
        {% if rule.mode != 'fixed' %}
        <tr><th>Ladder steps so far <span class="help" title="Orders of ₹{{ minOrderInr | inr0 }} or more count as one step each once the advance has cleared. Orders of the same client within {{ groupDays }} days of the first are one step.">ℹ</span></th><td><b>{{ rule.count }}{% if rule.of !== null %} of {{ rule.of }}{% endif %}</b>{% if rule.next_rate !== null %} — {{ rule.more }} more counting order{{ '' if rule.more == 1 else 's' }} to reach {{ rule.next_rate }}{% else %} — the top step{% endif %}</td></tr>
        {% endif %}
      </table>
      {% if rule.mode != 'fixed' %}
        <div class="stat-row" data-ladder-steps>
          {% for s in rule.steps %}
            <div class="stat{{ ' stat-current' if s.current }}"{% if s.current %} style="border:2px solid var(--accent, #c9962b)"{% endif %}><div class="stat-label">{{ s.label }}</div>
              <div class="stat-value">{{ s.rate }}</div><small>{{ s.level_name }}{{ ' · ← now' if s.current }}</small></div>
          {% endfor %}
        </div>
        <p class="muted small" data-step-rule>An order of ₹{{ minOrderInr | inr0 }} or more (value of the goods, FOB) counts as one ladder step once its advance has cleared (LC orders: once the LC is confirmed; no advance and no LC: once the buyer has paid in full). Orders of the same client within {{ groupDays }} days of the first order of the group are one step. A smaller order earns nothing and does not count — except the client's first order, which always earns. Cancelled orders never count.</p>
      {% endif %}
      {% if priceRule %}
        {% set __fmtPct = (priceRule.pct | float(0)).toFixed(2) | replace(r/\.?0+$/, '') %}
        <h3 id="price-rule">Commission in the client's price <span class="help" title="How much commission the client's price already includes for this associate. Above it, the rest is paid from our margin.">ℹ</span></h3>
        <table class="kv" data-price-rule>
          <tr><th>Uses</th><td><b>{{ priceRules[priceRule.rule] }}{% if priceRule.pct !== null %} — {{ __fmtPct }}%{% endif %}</b> <small class="muted">{{ "(this associate's own choice)" if priceRule.own else '(the company setting — Admin → Pricing)' }}</small></td></tr>
          <tr><th>Right now</th><td data-right-now>{{ rightNow }}</td></tr>
          {% if marginSoFar %}<tr><th>Paid from our margin so far <span class="help" title="This financial year (from 1 April): the commission above the % in the client's price, on orders whose buyer has paid in full. Orders whose buyer is still paying are shown on the line below as expected.">ℹ</span></th><td data-margin-so-far>₹{{ marginSoFar.inr | inr }} <small class="muted">on {{ marginSoFar.orders }} order{{ '' if marginSoFar.orders == 1 else 's' }} this financial year (buyer paid in full)</small>{% if marginSoFar.open_orders > 0 %}<br><small class="muted" data-margin-expected>+ ₹{{ marginSoFar.open_inr | inr }} expected on {{ marginSoFar.open_orders }} open order{{ '' if marginSoFar.open_orders == 1 else 's' }} (buyer still paying)</small>{% endif %}</td></tr>{% endif %}
        </table>
        {% if canPricing %}
          <details class="card"><summary>Change for this associate</summary>
          <form method="post" action="/associates/{{ id }}/price-rule" data-price-rule-form>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <div class="choice-group"><label><input type="radio" name="price_rule" value="company"{{ ' checked' if not priceRule.own }} required> Use the company setting</label>
              <span class="choice-help">Follows Admin › Pricing › Settings (today: {{ priceRules[companyPriceRule] }}).</span></div>
            {% for k, l in priceRules %}
              <div class="choice-group"><label><input type="radio" name="price_rule" value="{{ k }}"{{ ' checked' if priceRule.own and priceRule.rule == k }}> {{ l }}</label>
                <span class="choice-help">{{ priceRuleText[k] }}</span>
                {% if k == 'fixed' %}<label class="choice-extra">Fixed % <input type="number" name="price_rule_fixed_pct" min="0" max="50" step="0.01" placeholder="e.g. 5" style="width:7em" aria-label="Fixed % included in the client's price" data-required-when="price_rule=fixed" value="{{ priceRule.pct if (priceRule.own and priceRule.rule == 'fixed') else '' }}"> %</label>{% endif %}</div>
            {% endfor %}
            <label>Reason for the change *<input type="text" name="price_rule_reason" required minlength="10" maxlength="255" placeholder="e.g. Agreed with the associate on 24 Nov for the new market"></label>
            <p class="muted small">New prices only: orders whose prices are already fixed keep them. Kept in the Audit Log.</p>
            <button type="submit">Save</button>
          </form>
          </details>
        {% endif %}
      {% endif %}
      {% if canPricing %}
        <div class="btn-row">
          {% if rule.mode == 'own_ladder' %}
            <a class="btn-sm" href="/associates/{{ id }}/commission-rule?rule=own_ladder">Edit own ladder</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=ladder">Remove own ladder — use the standard ladder</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=fixed">Set a fixed %</a>
          {% elif rule.mode == 'fixed' %}
            <a class="btn-sm" href="/associates/{{ id }}/commission-rule?rule=fixed">Change the fixed %</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=ladder">Use the standard ladder</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=own_ladder">+ Add own ladder for this associate</a>
          {% else %}
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=own_ladder">+ Add own ladder for this associate</a>
            <a class="btn-sm btn-secondary" href="/associates/{{ id }}/commission-rule?rule=fixed">Set a fixed %</a>
          {% endif %}
        </div>
        <p class="muted small">"Add own ladder" only when needed: it opens a copy of the standard ladder to change. Changes apply to new orders only (an order keeps the % fixed at its Proforma Invoice); a reason is needed and kept in the Audit Log.</p>
      {% endif %}
    {% endif %}
  </div>
