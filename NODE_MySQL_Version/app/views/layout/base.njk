<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NexaCrest International — Export Operations</title>
<link rel="icon" href="/img/favicon.ico?v=2" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png?v=2">
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png?v=2">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png?v=2">
<link rel="stylesheet" href="{{ asset('/css/app.css') }}">
<script src="{{ asset('/js/app.js') }}" defer></script>
{% if idleMeta %}<meta name="session-idle" content="{{ idleMeta.idle }}" data-warn="{{ idleMeta.warn }}"{% if idleMeta.absoluteLeft is number %} data-absolute-left="{{ idleMeta.absoluteLeft }}"{% endif %} data-keepalive="{{ idleMeta.keepalive }}" data-login="{{ idleMeta.login }}" data-csrf="{{ csrfToken }}">{% endif %}{# D-283: idle warning popup (app.js) #}
</head>
<body>
{% if devServerEnabled %}
  <div class="dev-server-banner">&#9888; DEV / TEST ENVIRONMENT — this is not the production server &#9888;</div>
{% endif %}
<div class="app-shell">
<header class="sidebar">
  <div class="sidebar-brand">
    <span class="sidebar-brand-mark" aria-hidden="true">
      <img src="/img/logo.jpg" alt="">
    </span>
    <span class="sidebar-brand-name">NexaCrest</span>
  </div>
  {% if currentUser %}
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">&#9776;</label>
  {% endif %}
  <nav class="sidebar-nav" data-testid="main-menu">
    {# Owner decision D-320 (point 26): the short left menu (13 entries), built from src/config/navigation.json (services/navigation.js) — each entry shows only when this person can open at least one page behind it. #}
    {% if not nav %}
      <a href="/" class="{{ 'active' if currentPath === '/' else '' }}">Dashboard</a>
    {% else %}{% for entry in nav.sidebar %}
      {% if entry.heading %}<div class="nav-heading">{{ entry.heading }}</div>{% endif %}
      <a href="{{ entry.href }}" class="{{ 'active' if entry.active else '' }}" data-nav="{{ entry.key }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ entry.icon | safe }}</svg></span>{{ entry.label }}{% if entry.count > 0 %} <span class="nav-badge">{{ entry.count }}</span>{% endif %}</a>
    {% endfor %}{% endif %}
  </nav>
  <div class="sidebar-user">
    {% if currentUser %}
      <a href="/notifications" class="sidebar-user-notif {{ 'active' if (currentPath | startswith('/notifications')) else '' }}" aria-label="Notifications{% if unreadCount > 0 %} ({{ unreadCount }} unread){% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        Notifications{% if unreadCount > 0 %} <span class="nav-badge">{{ unreadCount }}</span>{% endif %}
      </a>
      {% if actingMembership %}
        <div class="dept-badge" style="--dept-color:{{ actingMembership.department_color }}" data-testid="dept-badge">
          <span class="dept-badge-label">Logged in as</span>
          <strong>{{ actingMembership.designation_title }}</strong>
          {{ actingMembership.department_name }}
          {% if myMemberships.length > 1 %}
            <details class="dept-switch">
              <summary>Switch department &#9662;</summary>
              <div class="dept-switch-list">
                {% for m in myMemberships %}
                  {% if m.id == actingMembership.id %}
                    <div class="current">&#9679; {{ m.designation_title }} — {{ m.department_name }}</div>
                  {% else %}
                    <form method="post" action="/switch-department"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="membership_id" value="{{ m.id }}"><button type="submit">&#9675; {{ m.designation_title }} — {{ m.department_name }}</button></form>
                  {% endif %}
                {% endfor %}
                <div class="hint">Switching reloads the app with that department's menus, tasks and data.</div>
              </div>
            </details>
          {% endif %}
        </div>
      {% endif %}
      {% if division.showSwitcher %}{# D-257: company level, two or more active divisions #}
        <form method="post" action="/divisions/choose" class="division-switch" data-testid="division-switcher" style="margin:8px 0;color:#fff;font-size:12px">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="back" value="{{ currentPath }}">
          <label>Division
            <select name="division" onchange="this.form.submit()">
              <option value="all"{{ ' selected' if division.currentId === null else '' }}>All divisions</option>
              {% for d in division.active %}
                <option value="{{ d.id }}"{{ ' selected' if division.currentId == d.id else '' }}>{{ d.name }}</option>
              {% endfor %}
            </select>
          </label>
          <noscript><button type="submit" class="btn-sm">Show</button></noscript>
        </form>
      {% endif %}
      <a href="/account" class="sidebar-user-card">
        <span class="sidebar-user-avatar">{{ currentUser.name[0] | upper }}</span>
        <span class="sidebar-user-name">{{ currentUser.name }}</span>
      </a>
      <form method="post" action="/logout" class="sidebar-logout-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="sidebar-logout">Log out</button></form>
    {% endif %}
  </div>
</header>
<div class="app-main">
  {% if previewDesignation %}
    <div class="preview-banner" data-testid="preview-banner">
      <span>Previewing the app as {{ previewDesignation.title }} · {{ previewDesignation.department_name }} — you see only what this designation sees (your own extra rights are off).</span>
      <form method="post" action="/preview/exit"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm">Exit preview</button></form>
    </div>
  {% endif %}
  {% if testModeEnabled %}
    <div class="test-mode-banner">TEST MODE ACTIVE — client access suspended, all outbound business mail is redirected, admin panel settings are locked. Any order/client/document created now is test data.</div>
  {% endif %}
  <main class="page">
    {% if nav and nav.bar %}{% set bar = nav.bar %}{% include "partials/section_nav.njk" %}{% endif %}{# D-320: this section's menu bar #}
    {% for f in flashes %}
      <div class="alert alert-{{ f.type }}">{{ f.message }}{% if f.copy_link %}{% set copyLink = f.copy_link %}{% set copyNote = null %}{% include "partials/copy_link.njk" %}{% endif %}{# D-280 #}</div>
    {% endfor %}
    {% if (currentPath | startswith('/reports')) and division.showSwitcher %}{# D-257: one shared Division filter for every report (two or more active divisions only) #}
      <form method="get" class="report-division-filter" data-testid="report-division-filter">
        {% for k, v in query %}{% if k != 'division' and (v is string or v is number) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endif %}{% endfor %}
        <label>Division
          <select name="division" onchange="this.form.submit()">
            <option value="">All divisions</option>
            {% for d in division.active %}
              <option value="{{ d.id }}"{{ ' selected' if (query.division | int) == d.id else '' }}>{{ d.name }}</option>
            {% endfor %}
          </select>
        </label>
        <noscript><button type="submit" class="btn-sm">Show</button></noscript>
      </form>
    {% endif %}
    {{ content | safe }}
  </main>
</div>
</div>
<script>
/* 90-item backlog "sitewide collapsible sections beyond Settings": the
   independently-collapsible, per-browser-remembered <details> pattern
   90-item backlog #27 built for Company Settings (originally inline in
   views/settings/index.njk, class="settings-section") is now sitewide —
   any page's <details class="collapsible-section" data-category="X">
   gets the same open/closed persistence, keyed on its own data-category
   so a staff member's preference for one section never leaks into
   another's. The storage key keeps the original "settings-section-open:"
   prefix (an internal namespace, invisible to users) rather than
   resetting a Settings user's stored preference for a rename with no
   visible benefit. Inputs inside a closed <details> still submit
   normally, so collapsing a section never drops its values. */
document.querySelectorAll('.collapsible-section[data-category]').forEach(function (details) {
  var storageKey = 'settings-section-open:' + details.dataset.category;
  try {
    var stored = localStorage.getItem(storageKey);
    if (stored !== null) { details.open = stored === '1'; }
  } catch (e) { /* ignore — storage unavailable, keep the default open state */ }
  details.addEventListener('toggle', function () {
    try { localStorage.setItem(storageKey, details.open ? '1' : '0'); } catch (e) { /* ignore */ }
  });
});
</script>
</body>
</html>
