<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NexaCrest International — Export Operations</title>
<link rel="icon" href="/img/favicon.ico?v=2" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png?v=2">
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png?v=2">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png?v=2">
<link rel="stylesheet" href="{{ asset('/css/app.css') }}">
<script src="{{ asset('/js/app.js') }}" defer></script>
</head>
<body>
{% if devServerEnabled %}
  <div class="dev-server-banner">&#9888; DEV / TEST ENVIRONMENT — this is not the production server &#9888;</div>
{% endif %}
{% set canDisputes = permissions.manage_disputes or permissions.respond_to_disputes %}
{# docs/schema.sql Section BX — a Complaint is not a Dispute; same visibility split. #}
{% set canComplaints = permissions.manage_complaints or permissions.respond_to_complaints %}
{% set canViewComplaintsList = permissions.manage_complaints or permissions.respond_to_complaints %}
{# External QA report U-18: /clients and /orders each also accept their own narrower view_clients/view_orders permission (server.js) — a Viewer/Auditor holds exactly these two and nothing else in this group, so without them here the whole Operations dropdown never rendered at all, even though both routes worked fine by direct URL. #}
{% set opsGroupVisible = permissions.manage_orders or permissions.view_archived_orders or canDisputes or canComplaints or permissions.view_clients or permissions.view_orders %}
{# External QA report U-01: the main /disputes LIST route requires manage_disputes only (see server.js) — respond_to_disputes alone (e.g. Export Executive) never grants the cross-order list page. canDisputes above stays as the Ops group's own broader visibility check. #}
{% set canViewDisputesList = permissions.manage_disputes or permissions.respond_to_disputes %}
{% set insightsGroupVisible = permissions.view_reports or permissions.view_audit_log or permissions.pay_incentives or permissions.view_own_incentives %}
{# 90-item backlog #34: manage_hs_codes/manage_compliance_task_types/
   manage_dropdown_options/manage_email_templates each gate their own link
   inside this dropdown but were never added to the group's own visibility
   check — a role whose ONLY Admin-section permission was one of these
   four saw no "Admin" dropdown at all. #}
{% set adminGroupVisible = permissions.manage_company_settings or permissions.manage_assets or permissions.manage_signatories or permissions.manage_permissions or permissions.manage_users or permissions.manage_field_protection or permissions.edit_locked_data or permissions.manage_sample_data or permissions.data_export_run or permissions.manage_logistics_partners or permissions.manage_suppliers or permissions.manage_ports or permissions.manage_payment_presets or permissions.manage_hs_codes or permissions.manage_compliance_task_types or permissions.manage_dropdown_options or permissions.manage_email_templates or permissions.manage_incentives %}
{% set opsGroupActive = (currentPath | startswith('/clients')) or (currentPath | startswith('/orders')) or (currentPath | startswith('/client-intake')) or (currentPath | startswith('/pi-intake-review')) or (currentPath | startswith('/reorder-requests')) or (currentPath | startswith('/disputes')) or (currentPath | startswith('/complaints')) %}
{% set insightsGroupActive = (currentPath | startswith('/reports')) or (currentPath | startswith('/audit-log')) or (currentPath | startswith('/incentives/payouts')) or (currentPath | startswith('/my-incentives')) %}
{% set adminGroupActive = (currentPath | startswith('/settings')) or (currentPath | startswith('/holidays')) or (currentPath | startswith('/hs-codes')) or (currentPath | startswith('/watermarks')) or (currentPath | startswith('/company-assets')) or (currentPath | startswith('/signatories')) or (currentPath | startswith('/admin')) or (currentPath | startswith('/users')) or (currentPath | startswith('/sample-data')) or (currentPath | startswith('/email-templates')) or (currentPath | startswith('/ui-templates')) or (currentPath | startswith('/logistics-partners')) or (currentPath | startswith('/suppliers')) or (currentPath | startswith('/ports')) or (currentPath | startswith('/payment-presets')) or (currentPath | startswith('/compliance-task-types')) or (currentPath | startswith('/incentives/settings')) or (currentPath | startswith('/associates')) %}
{% set ordersActive = currentPath === '/orders' or ((currentPath | startswith('/orders/')) and not (currentPath | startswith('/orders/archived'))) %}
<div class="app-shell">
<header class="sidebar">
  <div class="sidebar-brand">
    <span class="sidebar-brand-mark" aria-hidden="true">
      <img src="/img/logo.jpg" alt="">
    </span>
    <span class="sidebar-brand-name">NexaCrest</span>
  </div>
  {% if currentUser %}
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">&#9776;</label>
  {% endif %}
  <nav class="sidebar-nav">
    <a href="/" class="{{ 'active' if currentPath === '/' else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg></span>Dashboard</a>
    {% if currentUser %}
      <a href="/getting-started" target="_blank" rel="noopener"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg></span>Getting Started</a>
      <a href="/reference-docs" class="{{ 'active' if (currentPath | startswith('/reference-docs')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg></span>Reference Library</a>
      <a href="/sop" target="_blank" rel="noopener"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></span>SOP / Operations Guide</a>
      <a href="/gallery" class="{{ 'active' if (currentPath | startswith('/gallery')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg></span>Gallery</a>
      <a href="/reviews" class="{{ 'active' if (currentPath | startswith('/reviews')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>My Reviews{% if myReviewsPendingCount > 0 %} <span class="nav-badge">{{ myReviewsPendingCount }}</span>{% endif %}</a>
      {% if permissions.approve_email_send %}<a href="/email-approvals" class="{{ 'active' if (currentPath | startswith('/email-approvals')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg></span>Email Approvals{% if emailApprovalsPendingCount > 0 %} <span class="nav-badge">{{ emailApprovalsPendingCount }}</span>{% endif %}</a>{% endif %}
      {% if permissions.ca_module_view %}<a href="/ca" class="{{ 'active' if (currentPath | startswith('/ca')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></span>CA / Accounting</a>{% endif %}
      {% if permissions.view_product_catalog %}<a href="/products" class="{{ 'active' if (currentPath | startswith('/products')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></span>Products</a>{% endif %}
    {% endif %}
    {% if currentUser and opsGroupVisible %}
      <details class="nav-group" {{ 'open' if opsGroupActive else '' }}>
        <summary><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg></span>Operations</summary>
        <div class="nav-dropdown">
          {% if permissions.manage_orders or permissions.view_clients %}<a href="/clients" class="{{ 'active' if (currentPath | startswith('/clients')) else '' }}">Clients</a>{% endif %}
          {% if permissions.manage_orders or permissions.view_orders %}<a href="/orders" class="{{ 'active' if ordersActive else '' }}">Orders</a>{% endif %}
          {% if permissions.view_archived_orders %}<a href="/orders/archived" class="{{ 'active' if (currentPath | startswith('/orders/archived')) else '' }}">Archived Orders</a>{% endif %}
          {# QA Round 5, R5-22: these three routes need manage_orders. #}
          {% if permissions.manage_orders %}
          <a href="/client-intake" class="{{ 'active' if (currentPath | startswith('/client-intake')) else '' }}">Quotation Intake Review{% if clientIntakePendingCount > 0 %} <span class="nav-badge">{{ clientIntakePendingCount }}</span>{% endif %}</a>
          <a href="/pi-intake-review" class="{{ 'active' if (currentPath | startswith('/pi-intake-review')) else '' }}">PI Intake Review{% if piIntakePendingCount > 0 %} <span class="nav-badge">{{ piIntakePendingCount }}</span>{% endif %}</a>
          <a href="/reorder-requests" class="{{ 'active' if (currentPath | startswith('/reorder-requests')) else '' }}">Reorder Requests</a>
          {% endif %}
          {% if canViewDisputesList %}<a href="/disputes" class="{{ 'active' if (currentPath | startswith('/disputes')) else '' }}">Disputes</a>{% endif %}
          {% if canViewComplaintsList %}<a href="/complaints" class="{{ 'active' if (currentPath | startswith('/complaints')) else '' }}">Complaints</a>{% endif %}
        </div>
      </details>
    {% endif %}
    {% if currentUser and insightsGroupVisible %}
      <details class="nav-group" {{ 'open' if insightsGroupActive else '' }}>
        <summary><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg></span>Insights</summary>
        <div class="nav-dropdown">
          {% if permissions.view_reports %}<a href="/reports" class="{{ 'active' if (currentPath | startswith('/reports')) else '' }}">Reports</a>{% endif %}
          {% if permissions.pay_incentives %}<a href="/incentives/payouts" class="{{ 'active' if (currentPath | startswith('/incentives/payouts')) else '' }}">Incentive Payouts</a>{% endif %}
          {% if permissions.view_own_incentives %}<a href="/my-incentives" class="{{ 'active' if (currentPath | startswith('/my-incentives')) else '' }}">My Incentives</a>{% endif %}
          {% if permissions.view_audit_log %}<a href="/audit-log" class="{{ 'active' if (currentPath | startswith('/audit-log')) else '' }}">Audit Log</a>{% endif %}
        </div>
      </details>
    {% endif %}
    {% if currentUser and adminGroupVisible %}
      <details class="nav-group" {{ 'open' if adminGroupActive else '' }}>
        <summary><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></span>Admin</summary>
        <div class="nav-dropdown">
          {% if permissions.manage_company_settings %}<a href="/settings" class="{{ 'active' if (currentPath | startswith('/settings')) else '' }}">Company Settings{% if settingsExpiryWarningCount > 0 %} <span class="nav-badge">{{ settingsExpiryWarningCount }}</span>{% endif %}</a>{% endif %}
          {% if permissions.manage_company_settings %}<a href="/holidays" class="{{ 'active' if (currentPath | startswith('/holidays')) else '' }}">Holiday Calendar</a>{% endif %}
          {% if permissions.manage_hs_codes %}<a href="/hs-codes" class="{{ 'active' if (currentPath | startswith('/hs-codes')) else '' }}">HS Codes</a>{% endif %}
          {% if permissions.manage_logistics_partners %}<a href="/logistics-partners" class="{{ 'active' if (currentPath | startswith('/logistics-partners')) else '' }}">Logistics Partners</a>{% endif %}
          {% if permissions.manage_suppliers %}<a href="/suppliers" class="{{ 'active' if (currentPath | startswith('/suppliers')) else '' }}">Suppliers</a>{% endif %}
          {% if permissions.manage_ports %}<a href="/ports" class="{{ 'active' if (currentPath | startswith('/ports')) else '' }}">Ports</a>{% endif %}
          {% if permissions.manage_payment_presets %}<a href="/payment-presets" class="{{ 'active' if (currentPath | startswith('/payment-presets')) else '' }}">Payment Presets</a>{% endif %}
          {% if permissions.manage_compliance_task_types %}<a href="/compliance-task-types" class="{{ 'active' if (currentPath | startswith('/compliance-task-types')) else '' }}">Compliance Task Types</a>{% endif %}
          {% if permissions.manage_dropdown_options %}<a href="/admin/dropdown-options" class="{{ 'active' if (currentPath | startswith('/admin/dropdown-options')) else '' }}">Dropdown Option Lists</a>{% endif %}
          {% if permissions.manage_email_templates %}<a href="/email-templates" class="{{ 'active' if (currentPath | startswith('/email-templates')) else '' }}">Email Templates</a>{% endif %}
          {% if permissions.manage_company_settings %}<a href="/ui-templates" class="{{ 'active' if (currentPath | startswith('/ui-templates')) else '' }}">UI Templates</a>{% endif %}
          {% if permissions.manage_company_settings %}<a href="/watermarks" class="{{ 'active' if (currentPath | startswith('/watermarks')) else '' }}">Watermarks</a>{% endif %}
          {% if permissions.manage_assets %}<a href="/company-assets" class="{{ 'active' if (currentPath | startswith('/company-assets')) else '' }}">Assets</a>{% endif %}
          {% if permissions.manage_signatories %}<a href="/signatories" class="{{ 'active' if (currentPath | startswith('/signatories')) else '' }}">Signatories</a>{% endif %}
          {% if permissions.manage_permissions %}<a href="/admin/departments" class="{{ 'active' if (currentPath | startswith('/admin/departments')) else '' }}">Departments</a>{% endif %}
          {% if permissions.manage_permissions %}<a href="/admin/permissions" class="{{ 'active' if (currentPath | startswith('/admin/permissions')) else '' }}">Permissions</a>{% endif %}
          {% if permissions.manage_users %}<a href="/users" class="{{ 'active' if (currentPath | startswith('/users')) else '' }}">Users</a>{% endif %}
          {% if permissions.manage_field_protection %}<a href="/admin/field-protection" class="{{ 'active' if (currentPath | startswith('/admin/field-protection')) else '' }}">Field Protection</a>{% endif %}
          {% if permissions.manage_incentives %}<a href="/incentives/settings" class="{{ 'active' if (currentPath | startswith('/incentives/settings')) else '' }}">Team Incentives</a><a href="/associates" class="{{ 'active' if (currentPath | startswith('/associates')) else '' }}">Associates</a>{% endif %}
          {% if permissions.edit_locked_data %}<a href="/admin/overrides" class="{{ 'active' if (currentPath | startswith('/admin/overrides')) else '' }}">Admin Overrides</a>{% endif %}
          {% if permissions.manage_sample_data %}<a href="/sample-data" class="{{ 'active' if (currentPath | startswith('/sample-data')) else '' }}">Sample Data</a>{% endif %}
          {% if permissions.data_export_run %}<a href="/admin/data-export" class="{{ 'active' if (currentPath | startswith('/admin/data-export')) else '' }}">Data Export / Migration</a>{% endif %}
        </div>
      </details>
    {% endif %}
    {% if isSuperAdmin %}
      <a href="/super-admin" class="{{ 'active' if (currentPath | startswith('/super-admin')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg></span>Super Admin</a>
      <a href="/test-mode" class="{{ 'active' if (currentPath | startswith('/test-mode')) else '' }}"><span class="nav-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6L4 20a1 1 0 0 0 1 2h14a1 1 0 0 0 1-2L15 8V2"></path><path d="M8.5 14h7"></path></svg></span>Test Mode{% if testModeEnabled %} <span class="nav-live-dot" aria-hidden="true"></span>{% endif %}</a>
    {% endif %}
  </nav>
  <div class="sidebar-user">
    {% if currentUser %}
      <a href="/notifications" class="sidebar-user-notif {{ 'active' if (currentPath | startswith('/notifications')) else '' }}" aria-label="Notifications{% if unreadCount > 0 %} ({{ unreadCount }} unread){% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        Notifications{% if unreadCount > 0 %} <span class="nav-badge">{{ unreadCount }}</span>{% endif %}
      </a>
      {% if actingMembership %}
        <div class="dept-badge" style="--dept-color:{{ actingMembership.department_color }}" data-testid="dept-badge">
          <span class="dept-badge-label">Logged in as</span>
          <strong>{{ actingMembership.designation_title }}</strong>
          {{ actingMembership.department_name }}
          {% if myMemberships.length > 1 %}
            <details class="dept-switch">
              <summary>Switch department &#9662;</summary>
              <div class="dept-switch-list">
                {% for m in myMemberships %}
                  {% if m.id == actingMembership.id %}
                    <div class="current">&#9679; {{ m.designation_title }} — {{ m.department_name }}</div>
                  {% else %}
                    <form method="post" action="/switch-department"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="membership_id" value="{{ m.id }}"><button type="submit">&#9675; {{ m.designation_title }} — {{ m.department_name }}</button></form>
                  {% endif %}
                {% endfor %}
                <div class="hint">Switching reloads the app with that department's menus, tasks and data.</div>
              </div>
            </details>
          {% endif %}
        </div>
      {% endif %}
      <a href="/account" class="sidebar-user-card">
        <span class="sidebar-user-avatar">{{ currentUser.name[0] | upper }}</span>
        <span class="sidebar-user-name">{{ currentUser.name }}</span>
      </a>
      <form method="post" action="/logout" class="sidebar-logout-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="sidebar-logout">Log out</button></form>
    {% endif %}
  </div>
</header>
<div class="app-main">
  {% if previewDesignation %}
    <div class="preview-banner" data-testid="preview-banner">
      <span>Previewing the app as {{ previewDesignation.title }} · {{ previewDesignation.department_name }} — you see only what this designation sees (your own extra rights are off).</span>
      <form method="post" action="/preview/exit"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm">Exit preview</button></form>
    </div>
  {% endif %}
  {% if testModeEnabled %}
    <div class="test-mode-banner">TEST MODE ACTIVE — client access suspended, all outbound business mail is redirected, admin panel settings are locked. Any order/client/document created now is test data.</div>
  {% endif %}
  <main class="page">
    {% for f in flashes %}
      <div class="alert alert-{{ f.type }}">{{ f.message }}</div>
    {% endfor %}
    {{ content | safe }}
  </main>
</div>
</div>
<script>
/* 90-item backlog "sitewide collapsible sections beyond Settings": the
   independently-collapsible, per-browser-remembered <details> pattern
   90-item backlog #27 built for Company Settings (originally inline in
   views/settings/index.njk, class="settings-section") is now sitewide —
   any page's <details class="collapsible-section" data-category="X">
   gets the same open/closed persistence, keyed on its own data-category
   so a staff member's preference for one section never leaks into
   another's. The storage key keeps the original "settings-section-open:"
   prefix (an internal namespace, invisible to users) rather than
   resetting a Settings user's stored preference for a rename with no
   visible benefit. Inputs inside a closed <details> still submit
   normally, so collapsing a section never drops its values. */
document.querySelectorAll('.collapsible-section[data-category]').forEach(function (details) {
  var storageKey = 'settings-section-open:' + details.dataset.category;
  try {
    var stored = localStorage.getItem(storageKey);
    if (stored !== null) { details.open = stored === '1'; }
  } catch (e) { /* ignore — storage unavailable, keep the default open state */ }
  details.addEventListener('toggle', function () {
    try { localStorage.setItem(storageKey, details.open ? '1' : '0'); } catch (e) { /* ignore */ }
  });
});
</script>
</body>
</html>
