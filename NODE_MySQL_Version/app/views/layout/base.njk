<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NexaCrest International — Export Operations</title>
<link rel="stylesheet" href="/css/app.css">
</head>
<body>
{% set opsGroupVisible = permissions.manage_orders %}
{% set insightsGroupVisible = permissions.view_reports or permissions.view_audit_log or permissions.approve_email_send %}
{% set adminGroupVisible = permissions.manage_company_settings or permissions.manage_assets or permissions.manage_signatories or permissions.manage_permissions or permissions.manage_users or permissions.manage_field_protection or permissions.edit_locked_data or permissions.manage_sample_data %}
<header class="topbar">
  <div class="topbar-brand">NEXACREST <span>INTERNATIONAL</span></div>
  {% if currentUser %}
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">&#9776;</label>
  {% endif %}
  <nav class="topbar-nav">
    <a href="/">Dashboard</a>
    {% if currentUser %}
      <a href="/reference-docs">Reference Library</a>
      <a href="/reviews">My Reviews</a>
      {% if permissions.view_product_catalog %}<a href="/products">Products</a>{% endif %}
    {% endif %}
    {% if currentUser and opsGroupVisible %}
      <details class="nav-group">
        <summary>Operations</summary>
        <div class="nav-dropdown">
          <a href="/clients">Clients</a>
          <a href="/orders">Orders</a>
          <a href="/client-intake">Client Requests</a>
          <a href="/disputes">Disputes</a>
        </div>
      </details>
    {% endif %}
    {% if currentUser and insightsGroupVisible %}
      <details class="nav-group">
        <summary>Insights</summary>
        <div class="nav-dropdown">
          {% if permissions.view_reports %}<a href="/reports">Reports</a>{% endif %}
          {% if permissions.view_audit_log %}<a href="/audit-log">Audit Log</a>{% endif %}
          {% if permissions.approve_email_send %}<a href="/email-approvals">Email Approvals</a>{% endif %}
        </div>
      </details>
    {% endif %}
    {% if currentUser and adminGroupVisible %}
      <details class="nav-group">
        <summary>Admin</summary>
        <div class="nav-dropdown">
          {% if permissions.manage_company_settings %}<a href="/settings">Company Settings</a>{% endif %}
          {% if permissions.manage_company_settings %}<a href="/holidays">Holiday Calendar</a>{% endif %}
          {% if permissions.manage_assets %}<a href="/company-assets">Assets</a>{% endif %}
          {% if permissions.manage_signatories %}<a href="/signatories">Signatories</a>{% endif %}
          {% if permissions.manage_permissions %}<a href="/admin/permissions">Permissions</a>{% endif %}
          {% if permissions.manage_users %}<a href="/users">Users</a>{% endif %}
          {% if permissions.manage_field_protection %}<a href="/admin/field-protection">Field Protection</a>{% endif %}
          {% if permissions.edit_locked_data %}<a href="/admin/overrides">Admin Overrides</a>{% endif %}
          {% if permissions.manage_sample_data %}<a href="/sample-data">Sample Data</a>{% endif %}
        </div>
      </details>
    {% endif %}
    {% if isSuperAdmin %}
      <a href="/super-admin">Super Admin</a>
      <a href="/test-mode">Test Mode{% if testModeEnabled %} (ON){% endif %}</a>
    {% endif %}
  </nav>
  <div class="topbar-user">
    {% if currentUser %}
      <a href="/notifications">Notifications{% if unreadCount > 0 %} ({{ unreadCount }}){% endif %}</a>
      <span>{{ currentUser.name }}</span>
      <a href="/logout" class="logout-link">Log out</a>
    {% endif %}
  </div>
</header>
{% if testModeEnabled %}
  <div class="test-mode-banner">TEST MODE ACTIVE — client access suspended, all outbound business mail is redirected, admin panel settings are locked. Any order/client/document created now is test data.</div>
{% endif %}
<main class="page">
  {% for f in flashes %}
    <div class="alert alert-{{ f.type }}">{{ f.message }}</div>
  {% endfor %}
  {{ content | safe }}
</main>
</body>
</html>
