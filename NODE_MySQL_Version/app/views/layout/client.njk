<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NexaCrest International — My Orders</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/app.css">
<script src="/js/app.js" defer></script>
</head>
<body>
{% if devServerEnabled %}
  <div class="dev-server-banner">&#9888; DEV / TEST ENVIRONMENT — this is not the production server &#9888;</div>
{% endif %}
{% if isImpersonating %}
  <div class="impersonation-banner">
    &#128100; A staff member is viewing this portal on this client's behalf.
    <form method="post" action="/client/end-impersonation" style="margin:0"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="impersonation-banner-end">End impersonation</button></form>
  </div>
{% endif %}
<header class="client-topbar">
  <div class="topbar-brand">
    <span class="bare-brand-mark" aria-hidden="true"><img src="/img/logo.jpg" alt=""></span>
    NexaCrest <span>International</span>
  </div>
  <nav class="topbar-nav">
    <a href="/client">My Orders</a>
    <a href="/client/account">My Account</a>
    <form method="post" action="/client/logout" style="margin-left:auto"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="topbar-nav-logout">Log out</button></form>
  </nav>
</header>
<main class="page">
  {% for f in flashes %}
    <div class="alert alert-{{ f.type }}">{{ f.message }}</div>
  {% endfor %}
  {{ content | safe }}
</main>
</body>
</html>
