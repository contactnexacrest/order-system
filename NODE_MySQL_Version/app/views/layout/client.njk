<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NexaCrest International — My Orders</title>
<link rel="icon" href="/img/favicon.ico?v=2" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png?v=2">
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png?v=2">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png?v=2">
<link rel="stylesheet" href="{{ asset('/css/app.css') }}">
<script src="{{ asset('/js/app.js') }}" defer></script>
{% if idleMeta %}<meta name="session-idle" content="{{ idleMeta.idle }}" data-warn="{{ idleMeta.warn }}"{% if idleMeta.absoluteLeft is number %} data-absolute-left="{{ idleMeta.absoluteLeft }}"{% endif %} data-keepalive="{{ idleMeta.keepalive }}" data-login="{{ idleMeta.login }}" data-csrf="{{ csrfToken }}">{% endif %}{# D-283: idle warning popup (app.js) #}
</head>
<body>
{% if devServerEnabled %}
  <div class="dev-server-banner">&#9888; DEV / TEST ENVIRONMENT — this is not the production server &#9888;</div>
{% endif %}
{% if isImpersonating %}
  <div class="impersonation-banner">
    &#128100; A staff member is viewing this portal on this client's behalf.
    <form method="post" action="/client/end-impersonation" style="margin:0"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="impersonation-banner-end">End impersonation</button></form>
  </div>
{% endif %}
<header class="client-topbar">
  <div class="topbar-brand">
    <span class="bare-brand-mark" aria-hidden="true"><img src="/img/logo.jpg" alt=""></span>
    NexaCrest <span>International</span>
  </div>
  <nav class="topbar-nav">
    <a href="/client">My Orders</a>
    <a href="/client/account">My Account</a>
    <form method="post" action="/client/logout" style="margin-left:auto"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="topbar-nav-logout">Log out</button></form>
  </nav>
</header>
<main class="page">
  {% for f in flashes %}
    <div class="alert alert-{{ f.type }}">{{ f.message }}{% if f.copy_link %}{% set copyLink = f.copy_link %}{% set copyNote = null %}{% include "partials/copy_link.njk" %}{% endif %}{# D-280 #}</div>
  {% endfor %}
  {{ content | safe }}
</main>
</body>
</html>
