{# The associate portal's layout (owner decision 1 Nov 2026, AS-1), like layout/client.njk.
   Expects: me (the signed-in associate, or empty on login pages), unread (unread notices), viewAs (bool: a staff read-only view), flashes, devServerEnabled, csrfToken, content. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NexaCrest International — Associate Portal</title>
<link rel="icon" href="/img/favicon.ico?v=2" sizes="any">
<link rel="stylesheet" href="{{ asset('/css/app.css') }}">
<script src="{{ asset('/js/app.js') }}" defer></script>
</head>
<body>
{% if devServerEnabled %}
  <div class="dev-server-banner">&#9888; DEV / TEST ENVIRONMENT — this is not the production server &#9888;</div>
{% endif %}
{% if viewAs %}
  <div class="impersonation-banner">&#128100; Staff view of this associate's portal — read-only.
    <form method="post" action="/associate/logout" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="impersonation-banner-end">End staff view</button></form></div>
{% endif %}
<header class="client-topbar">
  <div class="topbar-brand">
    <span class="bare-brand-mark" aria-hidden="true"><img src="/img/logo.jpg" alt=""></span>
    NexaCrest <span>Associate Portal</span>
  </div>
  {% if me and me.id %}
  <nav class="topbar-nav">
    <a href="/associate">Home{{ (' (' ~ unread ~ ' new)') if unread else '' }}</a>
    {# D-261: only what the access level shows (the server refuses the rest too) #}
    {% if not access or access.clients %}<a href="/associate/clients">My clients</a>{% endif %}
    {% if not access or access.orders %}<a href="/associate/orders">Orders</a>{% endif %}
    {% if not access or access.catalogue %}<a href="/associate/catalogue">Catalogue</a>{% endif %}
    {% if not access or access.commission or access.tds_certificates %}<a href="/associate/commission">Commission</a>{% endif %}
    {% if not access or access.messages %}<a href="/associate/messages">Messages</a>{% endif %}
    <a href="/associate/profile">Profile</a>
    {% if viewAs %}<form method="post" action="/associate/logout" style="margin-left:auto"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="topbar-nav-logout">End staff view</button></form>{% else %}
    <form method="post" action="/associate/logout" style="margin-left:auto"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="topbar-nav-logout">Log out</button></form>{% endif %}
  </nav>
  {% endif %}
</header>
<main class="page">
  {% if me and me.status == 'suspended' %}
    <div class="alert alert-warning" role="status" data-associate-suspended>Your account is suspended — you can see your clients, orders and commission, but cannot invite clients or change your details.</div>
  {% endif %}
  {% if me and bankWaiting %}{# D-293: on every page until they confirm or refuse #}
    <div class="alert alert-warning" role="status" data-bank-confirm-bar><b>New bank details are waiting for your confirmation.</b> Your commission will only be paid to them after you confirm. If you did not ask for this, tell us now.
      <a class="btn-sm" href="/associate/bank/confirm">Review now</a></div>
  {% endif %}
  {% for f in flashes %}
    <div class="alert alert-{{ f.type }}">{{ f.message }}</div>
  {% endfor %}
  {{ content | safe }}
</main>
</body>
</html>
