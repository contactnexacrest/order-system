<div class="card page-wide">
  <p class="muted small"><a href="/reports">&larr; Back to Reports</a></p>
  <h1>Amendment Report</h1>
  <p class="muted">Every amendment across all orders — filtered by date created.</p>

  <form method="get" action="/reports/amendments" class="section">
    <div class="kv-grid">
      <label>Date From<input type="date" name="date_from" value="{{ filters.dateFrom or '' }}"></label>
      <label>Date To<input type="date" name="date_to" value="{{ filters.dateTo or '' }}"></label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm">Run</button>
      <a class="btn-sm btn-secondary js-slow-download" data-loading-text="Exporting…" href="/reports/amendments?date_from={{ filters.dateFrom or '' }}&date_to={{ filters.dateTo or '' }}&format=csv">Export CSV</a>
    </div>
  </form>

  <div class="section">
    <h2>Summary</h2>
    <p class="muted small">Computed from exactly the {{ rows.length }} amendment(s) listed below.</p>
    <div class="kv-grid">
      <div>
        <span class="k">By Status</span>
        <span class="v">{% for status, n in byStatus %}{{ status | replace('_', ' ') }}: {{ n }}<br>{% endfor %}{% if (byStatus | length) == 0 %}—{% endif %}</span>
      </div>
      <div>
        <span class="k">By Requested By</span>
        <span class="v">{% for who, n in byRequestedBy %}{{ who | capitalize }}: {{ n }}<br>{% endfor %}{% if (byRequestedBy | length) == 0 %}—{% endif %}</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>Amendments</h2>
    <table class="list">
      <tr><th>Amendment Ref</th><th>Order Ref</th><th>Client</th><th>Requested By</th><th>Status</th><th>Amended Advance</th><th>Amended Balance</th><th>Effective From</th><th>Created</th></tr>
      {% for r in rows %}
      <tr>
        <td>{{ r.amendment_reference }}</td>
        <td><a href="/orders/{{ r.order_id }}">{{ r.order_reference }}</a></td>
        <td>{{ r.company_legal_name }}</td>
        <td>{{ r.requested_by | capitalize }}</td>
        <td>{{ r.status | replace('_', ' ') }}</td>
        <td>{{ (r.currency_code ~ ' ' ~ (r.amended_advance_amount | money)) if r.amended_advance_amount != null else '—' }}</td>
        <td>{{ (r.currency_code ~ ' ' ~ (r.amended_balance_amount | money)) if r.amended_balance_amount != null else '—' }}</td>
        <td>{{ r.effective_from or '—' }}</td>
        <td>{{ r.created_at }}</td>
      </tr>
      {% endfor %}
      {% if not rows or rows.length == 0 %}<tr><td colspan="9" class="muted">No amendments match these filters.</td></tr>{% endif %}
    </table>
  </div>
</div>
