<div class="card page-wide">
  <p class="muted small"><a href="/reports">&larr; Back to Reports</a></p>
  <h1>Today's Payments</h1>
  <p class="muted">What actually cleared/was paid on this specific day, both directions — distinct from the Payments Report, which filters orders by created date and shows their current status regardless of when a leg cleared.</p>

  <form method="get" action="/reports/todays-payments" class="section">
    <div class="kv-grid">
      <label>Date<input type="date" name="date" value="{{ date }}"></label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm">Run</button>
      <a class="btn-sm btn-secondary js-slow-download" data-loading-text="Exporting…" href="/reports/todays-payments?date={{ date }}&format=csv">Export CSV</a>
    </div>
  </form>

  <div class="section">
    <h2>Incoming (Buyer) Payments</h2>
    <table class="list">
      <tr><th>Order Ref</th><th>Client</th><th>Currency</th><th>Leg</th><th>Amount</th><th>Cleared</th></tr>
      {% for r in incomingRows %}
        <tr>
          <td><a href="/orders/{{ r.order_id }}">{{ r.order_reference }}</a></td>
          <td>{{ r.company_legal_name }}</td>
          <td>{{ r.currency_code }}</td>
          <td>{{ r.leg }}</td>
          <td>{{ r.amount | money }}</td>
          <td>{{ r.cleared_at }}</td>
        </tr>
      {% endfor %}
      {% if (incomingRows | length) == 0 %}<tr><td colspan="6" class="muted">No incoming payments cleared on this date.</td></tr>{% endif %}
    </table>
  </div>

  <div class="section">
    <h2>Outgoing (Supplier) Payments</h2>
    {% if not canManageSupplierPayments %}
      <p class="muted">Only Accounts/Admin/MD/ED can see supplier payment amounts — this is internal cost data.</p>
    {% else %}
    <table class="list">
      <tr><th>Order Ref</th><th>Supplier</th><th>Leg</th><th>Amount (INR)</th><th>Paid</th></tr>
      {% for r in supplierRows %}
        <tr>
          <td><a href="/orders/{{ r.order_id }}">{{ r.order_reference }}</a></td>
          <td>{{ r.supplier_legal_name }}</td>
          <td>{{ r.leg }}</td>
          <td>{{ r.amount | money }}</td>
          <td>{{ r.paid_at }}</td>
        </tr>
      {% endfor %}
      {% if (supplierRows | length) == 0 %}<tr><td colspan="5" class="muted">No supplier payments recorded on this date.</td></tr>{% endif %}
    </table>
    {% endif %}
  </div>
</div>
