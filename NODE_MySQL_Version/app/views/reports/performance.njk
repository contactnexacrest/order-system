{% macro deltaBadge(pct) %}
  {% if pct == null %}
    <span class="muted small">—</span>
  {% else %}
    {% set cls = 'badge-success' if pct > 0 else ('badge-lost' if pct < 0 else 'badge-warning') %}
    {% set arrow = '&#9650;' if pct > 0 else ('&#9660;' if pct < 0 else '&#8212;') %}
    <span class="badge {{ cls }}">{{ arrow | safe }} {{ (pct if pct >= 0 else -pct) | money }}%</span>
  {% endif %}
{% endmacro %}
{% set r = report.current %}
{% set prev = report.previous %}
{% set cmp = report.comparison %}
{% set presets = {
  'this_month': 'This Month', 'last_month': 'Last Month',
  'this_quarter': 'This Quarter', 'last_quarter': 'Last Quarter',
  'this_half_year': 'This Half-Year', 'last_half_year': 'Last Half-Year',
  'this_year': 'This Year', 'last_year': 'Last Year'
} %}
<div class="card page-wide">
  <p class="muted small"><a href="/reports">&larr; Back to Reports</a></p>
  <h1>Sales Performance Report</h1>
  <p class="muted">How the business is doing over any period — quotations and PIs sent, wins, losses (with each one's own reason), win rate, and FOB value won — automatically compared against the immediately preceding period of equal length whenever both dates are set.</p>

  <div class="section">
    <div class="btn-row" style="flex-wrap:wrap;margin-bottom:10px;">
      {% for key, label in presets %}
        <a href="/reports/performance?preset={{ key }}" class="btn-sm {{ 'btn-accent' if filters.preset == key else 'btn-secondary' }}">{{ label }}</a>
      {% endfor %}
    </div>
    <form method="get" action="/reports/performance">
      <div class="kv-grid">
        <label>Date From<input type="date" name="date_from" value="{{ filters.dateFrom or '' }}"></label>
        <label>Date To<input type="date" name="date_to" value="{{ filters.dateTo or '' }}"></label>
      </div>
      <div class="btn-row"><button type="submit" class="btn-sm">Run Custom Range</button></div>
    </form>
    {% if prev != null %}
      <p class="muted small">Compared against {{ report.previous_range[0] }} to {{ report.previous_range[1] }} (same number of days, immediately before).</p>
    {% else %}
      <p class="muted small">Set both Date From and Date To (or pick a preset) to see a comparison against the previous period of equal length.</p>
    {% endif %}
  </div>

  <div class="section">
    <h2>Key Metrics</h2>
    <table class="list">
      <tr><th>Metric</th><th>This Period</th>{% if prev != null %}<th>Previous Period</th><th>Change</th>{% endif %}</tr>
      <tr>
        <td>Orders Created</td><td>{{ r.orders_created }}</td>
        {% if prev != null %}<td>{{ prev.orders_created }}</td><td>{{ deltaBadge(cmp.orders_created) }}</td>{% endif %}
      </tr>
      <tr>
        <td>Quotations Sent</td><td>{{ r.quotations_sent }}</td>
        {% if prev != null %}<td>{{ prev.quotations_sent }}</td><td>{{ deltaBadge(cmp.quotations_sent) }}</td>{% endif %}
      </tr>
      <tr>
        <td>PIs Sent</td><td>{{ r.pi_sent }}</td>
        {% if prev != null %}<td>{{ prev.pi_sent }}</td><td>{{ deltaBadge(cmp.pi_sent) }}</td>{% endif %}
      </tr>
      <tr>
        <td>Won (reached PI)</td><td>{{ r.won }}</td>
        {% if prev != null %}<td>{{ prev.won }}</td><td>{{ deltaBadge(cmp.won) }}</td>{% endif %}
      </tr>
      <tr>
        <td>Lost — total <span class="muted small">({{ r.lost_before_pi }} before PI, {{ r.lost_after_pi }} after)</span></td>
        <td>{{ r.lost_total }}</td>
        {% if prev != null %}<td>{{ prev.lost_total }}</td><td>{{ deltaBadge(cmp.lost_total) }}</td>{% endif %}
      </tr>
      <tr>
        <td><strong>Win Rate</strong></td>
        <td><strong>{% if r.win_rate_pct != null %}{{ r.win_rate_pct }}%{% else %}—{% endif %}</strong></td>
        {% if prev != null %}<td>{% if prev.win_rate_pct != null %}{{ prev.win_rate_pct }}%{% else %}—{% endif %}</td><td>{{ deltaBadge(cmp.win_rate_pct) }}</td>{% endif %}
      </tr>
    </table>
  </div>

  <div class="section">
    <h2>FOB Value Won (by currency)</h2>
    <p class="muted small">Sum of the product FOB value for every order that reached PI in this period — never summed across currencies.</p>
    {% if (r.fob_won_by_currency | length) == 0 %}
      <p class="muted">No orders reached PI in this period.</p>
    {% else %}
      <table class="list">
        <tr><th>Currency</th><th>FOB Value Won</th>{% if prev != null %}<th>Previous Period</th>{% endif %}</tr>
        {% for cc, amount in r.fob_won_by_currency %}
        <tr>
          <td>{{ cc }}</td>
          <td>{{ amount | money }}</td>
          {% if prev != null %}<td>{{ (prev.fob_won_by_currency[cc] or 0) | money }}</td>{% endif %}
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  </div>

  <div class="section">
    <h2>Lost Orders — Detail</h2>
    <p class="muted small">Every order marked lost in this period, with its own reason as recorded at the time.</p>
    <table class="list">
      <tr><th>Order</th><th>Client</th><th>Lost On</th><th>Stage Reached</th><th>Reason</th></tr>
      {% if report.lost_orders.length == 0 %}
      <tr><td colspan="5" class="muted">No orders were lost in this period.</td></tr>
      {% endif %}
      {% for lo in report.lost_orders %}
      <tr>
        <td><a href="/orders/{{ lo.id }}">{{ lo.order_reference }}</a></td>
        <td>{{ lo.company_legal_name }}</td>
        <td>{{ lo.lost_at }}</td>
        <td>{{ 'PI' if lo.reached_pi else 'Quotation' }}</td>
        <td>{% if lo.lost_reason %}{{ lo.lost_reason }}{% else %}<span class="muted">—</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
