<div class="card page-wide">
  <p class="muted small"><a href="/reports">&larr; Back to Reports</a></p>
  <h1>Dispute Report</h1>
  <p class="muted">Every dispute across all orders — filtered by notice date. "Days Open" counts from notice date to today for open disputes, or to resolution for resolved ones.</p>

  <form method="get" action="/reports/disputes" class="section">
    <div class="kv-grid">
      <label>Notice Date From<input type="date" name="date_from" value="{{ filters.dateFrom or '' }}"></label>
      <label>Notice Date To<input type="date" name="date_to" value="{{ filters.dateTo or '' }}"></label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm">Run</button>
      <a class="btn-sm btn-secondary js-slow-download" data-loading-text="Exporting…" href="/reports/disputes?date_from={{ filters.dateFrom or '' }}&date_to={{ filters.dateTo or '' }}&format=csv">Export CSV</a>
    </div>
  </form>

  <div class="section">
    <h2>Summary</h2>
    <p class="muted small">Computed from exactly the {{ rows.length }} dispute(s) listed below.</p>
    <div class="kv-grid">
      <div><span class="k">Open (not Resolved)</span><span class="v">{{ openCount }}</span></div>
      <div><span class="k">Average Resolution Time</span><span class="v">{{ (avgResolutionDays ~ ' days') if avgResolutionDays != null else '—' }}</span></div>
      <div>
        <span class="k">By Status</span>
        <span class="v">{% for status, n in byStatus %}{{ status }}: {{ n }}<br>{% endfor %}{% if (byStatus | length) == 0 %}—{% endif %}</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>Disputes</h2>
    <table class="list">
      <tr><th>Order Ref</th><th>Client</th><th>Notice Date</th><th>From</th><th>Status</th><th>Response Due</th><th>Resolved At</th><th>Days Open</th></tr>
      {% for r in rows %}
      <tr>
        <td><a href="/orders/{{ r.order_id }}">{{ r.order_reference }}</a></td>
        <td>{{ r.company_legal_name }}</td>
        <td>{{ r.notice_date }}</td>
        <td>{{ r.from_party or '—' }}</td>
        <td>{{ r.status }}</td>
        <td>{{ r.response_due_date or '—' }}</td>
        <td>{{ r.resolved_at or '—' }}</td>
        <td>{{ r.days_open }}</td>
      </tr>
      {% endfor %}
      {% if not rows or rows.length == 0 %}<tr><td colspan="8" class="muted">No disputes match these filters.</td></tr>{% endif %}
    </table>
  </div>
</div>
