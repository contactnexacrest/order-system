<div class="card page-wide">
  <p class="muted small"><a href="/reports">&larr; Back to Reports</a></p>
  <h1>Order Profitability Report</h1>
  <p class="muted">Revenue, cost, the associate commission and team incentive, and the profit left per order — filtered by order creation date. Commission and incentive are <strong>estimated</strong> until the MD locks the order, then the locked figure replaces the estimate (never both). See each order's own page for the full cost breakdown behind these figures.</p>

  <form method="get" action="/reports/order-profitability" class="section">
    <div class="kv-grid">
      <label>Created From<input type="date" name="date_from" value="{{ filters.dateFrom or '' }}"></label>
      <label>Created To<input type="date" name="date_to" value="{{ filters.dateTo or '' }}"></label>
      <label>Orders
        <select name="scope">
          <option value="all"{% if (filters.scope or 'all') == 'all' %} selected{% endif %}>Include open orders (estimated)</option>
          <option value="locked"{% if filters.scope == 'locked' %} selected{% endif %}>Locked orders only</option>
        </select>
      </label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm">Run</button>
      <a class="btn-sm btn-secondary js-slow-download" data-loading-text="Exporting…" href="/reports/order-profitability?date_from={{ filters.dateFrom or '' }}&date_to={{ filters.dateTo or '' }}&scope={{ filters.scope or 'all' }}&format=csv">Export CSV</a>
    </div>
  </form>

  <div class="section">
    <h2>Totals for This Period <span class="muted small">({% if filters.scope == 'locked' %}locked orders only{% else %}open orders included — their commission and incentive are estimates{% endif %})</span></h2>
    <div class="kv-grid">
      <div><span class="k">Total Revenue (INR)</span><span class="v">{{ totals.revenue_inr | money }}</span></div>
      <div><span class="k">Cost before commission &amp; incentive (INR)</span><span class="v">{{ totals.cost_before_incentives_inr | money }}</span></div>
      <div><span class="k">Profit before commission &amp; incentive (INR)</span><span class="v">{{ totals.profit_before_commission_inr | money }}</span></div>
      {% if seeIncentives %}
      <div><span class="k">Associate commission (INR)</span><span class="v">{{ totals.commission_inr | money }}</span></div>
      <div><span class="k">Team incentive (INR)</span><span class="v">{{ totals.incentive_inr | money }}</span></div>
      <div><span class="k">Profit after commission &amp; incentive (INR)</span><span class="v">{{ totals.profit_after_incentive_inr | money }}</span></div>
      <div><span class="k">Overall margin after %</span><span class="v">{% if totals.margin_after_pct != null %}{{ totals.margin_after_pct | money }}%{% else %}—{% endif %}</span></div>
      {% else %}
      <div><span class="k">Associate commission &amp; team incentive</span><span class="v muted small">Shown to whoever manages or pays incentives.</span></div>
      {% endif %}
    </div>
  </div>

  {% if divisionProfit %}
  <div class="section" data-testid="division-profit">
    <h2>Profit by division</h2>
    <p class="muted">Company costs not linked to an order or a division (₹{{ divisionProfit.overhead_fmt }} in this period) are shared out by revenue{{ ' — not shared: no revenue in this period' if divisionProfit.overhead_unshared else '' }}. A division's own costs are charged to it alone.</p>
    <table class="list">
      <tr><th>Division</th><th>Orders</th><th>Revenue (INR)</th><th>Share of revenue</th><th>{{ divisionProfit.profit_label }} (INR)</th><th>Division's own costs (INR)</th><th>Share of company overhead (INR)</th><th>Profit after overhead (INR)</th></tr>
      {% for d in divisionProfit.rows %}
      <tr data-division="{{ d.code }}"><td>{{ d.name }}</td><td>{{ d.orders }}</td><td>{{ d.revenue_fmt }}</td><td>{{ d.revenue_share_pct }}%</td>
        <td>{{ d.profit_fmt }}</td><td>{{ d.own_fmt }}</td><td>{{ d.overhead_fmt }}</td><td>{{ d.after_fmt }}</td></tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}
  <div class="section">
    <table class="list">
      <tr><th>Order</th><th>Client</th><th>Created</th><th>Revenue (INR)</th><th>Cost before commission &amp; incentive (INR)</th><th>Profit before (INR)</th>{% if seeIncentives %}<th>Associate commission (INR)</th><th>Team incentive (INR)</th><th>Profit after (INR)</th><th>Margin after %</th>{% endif %}</tr>
      {% for r in rows %}
      <tr>
        <td><a href="/orders/{{ r.order_id }}">{{ r.order_reference }}</a></td>
        <td>{{ r.company_legal_name }}</td>
        <td>{{ r.created_at }}</td>
        <td>{{ r.revenue_inr | money }}{% if r.revenue_is_estimated %} <span class="muted small">(est.)</span>{% endif %}</td>
        <td>{{ r.cost_before_incentives_inr | money }}</td>
        <td>{{ r.profit_before_commission_inr | money }}</td>
        {% if seeIncentives %}
        <td>{% if r.commission_state %}{{ r.commission_inr | money }} <span class="muted small">({{ profitStateLabel(r.commission_state) }})</span>{% else %}<span class="muted">—</span>{% endif %}</td>
        <td>{{ r.incentive_inr | money }} <span class="muted small">({{ profitStateLabel(r.incentive_state) }})</span></td>
        <td>{{ r.profit_after_incentive_inr | money }}</td>
        <td>{% if r.margin_after_pct != null %}{{ r.margin_after_pct | money }}%{% else %}—{% endif %}</td>
        {% endif %}
      </tr>
      {% else %}
      <tr><td colspan="{{ 10 if seeIncentives else 6 }}" class="muted">No orders in this period.</td></tr>
      {% endfor %}
    </table>
  </div>
</div>
