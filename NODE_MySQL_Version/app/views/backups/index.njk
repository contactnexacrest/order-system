{# Port of views/backups/index.php — D-260 Admin › Backups (read-only). #}
{% set badges = { ok: ['badge-success', 'OK'], stale: ['badge-danger', 'Too old'], failed: ['badge-danger', 'Failed'], missing: ['badge-warning', 'No run yet'], not_set: ['badge-warning', 'Not set up'] } %}
<div class="card page-wide">
  <h1>Backups</h1>
  <p class="muted">Every night the server makes an extra copy of the database and of every order document. The copies only read the live system — nothing live is ever changed. This page only shows what the backup jobs report; it cannot start, change or delete a backup. How to restore: <a href="/sop/32-backups-restore">SOP — Backups and restore</a>.</p>

  {% if problems.length %}
    <div class="alert alert-danger" role="alert"><strong>Needs attention</strong>
      <ul>{% for p in problems %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
  {% elif settings.backup_dir %}
    <div class="alert alert-success" role="status">All backup jobs ran on time.</div>
  {% endif %}

  <div class="section">
    <h2>Last runs</h2>
    <div class="table-wrap"><table class="table" id="backup-jobs">
      <thead><tr><th>Job</th><th>Status</th><th>Finished</th><th>Copy</th><th>Size</th><th>Encrypted</th><th>Off-site</th><th>Details</th></tr></thead>
      <tbody>
      {% for row in rows %}{% set b = badges[row.state] %}
        <tr data-job="{{ row.job }}">
          <td>{{ row.label }}</td>
          <td><span class="badge {{ b[0] }}">{{ b[1] }}</span></td>
          <td>{% if row.status %}{{ row.finished_label }}{% if row.ago_label %}<br><small class="muted">{{ row.ago_label }}</small>{% endif %}{% else %}—{% endif %}</td>
          <td>{% if row.status %}{{ row.status.file }}{% else %}—{% endif %}</td>
          <td>{% if row.status %}{{ row.size_label }}{% else %}—{% endif %}</td>
          <td>{% if row.job == 'restore_test' %}—{% elif row.status %}{{ row.status.encrypted or 'no' }}{% else %}—{% endif %}</td>
          <td>{% if row.job == 'restore_test' %}—{% elif row.status %}{{ row.status.offsite }}{% else %}—{% endif %}</td>
          <td>{{ row.message }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
  </div>

  <div class="section">
    <h2>Settings (app/.env)</h2>
    <p class="muted">Changed on the server in <code>app/.env</code>, not here. The cron lines only start the jobs.</p>
    <div class="kv-grid" id="backup-settings">
      <div><span class="k">Where copies are kept (BACKUP_DIR)</span>{% if settings.backup_dir %}{{ settings.backup_dir }}{% else %}<strong>Not set — no backups are being made</strong>{% endif %}</div>
      <div><span class="k">Keep for (BACKUP_KEEP_YEARS)</span>{{ settings.keep_years }} years</div>
      <div><span class="k">One copy per month after (BACKUP_THIN_AFTER_DAYS)</span>{% if settings.thin_after_days == '0' %}Never — every nightly database copy is kept{% else %}{{ settings.thin_after_days }} days (database copies; documents are stored once each){% endif %}</div>
      <div><span class="k">Encryption (BACKUP_ENCRYPTION_KEY_FILE)</span>{% if settings.encryption_key_file %}On (key file set — keep a copy of the key somewhere safe, away from the server){% else %}<strong>Off</strong> — set a key file{% endif %}</div>
      <div><span class="k">Off-site copy (BACKUP_OFFSITE_TARGET)</span>{% if settings.offsite_target %}{{ settings.offsite_target }}{% else %}Not chosen yet — copies stay on this server only{% endif %}</div>
    </div>
  </div>
</div>
