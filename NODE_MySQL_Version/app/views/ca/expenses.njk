<div class="card page-wide">
  <p class="muted small" style="margin-top:0;"><a href="/ca">&larr; CA / Accounting</a></p>
  <h1>Expenses</h1>
  <p class="muted">Imported one-way from Zoho Books — salary, supplier payments, travel, and anything else entered as an expense there. This is a read-only mirror for CA/reconciliation reporting; expenses are still entered in Zoho Books itself, never here. <a href="/ca/zoho-sync">Zoho Books sync &rarr;</a></p>

  <div class="section">
    <h2>Imported Expenses</h2>
    <p class="muted small">The TDS column is a local-only annotation — setting it never changes anything in Zoho Books.</p>
    {% if expenses.length == 0 %}
      <p class="muted">No expenses imported yet — run a Zoho Books sync once it's configured.</p>
    {% else %}
      <table class="list">
        <tr><th>Date</th><th>Category</th><th>Vendor</th><th>Description</th><th>Amount</th><th>TDS</th></tr>
        {% for e in expenses %}
        <tr>
          <td>{{ e.expense_date }}</td>
          <td>{{ e.category }}</td>
          <td>{{ e.vendor_name or '—' }}</td>
          <td class="muted small">{{ e.description or '' }}</td>
          <td>{{ e.amount | money }} {{ e.currency_code }}</td>
          <td>
            {% if canEditTds and e.lockMessage == null %}
              <form method="post" action="/ca/expenses/{{ e.id }}/tds" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <label style="display:flex; gap:4px; align-items:center;">
                  <input type="checkbox" name="is_tds_applicable" value="1" {{ 'checked' if e.is_tds_applicable else '' }}> TDS
                </label>
                <input type="text" name="tds_amount" placeholder="Amount" value="{{ e.tds_amount or '' }}" style="width:90px;">
                <button type="submit" class="btn-sm">Save</button>
              </form>
            {% else %}
              {% if e.is_tds_applicable %}
                Yes{% if e.tds_amount != null %} ({{ e.tds_amount | money }}){% endif %}
              {% else %}
                <span class="muted">No</span>
              {% endif %}
              {% if e.lockMessage != null %}
                <br><span class="muted small">&#128274; {{ e.lockMessage }}</span>
              {% endif %}
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  </div>
</div>
