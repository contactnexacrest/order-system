{# D-257 Zoho: the "App vs Zoho" check of a Domestic Trade order, an import or a merchant trade deal — reads only. #}
{% set badges = { match: 'badge-success', not_sent: 'badge-warning', before_go_live: 'badge-complete', different: 'badge-danger', missing: 'badge-danger', books_only: 'badge-danger' } %}
<div class="card page-wide">
  <p class="muted small" style="margin-top:0;"><a href="{{ back }}">&larr; {{ title }}</a> &middot; <a href="/ca/zoho-sync">Zoho Books Sync</a></p>
  <h1>App vs Zoho Books</h1>
  <p class="muted">{{ title }} &middot; {{ party }}. Every record of it in the app that goes to Zoho Books, beside what Books holds for it. This page only reads; it changes nothing in the app or in Books.</p>

  {% if error !== null %}
    <div class="alert alert-error">{{ error }}</div>
  {% else %}
    {% set c = result.counts %}
    {% set problems = (c.different or 0) + (c.missing or 0) + (c.books_only or 0) %}
    <div class="section">
      <h2>{% if problems == 0 and not c.not_sent %}Everything matches{% elif problems > 0 %}{{ problems }} difference(s) to look at{% else %}Waiting to be sent{% endif %}</h2>
      <div class="kv-grid">
        {% for key in ['match', 'not_sent', 'different', 'missing'] %}
          <div><span class="k">{{ statusLabels[key] }}</span><span class="v">{{ c[key] or 0 }}</span></div>
        {% endfor %}
      </div>
      <p class="muted small">"Not in Zoho Books yet" goes on the next sync (or "Send to Zoho Books" on its page; the Zoho Sync Log says why it has not gone so far). "Different" and "Missing" mean someone changed Books directly, or the app changed after sending: correct the side that is wrong.</p>
    </div>

    <div class="section">
      {% if result.rows.length == 0 %}
        <p class="muted">Nothing of this record goes to Zoho Books yet.</p>
      {% else %}
        <table class="list">
          <tr><th>Part</th><th>Record</th><th style="text-align:right">In the app</th><th style="text-align:right">In Zoho Books</th><th>Status</th><th>Note</th></tr>
          {% for row in result.rows %}
          <tr>
            <td>{{ row.group }}</td>
            <td>{{ row.item }}</td>
            <td style="text-align:right; white-space:nowrap;">{{ row.app if row.app !== null else '—' }}</td>
            <td style="text-align:right; white-space:nowrap;">{{ row.books if row.books !== null else '—' }}</td>
            <td><span class="badge {{ badges[row.status] }}" style="margin-left:0;">{{ statusLabels[row.status] }}</span></td>
            <td class="small">{{ row.note }}</td>
          </tr>
          {% endfor %}
        </table>
      {% endif %}
    </div>
  {% endif %}
</div>
