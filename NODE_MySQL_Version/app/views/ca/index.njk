<div class="card page-wide">
  <h1>CA / Accounting</h1>
  <p class="muted">The accounting side of the business — separate from order stages. Nothing here moves an order forward, and nothing in the order reports feeds this.</p>

  {# D-395 (20 Nov 2026, Option B): what needs doing first. Each box shows only to a person who may open the page it leads to. #}
  <div class="ca-attention" data-ca-attention>
    <h2>Needs attention</h2>
    <div class="ca-attention-grid">
      {% for box in attention %}
      <div class="ca-att tone-{{ box.tone }}" data-ca-box="{{ box.key }}">
        <span class="ca-att-value">{{ box.value }}</span>
        <span class="ca-att-label">{{ box.label }}</span>
        <a class="btn-sm btn-secondary" href="{{ box.href }}">{{ box.button }} &rsaquo;</a>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="ca-cards">
    <div class="ca-card">
      <div class="ca-card-head"><span class="ca-ico" aria-hidden="true">&#8599;</span><h2>Revenue &amp; benefits</h2></div>
      <p class="muted small">Revenue by financial or calendar year, and the export-benefit claims (RoDTEP etc.) per order.</p>
      <div class="btn-row">
        <a class="btn btn-sm" href="/ca/reports">Revenue reports</a>
        <a class="btn-sm btn-secondary" href="/ca/export-benefits">Export benefits</a>
        <a class="btn-sm btn-secondary" href="/ca/gst-refunds">GST refunds (LUT)</a>
        {% if permissions.view_cafin %}
          <a class="btn-sm btn-secondary" href="/ca/cafin-export">CAFIN export (CSV, all orders) <span class="badge badge-internal">management</span></a>
        {% endif %}
      </div>
    </div>

    <div class="ca-card">
      <div class="ca-card-head"><span class="ca-ico" aria-hidden="true">%</span><h2>Expenses &amp; TDS</h2></div>
      <p class="muted small">Every recorded expense (ECGC, inspection, CHA, transport …) with its TDS, and the TDS payable by month.</p>
      <div class="btn-row">
        <a class="btn btn-sm" href="/ca/expenses">Expenses</a>
        <a class="btn-sm btn-secondary" href="/ca/tds-summary">TDS payable summary</a>
      </div>
    </div>

    <div class="ca-card">
      <div class="ca-card-head"><span class="ca-ico" aria-hidden="true">&#8644;</span><h2>Bank &amp; reconciliation</h2></div>
      <p class="muted small">Upload a bank statement and match its lines to receipts and expenses.</p>
      <div class="btn-row">
        <a class="btn btn-sm" href="/ca/bank-statement">Bank statement</a>
        <a class="btn-sm btn-secondary" href="/ca/reconciliation">Reconciliation</a>
      </div>
    </div>

    {% if canManageCa %}
    <div class="ca-card">
      <div class="ca-card-head"><span class="ca-ico" aria-hidden="true">&#10227;</span><h2>Zoho Books &amp; year lock</h2></div>
      <p class="muted small">Send settlements and expenses to Zoho Books; lock a financial year once it is reconciled. Needs the CA Manage permission.</p>
      <div class="btn-row">
        <a class="btn btn-sm" href="/ca/zoho-sync">Zoho Books sync</a>
        <a class="btn-sm btn-secondary" href="/ca/fy-locks">Financial year lock</a>
      </div>
    </div>
    {% endif %}
  </div>

  <div class="section" id="register">
    <h2>INR Settlement Register</h2>
    <p class="muted small">Every advance/balance/freight leg that has been marked cleared in the order pipeline: the actual INR amount credited, the forex gain/(loss) against the order's assumed exchange rate, and its FIRC/eBRC realization proof. Recorded from the order's own Payment Status section by whoever holds the "Add/edit INR actual" permission.</p>
    <div class="ca-summary" data-ca-summary>
      <div><strong>{{ summary.legs }}</strong>legs cleared</div>
      <div><strong>&#8377;{{ summary.inr_credited | money }}</strong>INR credited</div>
      <div><strong class="{{ 'loss' if summary.forex_net < 0 else 'gain' }}">{% if summary.forex_known %}&#8377;{{ (summary.forex_net | abs) | money }}{{ ' loss' if summary.forex_net < 0 else ' gain' }}{% else %}—{% endif %}</strong>forex, net</div>
      <div><strong class="{{ 'bad' if summary.firc_pending > 0 else '' }}">{{ summary.firc_pending }}</strong>FIRC / eBRC pending</div>
      <div><strong>{{ summary.not_in_zoho }}</strong>not yet in Zoho</div>
    </div>
    <div class="btn-row ca-filters">
      {% for f in [['all', 'All'], ['firc', 'FIRC pending (' ~ summary.firc_pending ~ ')'], ['zoho', 'Not in Zoho (' ~ summary.not_in_zoho ~ ')'], ['estimated', 'Estimated only (' ~ summary.estimated ~ ')']] %}
        <a class="btn-sm btn-secondary{{ ' is-active' if show == f[0] else '' }}" href="{{ '/ca' if f[0] == 'all' else '/ca?show=' ~ f[0] }}#register"{% if show == f[0] %} aria-current="true"{% endif %}>{{ f[1] }}</a>
      {% endfor %}
    </div>
    {% if settlements.length == 0 %}
      <p class="muted">{{ 'No settlement legs have been cleared yet.' if show == 'all' else 'No leg matches this filter.' }}</p>
    {% else %}
      <table class="list">
        <tr><th>Order Ref</th><th>Client</th><th>Leg</th><th>Foreign Amount</th><th>Currency</th><th>Exchange Rate</th><th>Cleared On</th><th>INR Actual</th><th>Forex Gain/(Loss)</th><th>FIRC/eBRC</th><th>Zoho Books</th></tr>
        {% for s in settlements %}
        <tr>
          <td>{% if canOpenOrder(s.order_id) %}<a href="/orders/{{ s.order_id }}">{{ s.buyer_inquiry_ref }}</a>{% else %}{{ s.buyer_inquiry_ref }}{% endif %}</td>
          <td>{{ s.company_legal_name }}</td>
          <td>{{ s.leg | legLabel }}</td>
          <td>{{ (s.foreign_amount | money) if s.foreign_amount != null else '—' }}</td>
          <td>{{ s.currency_code }}</td>
          <td>{{ (s.exchange_rate | rate4) if s.exchange_rate != null else '—' }}</td>
          <td>{{ s.cleared_at }}</td>
          <td>
            {% if s.inr_actual != null %}
              &#8377;{{ s.inr_actual | money }}
              <div class="muted small">
                {% if s.inr_actual_recorded_at != null %}
                  {{ s.inr_actual_recorded_at }}{% if s.inr_actual_recorded_by %} by {{ usersById[s.inr_actual_recorded_by] or ('User #' ~ s.inr_actual_recorded_by) }}{% endif %}
                {% endif %}
              </div>
            {% elif s.inr_estimated != null %}{# D-244: INR not known yet — the amount at the recorded rate #}
              &#8377;{{ s.inr_estimated | money }}
              <div class="muted small">estimated at recorded rate — INR credited not recorded yet</div>
            {% else %}
              <span class="muted">Not yet recorded</span>
            {% endif %}
          </td>
          <td>
            {# D-244: rupees the bank kept, booked as Bank Charges #}
            {% set bankCharges = s.bank_charges_inr %}
            {% if s.forex_gain_loss != null and (bankCharges == null or (s.forex_gain_loss | abs) >= 0.005) %}
              <span>&#8377;{{ (s.forex_gain_loss | abs) | money }} {{ 'gain' if s.forex_gain_loss >= 0 else 'loss' }}</span>
            {% endif %}
            {% if bankCharges != null %}
              <div>&#8377;{{ bankCharges | money }} bank charges</div>
            {% elif s.forex_gain_loss == null %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td>
            {% if s.firc_reference != null %}
              {{ s.firc_reference }}<div class="muted small">{{ s.firc_received_at }}</div>
            {% elif s.firc_pending %}
              <span class="review-banner bad" style="display:inline-flex; padding:3px 8px;">Pending — flag for follow-up</span>
            {% else %}
              <span class="muted">Not yet recorded</span>
            {% endif %}
          </td>
          <td class="muted small">
            {% if s.zoho_synced_at != null %}
              Synced {{ s.zoho_synced_at }}
            {% elif s.inr_actual != null %}
              Pending
            {% else %}
              —
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  </div>
</div>
