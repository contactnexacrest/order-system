<div class="card page-wide">
  <p class="muted small" style="margin-top:0;"><a href="/ca">&larr; CA / Accounting</a></p>
  <h1>Zoho Books Sync</h1>
  <p class="muted">Pushes settlement legs with a recorded INR actual to Zoho Books as customer payments — one-way, revenue only. Runs on demand here, or hourly via the scheduled job (see README's background-jobs section). If Zoho Books isn't configured, this is a routine no-op — nothing else in the app depends on it.</p>

  <div class="section">
    <h2>Status</h2>
    <div class="kv-grid">
      <div><span class="k">Zoho Books</span><span class="v">{% if isEnabled %}<span style="color:var(--success)">Enabled</span>{% else %}<span class="muted">Not configured</span>{% endif %}</span></div>
      <div><span class="k">Legs Pending Sync</span><span class="v">{{ pendingCount }}</span></div>
    </div>
    {% if not isEnabled %}
      <p class="muted small">Fill in every <code>zoho_books_*</code> setting and set <code>zoho_books_enabled</code> to on, under Admin &rarr; Settings, to start syncing.</p>
    {% endif %}
    <form method="post" action="/ca/zoho-sync/run" style="margin-top:10px;">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-sm">Sync Now</button>
    </form>
  </div>

  <div class="section">
    <h2>Sync Log</h2>
    <p class="muted small">Independent of the main system audit log — every sync attempt (manual or scheduled), success or failure, is one row here.</p>
    {% if log.length == 0 %}
      <p class="muted">No sync attempts yet.</p>
    {% else %}
      <table class="list">
        <tr><th>When</th><th>Trigger</th><th>Leg</th><th>Status</th><th>Zoho Reference</th><th>Message</th></tr>
        {% for row in log %}
        <tr>
          <td>{{ row.created_at }}</td>
          <td>{{ row.triggered_by }}{% if row.triggered_by_name %} ({{ row.triggered_by_name }}){% endif %}</td>
          <td>
            {% if row.entity_id %}
              <a href="/orders/{{ row.entity_id }}">Order #{{ row.entity_id }}</a>{% if row.leg %} — {{ row.leg | capitalize }}{% endif %}
            {% else %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td>
            {% if row.status == 'success' %}
              <span style="color:var(--success)">Success</span>
            {% elif row.status == 'error' %}
              <span style="color:var(--danger)">Error</span>
            {% else %}
              <span class="muted">Skipped</span>
            {% endif %}
          </td>
          <td>{{ row.zoho_reference or '—' }}</td>
          <td class="muted small">{{ row.message or '' }}</td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
  </div>
</div>
