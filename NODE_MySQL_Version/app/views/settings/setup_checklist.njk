{% set statusLabel = { done: 'Done', needed: 'Needed', optional: 'Optional', review: 'Check' } %}
<div class="card page-wide">
  <h1>Setup checklist</h1>
  <p class="muted">What a new installation still needs before real use. <strong>{{ neededCount }}</strong> item(s) needed. Each button opens the page where it is set; the starting values from the installation are flagged until the company's own are entered.</p>
  <table class="list">
    <tr><th>Item</th><th>Status</th><th>Details</th><th></th></tr>
    {% for it in items %}
    <tr id="setup-{{ it.key }}">
      <td><strong>{{ it.title }}</strong></td>
      <td><span class="setup-status {{ 'needed' if it.status == 'review' else it.status }}">{{ statusLabel[it.status] or it.status }}</span></td>
      <td>{{ it.detail }}
        {% if it.tick %}
          {% if it.may_tick %}
          <form method="post" action="/admin/setup-checklist/tick" class="btn-row" style="margin-top:6px;align-items:center;flex-wrap:wrap">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="item_key" value="{{ it.tick }}">
            {% if not it.ticked %}
              <input type="hidden" name="ticked" value="1">
              <label class="small"><input type="checkbox" name="confirm" value="1" required> {{ it.tick_label }} *</label>
              <input type="text" name="note" maxlength="300" placeholder="Note (optional), e.g. confirmed with the CA on the phone" aria-label="Note" style="min-width:240px">
              <button type="submit" class="btn-sm">Tick</button>
            {% else %}
              <input type="hidden" name="ticked" value="0">
              <button type="submit" class="btn-sm btn-secondary">Remove the tick</button>
            {% endif %}
          </form>
          {% elif not it.ticked %}
          <br><span class="muted small">Ask someone who may tick it (the MD for pricing and commission levels).</span>
          {% endif %}
        {% endif %}
        {% if it.action == 'national_holidays' %}
          <form method="post" action="/admin/setup-checklist/national-holidays" style="margin-top:6px">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm btn-secondary">Add the national holidays for {{ year }} and {{ year + 1 }}</button>
          </form>
        {% endif %}
      </td>
      <td><a class="btn-sm" href="{{ it.url }}">{{ it.button }}</a></td>
    </tr>
    {% endfor %}
  </table>

  <div class="section" id="recommended">
    <h2>Settings that differ from the recommended values</h2>
    {% if not differences.length %}
      <p class="muted">Every listed setting is at its recommended value.</p>
    {% else %}
    <form method="post" action="/admin/setup-checklist/apply-recommended">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <table class="list">
        <tr><th>Apply</th><th>Setting</th><th>Now</th><th>Recommended</th></tr>
        {% for d in differences %}
        <tr>
          <td><input type="checkbox" name="keys[]" value="{{ d.key }}" checked aria-label="Apply the recommended value for {{ d.label }}"></td>
          <td>{{ d.label }}</td>
          <td><span class="badge badge-warning">Differs</span> {{ d.current if d.current != '' else '(empty)' }}</td>
          <td>{{ d.recommended if d.recommended != '' else '(empty)' }}</td>
        </tr>
        {% endfor %}
      </table>
      <label>Reason for applying the recommended values *
        <textarea name="reason" rows="2" required minlength="10" maxlength="500" placeholder="At least 10 characters, e.g. setting up the new installation as recommended"></textarea>
      </label>
      <button type="submit" class="btn-sm">Apply recommended</button>
    </form>
    {% endif %}
    <p class="muted small">Recommended: {{ recommendedText }}. Every change is recorded in the Audit Log with your reason.</p>
  </div>
</div>
