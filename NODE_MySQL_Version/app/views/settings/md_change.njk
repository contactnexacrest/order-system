{# D-349 (owner, 12 Nov 2026, confirm 1 + confirm 2): Settings › Company — the Managing Director's name / title
   changed. Shows what still carries the old value and asks "Save and apply" or "Save setting only". Nothing is
   saved until one of the two buttons is pressed. Port of md_change.php. #}
{% set labels = { md_name: "Managing Director's name", md_title: "Managing Director's title" } %}
{% set nOrders = preview.orders | length %}
{% set nDocs = preview.documents | length %}
<div class="card" id="md-change-panel">
  <h1>Managing Director's name or title changed</h1>
  <p class="muted"><a href="/settings">&larr; Company Settings</a> (going back saves nothing)</p>

  {% for key in ['md_name', 'md_title'] %}{% if changes[key] %}
    <p>The {{ labels[key] }} changed from "<strong>{{ changes[key].old }}</strong>" to "<strong>{{ changes[key].new }}</strong>".</p>
  {% endif %}{% endfor %}
  <p><strong>Apply it to:</strong></p>

  <form method="post" action="/settings/md-change">
    {# The choice travels in the button's own address: app.js disables the pressed button while the form is sent, so a name/value on it would not arrive. #}
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <p>
      <label><input type="checkbox" name="apply_orders" value="1"{% if nOrders > 0 %} checked{% else %} disabled{% endif %}>
        <strong>{{ nOrders }}</strong> open order(s) whose kept company details still show the old value</label>
      {% if nOrders > 0 %}
        <br><span class="muted small">{% for o in preview.orders %}{{ o.ref }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
      {% endif %}
    </p>
    <p>
      <label><input type="checkbox" name="apply_documents" value="1"{% if nDocs > 0 %} checked{% else %} disabled{% endif %}>
        <strong>{{ nDocs }}</strong> document(s) still in Draft / In review whose kept signatory is the company fallback and still shows the old value</label>
      {% if nDocs > 0 %}
        <br><span class="muted small">{% for d in preview.documents %}{{ d.ref }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
      {% endif %}
    </p>

    {% if preview.founder_note %}
      <div class="alert alert-info" id="md-change-founder-note">&#8505; {{ preview.founder_note }}</div>
    {% endif %}

    <p class="muted small" id="md-change-not-changed">Not changed: {{ preview.not_changed_documents }} document(s) already approved or sent; {{ preview.not_changed_orders }} closed and cancelled order(s).</p>

    <p style="display:flex;gap:8px;flex-wrap:wrap;">
      <button type="submit" formaction="/settings/md-change?choice=apply">Save and apply</button>
      <button type="submit" formaction="/settings/md-change?choice=setting_only" class="btn-secondary">Save setting only</button>
    </p>
    <p class="muted small">Either button saves the setting with the reason you gave. Every change is kept in the Audit Log (old &rarr; new, which orders, which documents).</p>
  </form>
</div>
