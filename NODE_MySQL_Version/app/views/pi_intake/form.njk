<div class="card">
  <h1>Your details for the proforma invoice</h1>
  <p class="muted">Order {{ submission.order_reference }} — {{ submission.client_company_legal_name }}</p>
  <p class="muted">You already agreed the products in your quotation. Here you confirm the exact names and addresses for your shipping documents. We will send your proforma invoice within 24 hours.</p>
  <div class="intake-summary">
    <span>&#128203; 6 short sections</span>
    <span>&#9989; Fields marked * are required</span>
    <span>&#9999; Your Details are pre-filled from your Quotation — please review and correct if needed</span>
    <span>&#128274; Confirm exactly as it should appear on official documents</span>
  </div>

  <form method="post" action="/pi-details/{{ token }}">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">1</span> Your Details</legend>
      <div class="field-grid">
        <label class="full">Company name, as registered *
          <input type="text" name="company_legal_name" value="{{ submission.company_legal_name or '' }}" placeholder="Exact legal name, no abbreviations" required>
        </label>
        <label class="full">Billing Address Line 1 *
          <input type="text" name="billing_address_line1" value="{{ submission.billing_address_line1 or '' }}" placeholder="Street number and street name" required>
        </label>
        <label>Address Line 2
          <input type="text" name="billing_address_line2" value="{{ submission.billing_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town *
          <input type="text" name="billing_city" value="{{ submission.billing_city or '' }}" placeholder="e.g., Rotterdam" required>
        </label>
        <label>Postcode
          <input type="text" name="billing_postcode" value="{{ submission.billing_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country *
          <input type="text" name="billing_country" value="{{ submission.billing_country or '' }}" placeholder="e.g., Netherlands" required>
        </label>
        <label>Contact Person *
          <input type="text" name="contact_person" value="{{ submission.contact_person or '' }}" placeholder="e.g., Purchasing Manager" required>
        </label>
        <label>Email *
          <input type="email" name="email" value="{{ submission.email or '' }}" placeholder="e.g., name@example.com" required>
        </label>
        <label>Phone *
          <input type="text" name="phone" value="{{ submission.phone or '' }}" placeholder="e.g., +1 555 123 4567" required>
        </label>
        <label>Company tax number (VAT, EORI or tax registration) *
          <input type="text" name="vat_eori_tax_no" value="{{ submission.vat_eori_tax_no or '' }}" placeholder="UK: your EORI number. Other countries: your company tax number" required>
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">2</span> Who receives the goods (consignee)</legend>
      <p class="muted small">The consignee is the company that receives the goods. Its name goes on the bill of lading (the shipping document). It is often your own company, but not always.</p>
      {% set consigneeSame = (submission.consignee_same_as_buyer | default(1)) | int == 1 %}
      <label><input type="checkbox" id="consignee_same_as_buyer" name="consignee_same_as_buyer" value="1" {{ 'checked' if consigneeSame }}> Same as Buyer (my own company above)</label>
      <div id="consignee_fields" class="field-grid" style="display:none">
        <label class="full">Consignee Company Legal Name
          <input type="text" name="consignee_name" value="{{ submission.consignee_name or '' }}" placeholder="e.g., ABC Memorial Stones Ltd">
        </label>
        <label class="full">Address Line 1
          <input type="text" name="consignee_address_line1" value="{{ submission.consignee_address_line1 or '' }}" placeholder="Street number and street name">
        </label>
        <label>Address Line 2
          <input type="text" name="consignee_address_line2" value="{{ submission.consignee_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town
          <input type="text" name="consignee_city" value="{{ submission.consignee_city or '' }}" placeholder="e.g., Rotterdam">
        </label>
        <label>Postcode
          <input type="text" name="consignee_postcode" value="{{ submission.consignee_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country
          <input type="text" name="consignee_country" value="{{ submission.consignee_country or '' }}" placeholder="e.g., Netherlands">
        </label>
        <label>Company tax number (VAT, EORI or tax registration)
          <input type="text" name="consignee_vat_eori_tax_no" value="{{ submission.consignee_vat_eori_tax_no or '' }}" placeholder="UK: your EORI number. Other countries: your company tax number">
        </label>
        <label>Contact Person
          <input type="text" name="consignee_contact_person" value="{{ submission.consignee_contact_person or '' }}" placeholder="e.g., Logistics Manager">
        </label>
        <label>Phone
          <input type="text" name="consignee_phone" value="{{ submission.consignee_phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
        <label>Email
          <input type="email" name="consignee_email" value="{{ submission.consignee_email or '' }}" placeholder="e.g., name@example.com">
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">3</span> Who to tell when the goods arrive (notify party)</legend>
      <p class="muted small">The company the shipping line tells when the goods arrive. This is usually your freight forwarder or customs agent. It can be different from the consignee.</p>
      {% set notifySame = (submission.notify_party_same_as_consignee | default(1)) | int == 1 %}
      <label><input type="checkbox" id="notify_party_same_as_consignee" name="notify_party_same_as_consignee" value="1" {{ 'checked' if notifySame }}> Same as Consignee</label>
      <div id="notify_party_fields" class="field-grid" style="display:none">
        <label class="full">Notify Party Name
          <input type="text" name="notify_party" value="{{ submission.notify_party or '' }}" placeholder="e.g., ABC Freight Forwarders Ltd">
        </label>
        <label class="full">Address Line 1
          <input type="text" name="notify_party_address_line1" value="{{ submission.notify_party_address_line1 or '' }}" placeholder="Street number and street name">
        </label>
        <label>Address Line 2
          <input type="text" name="notify_party_address_line2" value="{{ submission.notify_party_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town
          <input type="text" name="notify_party_city" value="{{ submission.notify_party_city or '' }}" placeholder="e.g., Rotterdam">
        </label>
        <label>Postcode
          <input type="text" name="notify_party_postcode" value="{{ submission.notify_party_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country
          <input type="text" name="notify_party_country" value="{{ submission.notify_party_country or '' }}" placeholder="e.g., Netherlands">
        </label>
        <label>Contact Person
          <input type="text" name="notify_party_contact_person" value="{{ submission.notify_party_contact_person or '' }}" placeholder="e.g., Logistics Manager">
        </label>
        <label>Phone
          <input type="text" name="notify_party_phone" value="{{ submission.notify_party_phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
        <label>Email
          <input type="email" name="notify_party_email" value="{{ submission.notify_party_email or '' }}" placeholder="e.g., name@example.com">
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">4</span> Shipping Details</legend>
      <div class="field-grid">
        <label>Port where the goods arrive *
          <input type="text" name="port_of_discharge_text" value="{{ submission.port_of_discharge_text or '' }}" placeholder="e.g. Rotterdam" required>
        </label>
        <label>Country of Final Destination *
          <input type="text" name="country_of_destination" value="{{ submission.country_of_destination or '' }}" placeholder="e.g., Hungary / UK / France" required>
        </label>
        <label>Delivery terms (Incoterm) *
          <select id="incoterm_select" required>
            <option value="">— Select —</option>
            {% for i in incoterms %}
              <option value="{{ i.code }}" {% if submission.incoterm_confirmed == i.code %}selected{% endif %}>{{ i.code }}</option>
            {% endfor %}
            <option value="__other__" {% if incotermIsOther %}selected{% endif %}>Other (not listed) — specify</option>
          </select>
          <input type="text" id="incoterm_confirmed_input" name="incoterm_confirmed" value="{{ submission.incoterm_confirmed or '' }}" placeholder="Type the delivery terms, e.g. DAP" style="{% if not incotermIsOther %}display:none{% endif %}" {% if not incotermIsOther %}readonly{% endif %}>
          <small class="muted">For example FOB: you book the sea freight. CIF: we book freight and insurance to your port.</small>
        </label>
        <label>Container Type
          <input type="text" name="container_type_text" value="{{ submission.container_type_text or '' }}" placeholder="Leave empty to keep the one in your quotation">
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">5</span> Payment Terms &amp; Order Confirmation</legend>
      <div class="field-grid">
        <label class="full">Please confirm the payment terms from your quotation *
          <textarea name="payment_terms_confirmation" placeholder="{{ paymentTermsPlaceholder }}" required>{{ submission.payment_terms_confirmation or paymentTermsPlaceholder }}</textarea>
        </label>
        <label class="full">Which quotation are you accepting? (quotation number) *
          <textarea name="quotation_acceptance_reference" placeholder="{{ quotationAcceptancePlaceholder }}" required>{{ submission.quotation_acceptance_reference or quotationAcceptancePlaceholder }}</textarea>
        </label>
        <label>Certificate of origin you need <span class="info-bubble" tabindex="0" title="This certificate shows the country where the goods were made. Customs often ask for it. GSP Form A can lower your import duty if your country is part of the scheme. Non-preferential is the standard certificate. If you are not sure, leave it empty and we will check with you.">&#9432;</span>
          {# Owner report (2026-10-26): a dropdown of the real options, so what the client picks is kept exactly. #}
          {% set cooPicked = matchOption(cooTypes, submission.coo_type or '') %}
          <select name="coo_type">
            <option value="">Not sure — please confirm with me</option>
            {% for o in cooTypes %}
              <option value="{{ o.option_value }}" {% if cooPicked == o.option_value %}selected{% endif %}>{{ o.option_value }}</option>
            {% endfor %}
          </select>
        </label>
        <label>Your purchase order or reference number
          <input type="text" name="buyer_po_ref" value="{{ submission.buyer_po_ref or '' }}" placeholder="If you have none, write NIL">
        </label>
        <label class="full">Any special document needs?
          <textarea name="special_document_requirements" placeholder="e.g. None, or: commercial invoice must be legalised by the consulate">{{ submission.special_document_requirements or '' }}</textarea>
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">6</span> Confirmation</legend>
      <div class="intake-note">
        <strong>After you send this form, these details are locked.</strong> Neither you nor NexaCrest can change them in the normal way. If something is wrong later, we have to set up your company again from the start. There is no edit button.
      </div>
      <label><input type="checkbox" name="confirm_lock" value="1" required> I confirm the above is correct and understand it will be locked.</label>
    </fieldset>

    <button type="submit">Send my details</button>
  </form>
</div>
<script>
(function () {
  function wireSameAs(checkboxId, fieldsId) {
    var checkbox = document.getElementById(checkboxId);
    var container = document.getElementById(fieldsId);
    if (!checkbox || !container) { return; }
    var inputs = container.querySelectorAll('input, textarea, select');
    function apply() {
      var same = checkbox.checked;
      container.style.display = same ? 'none' : '';
      inputs.forEach(function (el) { el.disabled = same; });
    }
    checkbox.addEventListener('change', apply);
    apply();
  }
  wireSameAs('consignee_same_as_buyer', 'consignee_fields');
  wireSameAs('notify_party_same_as_consignee', 'notify_party_fields');

  var incotermSelect = document.getElementById('incoterm_select');
  var incotermInput = document.getElementById('incoterm_confirmed_input');
  if (incotermSelect && incotermInput) {
    var applyIncoterm = function () {
      var isOther = incotermSelect.value === '__other__';
      incotermInput.style.display = isOther ? '' : 'none';
      incotermInput.readOnly = !isOther;
      if (!isOther) { incotermInput.value = incotermSelect.value; }
    };
    incotermSelect.addEventListener('change', applyIncoterm);
    applyIncoterm();
  }
})();
</script>
