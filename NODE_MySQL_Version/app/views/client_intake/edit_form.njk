<div class="card">
  <h1>Correct Your Quotation Details</h1>
  <p class="muted">We haven't reviewed your request yet, so you can still fix anything here. Fields marked * are required.</p>

  <form method="post" action="/quotation-details/edit/{{ token }}">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">1</span> Your Details</legend>
      <div class="field-grid">
        <label class="full">Company Legal Name *
          <input type="text" name="company_legal_name" value="{{ submission.company_legal_name }}" required>
        </label>
        <label class="full">Billing Address *
          <textarea name="billing_address" required>{{ submission.billing_address }}</textarea>
        </label>
        <label>Contact Person *
          <input type="text" name="contact_person" value="{{ submission.contact_person }}" required>
        </label>
        <label>Email *
          <input type="email" name="email" value="{{ submission.email }}" required>
        </label>
        <label>Phone
          <input type="text" name="phone" value="{{ submission.phone or '' }}">
        </label>
        <label>VAT / EORI / Tax Reg. No. *
          <input type="text" name="vat_eori_tax_no" value="{{ submission.vat_eori_tax_no or '' }}" required>
        </label>
        <label>Country of Destination *
          <input type="text" name="country_of_destination" value="{{ submission.country_of_destination }}" required>
        </label>
        <label>Port of Discharge
          <input type="text" name="port_of_discharge_text" value="{{ submission.port_of_discharge_text or '' }}">
        </label>
        <label class="full">Certificate of Origin Type
          <input type="text" name="coo_type" value="{{ submission.coo_type or '' }}">
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">2</span> Consignee Details</legend>
      <p class="muted small">The consignee is the company your goods actually ship to — often the same as you, but not always.</p>
      {% set consigneeSame = (submission.consignee_same_as_buyer | default(1)) | int == 1 %}
      <label><input type="checkbox" id="consignee_same_as_buyer" name="consignee_same_as_buyer" value="1" {{ 'checked' if consigneeSame }}> Same as Buyer (my own company above)</label>
      <div id="consignee_fields" class="field-grid" style="display:none">
        <label class="full">Consignee Company Legal Name
          <input type="text" name="consignee_name" value="{{ submission.consignee_name or '' }}">
        </label>
        <label class="full">Consignee Address Line 1
          <input type="text" name="consignee_address_line1" value="{{ submission.consignee_address_line1 or '' }}">
        </label>
        <label>Address Line 2
          <input type="text" name="consignee_address_line2" value="{{ submission.consignee_address_line2 or '' }}">
        </label>
        <label>City / Town
          <input type="text" name="consignee_city" value="{{ submission.consignee_city or '' }}">
        </label>
        <label>Postcode
          <input type="text" name="consignee_postcode" value="{{ submission.consignee_postcode or '' }}">
        </label>
        <label>Country
          <input type="text" name="consignee_country" value="{{ submission.consignee_country or '' }}">
        </label>
        <label>VAT / EORI / Tax Reg. No.
          <input type="text" name="consignee_vat_eori_tax_no" value="{{ submission.consignee_vat_eori_tax_no or '' }}">
        </label>
        <label>Contact Person
          <input type="text" name="consignee_contact_person" value="{{ submission.consignee_contact_person or '' }}">
        </label>
        <label>Phone
          <input type="text" name="consignee_phone" value="{{ submission.consignee_phone or '' }}">
        </label>
        <label>Email
          <input type="email" name="consignee_email" value="{{ submission.consignee_email or '' }}">
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">3</span> Shipping Preference</legend>
      <div class="field-grid">
        <label>Incoterm *
          <input type="text" name="incoterm_preference" value="{{ submission.incoterm_preference or '' }}" required>
        </label>
        <label>Container Type
          <input type="text" name="container_type_text" value="{{ submission.container_type_text or '' }}">
        </label>
        <label class="full">Your Own Reference Number
          <input type="text" name="buyer_own_reference" value="{{ submission.buyer_own_reference or '' }}">
        </label>
        <label class="full">Anything else we should know?
          <textarea name="notes">{{ submission.notes or '' }}</textarea>
        </label>
      </div>
    </fieldset>

    <button type="submit">Save Correction</button>
  </form>
</div>
<script>
(function () {
  var checkbox = document.getElementById('consignee_same_as_buyer');
  var container = document.getElementById('consignee_fields');
  if (!checkbox || !container) { return; }
  var inputs = container.querySelectorAll('input, textarea, select');
  function apply() {
    var same = checkbox.checked;
    container.style.display = same ? 'none' : 'block';
    inputs.forEach(function (el) { el.disabled = same; });
  }
  checkbox.addEventListener('change', apply);
  apply();
})();
</script>
