{# External QA report U-06: same select-plus-hidden-fallback pattern as
   Incoterm below, pre-selecting the submission's already-saved value. #}
{% macro countryField(idPrefix, name, required, value, isOther) %}
<select id="{{ idPrefix }}_select">
  <option value="">— Select —</option>
  <option value="Not sure" {% if value == 'Not sure' %}selected{% endif %}>Not sure</option>
  {% for c in countries %}
    <option value="{{ c }}" {% if value == c %}selected{% endif %}>{{ c }}</option>
  {% endfor %}
  <option value="__other__" {% if isOther %}selected{% endif %}>Other (not listed) — specify</option>
</select>
<input type="text" id="{{ idPrefix }}_input" name="{{ name }}" value="{{ value }}" placeholder="Type the country" style="{% if not isOther %}display:none{% endif %}" {% if not isOther %}readonly{% endif %} {% if required %}required{% endif %}>
{% endmacro %}
<div class="card">
  <h1>Correct Your Quotation Details</h1>
  <p class="muted">We haven't reviewed your request yet, so you can still fix anything here. Fields marked * are required.</p>

  <form method="post" action="/quotation-details/edit/{{ token }}">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">1</span> Your Details</legend>
      <div class="field-grid">
        <label class="full">Company Legal Name *
          <input type="text" name="company_legal_name" value="{{ submission.company_legal_name }}" placeholder="e.g., Test Company Ltd" required>
        </label>
        <label class="full">Billing Address Line 1 *
          <input type="text" name="billing_address_line1" value="{{ submission.billing_address_line1 or '' }}" placeholder="Street number and street name" required>
        </label>
        <label>Address Line 2
          <input type="text" name="billing_address_line2" value="{{ submission.billing_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town *
          <input type="text" name="billing_city" value="{{ submission.billing_city or '' }}" placeholder="e.g., Rotterdam" required>
        </label>
        <label>Postcode
          <input type="text" name="billing_postcode" value="{{ submission.billing_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country *
          {{ countryField('billing_country', 'billing_country', true, submission.billing_country or '', billingCountryIsOther) }}
        </label>
        <label>Contact Person *
          <input type="text" name="contact_person" value="{{ submission.contact_person }}" placeholder="e.g., John Doe" required>
        </label>
        <label>Email *
          <input type="email" name="email" value="{{ submission.email }}" placeholder="e.g., name@example.com" required>
        </label>
        <label>Phone
          <input type="text" name="phone" value="{{ submission.phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
        <label>VAT / EORI / Tax Reg. No. *
          <input type="text" name="vat_eori_tax_no" value="{{ submission.vat_eori_tax_no or '' }}" placeholder="e.g., GB123456789" required>
          <small class="muted">UK: EORI No. | Others: Tax Reg. No.</small>
        </label>
        <label>Country of Destination *
          {{ countryField('country_of_destination', 'country_of_destination', true, submission.country_of_destination or '', countryOfDestinationIsOther) }}
        </label>
        <label>Port of Discharge
          <input type="text" name="port_of_discharge_text" value="{{ submission.port_of_discharge_text or '' }}" placeholder="Optional — we'll advise">
        </label>
        <label class="full">Certificate of Origin Type
          {# Owner report (2026-10-26): a dropdown of the real options, so what the client picks is kept exactly. #}
          {% set cooPicked = matchOption(cooTypes, submission.coo_type or '') %}
          <select name="coo_type">
            <option value="">Not sure — please confirm with me</option>
            {% for o in cooTypes %}
              <option value="{{ o.option_value }}" {% if cooPicked == o.option_value %}selected{% endif %}>{{ o.option_value }}</option>
            {% endfor %}
          </select>
          <small class="muted">GSP Form A (preferential) / Non-preferential — confirm with your customs broker if unsure</small>
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">2</span> Consignee Details</legend>
      <p class="muted small">The consignee is the company your goods actually ship to — often the same as you, but not always.</p>
      {% set consigneeSame = (submission.consignee_same_as_buyer | default(1)) | int == 1 %}
      <label><input type="checkbox" id="consignee_same_as_buyer" name="consignee_same_as_buyer" value="1" {{ 'checked' if consigneeSame }}> Same as Buyer (my own company above)</label>
      <div id="consignee_fields" class="field-grid" style="display:none">
        <label class="full">Consignee Company Legal Name
          <input type="text" name="consignee_name" value="{{ submission.consignee_name or '' }}" placeholder="e.g., ABC Memorial Stones Ltd">
        </label>
        <label class="full">Consignee Address Line 1
          <input type="text" name="consignee_address_line1" value="{{ submission.consignee_address_line1 or '' }}" placeholder="Street number and street name">
        </label>
        <label>Address Line 2
          <input type="text" name="consignee_address_line2" value="{{ submission.consignee_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town
          <input type="text" name="consignee_city" value="{{ submission.consignee_city or '' }}" placeholder="e.g., Rotterdam">
        </label>
        <label>Postcode
          <input type="text" name="consignee_postcode" value="{{ submission.consignee_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country
          {{ countryField('consignee_country', 'consignee_country', false, submission.consignee_country or '', consigneeCountryIsOther) }}
        </label>
        <label>VAT / EORI / Tax Reg. No.
          <input type="text" name="consignee_vat_eori_tax_no" value="{{ submission.consignee_vat_eori_tax_no or '' }}" placeholder="e.g., GB123456789">
          <small class="muted">UK: EORI No. | Others: Tax Reg. No.</small>
        </label>
        <label>Contact Person
          <input type="text" name="consignee_contact_person" value="{{ submission.consignee_contact_person or '' }}" placeholder="e.g., Jane Smith">
        </label>
        <label>Phone
          <input type="text" name="consignee_phone" value="{{ submission.consignee_phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
        <label>Email
          <input type="email" name="consignee_email" value="{{ submission.consignee_email or '' }}" placeholder="e.g., name@example.com">
        </label>
      </div>
    </fieldset>

    <fieldset class="intake-step">
      <legend><span class="intake-step-num">3</span> Shipping Preference</legend>
      <div class="field-grid">
        <label>Incoterm *
          <select id="incoterm_select">
            <option value="">— Select —</option>
            {% for i in incoterms %}
              <option value="{{ i.code }}" {% if submission.incoterm_preference == i.code %}selected{% endif %}>{{ i.code }}</option>
            {% endfor %}
            <option value="__other__" {% if incotermIsOther %}selected{% endif %}>Other (not listed) — specify</option>
          </select>
          <input type="text" id="incoterm_preference_input" name="incoterm_preference" value="{{ submission.incoterm_preference or '' }}" placeholder="Type the Incoterm" style="{% if not incotermIsOther %}display:none{% endif %}" {% if not incotermIsOther %}readonly{% endif %}>
        </label>
        <label>Container Type
          <select name="container_type_text">
            <option value="">— Not sure / To Be Confirmed —</option>
            {% for o in containerTypes %}
              <option value="{{ o.option_value }}" {{ 'selected' if (submission.container_type_text or '') == o.option_value }}>{{ o.option_value }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="full">Your Own Reference Number
          <input type="text" name="buyer_own_reference" value="{{ submission.buyer_own_reference or '' }}" placeholder="Your internal reference number, if any — write NIL if none">
        </label>
        <label class="full">Anything else we should know?
          <textarea name="notes" placeholder="Product details, quantities, timeline, etc.">{{ submission.notes or '' }}</textarea>
        </label>
      </div>
    </fieldset>

    <button type="submit">Save Correction</button>
  </form>
</div>
<script>
(function () {
  var checkbox = document.getElementById('consignee_same_as_buyer');
  var container = document.getElementById('consignee_fields');
  if (!checkbox || !container) { return; }
  var inputs = container.querySelectorAll('input, textarea, select');
  function apply() {
    var same = checkbox.checked;
    container.style.display = same ? 'none' : '';
    inputs.forEach(function (el) { el.disabled = same; });
  }
  checkbox.addEventListener('change', apply);
  apply();
})();
(function () {
  var select = document.getElementById('incoterm_select');
  var input = document.getElementById('incoterm_preference_input');
  if (!select || !input) { return; }
  function apply() {
    var isOther = select.value === '__other__';
    input.style.display = isOther ? '' : 'none';
    input.readOnly = !isOther;
    if (!isOther) { input.value = select.value; }
  }
  select.addEventListener('change', apply);
  apply();
})();
function wireCountryField(idPrefix) {
  var select = document.getElementById(idPrefix + '_select');
  var input = document.getElementById(idPrefix + '_input');
  if (!select || !input) { return; }
  function apply() {
    var isOther = select.value === '__other__';
    input.style.display = isOther ? '' : 'none';
    input.readOnly = !isOther;
    if (!isOther) { input.value = select.value; }
  }
  select.addEventListener('change', apply);
  apply();
}
wireCountryField('billing_country');
wireCountryField('country_of_destination');
wireCountryField('consignee_country');
</script>
