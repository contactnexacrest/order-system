<div class="card page-wide">
  {% if documentId %}
    <h1>Send to Buyer — {{ document.document_type_code or '' }} {{ document.document_reference or '—' }}</h1>
  {% else %}
    <h1>Compose Email</h1>
  {% endif %}
  <p class="muted">{{ order.company_legal_name or '' }} &nbsp;&middot;&nbsp; {{ order.order_reference or '' }}</p>

  <form method="get" action="{{ '/orders/' ~ orderId ~ '/documents/' ~ documentId ~ '/send' if documentId else '/orders/' ~ orderId ~ '/email/compose' }}">
    <label>Email Template *
      <select name="template_key" required>
        <option value="">Select a template…</option>
        {% for t in templates %}
          {% if t.is_active %}
          <option value="{{ t.template_key }}" {{ 'selected' if templateKey == t.template_key else '' }}>{{ t.subject }}</option>
          {% endif %}
        {% endfor %}
      </select>
    </label>
    <button type="submit" class="btn-sm">Load Preview</button>
  </form>

  {% if previewError %}
    <div class="alert alert-error">{{ previewError }}</div>
  {% elif preview %}
    <div class="section">
      <h2>Exact Preview</h2>
      <div class="kv-grid">
        <div><span class="k">To</span><span class="v">{{ preview.recipient_email }}</span></div>
        <div><span class="k">Subject</span><span class="v" id="email-preview-subject">{{ preview.subject }}</span></div>
      </div>
      <pre id="email-preview-body" style="white-space:pre-wrap; border:1px solid #dcd6c9; padding:8px; font-size:9px;">{{ preview.body }}</pre>
      <div class="chat-post-form-row">
        <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('email-preview-subject').textContent).then(()=>this.textContent='Copied!').catch(()=>{})">Copy Subject</button>
        <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('email-preview-body').textContent).then(()=>this.textContent='Copied!').catch(()=>{})">Copy Body</button>
      </div>

      {% if documentId %}
        <p class="muted" style="margin-top:0.75rem">Attachment: the final watermarked PDF (never DOCX, never a clean copy).</p>
        <form method="post" action="/orders/{{ orderId }}/documents/{{ documentId }}/send">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="template_key" value="{{ templateKey }}">
          <label>Scheduled send time (leave blank for immediate)
            <input type="datetime-local" name="scheduled_at">
          </label>
          <button type="submit" class="btn-sm btn-success">Submit for Level-2 Approval</button>
        </form>
      {% else %}
        <p class="muted" style="margin-top:0.75rem">This isn't tied to a document, so there's no attachment/approval-queue flow here — copy the subject/body above and send it yourself from your own mail client, addressed to {{ preview.recipient_email }}.</p>
      {% endif %}
    </div>
  {% endif %}
</div>
