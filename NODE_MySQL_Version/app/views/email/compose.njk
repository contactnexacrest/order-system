{# 90-item backlog #73/#74: resending an Annexure that was already sent to
   the buyer once (possibly after edits to order_annexure_terms/products
   made since) gets an extra confirmation — the generic Level-1/Level-2
   approval flow treats a first-time send and a resend identically
   otherwise. Warn, don't block, same as every other staff-trust gate here. #}
{% set isAnnexureResend = documentId and document.document_type_code == 'ANNEXA' and document.status == 'sent' %}
<div class="card page-wide">
  <p class="muted small"><a href="/orders/{{ orderId }}">&larr; Back to Order</a></p>
  {% if documentId %}
    <h1>Send to Buyer — {{ document.document_type_code or '' }} {{ document.document_reference or '—' }}</h1>
  {% else %}
    <h1>Compose Email</h1>
  {% endif %}
  <p class="muted">{{ order.company_legal_name or '' }} &nbsp;&middot;&nbsp; {{ order.order_reference or '' }}</p>

  <form method="get" action="{{ '/orders/' ~ orderId ~ '/documents/' ~ documentId ~ '/send' if documentId else '/orders/' ~ orderId ~ '/email/compose' }}">
    <label>Email Template *
      <select name="template_key" required>
        <option value="">Select a template…</option>
        {% for t in templates %}
          {% if t.is_active %}
          <option value="{{ t.template_key }}" {{ 'selected' if templateKey == t.template_key else '' }}>{{ t.subject }}</option>
          {% endif %}
        {% endfor %}
      </select>
    </label>
    <button type="submit" class="btn-sm">Load Preview</button>
  </form>

  {% if previewError %}
    <div class="alert alert-error">{{ previewError }}</div>
  {% elif preview %}
    <div class="section">
      <h2>Exact Preview</h2>
      <div class="kv-grid">
        <div><span class="k">To</span><span class="v">{{ preview.recipient_email }}</span></div>
        <div><span class="k">Subject</span><span class="v" id="email-preview-subject">{{ preview.subject }}</span></div>
      </div>
      <pre id="email-preview-body" style="white-space:pre-wrap; border:1px solid #dcd6c9; padding:8px; font-size:9px;">{{ preview.body }}</pre>
      <div class="chat-post-form-row">
        <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('email-preview-subject').textContent).then(()=>this.textContent='Copied!').catch(()=>{})">Copy Subject</button>
        <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('email-preview-body').textContent).then(()=>this.textContent='Copied!').catch(()=>{})">Copy Body</button>
      </div>

      {% if documentId %}
        <p class="muted" style="margin-top:0.75rem">Attachment: the final watermarked PDF (never DOCX, never a clean copy).</p>
        {% if isAnnexureResend %}
          <p class="alert alert-warning">⚠ This Annexure was already sent to the buyer once. If its Product Entries or Additional Terms were edited since, make sure a new revision was generated and re-approved first — this will resend whatever the current approved PDF actually contains.</p>
        {% endif %}
        <form method="post" action="/orders/{{ orderId }}/documents/{{ documentId }}/send" {{ "onsubmit=\"return confirm('This Annexure was already sent to the buyer once. Resend it anyway?');\"" | safe if isAnnexureResend else '' }}>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="template_key" value="{{ templateKey }}">
          <label>Scheduled send time (leave blank for immediate)
            <input type="datetime-local" name="scheduled_at">
          </label>
          <button type="submit" class="btn-sm btn-success">Submit for Level-2 Approval</button>
        </form>
      {% else %}
        {% if templateKey == 'bl_copy_sent' %}
          <p class="muted" style="margin-top:0.75rem">Attachment: the scanned Bill of Lading copy on file for this order (Shipping &rarr; attach it there first if you haven't yet).</p>
        {% else %}
          <p class="muted" style="margin-top:0.75rem">This isn't tied to a specific document, so no attachment goes out with it.</p>
        {% endif %}
        <form method="post" action="/orders/{{ orderId }}/email/send">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="template_key" value="{{ templateKey }}">
          <label>Scheduled send time (leave blank for immediate)
            <input type="datetime-local" name="scheduled_at">
          </label>
          <button type="submit" class="btn-sm btn-success">Submit for Level-2 Approval</button>
        </form>
      {% endif %}
    </div>
  {% endif %}
</div>
