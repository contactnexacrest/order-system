{#
  Owner decision D-360 (13 Nov 2026, "go with recommendation", mockups p2 and decision_d1 part B):
  "+ Add product" for one supplier — pick an existing product (those with no supplier yet listed
  first, marked) or create a new one (name * unique, category *, HS code; it starts Inactive and not
  configured), then the supplier's price: base thickness *, price ₹ *, per (unit) *, quoted on *,
  valid until. The thicknesses and units follow the product's (or the category's) price rules —
  app.js fills them from data-choices. Used on the Edit supplier page (a panel) and on its own page
  from the Suppliers list. Expects addProduct (supplierController.addProductView). PHP twin: _add_product.php.
#}
{% set ap = addProduct %}
{% set o = ap.old %}
<form method="post" action="/suppliers/{{ ap.supplier.id }}/add-product" class="add-offer-form" data-add-offer
      data-choices="{{ ap.choicesJson }}"
      data-old-thickness="{{ o.thickness_mm or '' }}" data-old-unit="{{ o.unit or '' }}">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <input type="hidden" name="from" value="{{ ap.from }}">
  <input type="hidden" name="product_mode" value="{{ ap.mode }}" data-add-offer-mode-field>

  <div class="add-offer-row" data-add-offer-existing{% if ap.mode == 'new' %} hidden{% endif %}>
    <label>Product *
      <select name="product_id" required data-add-offer-product data-required-message="Pick the product, or create a new product."{% if ap.mode == 'new' %} disabled{% endif %}>
        <option value="">Choose…</option>
        {% for p in ap.choices.products %}
          <option value="{{ p.id }}"{% if (o.product_id or '') == (p.id | string) %} selected{% endif %}>{{ p.name }}{{ ' — no supplier yet' if p.no_supplier else '' }}{{ ' (Inactive)' if not p.active else '' }}{{ ' (already offered: use Edit price)' if p.offer_id !== null else '' }}</option>
        {% endfor %}
      </select>
    </label>
    <span class="badge badge-danger" data-add-offer-badge hidden>no supplier yet</span>
    <span class="muted small">or <button type="button" class="btn-link" data-add-offer-mode="new">create a new product</button> (name *, category *, HS code). Products with no supplier are listed first.</span>
    <p class="muted small add-offer-note" data-add-offer-dup hidden>This supplier already has a price for this product. Saving opens its "Edit price" form instead.</p>
  </div>

  <fieldset class="add-offer-new" data-add-offer-new{% if ap.mode != 'new' %} hidden{% endif %}>
    <legend>New product · <button type="button" class="btn-link" data-add-offer-mode="existing">pick an existing product instead</button></legend>
    <div class="add-offer-row">
      <label>Name *
        <input type="text" name="new_name"{% if ap.mode != 'new' %} disabled{% endif %} required maxlength="255" value="{{ o.new_name or '' }}" placeholder="e.g. Kashmir White Granite">
      </label>
      <label>Category *
        <select name="new_category_id"{% if ap.mode != 'new' %} disabled{% endif %} required data-add-offer-category>
          <option value="">Choose…</option>
          {% for c in ap.choices.categories %}
            <option value="{{ c.id }}"{% if (o.new_category_id or '') == (c.id | string) %} selected{% endif %}>{{ c.name }}</option>
          {% endfor %}
        </select>
      </label>
      <label>HS code
        <input type="text" name="new_hs_code"{% if ap.mode != 'new' %} disabled{% endif %} maxlength="20" value="{{ o.new_hs_code or '' }}" placeholder="e.g. 68022390 (empty = the category's)">
      </label>
    </div>
    <p class="muted small">The new product starts <strong>Inactive</strong> and not configured; it is not offered on quotations until it is configured.</p>
  </fieldset>

  <div class="add-offer-row">
    <label>Base thickness *
      <select name="thickness_mm" required data-add-offer-thickness data-required-message="Choose the thickness the supplier quoted.">
        <option value="">Choose the product first</option>
      </select>
    </label>
    <label>Price ₹ *
      <input type="text" name="price" inputmode="decimal" required pattern="[0-9,]{1,15}(\.[0-9]{1,2})?" value="{{ o.price or '' }}" placeholder="e.g. 180000">
    </label>
    <label>per *
      <select name="unit" required data-add-offer-unit data-required-message="Choose what the price is per.">
        <option value="">Choose…</option>
      </select>
    </label>
  </div>
  <div class="add-offer-row">
    <label>Quoted on *
      <input type="date" name="quoted_on" required max="{{ ap.today }}" value="{{ o.quoted_on or ap.today }}">
    </label>
    <label>Valid until
      <input type="date" name="valid_until" value="{{ o.valid_until or '' }}">
    </label>
    <div class="add-offer-actions">
      <button type="submit" class="btn">Save</button>
      <a class="btn-secondary btn" href="{{ ap.back }}">Cancel</a>
    </div>
  </div>
  <p class="muted small">On save the offer is switched on. For a price for every thickness, the other thicknesses are worked out from the one you type by the Category price rules (as on Market prices).</p>
</form>
