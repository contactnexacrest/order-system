<div class="card page-wide">
  {% include "incentives/_report_nav.njk" %}
  <h1>Owed at Month End</h1>
  <p class="muted">What NexaCrest owes staff and associates at the chosen date: everything locked on or before it and not paid by it. For today or a later date, orders ready to lock (buyer fully paid, no open claim) are added as estimates.</p>
  <form method="get" action="/reports/incentives/owed" class="section">
    <div class="kv-grid">
      <label>As at<input type="date" name="date" value="{{ date }}" required></label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm">Run</button>
      <a class="btn-sm btn-secondary js-slow-download" data-loading-text="Exporting…" href="/reports/incentives/owed?date={{ date }}&format=csv">Export CSV</a>
    </div>
  </form>
  <div class="section"><h2>Owed at {{ date | shortDate }} — &#8377;{{ totals.amount_inr | money }}</h2>{% include "incentives/_report_table.njk" %}</div>
</div>
