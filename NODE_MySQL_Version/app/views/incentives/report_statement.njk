<div class="card page-wide">
  {% include "incentives/_report_nav.njk" %}
  <h1>Person Statement</h1>
  <p class="muted">Every order of one staff member or one associate, in every state. Staff see their own on My incentives; associates on their portal (Commission).</p>
  <form method="get" action="/reports/incentives/statement" class="section">
    <div class="kv-grid">
      <label>Staff member
        <select name="user_id">
          <option value="0">Choose…</option>
          {% for p in people %}<option value="{{ p.id }}"{{ ' selected' if userId == p.id else '' }}>{{ p.name }}</option>{% endfor %}
        </select></label>
      <label>or Associate
        <select name="associate_id">
          <option value="0">Choose…</option>
          {% for a in associates %}<option value="{{ a.id }}"{{ ' selected' if associateId == a.id else '' }}>{{ a.name }}</option>{% endfor %}
        </select></label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm">Show</button>
      {% if rows.length %}<a class="btn-sm btn-secondary js-slow-download" data-loading-text="Exporting…" href="/reports/incentives/statement?{{ csvQuery }}&format=csv">Export CSV</a>{% endif %}
    </div>
  </form>
  {% if name %}
  <div class="section"><h2>{{ name }} — &#8377;{{ totals.amount_inr | money }}</h2>{% include "incentives/_report_table.njk" %}</div>
  {% else %}
  <p class="muted">Choose a staff member or an associate.</p>
  {% endif %}
</div>
