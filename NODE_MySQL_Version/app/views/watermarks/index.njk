<div class="card page-wide">
  <h1>Watermarks</h1>
  <p class="muted">Every generated PDF carries one of these two watermarks — <strong>Draft</strong> until a document is fully reviewer-approved, then <strong>Final</strong>. Each can show text only, an image only, or both at the same time — they're independent overlay layers, not either/or.</p>

  <div class="section">
    <p class="muted small">
      Watermark image on file: {% if watermarkImageAsset %}<strong>yes</strong> — <a href="/company-assets">replace it from Company Assets</a>{% else %}<strong>none yet</strong> — <a href="/company-assets">upload one from Company Assets</a> before picking Image or Both below.{% endif %}
    </p>
  </div>

  {% for which, w in sections %}
  <div class="section">
    <h2>{{ which | capitalize }} Watermark</h2>
    <form method="post" action="/watermarks/{{ which }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Mode
        <select name="mode">
          <option value="text" {{ 'selected' if (not w or w.mode == 'text') }}>Text only</option>
          <option value="image" {{ 'selected' if (w and w.mode == 'image') }}>Image only</option>
          <option value="both" {{ 'selected' if (w and w.mode == 'both') }}>Text and image together</option>
        </select>
      </label>

      <fieldset style="margin-top:8px">
        <legend class="muted small">Text settings (used when mode is Text or Both)</legend>
        <label>Text<input type="text" name="text_content" value="{{ w.text_content if (w and w.text_content) else ('DRAFT — NOT FOR RELEASE' if which == 'draft' else '') }}" style="width:280px"></label>
        <label>Color<input type="color" name="color" value="{{ w.color if (w and w.color) else '#CCCCCC' }}"></label>
        <label>Font size (pt)<input type="number" name="font_size" value="{{ w.font_size if (w and w.font_size) else 60 }}" style="width:80px"></label>
        <label>Opacity (0–1)<input type="number" step="0.05" min="0" max="1" name="opacity" value="{{ w.opacity if (w and w.opacity != null) else 0.3 }}" style="width:80px"></label>
        <label>Angle (degrees)<input type="number" name="angle" value="{{ w.angle if (w and w.angle != null) else 45 }}" style="width:80px"></label>
      </fieldset>

      <fieldset style="margin-top:8px">
        <legend class="muted small">Image settings (used when mode is Image or Both)</legend>
        <label>Position
          <select name="image_position">
            <option value="center" {{ 'selected' if (w and w.image_position == 'center') }}>Center</option>
            <option value="top-left" {{ 'selected' if (w and w.image_position == 'top-left') }}>Top left</option>
            <option value="top-right" {{ 'selected' if (w and w.image_position == 'top-right') }}>Top right</option>
            <option value="bottom-left" {{ 'selected' if (w and w.image_position == 'bottom-left') }}>Bottom left</option>
            <option value="bottom-right" {{ 'selected' if (w and w.image_position == 'bottom-right') }}>Bottom right</option>
          </select>
        </label>
        <label>Opacity (0–1)<input type="number" step="0.05" min="0" max="1" name="image_opacity" value="{{ w.image_opacity if (w and w.image_opacity != null) else 0.15 }}" style="width:80px"></label>
      </fieldset>

      <button type="submit" class="btn-sm btn-accent" style="margin-top:8px">Save {{ which | capitalize }} Watermark</button>
    </form>
  </div>
  {% endfor %}
</div>
