<div class="card page-wide">
  <p class="muted small"><a href="/reorder-requests">&larr; Back to Reorder Requests</a></p>
  <h1>Reorder Request — {{ request.company_legal_name }}</h1>
  <p class="muted">
    From <a href="/orders/{{ request.source_order_id }}">{{ request.source_order_reference }}</a>,
    submitted {{ request.submitted_at }}.
    {% if request.notes %}<br>Client's note: {{ request.notes }}{% endif %}
  </p>

  {% if request.status != 'pending' %}
    <p class="notice">This request was already {{ request.status }} — nothing more to do here.</p>
  {% else %}
    <form method="post" action="/reorder-requests/{{ request.id }}/approve">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="section">
        <h2>Product Lines <small class="muted">(confirm HS code and unit price for each before approving)</small></h2>
        {% for l in lines %}
          <div class="card-nested">
            <label>Description *<input type="text" name="description[{{ loop.index0 }}]" value="{{ l.description }}"></label>
            <label>Dimensions<input type="text" name="dimensions[{{ loop.index0 }}]" value="{{ l.dimensions or '' }}"></label>
            <label>Finish<input type="text" name="finish[{{ loop.index0 }}]" value="{{ l.finish or '' }}"></label>
            <label>Qty<input type="text" name="quantity[{{ loop.index0 }}]" value="{{ l.quantity or '' }}"></label>
            <label><input type="checkbox" name="quantity_is_tbc[{{ loop.index0 }}]" value="1" style="display:inline-block;width:auto;" {{ 'checked' if l.quantity_is_tbc }}> Qty TBC</label>
            <label>Unit<input type="text" name="unit[{{ loop.index0 }}]" value="{{ l.unit or '' }}"></label>
            <label>Unit Price *<input type="text" name="unit_price[{{ loop.index0 }}]" value="{{ l.unit_price or '' }}"></label>
            <label>HS Code *<input type="text" name="hs_code[{{ loop.index0 }}]" value="{{ l.hs_code or '' }}" list="hs_code_list" required></label>
          </div>
        {% endfor %}
        <datalist id="hs_code_list">
          {% for hc in hsCodes %}
            <option value="{{ hc.code }}">{{ hc.description or '' }}</option>
          {% endfor %}
        </datalist>
      </div>
      <button type="submit" class="btn-success" onclick="return confirm('Create a new order from these lines?');">Approve &amp; Create Order</button>
    </form>

    <div class="section">
      <h2>Reject Instead</h2>
      <form method="post" action="/reorder-requests/{{ request.id }}/reject" onsubmit="return confirm('Reject this reorder request?');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <textarea name="reason" rows="2" placeholder="Reason (required)" required minlength="10"></textarea>
        <button type="submit" class="btn-danger btn-sm">Reject</button>
      </form>
    </div>
  {% endif %}
</div>
