{# Owner hard rule 2026-11-01: every field and action of the Standard list's row (reorder_requests/index.njk). #}
{% macro kanbanCard(r) %}
<div class="entity-card kanban-card">
  <div class="entity-card-header">
    <span class="entity-card-title">{{ r.company_legal_name }}</span>
    {% if r.status and r.status != 'pending' %}<span class="badge {{ 'badge-active' if r.status == 'approved' else 'badge-lost' }}">{{ r.status | capitalize }}</span>{% endif %}
  </div>
  <div class="entity-card-sub">From <a href="/orders/{{ r.source_order_id }}">{{ r.source_order_reference }}</a></div>
  <div class="muted small">Notes: {{ r.notes or '—' }}</div>
  {% if not r.status or r.status == 'pending' %}
    <div class="muted small">Submitted {{ r.submitted_at }}</div>
    <div class="entity-card-footer"><a href="/reorder-requests/{{ r.id }}" class="btn-sm">Review</a></div>
  {% else %}
    <div class="muted small">Resolved by {{ r.reviewed_by_name or '—' }} · {{ r.reviewed_at }}</div>
    <div class="entity-card-footer">
      {% if r.status == 'approved' and r.new_order_reference %}
        <a href="/orders/{{ r.new_order_id }}">&rarr; {{ r.new_order_reference }}</a>
      {% elif r.status == 'rejected' %}
        <span class="muted small">{{ r.rejection_reason or '' }}</span>
      {% else %}
        <span class="muted small">—</span>
      {% endif %}
    </div>
  {% endif %}
</div>
{% endmacro %}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Reorder Requests — Kanban Board</h1>
      <p class="muted" style="margin:0;">Repeat-order requests submitted by clients from an order already on file. Approving reviews and confirms each product line (HS code, unit price) before it becomes a real order — nothing here becomes live automatically.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn-sm btn-secondary" href="/reorder-requests?view=list">Switch to list view</a>
    </div>
  </div>

  <div class="kanban-board">
    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Pending</span>
        <span class="kanban-column-count">{{ pending.length }}</span>
      </div>
      {% if pending.length == 0 %}
        <p class="kanban-column-empty">Nothing pending</p>
      {% else %}
        {% for r in pending %}{{ kanbanCard(r) }}{% endfor %}
      {% endif %}
    </div>

    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Approved</span>
        <span class="kanban-column-count">{{ approved.length }}</span>
      </div>
      {% if approved.length == 0 %}
        <p class="kanban-column-empty">Nothing here</p>
      {% else %}
        {% for r in approved %}{{ kanbanCard(r) }}{% endfor %}
      {% endif %}
    </div>

    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Rejected</span>
        <span class="kanban-column-count">{{ rejected.length }}</span>
      </div>
      {% if rejected.length == 0 %}
        <p class="kanban-column-empty">Nothing here</p>
      {% else %}
        {% for r in rejected %}{{ kanbanCard(r) }}{% endfor %}
      {% endif %}
    </div>
  </div>
</div>
