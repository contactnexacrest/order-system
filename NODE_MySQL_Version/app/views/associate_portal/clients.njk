{# Expects: me, clients (with country_of_destination, associate_registered_on, associate_locked_until, first_order_on, window_ends_on),
   invitations (each with i.usable), invitationStatuses (map), newLink, codeLink, protectionMonths, csrfToken. #}
<div class="card page-wide">
  <h1>My clients</h1>
  <p class="muted">Your buyer registers with NexaCrest themselves, with their own details, through your link or your personal code, and confirms that you introduced them. Once NexaCrest accepts the registration, the company is your client for {{ protectionMonths }} months — however they contact us later. The first completed registration of a company counts.</p>

  {% if newLink %}
    <div class="alert alert-success">Your new link — copy it and send it to your buyer (valid 30 days, for one registration):<br><code style="user-select:all">{{ newLink }}</code></div>
  {% endif %}

  <div class="section">
    <h2>Invite a client</h2>
    {% if me.status != 'active' %}<p class="muted">You can invite clients once your account is active.</p>{% else %}
    <div class="field-grid">
      <div>
        <h3>A link for one buyer</h3>
        <form method="post" action="/associate/invitations">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Company name *<input type="text" name="company_name" required minlength="2" maxlength="255" placeholder="e.g. Rotterdam Stone Trading BV"></label>
          <label>Country *<input type="text" name="country" required maxlength="100" placeholder="e.g. Netherlands"></label>
          <button type="submit" class="btn-sm">Create link</button>
        </form>
      </div>
      <div>
        <h3>Your personal code — for any buyer</h3>
        {% if me.personal_code %}
          <p>Code: <b style="font-size:1.2em">{{ me.personal_code }}</b><br>
            Link: <code style="user-select:all">{{ codeLink }}</code></p>
          <p class="muted small">The buyer enters the code on our quotation form (or opens the link) and confirms your name. The code always belongs to you; its last letter catches typing mistakes.</p>
        {% endif %}
        <form method="post" action="/associate/code" class="inline-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Choose the readable part (once) <input type="text" name="readable" required minlength="3" maxlength="12" pattern="[A-Za-z0-9 ]{3,12}" placeholder="e.g. RAJESH"></label>
          <button type="submit" class="btn-sm btn-secondary">Set my code</button>
        </form>
      </div>
    </div>
    {% endif %}
  </div>

  <div class="section">
    <h2>Registered clients ({{ clients.length }})</h2>
    <table class="list">
      <tr><th>Client</th><th>Country</th><th>Registered</th><th>Protected until</th><th>First order</th><th>10-day window ends</th><th></th></tr>
      {% for c in clients %}
        <tr><td>{{ c.company_legal_name }}</td><td>{{ c.country_of_destination or '' }}</td>
          <td>{{ (c.associate_registered_on | shortDate) if c.associate_registered_on else '—' }}</td><td>{{ (c.associate_locked_until | shortDate) if c.associate_locked_until else '—' }}</td><td>{{ (c.first_order_on | shortDate) if c.first_order_on else '—' }}</td><td>{{ (c.window_ends_on | shortDate) if c.window_ends_on else '—' }}</td>
          <td><a class="btn-sm btn-secondary" style="white-space:nowrap" href="/associate/clients/{{ c.id }}/certificate" target="_blank" rel="noopener">Registration certificate</a></td></tr>
      {% endfor %}
      {% if clients.length == 0 %}<tr><td colspan="7" class="muted">No clients yet.</td></tr>{% endif %}
    </table>
  </div>

  <div class="section">
    <h2>My invitations</h2>
    <table class="list">
      <tr><th>Created</th><th>Company</th><th>Kind</th><th>Status</th><th>Expires</th><th></th></tr>
      {% for i in invitations %}
        <tr><td>{{ (i.created_at | shortDate) if i.created_at else '—' }}</td><td>{{ i.company_name }}{% if i.country %} ({{ i.country }}){% endif %}</td>
          <td>{{ 'Personal code' if i.kind == 'personal_code' else 'Link' }}</td>
          <td>{{ invitationStatuses[i.status] or i.status }}</td><td>{{ (i.expires_at | shortDate) if i.expires_at else '—' }}</td>
          <td>{% if i.usable and i.kind == 'client_link' %}<form method="post" action="/associate/invitations/{{ i.id }}/cancel" data-confirm="Cancel this link?"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm btn-secondary">Cancel</button></form>{% endif %}</td></tr>
      {% endfor %}
      {% if invitations.length == 0 %}<tr><td colspan="6" class="muted">None yet.</td></tr>{% endif %}
    </table>
  </div>
</div>
