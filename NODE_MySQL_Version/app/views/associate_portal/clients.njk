{# Expects: me, clients (with country_of_destination, associate_registered_on, associate_locked_until, first_order_on, window_ends_on),
   invitations (each with i.usable), invitationStatuses (map), newLink, codeLink, protectionMonths, csrfToken. #}
<div class="card page-wide">
  <h1>My clients</h1>
  <p class="muted">Your buyer registers with NexaCrest themselves, with their own details, through your buyer registration link or your quotation link (with your personal code), and confirms that you introduced them. Once NexaCrest accepts the registration, the company is your client for {{ protectionMonths }} months — however they contact us later. The first completed registration of a company counts.</p>

  {% if newLink %}
    <div class="alert alert-success">Your new buyer registration link — copy it and send it to your buyer (valid 30 days, for one registration):<br><code style="user-select:all">{{ newLink }}</code></div>
  {% endif %}

  {% if access.registration_links %}{# D-261 #}
  <div class="section">
    <h2>Invite a client</h2>
    {% if me.status != 'active' %}<p class="muted">You can invite clients once your account is active.</p>{% else %}
    <div class="field-grid">
      <div>
        <h3>Buyer registration link — for one buyer</h3>
        <form method="post" action="/associate/invitations">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Company name *<input type="text" name="company_name" required minlength="2" maxlength="255" placeholder="e.g. Rotterdam Stone Trading BV"></label>
          <label>Country *<input type="text" name="country" required maxlength="100" placeholder="e.g. Netherlands"></label>
          <button type="submit" class="btn-sm">Create buyer registration link</button>
        </form>
      </div>
      <div id="code">
        <h3>Your personal code and quotation link — for any buyer</h3>
        {% if me.personal_code %}
          <p>Code: <b style="font-size:1.2em;font-family:monospace">{{ me.personal_code }}</b><br>
            Quotation link (with your code): <code style="user-select:all">{{ codeLink }}</code></p>
          <p class="muted small">Give the code or the quotation link to a buyer. When they register with it and confirm your name, they become your client. The code always belongs to you; its last letter catches typing mistakes.</p>
        {% endif %}
        {# Owner decision D-254 (A5): change the code like a captcha refresh; old codes keep bringing buyers to you. #}
        <details{% if proposal %} open{% endif %}><summary>{{ 'Choose my code' if not me.personal_code else 'Change my code' }}</summary>
          <form method="post" action="/associate/code/propose" class="inline-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Readable part (3–12 letters or digits) *<input type="text" name="readable" required minlength="3" maxlength="12" pattern="[A-Za-z0-9 ]{3,12}" value="{{ proposal.readable if proposal else '' }}" placeholder="e.g. RAJESHEXIM"></label>
            <button type="submit" class="btn-sm btn-secondary" title="Try another ending, like a captcha refresh">&#10227; New ending</button>
          </form>
          {% if proposal %}
            <p>Proposed code: <b style="font-size:1.2em;font-family:monospace">{{ proposal.code }}</b></p>
            <form method="post" action="/associate/code" class="inline-form" data-confirm="Use {{ proposal.code }} as your personal code?">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="hidden" name="code" value="{{ proposal.code }}">
              <button type="submit" class="btn-sm">Use this code</button>
            </form>
          {% endif %}
          <p class="muted small">You can change it up to {{ codeChangesPerYear }} times a year (used: {{ codeChangesUsed }}).</p>
          <div class="alert alert-success small">&#10003; Your clients and orders stay yours — they are linked to you, not to the code. Links you already shared keep working: your old codes still bring the buyer to you.</div>
        </details>
        {% if codes.length %}
          <h3>My codes</h3>
          <table class="list"><tr><th>Code</th><th>From</th><th>To</th><th>Status</th></tr>
            {% for c in codes %}<tr><td style="font-family:monospace">{{ c.code }}</td><td>{{ (c.issued_at | shortDate) if c.issued_at else '—' }}</td><td>{{ (c.retired_at | shortDate) if c.retired_at else '—' }}</td>
              <td>{% if c.blocked_at %}Blocked by NexaCrest{% elif c.code == me.personal_code %}Current{% else %}Still accepted (old links){% endif %}</td></tr>{% endfor %}
          </table>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="section">
    <h2>Registered clients ({{ clients.length }})</h2>
    <table class="list">
      <tr><th>Client</th><th>Country</th><th>Came via</th><th>Registered</th><th>Protected until</th>{% if access.orders %}<th>Orders</th>{% endif %}<th>10-day window ends</th><th></th></tr>
      {% for c in clients %}
        <tr><td>{{ c.company_legal_name }}</td><td>{{ c.country_of_destination or '' }}</td>
          <td>{{ c.came_via or '' }}</td><td>{{ (c.associate_registered_on | shortDate) if c.associate_registered_on else '—' }}</td><td>{{ (c.associate_locked_until | shortDate) if c.associate_locked_until else '—' }}</td>
          {% if access.orders %}<td>{% if c.order_refs.length %}{{ c.order_refs | join(', ') }}{% else %}<span class="muted">none yet</span>{% endif %}</td>{% endif %}<td>{{ (c.window_ends_on | shortDate) if c.window_ends_on else '—' }}</td>
          <td><a class="btn-sm btn-secondary" style="white-space:nowrap" href="/associate/clients/{{ c.id }}/certificate" target="_blank" rel="noopener">Registration certificate</a></td></tr>
      {% endfor %}
      {% if clients.length == 0 %}<tr><td colspan="8" class="muted">No clients yet.</td></tr>{% endif %}
    </table>
  </div>

  {% if access.registration_links %}
  <div class="section">
    <h2>My buyer registration links and codes used</h2>
    <table class="list">
      <tr><th>Created</th><th>Company</th><th>Kind</th><th>Status</th><th>Expires</th><th></th></tr>
      {% for i in invitations %}
        <tr><td>{{ (i.created_at | shortDate) if i.created_at else '—' }}</td><td>{{ i.company_name }}{% if i.country %} ({{ i.country }}){% endif %}</td>
          <td>{% if i.kind == 'personal_code' %}Personal code{% if i.code_used %} {{ i.code_used }}{% endif %}{% else %}Buyer registration link{% endif %}</td>
          <td>{{ invitationStatuses[i.status] or i.status }}</td><td>{{ (i.expires_at | shortDate) if i.expires_at else '—' }}</td>
          <td>{% if i.usable and i.kind == 'client_link' %}<form method="post" action="/associate/invitations/{{ i.id }}/cancel" data-confirm="Cancel this link?"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="btn-sm btn-secondary">Cancel</button></form>{% endif %}</td></tr>
      {% endfor %}
      {% if invitations.length == 0 %}<tr><td colspan="6" class="muted">None yet.</td></tr>{% endif %}
    </table>
  </div>
  {% endif %}
</div>
