{# Expects: valid (bool), token, email, csrfToken. #}
<div class="card card-narrow">
  <h1>Set your password</h1>
  {% if not valid %}
    <p>This link has expired or was already used. Ask your NexaCrest relationship manager for a new one.</p>
  {% else %}
    <p class="muted small">Your login e-mail: <b>{{ email }}</b></p>
    <form method="post" action="/associate/set-password/{{ token }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>New password <small class="muted">(at least 10 characters, letters and digits)</small><input type="password" name="new_password" required minlength="10" maxlength="200" pattern="(?=.*[A-Za-z])(?=.*\d).{10,}" title="At least 10 characters, with letters and digits" autocomplete="new-password"></label>
      <label>Re-enter the new password<input type="password" name="confirm_password" required minlength="10" maxlength="200" autocomplete="new-password"></label>
      <button type="submit">Set password</button>
    </form>
  {% endif %}
</div>
