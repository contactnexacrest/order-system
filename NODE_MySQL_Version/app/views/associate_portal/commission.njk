{# Expects: payouts (each with p.month_label, order_reference, note, company_legal_name, amount_fc, currency_code, amount_inr, status, hold_reason, paid_on, paid_inr, tds_inr, paid_reference),
   totals, print (bool), invoiceByPayout (map payoutId → {id, reference}), documents, docKinds (KINDS map), csrfToken. #}
<div class="card page-wide">
  <h1>My commission</h1>
  {% if access.commission %}{# D-261 #}
  {% if not print and me.no_commission != 1 %}{% include "associate_portal/_my_commission.njk" %}{% endif %}{# D-292 #}
  {% if not print and access.commission_statement %}<p><a class="btn-sm btn-secondary" href="/associate/commission?format=csv">Statement (CSV)</a> <a class="btn-sm btn-secondary" href="/associate/commission?print=1" target="_blank" rel="noopener">Printable statement</a></p>{% endif %}
  {# D-264: the order currency is the figure every associate sees; rupees only for an associate in India, once fixed. #}
  {% if not print %}<div class="alert alert-info" data-how-fixed><b>{{ howFixed.title }}</b><br>{{ howFixed.text }}</div>{% endif %}
  <p>Earned in the last {{ totals.months }} months: <b>{{ totalsText.earned }}</b> · Paid in the last {{ totals.months }} months: <b>{{ totalsText.paid }}</b> · Waiting to be paid: <b>{{ totalsText.waiting }}</b>{% if totals.held > 0 %} · On hold: <b>{{ totalsText.held }}</b>{% endif %}</p>
  <p class="muted small" data-commission-period>This shows the commission of the last {{ totals.months }} months, and any commission still waiting to be paid.</p>
  <p class="muted small">We pay each commission in the month shown, after you send us your invoice. Upload your invoice for each line below. We pay only into the bank account we have checked.</p>
  <table class="list">
    {% set __pctCol = access.commission_pct %}{# D-292: the % fixed on each order (with "Show commission %") #}
    <tr><th>Month</th><th>Order</th><th>Client</th>{% if __pctCol %}<th>Your %</th>{% endif %}<th>Amount</th><th>Status</th><th>Paid</th>{% if not print %}<th>Your invoice</th>{% endif %}</tr>
    {% for p in payouts %}{% set inv = invoiceByPayout[p.id] %}
      <tr><td>{{ p.month_label }}</td><td>{{ p.order_reference }}{% if p.note %}<br><small class="muted">{{ p.note }}</small>{% endif %}</td><td>{{ p.company_legal_name }}</td>
        {% if __pctCol %}<td data-order-pct>{{ p.rate_text or '—' }}</td>{% endif %}
        <td>{% if p.amount_fc !== null and p.amount_fc !== undefined %}{{ p.currency_code }} {{ p.amount_fc | money }}{% endif %}{% if p.fixed_rate !== null and p.fixed_rate !== undefined %} <span class="badge badge-active">Fixed</span>{% endif %}
          {% if p.fixed_line %}<br><small data-fixed-rupees>{{ p.fixed_line }}</small>{% elif isIndia and (p.fixed_rate === null or p.fixed_rate === undefined) %}<br><small>₹{{ p.amount_inr | inr }}</small>{% endif %}</td>
        {% set __neg = (p.amount_inr | float) < 0 and p.status == 'due' %}{% set __b = null if __neg else ('paid' if p.status == 'paid' else ('to_be_paid' if p.status == 'due' else null)) %}{# D-410 badges #}
        <td><span class="badge {% if __b == 'paid' %}badge-active{% elif __b == 'to_be_paid' %}badge-tobepaid{% else %}badge-inactive{% endif %}" data-badge="{{ __b or '' }}">{% if __b == 'paid' %}🟢 {% elif __b == 'to_be_paid' %}🔵 {% endif %}{{ p.status_label }}</span></td>
        <td>{% if p.status == 'paid' and not isIndia %}{{ p.paid_on | shortDate }} · {{ p.currency_code }} {{ p.amount_fc | money }} sent{% if p.paid_reference %}<br><small>Ref {{ p.paid_reference }}</small>{% endif %}{% elif p.status == 'paid' %}{{ p.paid_on | shortDate }}{% if (p.tds_inr | float) > 0 %}<br><small data-tds-breakdown>Before tax ₹{{ p.gross_inr | inr }} · Tax we deducted (TDS) ₹{{ p.tds_inr | inr }}{% if p.tds_section %} (Income Tax Act section {{ p.tds_section }}{% if p.tdsRateLabel %}, {{ p.tdsRateLabel }}{% endif %}){% endif %}</small><br>Paid to you ₹{{ p.paid_inr | inr }}{% else %} · ₹{{ p.paid_inr | inr }}{% endif %}{% if p.paid_reference %}<br><small>Ref {{ p.paid_reference }}</small>{% endif %}{% else %}—{% endif %}</td>
        {% if not print %}<td>
          {% if inv %}<a href="/associate/documents/{{ inv.id }}">{{ inv.reference or 'Invoice' }}</a>
          {% elif (p.amount_inr | float) > 0 and p.status != 'paid' %}
            <form method="post" action="/associate/commission/{{ p.id }}/invoice" enctype="multipart/form-data" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="text" name="invoice_no" required maxlength="100" placeholder="Invoice no." aria-label="Invoice number">
              <input type="file" name="invoice_file" required accept=".pdf,.jpg,.jpeg,.png" aria-label="Invoice file"><button type="submit" class="btn-sm">Upload</button></form>
          {% else %}—{% endif %}
        </td>{% endif %}</tr>
    {% endfor %}
    {% if payouts.length == 0 %}<tr><td colspan="8" class="muted">No commission yet. It is earned once a buyer has paid an order in full.</td></tr>{% endif %}
  </table>
  {% if __pctCol %}<p class="muted small">Each order shows the % it was given when its Proforma Invoice was sent. Orders still being paid by the buyer are listed under Orders as "Not earned yet — buyer still paying".</p>{% endif %}
  {% endif %}
  {% if not print and advices and advices.length %}{# D-410 (8): "Payments to you" — one line per bank transfer, with its advice #}
  <h2 id="payments-to-you">Payments to you</h2>
  <table class="list" data-payments-to-you>
    <tr><th>Paid on</th><th>Bank reference</th><th class="num">Paid to you</th><th>Payment advice</th></tr>
    {% for v in advices %}
      <tr><td>{{ v.paid_on | shortDate }}</td><td>{{ v.paid_reference or '—' }}</td>
        <td class="num"><span class="badge badge-active">🟢 {% if v.currency_code == 'INR' %}₹{{ v.total_paid | inr }}{% else %}{{ v.currency_code }} {{ v.total_paid | money }}{% endif %}</span></td>
        <td>{{ v.advice_no }}{% if v.revision > 0 %} Rev {{ v.revision }}{% endif %}{% if v.superseded_at %} <small class="muted">(replaced by a corrected advice)</small>{% endif %}
          · <a href="/associate/payment-advices/{{ v.id }}/pdf">PDF</a> · <a href="/associate/payment-advices/{{ v.id }}/docx">Word</a></td></tr>
    {% endfor %}
  </table>
  <p class="muted small">Each line is one bank transfer to you. The payment advice lists the orders it pays, the tax deducted and the bank reference.</p>
  {% endif %}
  {% if not print and access.tds_certificates %}
  <h2>Tax certificates (Form 16A) and foreign payment forms (15CA / 15CB) from NexaCrest</h2>
  <p class="small muted">By law, we deduct tax (TDS) from your commission. Every three months we give you a certificate of this tax (Form 16A). You will find it here.</p>
  <table class="list">
    {% for d in documents %}{% if d.kind == 'form_16a' or d.kind == 'form_15ca' or d.kind == 'form_15cb' %}
      <tr><td>{{ d.created_at | shortDate }}</td><td><a href="/associate/documents/{{ d.id }}">{{ docKinds[d.kind] }}</a></td><td>{{ d.reference or '' }}</td></tr>
    {% endif %}{% endfor %}
  </table>
  {% elif print %}<script>window.addEventListener('load', () => window.print());</script>{% endif %}
</div>
