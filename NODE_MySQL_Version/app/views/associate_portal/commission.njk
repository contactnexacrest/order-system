{# Expects: payouts (each with p.month_label, order_reference, note, company_legal_name, amount_fc, currency_code, amount_inr, status, hold_reason, paid_on, paid_inr, tds_inr, paid_reference),
   totals, print (bool), invoiceByPayout (map payoutId → {id, reference}), documents, docKinds (KINDS map), csrfToken. #}
<div class="card page-wide">
  <h1>My commission</h1>
  {% if access.commission %}{# D-261 #}
  {% if not print and access.commission_statement %}<p><a class="btn-sm btn-secondary" href="/associate/commission?format=csv">Statement (CSV)</a> <a class="btn-sm btn-secondary" href="/associate/commission?print=1" target="_blank" rel="noopener">Printable statement</a></p>{% endif %}
  {# D-264: the order currency is the figure every associate sees; rupees only for an associate in India, once fixed. #}
  {% if not print %}<div class="alert alert-info" data-how-fixed><b>{{ howFixed.title }}</b><br>{{ howFixed.text }}</div>{% endif %}
  <p>Earned in the last {{ totals.months }} months: <b>{{ totalsText.earned }}</b> · Paid in the last {{ totals.months }} months: <b>{{ totalsText.paid }}</b> · Waiting to be paid: <b>{{ totalsText.waiting }}</b>{% if totals.held > 0 %} · On hold: <b>{{ totalsText.held }}</b>{% endif %}</p>
  <p class="muted small" data-commission-period>This shows the commission of the last {{ totals.months }} months, and any commission still waiting to be paid.</p>
  <p class="muted small">Each commission is paid in the incentive month shown, against your invoice. Upload your invoice for each line below. Payments go only to your verified bank account.</p>
  <table class="list">
    <tr><th>Month</th><th>Order</th><th>Client</th><th>Amount</th><th>Status</th><th>Paid</th>{% if not print %}<th>Your invoice</th>{% endif %}</tr>
    {% for p in payouts %}{% set inv = invoiceByPayout[p.id] %}
      <tr><td>{{ p.month_label }}</td><td>{{ p.order_reference }}{% if p.note %}<br><small class="muted">{{ p.note }}</small>{% endif %}</td><td>{{ p.company_legal_name }}</td>
        <td>{% if p.amount_fc !== null and p.amount_fc !== undefined %}{{ p.currency_code }} {{ p.amount_fc | money }}{% endif %}{% if p.fixed_rate !== null and p.fixed_rate !== undefined %} <span class="badge badge-active">Fixed</span>{% endif %}
          {% if p.fixed_line %}<br><small data-fixed-rupees>{{ p.fixed_line }}</small>{% elif isIndia and (p.fixed_rate === null or p.fixed_rate === undefined) %}<br><small>₹{{ p.amount_inr | money }}</small>{% endif %}</td>
        <td>{{ p.status_label }}</td>
        <td>{% if p.status == 'paid' and not isIndia %}{{ p.paid_on | shortDate }} · {{ p.currency_code }} {{ p.amount_fc | money }} sent{% if p.paid_reference %}<br><small>Ref {{ p.paid_reference }}</small>{% endif %}{% elif p.status == 'paid' %}{{ p.paid_on | shortDate }}{% if (p.tds_inr | float) > 0 %}<br><small data-tds-breakdown>Gross ₹{{ p.gross_inr | money }} · TDS ₹{{ p.tds_inr | money }}{% if p.tds_section %} (u/s {{ p.tds_section }}{% if p.tdsRateLabel %} at {{ p.tdsRateLabel }}{% endif %}){% endif %}</small><br>Net paid ₹{{ p.paid_inr | money }}{% else %} · ₹{{ p.paid_inr | money }}{% endif %}{% if p.paid_reference %}<br><small>Ref {{ p.paid_reference }}</small>{% endif %}{% else %}—{% endif %}</td>
        {% if not print %}<td>
          {% if inv %}<a href="/associate/documents/{{ inv.id }}">{{ inv.reference or 'Invoice' }}</a>
          {% elif (p.amount_inr | float) > 0 and p.status != 'paid' %}
            <form method="post" action="/associate/commission/{{ p.id }}/invoice" enctype="multipart/form-data" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="text" name="invoice_no" required maxlength="100" placeholder="Invoice no." aria-label="Invoice number">
              <input type="file" name="invoice_file" required accept=".pdf,.jpg,.jpeg,.png" aria-label="Invoice file"><button type="submit" class="btn-sm">Upload</button></form>
          {% else %}—{% endif %}
        </td>{% endif %}</tr>
    {% endfor %}
    {% if payouts.length == 0 %}<tr><td colspan="7" class="muted">No commission yet. It is earned once a buyer has paid an order in full.</td></tr>{% endif %}
  </table>
  {% endif %}
  {% if not print and access.tds_certificates %}
  <h2>TDS certificates (Form 16A) and remittance forms from NexaCrest</h2>
  <p class="small muted">NexaCrest deducts TDS on commission as the law requires and issues your Form 16A each quarter; it appears here.</p>
  <table class="list">
    {% for d in documents %}{% if d.kind == 'form_16a' or d.kind == 'form_15ca' or d.kind == 'form_15cb' %}
      <tr><td>{{ d.created_at | shortDate }}</td><td><a href="/associate/documents/{{ d.id }}">{{ docKinds[d.kind] }}</a></td><td>{{ d.reference or '' }}</td></tr>
    {% endif %}{% endfor %}
  </table>
  {% elif print %}<script>window.addEventListener('load', () => window.print());</script>{% endif %}
</div>
