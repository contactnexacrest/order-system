{# Owner decision D-245 P3: the associate's price range. Per product: the price to quote and the lowest price
   they may agree. Never cost, margin or formula. PHP twin: prices.php. Expects: list {level, rows, hash, changed_at, acknowledged, ack_at}. #}
<div class="card page-wide">
  <h1>Your price range</h1>
  <p class="muted">Price list dated <b>{{ (list.changed_at | shortDate) if list.changed_at else '—' }}</b>{% if list.acknowledged %} · acknowledged by you on {{ list.ack_at | shortDate }} ✓{% endif %}</p>
  {% if not list.acknowledged and list.rows.length %}
    <div class="alert alert-warning">These prices are new or have changed. Please read them and acknowledge them.
      <form method="post" action="/associate/prices/acknowledge" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="hash" value="{{ list.hash }}"><button type="submit" class="btn-sm">I have read this price list</button></form>
    </div>
  {% endif %}
  <table class="list">
    <tr><th>Product</th><th>Unit</th><th class="r">Quote price (USD)</th><th class="r">Lowest you may agree (USD)</th></tr>
    {% for r in list.rows %}
      <tr><td>{{ r.name }}</td><td>{{ r.unit }}</td><td class="r">{{ r.quote | money }}</td><td class="r">{{ r.lowest | money }}</td></tr>
    {% endfor %}
    {% if list.rows.length == 0 %}<tr><td colspan="4" class="muted">No priced products yet.</td></tr>{% endif %}
  </table>
  <p class="small">Quote at the first price. You may agree any price down to the second one; your commission ({{ levelText }}) is the same anywhere in between. Below it, NexaCrest must approve in writing and <b>no commission is paid</b> on that line. Prices are FOB, per unit.</p>
</div>
