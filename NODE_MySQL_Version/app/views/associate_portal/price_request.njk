{# Owner decision D-255 (5 Nov 2026): one price request — the quote price and the lowest the associate may agree,
   valid until a date, with what changed the price. Never cost, margin or formula. On screen only. PHP twin: price_request.php. #}
{% set unit = r.unit or '' %}
<div class="card page-wide">
  <p class="muted small"><a href="/associate/catalogue">&larr; Catalogue</a></p>
  <h1>{{ product.name if product else 'Product' }}</h1>
  <p class="muted">Price request <b>{{ r.number }}</b> · {{ r.selection_text }}</p>
  {% if status == 'pending' %}
    <div class="alert alert-warning">This is not a standard specification — our team will send the price here and by e-mail within 24 hours (by {{ (r.due_at or '') | string | truncate(16, true, '') }}). It does not use one of your daily price requests.</div>
  {% elif r.quote !== null %}
    <p class="muted">{{ 'Expired on ' if status == 'expired' else 'Valid until ' }}{{ r.valid_until | shortDate }} · FOB Indian port, per {{ unit }}</p>
    <div class="field-grid">
      <div><div class="muted small">Quote price</div><div style="font-size:1.5em;font-weight:700">USD {{ r.quote | money }}{{ ' / CBM' if unit == 'CBM' else '' }}</div></div>
      <div><div class="muted small">Lowest you may agree</div><div style="font-size:1.5em;font-weight:700">USD {{ r.lowest | money }}{{ ' / CBM' if unit == 'CBM' else '' }}</div></div>
    </div>
    {% if breakdown.per_m2 %}<p class="muted small">≈ USD {{ breakdown.per_m2 | money }} per m² ({{ breakdown.m2_per_cbm }} m² in one CBM) — for comparison only; the order is in CBM.</p>{% endif %}
    <table class="list">
      {% for l in breakdown.lines or [] %}<tr><td>{{ l.label }}</td><td class="r">{{ l.change }}</td></tr>{% endfor %}
    </table>
    {% for c in breakdown.charges or [] %}<p class="small">+ {{ c }}</p>{% endfor %}
    <p class="small muted">Your commission{% if r.level_name %} ({{ r.level_name }}){% endif %} is the same anywhere between the two prices. Prices are confirmed on the Proforma Invoice. {{ left }} price requests left today.</p>
  {% else %}
    <p class="muted">This request was not priced.</p>
  {% endif %}
</div>
