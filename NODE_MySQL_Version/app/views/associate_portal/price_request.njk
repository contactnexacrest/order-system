{# Owner decision D-255 (5 Nov 2026): one price request — the quote price and the lowest the associate may agree,
   valid until a date, with what changed the price. Never cost, margin or formula. On screen only. PHP twin: price_request.php. #}
{% set unit = r.unit or '' %}
<div class="card page-wide">
  <p class="muted small"><a href="/associate/catalogue">&larr; Catalogue</a></p>
  <h1>{{ product.name if product else 'Product' }}</h1>
  <p class="muted">Price request <b>{{ r.number }}</b> · {{ r.selection_text }}</p>
  {% if status == 'pending' %}
    <div class="alert alert-warning">This is not a standard product, so our team will price it. You will get the price here and by e-mail within 24 hours (by {{ (r.due_at or '') | string | truncate(16, true, '') }}). This request does not count toward your daily limit.</div>
  {% elif r.quote !== null %}
    <p class="muted">{{ 'Expired on ' if status == 'expired' else 'Valid until ' }}{{ r.valid_until | shortDate }} · price on board the ship at the Indian port (FOB), per {{ unit }}</p>
    <div class="field-grid">
      <div><div class="muted small">Quote price</div><div style="font-size:1.5em;font-weight:700">USD {{ r.quote | money }}{{ ' / CBM' if unit == 'CBM' else '' }}</div></div>
      <div><div class="muted small">Lowest price you may agree with the buyer</div><div style="font-size:1.5em;font-weight:700">USD {{ r.lowest | money }}{{ ' / CBM' if unit == 'CBM' else '' }}</div></div>
    </div>
    {% if otherUnits %}{# Owner decision D-339: your two prices in the other units (worked out, nothing saved) #}
      <h2>Your prices in other units{% if otherUnits.mm != null %} — {{ otherUnits.mm / 10 }} cm thick{% endif %}</h2>
      <table class="list">
        <tr><th></th><th class="r">per CBM</th><th class="r">per SQM</th><th class="r">per SQFT</th></tr>
        <tr><td>Quote price (USD)</td>{% for u in ['CBM', 'SQM', 'SQFT'] %}<td class="r">{{ (otherUnits.quote[u] | money) if otherUnits.quote[u] != null else '—' }}</td>{% endfor %}</tr>
        <tr><td>Lowest you may agree (USD)</td>{% for u in ['CBM', 'SQM', 'SQFT'] %}<td class="r">{{ (otherUnits.lowest[u] | money) if otherUnits.lowest[u] != null else '—' }}</td>{% endfor %}</tr>
      </table>
      <p class="muted small">1 CBM = 1,000 ÷ thickness in mm SQM; 1 SQM = 10.7639 SQFT. "—" needs a thickness. Only to compare — the order is priced in the unit above.</p>
    {% endif %}
    {% if breakdown.per_m2 %}<p class="muted small">About USD {{ breakdown.per_m2 | money }} per square metre (one cubic metre gives {{ breakdown.m2_per_cbm }} SQM). This is only to compare; the order is priced per cubic metre.</p>{% endif %}
    <table class="list">
      {% for l in breakdown.lines or [] %}<tr><td>{{ l.label }}</td><td class="r">{{ l.change }}</td></tr>{% endfor %}
    </table>
    {% for c in breakdown.charges or [] %}<p class="small">+ {{ c }}</p>{% endfor %}
    <p class="small muted">Your commission is the same anywhere between the two prices. Prices are confirmed on the Proforma Invoice. {{ left }} price requests left today.</p>
  {% else %}
    <p class="muted">This request was not priced.</p>
  {% endif %}
</div>
