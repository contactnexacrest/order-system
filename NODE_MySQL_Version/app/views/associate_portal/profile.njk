{# Expects: me, commissionNow, commissionSettings, runLabel, banks (each with b.masked, b.usable_later = usable_from after today), usableBankMasked (string|null),
   documents, docKinds (KINDS map), associateKinds (list of kinds the associate may upload), bankWaitDays, csrfToken. #}
{% set __india = me.based_in == 'india' %}
<div class="card page-wide">
  <h1>My profile</h1>
  <table class="kv">
    <tr><th>Name</th><td>{{ me.name }}</td></tr>
    <tr><th>E-mail (login)</th><td>{{ me.email }} <small class="muted">— ask NexaCrest to change it</small></td></tr>
    <tr><th>Agreement</th><td>signed {{ (me.agreement_signed_on | shortDate) if me.agreement_signed_on else '—' }}, ends {{ (me.agreement_ends_on | shortDate) if me.agreement_ends_on else '—' }}{% if me.agreement_file_id %} · <a href="/associate/agreement">Download my agreement</a>{% endif %}</td></tr>
    <tr><th>My commission</th><td>
      {% if me.no_commission == 1 %}No commission under your agreement.{% else %}
      {% include "associate_portal/_my_commission.njk" %}{# D-292: the current % only, and How it works #}{% endif %}</td></tr>
  </table>

  <div class="section">
    <h2>Contact and tax details</h2>
    <form method="post" action="/associate/profile">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Phone<input type="tel" name="phone" maxlength="40" value="{{ me.phone or '' }}" placeholder="e.g. +91 98765 43210"></label>
        {% if __india %}<label>PAN<input type="text" name="pan" maxlength="10" pattern="[A-Za-z]{5}[0-9]{4}[A-Za-z]" title="As on the card, e.g. ABCDE1234F" value="{{ me.pan or '' }}" placeholder="e.g. ABCDE1234F"></label>{% endif %}
        <label>GSTIN (if registered)<input type="text" name="gstin" maxlength="15" pattern="[0-9]{2}[A-Za-z0-9]{13}" value="{{ me.gstin or '' }}" placeholder="e.g. 29ABCDE1234F1Z5"></label>
        <label style="grid-column:1/-1">Address<textarea name="address" maxlength="1000" rows="2" placeholder="e.g. 12 MG Road, Bengaluru 560001">{{ me.address or '' }}</textarea></label>
      </div>
      <button type="submit" class="btn-sm">Save</button>
    </form>
  </div>

  <div class="section">
    <h2>Bank details</h2>
    <p>Payments go to: <b>{{ usableBankMasked or 'no verified account yet' }}</b></p>
    <table class="list"><tr><th>Sent</th><th>Account</th><th>Status</th></tr>
      {% for b in banks %}<tr><td>{{ (b.requested_at | shortDate) if b.requested_at else '—' }}</td><td>{{ b.masked }}</td>
        <td>{{ b.status_text }}{% if b.status == 'awaiting_confirmation' %} <a class="btn-sm" href="/associate/bank/confirm">Review now</a>{% endif %}</td></tr>{% endfor %}
      {% if banks.length == 0 %}<tr><td colspan="3" class="muted">None yet.</td></tr>{% endif %}
    </table>
    <details><summary>{{ 'Add my bank details' if banks.length == 0 else 'Change my bank details' }}</summary>
      <p class="muted small">You confirm new details with a code we e-mail you (within {{ bankConfirmDays }} days), then NexaCrest checks them. Until then, payments keep going to your verified account; a changed account is used {{ bankWaitDays }} days after it is verified{{ (', a first account ' ~ bankWaitFirst ~ ' days after') if bankWaitFirst > 0 }}.</p>
      <form method="post" action="/associate/bank" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% include "associate_portal/_bank_fields.njk" %}
        <button type="submit" class="btn-sm">Send — then confirm with the e-mailed code</button>
      </form>
    </details>
  </div>

  <div class="section" id="kyc">
    <h2>My documents and KYC</h2>
    {# Owner decision D-252 (A3): the KYC checklist — NexaCrest checks each document; commission is paid once all are accepted. #}
    <table class="list"><tr><th>Needed</th><th>Status</th><th>Document</th></tr>
      {% for i in kyc %}
        <tr><td>{{ i.label }}</td>
          <td><span class="badge {{ {'accepted': 'badge-success', 'rejected': 'badge-danger', 'pending': 'badge-warning'}[i.status] or '' }}">{{ kycLabels[i.status] }}</span>
            {% if i.status == 'rejected' and i.doc and i.doc.review_reason %}<br><small>{{ i.doc.review_reason }} — please upload it again.</small>{% endif %}</td>
          <td>{% if i.doc %}{{ docKinds[i.doc.kind] or i.doc.kind }}{% if i.doc.id_doc_type %} — {{ idDocTypes[i.doc.id_doc_type] or i.doc.id_doc_type }}{% endif %}{% if i.doc.reference %} · {{ i.doc.reference }}{% endif %}{% elif i.by_nexacrest %}On file at NexaCrest{% else %}—{% endif %}</td></tr>
      {% endfor %}
    </table>
    <p class="muted small">Commission is paid once every document above is accepted.</p>
    {% if addressGrace %}<p class="small" data-address-grace>{{ addressGrace }}</p>{% endif %}{# D-290 #}
    <h3>All documents</h3>
    <table class="list"><tr><th>Added</th><th>Document</th><th>Number / reference</th><th>Status</th></tr>
      {% for d in documents %}<tr><td>{{ d.created_at | shortDate }}</td><td><a href="/associate/documents/{{ d.id }}">{{ docKinds[d.kind] or d.kind }}</a></td><td>{{ d.reference or '' }}</td>
        <td>{{ {'accepted': 'Accepted', 'rejected': 'Rejected', 'received': 'Being checked'}[d.status] or d.status }}</td></tr>{% endfor %}
      {% if documents.length == 0 %}<tr><td colspan="4" class="muted">None yet.</td></tr>{% endif %}
    </table>
    <form method="post" action="/associate/documents" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        {% set docUploadKinds = associateKinds %}{% include "associates/_doc_upload_fields.njk" %}
      </div>
      <button type="submit" class="btn-sm">Upload</button>
    </form>
    <p class="muted small">{{ 'India: PAN card, ID proof (Aadhaar card — we keep only its last 4 digits — or an ID document), address proof, bank proof, the signed agreement, GST certificate if registered.' if __india else 'Abroad: ID proof (passport, national ID card, residence permit or driving licence), address proof, bank proof, the signed agreement; also tax residency certificate, Form 10F, no-PE declaration.' }}</p>
    <p class="muted small">ID proof and address proof are two separate uploads. If one document shows both (e.g. a passport with your current address), upload it once as "ID document" and once as "Address proof" — we check each on its own.</p>
  </div>
</div>
