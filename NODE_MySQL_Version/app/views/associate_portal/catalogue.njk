{# Owner decision D-255 (5 Nov 2026): the associate's catalogue — the products they may offer, with no prices,
   supplier names or quarry locations. "Get price" asks for a price for one product and specification. PHP twin: catalogue.php. #}
{% set statusText = {'pending': 'Our team is working on it', 'ordered': 'Became an order', 'expired': 'Expired', 'refused': 'We could not give a price'} %}
<div class="card page-wide">
  <h1>Catalogue</h1>
  <p class="muted">Products you can offer to buyers. Ask us for a price. You can ask for <b>{{ left }}</b> more prices today (out of {{ limit }}).</p>
  <table class="list">
    <tr><th>Product</th><th>Available as</th><th>Finishes</th><th></th></tr>
    {% for p in products %}
      <tr>
        <td><b>{{ p.name }}</b>{% if p.description %}<br><small class="muted">{{ p.description | truncate(160, true, '') }}</small>{% endif %}</td>
        <td>{{ p.forms | join(', ') if p.forms.length else '—' }}</td>
        <td>{{ p.finishes | join(', ') if p.finishes.length else '—' }}</td>
        <td>{% if access.get_price %}<a class="btn-sm" href="/associate/catalogue/{{ p.id }}">Get price</a>{% endif %}</td>
      </tr>
    {% endfor %}
    {% if not products.length %}<tr><td colspan="4" class="muted">No products are open to you yet — NexaCrest chooses which categories you can offer.</td></tr>{% endif %}
  </table>
  <p class="small muted">No prices, supplier names or quarry locations are shown here. Product descriptions can be shared with buyers.</p>

  <h2>Your price requests</h2>
  <table class="list">
    <tr><th>No.</th><th>Product · specification</th><th class="r">Price to quote · Lowest price you may agree</th><th>Status</th></tr>
    {% for r in requests %}
      <tr>
        <td><a href="/associate/price-requests/{{ r.id }}">{{ r.number }}</a></td>
        <td>{{ r.product_name }} · {{ r.selection_text }}</td>
        <td class="r">{% if r.quote !== null %}{{ r.quote | money }} · {{ r.lowest | money }} <small class="muted">USD/{{ r.unit }}</small>{% else %}—{% endif %}</td>
        <td>{% if r.display_status == 'valid' %}Valid until {{ r.valid_until | shortDate }}{% elif r.display_status == 'priced' %}Priced — valid until {{ r.valid_until | shortDate }}{% else %}{{ statusText[r.display_status] or r.display_status }}{% endif %}</td>
      </tr>
    {% endfor %}
    {% if not requests.length %}<tr><td colspan="4" class="muted">No price requests yet.</td></tr>{% endif %}
  </table>
</div>
