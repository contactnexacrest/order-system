{# Expects: me, statuses (STATUSES map), totals {earned, waiting, paid, held, months}, clients, orders (latest 5, each with stage and commission),
   events (notices: created_at, message, read_at, is_notice), openInvitations (count of created/opened/registered invitations). #}
<div class="card page-wide">
  <h1>Welcome, {{ me.name }}</h1>
  {% if me.status != 'active' %}<div class="alert alert-warning">Your account is {{ (statuses[me.status] or me.status) | lower }}. {{ 'It becomes active once NexaCrest has checked your documents and bank details — add them under Profile.' if me.status == 'invited' else 'Contact your relationship manager.' }}</div>{% endif %}
  {% if kycMissing.length or not me.address %}
    {# Owner decision D-253 / D-252: after the first login the associate completes the profile and the KYC documents. #}
    <div class="alert alert-warning">Please complete <a href="/associate/profile#kyc">your profile and documents</a>{% if kycMissing.length %} — still needed or being checked: {{ kycMissing | join(', ') }}{% endif %}{% if not me.address %}{{ '; ' if kycMissing.length else ' — ' }}your address{% endif %}. Commission is paid once your documents are accepted.</div>
  {% endif %}
  {% if access.commission %}{# D-261 #}
  <div class="stat-row">
    {# D-264: the order currency (USD) is the figure an associate sees; rupees only on a fixed line, for an associate in India. #}
    <div class="stat"><div class="stat-label">Earned in the last {{ totals.months }} months</div><div class="stat-value">{{ totalsText.earned }}</div></div>
    <div class="stat"><div class="stat-label">Waiting to be paid</div><div class="stat-value">{{ totalsText.waiting }}</div></div>
    <div class="stat"><div class="stat-label">Paid in the last {{ totals.months }} months</div><div class="stat-value">{{ totalsText.paid }}</div></div>
    {% if totals.held > 0 %}<div class="stat"><div class="stat-label">On hold</div><div class="stat-value">{{ totalsText.held }}</div></div>{% endif %}
  </div>
  {% endif %}
  <p>{% if access.clients %}Clients: <b>{{ clients.length }}</b>{% endif %}{% if access.registration_links %} · Buyer registration links open: <b>{{ openInvitations }}</b>
    {% if me.personal_code %} · Your personal code: <b>{{ me.personal_code }}</b>{% endif %}{% endif %}</p>
  {% if access.registration_links %}<p><a class="btn-sm" href="/associate/clients">Invite a client</a></p>{% endif %}

  {% if access.orders %}{# D-261 #}
  <h2>Latest orders</h2>
  <table class="list"><tr><th>Order</th><th>Client</th><th>Stage</th>{% if access.commission %}<th>Commission</th>{% endif %}</tr>
    {% for o in orders %}<tr><td><a href="/associate/orders/{{ o.id }}">{{ o.order_reference }}</a></td><td>{{ o.company_legal_name }}</td><td>{{ o.stage }}</td>{% if access.commission %}<td>{% include "associate_portal/_commission_cell.njk" %}</td>{% endif %}</tr>{% endfor %}
    {% if orders.length == 0 %}<tr><td colspan="4" class="muted">No orders yet.</td></tr>{% endif %}
  </table>
  {% endif %}

  <h2>Notices</h2>
  <table class="list">
    {% for e in events %}<tr><td style="white-space:nowrap">{{ e.created_at | shortDate }}</td><td>{% if not e.read_at and e.is_notice == 1 %}<b>{{ e.message }}</b>{% else %}{{ e.message }}{% endif %}</td></tr>{% endfor %}
    {% if events.length == 0 %}<tr><td class="muted">Nothing yet.</td></tr>{% endif %}
  </table>
</div>
