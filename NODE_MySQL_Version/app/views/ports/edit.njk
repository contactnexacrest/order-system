<div class="card page-wide">
  <p class="muted small"><a href="/ports">&larr; Back to Ports</a></p>
  <h1>Edit Port — {{ port.name }}</h1>
  <form method="post" action="/ports/{{ port.id }}/update">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field-grid">
      <label>Port Name *
        <input type="text" name="name" value="{{ port.name }}" placeholder="e.g., Nhava Sheva (JNPT)" required>
      </label>
      <label>City <small class="muted">(printed on Incoterms labels, e.g. "FOB Mumbai" — not the terminal name above)</small>
        <input type="text" name="city" value="{{ port.city or '' }}" placeholder="e.g., Mumbai">
      </label>
      <label>Country
        <input type="text" name="country" value="{{ port.country or '' }}" placeholder="e.g., India">
      </label>
      <label>Role *
        <select name="port_role" required>
          {% for key, label in roles %}
            <option value="{{ key }}" {% if port.port_role == key %}selected{% endif %}>{{ label }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm btn-success">Save Changes</button>
      <a href="/ports" class="btn-sm btn-secondary">Cancel</a>
    </div>
  </form>
</div>
