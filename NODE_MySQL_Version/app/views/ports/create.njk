<div class="card page-wide">
  <p class="muted small"><a href="/ports">&larr; Back to Ports</a></p>
  <h1>Add Port</h1>
  <form method="post" action="/ports">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field-grid">
      <label>Port Name *
        <input type="text" name="name" placeholder="e.g., Nhava Sheva (JNPT)" required>
      </label>
      <label>City <small class="muted">(printed on Incoterms labels, e.g. "FOB Mumbai" — not the terminal name above)</small>
        <input type="text" name="city" placeholder="e.g., Mumbai">
      </label>
      <label>Country
        <input type="text" name="country" placeholder="e.g., India">
      </label>
      <label>Role *
        <select name="port_role" required>
          {% for key, label in roles %}
            <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn-sm btn-success">Add Port</button>
      <a href="/ports" class="btn-sm btn-secondary">Cancel</a>
    </div>
  </form>
</div>
