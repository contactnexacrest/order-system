<div class="card card-narrow">
  <h1>My Account</h1>
  <p class="muted small">{{ user.name }} &middot; {{ user.email }}</p>

  <div class="section">
    <h2>Email Signature</h2>
    <p class="muted">Appended to every email you send through the system — document sends, order updates, anything else. Leave blank to fall back to your name and title.</p>
    <form method="post" action="/account/signature">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Signature<textarea name="email_signature" rows="6" placeholder="Regards,&#10;Export Executive&#10;NexaCrest International&#10;+91-0000000000">{{ user.email_signature or '' }}</textarea></label>
      <button type="submit" class="btn-sm btn-accent">Save Signature</button>
    </form>
  </div>

  <div class="section">
    <h2>Notifications</h2>
    <p class="muted">The system emails a notification for every action logged against orders, clients, documents, payments, and more. This controls whether you personally receive a copy of your own actions — a separate, always-on notification address can also be configured by an admin (Settings &gt; Notifications).</p>
    <form method="post" action="/account/notifications">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label><input type="checkbox" name="email_action_notifications_enabled" value="1" {{ 'checked' if user.email_action_notifications_enabled }}> Email me my notifications — work waiting on me and what clients do on my orders</label>
      <button type="submit" class="btn-sm btn-accent">Save Notification Preference</button>
    </form>
  </div>

  <div class="section">
    <h2>UI Template</h2>
    <p class="muted">Choose which UI template you see across the app. Leave on "Use company default" to automatically follow whatever the company default is set to (Admin &gt; Settings), even if it changes later.</p>
    <form method="post" action="/account/ui-template">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Template
        <select name="ui_template_preference_id">
          <option value="" {{ 'selected' if not user.ui_template_preference_id }}>Use company default</option>
          {% for t in activeUiTemplates %}
            <option value="{{ t.id }}" {{ 'selected' if user.ui_template_preference_id == t.id }}>{{ t.name }}</option>
          {% endfor %}
        </select>
      </label>
      <button type="submit" class="btn-sm btn-accent">Save UI Template</button>
    </form>
  </div>

  {# Owner decision D-283 (11 Nov 2026): "This is my own office computer" — forget them all. #}
  <div class="section" id="remembered-computers">
    <h2>Remembered computers</h2>
    <p class="small">Computers where you ticked "This is my own office computer" skip the e-mailed login code for {{ rememberDays }} day(s). Remembered now: <b>{{ rememberedCount }}</b>.</p>
    <form method="post" action="/account/forget-computers" data-confirm="Forget all remembered computers? Every computer asks for the login code again at the next login.">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-sm btn-secondary">Forget all remembered computers</button>
    </form>
  </div>

  {% if backupEligible %}
  <div class="section" id="backup-codes">
    <h2>Emergency backup codes</h2>
    <p class="small">Every login needs a 6-digit code e-mailed to you. If e-mail ever stops working, a backup code lets you sign in instead. Each code works once; using one is recorded and the company-settings holders are told. Keep them somewhere safe and offline.</p>
    <p data-backup-remaining>Backup codes left: <b>{{ backupRemaining }}</b> of {{ backupCount }}</p>
    <form method="post" action="/account/backup-codes" data-confirm="Make a new set of backup codes? The codes you have now will stop working.">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Current password *
        <input type="password" name="current_password" required placeholder="Your current password">
      </label>
      <button type="submit" class="btn-sm">Make new backup codes</button>
    </form>
  </div>
  {% endif %}

  <div class="section">
    <h2>Change Password</h2>
    <form method="post" action="/account/password">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Current Password
        <input type="password" name="current_password" required placeholder="Your current password">
      </label>
      <label>New Password
        <input type="password" name="new_password" required placeholder="At least 10 characters">
      </label>
      <label>Confirm New Password
        <input type="password" name="confirm_password" required placeholder="Type the new password again">
      </label>
      <button type="submit" class="btn-sm btn-accent">Update Password</button>
    </form>
  </div>
</div>
