<div class="card page-wide">
  <p class="muted small"><a href="/products">&larr; Back to Products</a></p>
  <h1>{{ product.name }} <span class="badge {{ 'badge-active' if product.is_active else 'badge-inactive' }}">{{ 'Active' if product.is_active else 'Inactive' }}</span></h1>
  <p class="muted">HS Code: <strong>{{ product.hs_code }}</strong> &nbsp;·&nbsp; Origin: {{ product.origin or '—' }}</p>

  {% if canManage %}
    <p>
      <a class="btn-sm" href="/products/{{ product.id }}/edit">Edit</a>
      <form method="post" action="/products/{{ product.id }}/delete" style="display:inline" onsubmit="return confirm('Permanently delete this product and all its images/suppliers/misc charges? This cannot be undone.');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn-sm btn-danger">Delete Product</button>
      </form>
    </p>
  {% endif %}

  <div class="section">
    <h2>Specifications</h2>
    <p>{{ product.specifications | nl2br }}</p>
    {# Owner decision D-255 (5 Nov 2026): the options that change the price. #}
    {% if permissions.view_price_buildup or permissions.manage_product_specifications or permissions.manage_pricing %}<p><a class="btn-sm btn-secondary" href="/products/{{ product.id }}/specifications">Price options (specifications)</a></p>{% endif %}
  </div>


  {% include 'products/_pricing.njk' %}

  {% if canViewPricing %}
  <div class="section">
    <h2>Default Cost Components</h2>
    <p class="muted small">These are the catalog-wide fallbacks a computed-FOB supplier uses for any cost component it does not itself override.</p>
    <div class="kv-grid">
      {# Owner decision D-214, phase 2: the factory cost is the buying side; the rest are logistics costs. #}
      {% if sees.purchase %}<div><span class="k">Factory Cost</span><span class="v">{{ '—' if product.default_factory_cost == null else (product.default_factory_cost | money) }}</span></div>{% endif %}
      {% if sees.logistics %}
      <div><span class="k">Transportation Cost</span><span class="v">{{ '—' if product.default_transportation_cost == null else (product.default_transportation_cost | money) }}</span></div>
      <div><span class="k">Packing Cost</span><span class="v">{{ '—' if product.default_packing_cost == null else (product.default_packing_cost | money) }}</span></div>
      <div><span class="k">Loading Cost</span><span class="v">{{ '—' if product.default_loading_cost == null else (product.default_loading_cost | money) }}</span></div>
      <div><span class="k">CHA Cost</span><span class="v">{{ '—' if product.default_cha_cost == null else (product.default_cha_cost | money) }}</span></div>{% endif %}
    </div>
  </div>
  {% endif %}

  <div class="section">
    <h2>Images</h2>
    <div class="asset-grid">
      {% for img in images %}
        <div class="asset-tile" style="position:relative">
          <img src="/products/images/{{ img.id }}/view" alt="Product image" class="asset-preview">
          {% if canManage %}
            <form method="post" action="/products/images/{{ img.id }}/delete" style="position:absolute;top:4px;right:4px" onsubmit="return confirm('Remove this image?');">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" class="btn-sm btn-danger" title="Remove image">&times;</button>
            </form>
          {% endif %}
        </div>
      {% endfor %}
      {% if not images.length %}<p class="muted">No images uploaded yet.</p>{% endif %}
    </div>
    {% if canManage %}
      <form method="post" action="/products/{{ product.id }}/images/upload" enctype="multipart/form-data" style="margin-top:0.75rem">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="file" name="image" accept=".png,.jpg,.jpeg" required aria-label="Image">
        <button type="submit" class="btn-sm">Upload Image</button>
      </form>
    {% endif %}
  </div>

  {% if canViewPricing and canSeeSuppliers %}
  <div class="section">
    <h2>Suppliers</h2>
    <table class="list">
      <tr>
        <th>Supplier</th><th>Location</th><th>Contact</th><th>FOB Source</th><th>Effective FOB</th><th>Used for pricing</th><th></th>
      </tr>
      {% if not suppliers.length %}
        <tr><td colspan="7" class="muted">No suppliers on file yet.</td></tr>
      {% endif %}
      {% for s in suppliers %}
        <tr>
          <td>{{ s.supplier_name }}</td>
          <td>{{ s.location or '—' }}</td>
          <td>
            {{ s.contact_person or '—' }}
            {% if s.contact_phone %}<br><small class="muted">{{ s.contact_phone }}</small>{% endif %}
            {% if s.contact_email %}<br><small class="muted">{{ s.contact_email }}</small>{% endif %}
          </td>
          <td>{{ s.fob_source | capitalize }}</td>
          <td>{{ 'To Be Confirmed' if s.effective_fob == null else (s.effective_fob | money) }}</td>
          <td>{{ '&#9733;' | safe if s.is_primary else '' }}</td>
          <td>
            {% if canManage %}
              {% if not s.is_primary %}
                <form method="post" action="/products/suppliers/{{ s.id }}/set-primary" style="display:inline">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn-sm">Use for pricing</button>
                </form>
              {% endif %}
              <details style="display:inline-block">
                <summary class="btn-sm" style="display:inline-block;cursor:pointer">Edit</summary>
                <div class="card-nested">
                  <form method="post" action="/products/suppliers/{{ s.id }}/update">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <label>Supplier Name *<input type="text" name="supplier_name" value="{{ s.supplier_name }}" required placeholder="e.g. Sri Balaji Granites"></label>
                    <label>Location<input type="text" name="location" value="{{ s.location or '' }}" placeholder="e.g. Krishnagiri, Tamil Nadu"></label>
                    <label>Contact Person<input type="text" name="contact_person" value="{{ s.contact_person or '' }}" placeholder="e.g. Rajesh Kumar"></label>
                    <label>Contact Phone<input type="text" name="contact_phone" value="{{ s.contact_phone or '' }}" placeholder="e.g. +91 98765 43210"></label>
                    <label>Contact Email<input type="text" name="contact_email" value="{{ s.contact_email or '' }}" placeholder="e.g. name@company.com"></label>
                    <label>FOB Source
                      <select name="fob_source">
                        <option value="direct" {{ 'selected' if s.fob_source == 'direct' }}>Direct</option>
                        <option value="computed" {{ 'selected' if s.fob_source == 'computed' }}>Computed</option>
                      </select>
                    </label>
                    <label>FOB Value (direct only)<input type="number" step="0.01" min="0" name="fob_value" value="{{ s.fob_value if s.fob_value != null else '' }}" placeholder="e.g. 4500.00"></label>
                    <label>Factory Cost override<input type="number" step="0.01" min="0" name="factory_cost" value="{{ s.factory_cost if s.factory_cost != null else '' }}" placeholder="e.g. 350000"></label>
                    <label>Transportation Cost override<input type="number" step="0.01" min="0" name="transportation_cost" value="{{ s.transportation_cost if s.transportation_cost != null else '' }}" placeholder="e.g. 9000"></label>
                    <label>Packing Cost override<input type="number" step="0.01" min="0" name="packing_cost" value="{{ s.packing_cost if s.packing_cost != null else '' }}" placeholder="e.g. 12000"></label>
                    <label>Loading Cost override<input type="number" step="0.01" min="0" name="loading_cost" value="{{ s.loading_cost if s.loading_cost != null else '' }}" placeholder="e.g. 8000"></label>
                    <label>CHA Cost override<input type="number" step="0.01" min="0" name="cha_cost" value="{{ s.cha_cost if s.cha_cost != null else '' }}" placeholder="e.g. 15000"></label>
                    <label>Notes<textarea name="notes" rows="2" placeholder="Optional notes">{{ s.notes or '' }}</textarea></label>
                    <label><input type="checkbox" name="is_primary" value="1" {{ 'checked' if s.is_primary }}> Used for pricing</label>
                    <button type="submit" class="btn-sm">Save</button>
                  </form>
                </div>
              </details>
              <form method="post" action="/products/suppliers/{{ s.id }}/delete" style="display:inline" onsubmit="return confirm('Remove this supplier?');">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button type="submit" class="btn-sm btn-danger">Delete</button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>

    {% if canManage %}
      <details>
        <summary class="btn-sm" style="display:inline-block;cursor:pointer">+ Add Supplier</summary>
        <div class="card-nested">
          <form method="post" action="/products/{{ product.id }}/suppliers/add">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Supplier Name *<input type="text" name="supplier_name" required placeholder="e.g. Sri Balaji Granites"></label>
            <label>Location<input type="text" name="location" placeholder="e.g. Krishnagiri, Tamil Nadu"></label>
            <label>Contact Person<input type="text" name="contact_person" placeholder="e.g. Rajesh Kumar"></label>
            <label>Contact Phone<input type="text" name="contact_phone" placeholder="e.g. +91 98765 43210"></label>
            <label>Contact Email<input type="text" name="contact_email" placeholder="e.g. name@company.com"></label>
            <label>FOB Source
              <select name="fob_source">
                <option value="direct">Direct</option>
                <option value="computed">Computed</option>
              </select>
            </label>
            <label>FOB Value (direct only)<input type="number" step="0.01" min="0" name="fob_value" placeholder="e.g. 4500.00"></label>
            <label>Factory Cost override<input type="number" step="0.01" min="0" name="factory_cost" placeholder="e.g. 350000"></label>
            <label>Transportation Cost override<input type="number" step="0.01" min="0" name="transportation_cost" placeholder="e.g. 9000"></label>
            <label>Packing Cost override<input type="number" step="0.01" min="0" name="packing_cost" placeholder="e.g. 12000"></label>
            <label>Loading Cost override<input type="number" step="0.01" min="0" name="loading_cost" placeholder="e.g. 8000"></label>
            <label>CHA Cost override<input type="number" step="0.01" min="0" name="cha_cost" placeholder="e.g. 15000"></label>
            <label>Notes<textarea name="notes" rows="2" placeholder="Optional notes"></textarea></label>
            <label><input type="checkbox" name="is_primary" value="1"> Used for pricing</label>
            <button type="submit" class="btn-sm btn-accent">Add Supplier</button>
          </form>
        </div>
      </details>
    {% endif %}
  </div>

  <div class="section">
    <h2>Misc Charges <span class="muted small">(reference only — never included in any FOB calculation)</span></h2>
    <table class="list">
      <tr><th>Label</th><th>Amount</th><th>Notes</th><th></th></tr>
      {% if not miscCharges.length %}
        <tr><td colspan="4" class="muted">No misc charges on file.</td></tr>
      {% endif %}
      {% for mc in miscCharges %}
        <tr>
          <td>{{ mc.label }}</td>
          <td>{{ mc.amount | money }}</td>
          <td>{{ mc.notes or '' }}</td>
          <td>
            {% if canManage %}
              <form method="post" action="/products/misc-charges/{{ mc.id }}/delete" style="display:inline" onsubmit="return confirm('Remove this misc charge?');">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button type="submit" class="btn-sm btn-danger">Delete</button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
    {% if canManage %}
      <form method="post" action="/products/{{ product.id }}/misc-charges/add" style="display:flex;gap:8px;align-items:center">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="text" name="label" placeholder="e.g. Bank charges" required aria-label="Label">
        <input type="number" step="0.01" name="amount" placeholder="Amount" required aria-label="Amount">
        <input type="text" name="notes" placeholder="Notes (optional)" aria-label="Notes">
        <button type="submit" class="btn-sm btn-accent">Add</button>
      </form>
    {% endif %}
  </div>
  {% else %}
    <p class="muted">You do not have permission to view supplier prices or misc charges for this product.</p>
  {% endif %}
</div>
