{#
  Owner decision D-300 (point 12, 11 Nov 2026): one supplier price — every thickness (TYPED or CALCULATED,
  "↺ use calculated", recalculated on screen), packing and loading, CHA + transport per container, what goes
  into the FOB cost, and the price history (who, when, old → new). D-303: the supplier from the directory.
  Port of views/products/supplier_price_edit.php.
#}
{% set unitName = product.reference_unit or 'unit' %}
{% set ro = '' if canRecord else ' disabled' %}
<div class="card page-wide">
  <p class="muted small"><a href="/products/{{ product.id }}/market-prices">&larr; Market prices — {{ product.name }}</a></p>
  <h1>Supplier price — {{ product.name }}</h1>
  <form method="post" action="/products/suppliers/{{ row.id }}/price" class="field-grid">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {% set pickName = row.supplier_name %}{% set pickId = row.supplier_id %}{% set pickLocation = row.location %}
    {% include "products/_supplier_pick.njk" %}
    <label>Quoted on *<input type="date" name="quoted_on" required max="{{ today }}" value="{{ row.quoted_on or row.updated_on }}"{{ ro }}></label>
    <label>Valid until<input type="date" name="valid_until" value="{{ row.valid_until or '' }}"{{ ro }}></label>
    {% if gridView %}
      <fieldset class="full"><legend class="legend-sentence">Prices by thickness (₹) — enter any one; the others are worked out. Change any of them if the supplier quoted it.</legend>
        {% include "products/_thickness_grid.njk" %}
      </fieldset>
    {% else %}
      <label>Price (₹) per {{ 'CBM' if (row.price_basis == 'cbm' or row.combo_per == 'cbm') else unitName }} *<input type="text" inputmode="decimal" name="price_inr" required data-max-decimals="2" data-max-value="999999999999.99" value="{{ row.fob_value }}" placeholder="e.g. 80000.00"{{ ro }}></label>
    {% endif %}
    {% include "products/_cha_transport.njk" %}
    <label class="full">Notes<textarea name="notes" rows="2" maxlength="1000" placeholder="e.g. Ex-works, Grade A, min 2 blocks"{{ ro }}>{{ row.notes or '' }}</textarea></label>
    {% if canRecord %}<div><button type="submit" class="btn-sm btn-accent">Save price</button></div>{% endif %}
  </form>

  {% if fob %}
    <h2>What goes into the cost per {{ (fob.unit | unitLabel) or unitName }} <small class="muted">({{ fobMmLabel }})</small></h2>
    <table class="list" style="max-width:640px">
      <tr><td>Supplier price{{ '' if row.includes_packing_loading == 0 else ' (includes packing and loading)' }}</td><td class="num">{{ fob.supplier | money }}</td></tr>
      <tr><td>CHA + transport per unit</td><td class="num">{{ fob.cha | money }}</td></tr>
      {% if fob.packing > 0 %}<tr><td>Packing and loading (product's costs)</td><td class="num">{{ fob.packing | money }}</td></tr>{% endif %}
      <tr><td><strong>FOB cost (₹)</strong></td><td class="num"><strong>{{ fob.total | money }}</strong></td></tr>
    </table>
    <p class="small muted">The selling price is then worked out from the FOB cost as usual.{% if fob.note %} {{ fob.note }}{% endif %}</p>
  {% endif %}

  <h2>Price history</h2>
  <table class="list">
    <tr><th>When</th><th>Who</th><th>What</th><th>Old</th><th>New</th></tr>
    {% for h in history %}
      <tr><td>{{ h.changed_at | shortDate }} {{ h.changed_at | timeHm }}</td><td>{{ h.changed_by_name or '—' }}</td>
        <td>{{ h.what }}</td><td>{{ h.old_value or '—' }}</td><td>{{ h.new_value or '—' }}</td></tr>
    {% endfor %}
    {% if not history.length %}<tr><td colspan="5" class="muted">No changes since this price was recorded.</td></tr>{% endif %}
  </table>
</div>
