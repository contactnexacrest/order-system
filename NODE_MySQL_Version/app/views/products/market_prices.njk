{#
  Owner decision D-245 (4 Nov 2026), P1: Procurement's market prices for one product — supplier
  prices only (₹), dated, with history. No selling prices, margins or floors are on this page.
  D-300 (point 12, 11 Nov 2026): one supplier price holds every thickness (grid), packing and loading,
  and CHA + transport per container. D-303 (point 15): the supplier is picked from the Suppliers directory.
  D-335 (12 Nov 2026): one price card per supplier price for every thickness (typed / calculated / no price,
  the base) and "Add / update a price". Port of views/products/market_prices.php.
#}
{% set unitName = product.reference_unit or 'unit' %}
<div class="card page-wide">
  <p class="muted small"><a href="/products/{{ product.id }}">&larr; Back to {{ product.name }}</a></p>
  <h1>Market Prices — {{ product.name }}</h1>
  <p class="muted">Supplier prices for this product (₹), newest first, with the ones <strong>used for pricing</strong> on top.{% if rules.grid %} One price card per supplier holds <strong>every thickness</strong>. A price you <strong>typed</strong> always wins — no rule changes it; the <strong>base</strong> you chose (◉) is what the product's price and order lines without a thickness use; the price rules only <strong>work out</strong> the thicknesses you tick while adding a price.{% endif %} An <strong>exact price for a special combination</strong> (e.g. "30 mm · Leather") is used as it is for the options it names. Record a new price as a new row so the history stays; a price older than {{ staleDays }} days, or past its "valid until" date, is marked. Changing the price used for pricing changes new quotes only — orders with an issued Proforma Invoice keep their prices.</p>
  {% if rules.grid %}<p class="small muted">Rules for {{ rules.category_name }}{% if rules.own.length %} <span class="badge badge-warning">own rule</span>{% endif %}: {{ rulesSummary }}{% if canChangeRules and rules.category_id %} <a class="btn-sm" href="/products/categories/{{ rules.category_id }}?tab=rules">Change these rules</a>{% endif %}</p>{% endif %}

  <table class="list">
    <tr><th>Used for pricing</th><th>Supplier</th><th>Per</th><th class="num">Price (₹)</th><th class="num">FOB cost (₹)</th><th>Quoted on</th><th>Valid until</th><th>Notes</th><th></th></tr>
    {% if not rows.length %}<tr><td colspan="9" class="muted">No supplier prices recorded yet.</td></tr>{% endif %}
    {% for r in rows %}
      <tr>
        {% set basis = r.price_basis or 'unit' %}{% set isCbm = basis == 'cbm' %}{% set isCombo = basis == 'combo' %}{% set isGrid = basis == 'grid' %}
        {% set used = (r.combo_in_use == 1) if isCombo else ((r.is_cbm_primary == 1) if isCbm else (r.is_primary == 1)) %}
        <td>{% if used %}<span class="badge badge-active">● {{ 'Exact' if isCombo else ('All thicknesses' if isGrid else 'Base') }}</span>{% else %}<span class="muted">○</span>{% endif %}</td>
        <td>{{ r.supplier_name }}{% if not r.supplier_id %} <span class="badge badge-warning" title="Typed before the Suppliers directory link — link it on Products › Link these prices">not linked</span>{% endif %}{% if r.location %}<br><small class="muted">{{ r.location }}</small>{% endif %}</td>
        <td>{% if isCombo %}<span class="badge badge-purple">Exact: {{ r.combo_text }}</span> <small class="muted">per {{ 'CBM' if r.combo_per == 'cbm' else unitName }}</small>{% elif isGrid %}every thickness{% elif isCbm %}<span class="badge">CBM — thick stone</span>{% else %}{{ unitName }}{% endif %}</td>
        <td class="num">
          {% if isGrid and r.card %}
            <span class="nowrap">Base: {{ r.card.base_label }} {% if r.card.base_price !== null %}{{ r.card.base_price | money }} <small class="muted">/{{ r.card.base_unit }}</small>{% else %}<small class="muted">no price</small>{% endif %}</span>
            <br><a class="small" href="#price-card-{{ r.id }}">every thickness ↓</a>
          {% else %}
            {{ 'To Be Confirmed' if r.effective_fob == null else (r.effective_fob | money) }}
          {% endif %}
          {% if r.includes_packing_loading == 0 %}<br><small class="muted">packing and loading not included</small>{% endif %}
        </td>
        <td class="num">{% if r.fob %}{{ r.fob.total | money }}<br><small class="muted">per {{ (r.fob.unit | unitLabel) or unitName }}{% if r.fob.cha > 0 %} · incl. CHA + transport {{ r.fob.cha | money }}{% endif %}</small>{% else %}—{% endif %}</td>
        <td>{{ r.price_date or '—' }}{% if r.staleness == 'stale' %} <span class="badge badge-warning">stale</span>{% endif %}</td>
        <td>{% if r.valid_until %}{{ r.valid_until }}{% if r.staleness == 'expired' %} <span class="badge badge-danger">expired</span>{% endif %}{% else %}<span class="muted">—</span>{% endif %}</td>
        <td>{{ r.notes or '' }}</td>
        <td>
          {% if canRecord and (not used or isCombo) %}
            <form method="post" action="/products/suppliers/{{ r.id }}/use-for-pricing" style="display:inline">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" class="btn-sm">{{ 'Stop using' if (isCombo and used) else 'Use for pricing' }}</button>
            </form>
          {% endif %}
          {% if r.fob_source == 'direct' %}<a class="btn-sm" href="/products/suppliers/{{ r.id }}/price">{{ 'Edit' if canRecord else 'View' }}</a>{% endif %}
          {# D-359: the simple "Edit price" form (one price, the other thicknesses worked out, Undo). #}
          {% if canRecord and r.fob_source == 'direct' %}<a class="btn-sm btn-accent" href="/products/suppliers/{{ r.id }}/edit-price">Edit price</a>{% endif %}
        </td>
      </tr>
    {% endfor %}
  </table>

  {# D-335: one price card per supplier price for every thickness. #}
  {% for r in rows %}{% if r.card %}
    {% set pcRow = r %}{% set card = r.card %}{% set av = r.addView %}{% set pcReturn = '' %}
    {% include "products/_price_card.njk" %}
  {% endif %}{% endfor %}

  {% if canRecord %}
    <h2 id="add-price">Add a price{% if rules.grid %} from another supplier{% endif %}</h2>
    {% if prefill and prefill.purchase_quote_id %}<p class="small muted">Filled in from the supplier quote — check the price and add it.</p>{% endif %}
    <form method="post" action="/products/{{ product.id }}/market-prices" class="field-grid">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% if prefill and prefill.purchase_quote_id %}<input type="hidden" name="purchase_quote_id" value="{{ prefill.purchase_quote_id }}">{% endif %}
      {% set pickName = prefill.supplier_name if prefill else '' %}{% set pickId = prefill.supplier_id if prefill else '' %}{% set pickLocation = '' %}
      {% include "products/_supplier_pick.njk" %}
      <label>Quoted on *<input type="date" name="quoted_on" required max="{{ today }}" value="{{ prefill.quoted_on if (prefill and prefill.quoted_on) else today }}"></label>
      <label>Valid until<input type="date" name="valid_until" value="{{ prefill.valid_until if (prefill and prefill.valid_until) else '' }}"></label>
      <label>Price for *
        <select name="price_basis" required>
          {% if rules.grid %}
            <option value="grid">Every thickness — the prices below</option>
          {% else %}
            <option value="unit">The product's unit ({{ unitName }})</option>
            <option value="cbm">Thick stone, {{ cbmFrom or 50 }} mm and above (per CBM)</option>
          {% endif %}
          {% if offered and offered.length %}<option value="combo">A special combination (exact price)</option>{% endif %}
        </select>
        <small class="muted">Kept only for special combinations, e.g. "30 mm · Leather" quoted as one exact price{% if rules.grid %}; ordinary thickness prices always go in the grid{% endif %}.</small></label>
      {% if rules.grid %}
        <fieldset class="full" data-show-when="price_basis=grid"><legend class="legend-sentence">The price the supplier quoted — type one thickness and tick the others to work out from it. It becomes the base for orders.</legend>
          {% set av = newAddView %}{% set afCard = null %}{% set afDate = '' %}
          {% include "products/_price_add.njk" %}
        </fieldset>
        <label data-show-when="price_basis=combo">Exact price (₹) *<input type="text" inputmode="decimal" name="price_inr" data-max-decimals="2" data-max-value="999999999999.99" data-required-when="price_basis=combo" placeholder="e.g. 4900.00" value="{{ prefill.price_inr if (prefill and prefill.price_inr) else '' }}" disabled></label>
      {% else %}
        <label>Price (₹) *<input type="text" inputmode="decimal" name="price_inr" required data-max-decimals="2" data-max-value="999999999999.99" placeholder="e.g. 80000.00" value="{{ prefill.price_inr if (prefill and prefill.price_inr) else '' }}"></label>
      {% endif %}
      {% if offered and offered.length %}
      <fieldset class="full" data-show-when="price_basis=combo"><legend class="legend-sentence">The special combination <small class="muted">(leave "any" for what the price does not fix)</small></legend>
        <div class="field-grid">
        {% for sp in offered %}
          <label>{{ sp.name }}
            <select name="combo[{{ sp.id }}]">
              <option value="">any</option>
              {% for o in sp.options %}<option value="{{ o.id }}">{{ o.name }}</option>{% endfor %}
            </select></label>
        {% endfor %}
        </div>
      </fieldset>
      {% endif %}
      {% include "products/_cha_transport.njk" %}
      <label class="full">Notes<textarea name="notes" rows="2" maxlength="1000" placeholder="e.g. Ex-works, Grade A, min 2 blocks"></textarea></label>
      <label class="inline"><input type="checkbox" name="used_for_pricing" value="1"> Use this price for pricing</label>
      <div><button type="submit" class="btn-sm btn-accent">Save price</button></div>
    </form>
    {% if canQuickAdd %}{% set quickProductId = product.id %}{% include "products/_supplier_quick_add.njk" %}{% endif %}

    {% if quotes.length %}
      <h2>Copy from a supplier quote</h2>
      <p class="muted small">Quotes recorded in Procurement for orders of this product.</p>
      <table class="list">
        <tr><th>Supplier</th><th class="num">Price (₹)</th><th>Recorded</th><th>Valid until</th><th>Reference</th><th></th></tr>
        {% for q in quotes %}
          <tr>
            <td>{{ q.supplier_legal_name }}</td>
            <td class="num">{{ q.unit_price_inr | money }}{% if q.unit %} <small class="muted">per {{ q.unit }}</small>{% endif %}</td>
            <td>{{ q.recorded_on }}</td>
            <td>{{ q.valid_until or '—' }}</td>
            <td>{{ q.quote_reference or '' }}</td>
            <td>
              {% if not rules.grid %}
              <form method="post" action="/products/{{ product.id }}/market-prices" style="display:inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="purchase_quote_id" value="{{ q.id }}">
                <button type="submit" class="btn-sm">Copy as a market price</button>
              </form>
              {% endif %}
              <a class="btn-sm" href="/products/{{ product.id }}/market-prices?from_quote={{ q.id }}#add-price">{{ 'Copy into the form' if rules.grid else 'Copy for a special combination' }}</a>
            </td>
          </tr>
        {% endfor %}
      </table>
    {% endif %}
  {% endif %}
</div>
