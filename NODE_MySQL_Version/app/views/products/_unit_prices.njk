{#
  Owner decision D-339 (12 Nov 2026, owner confirmed twice; mockup screen 2): the read-only
  card "Prices in other units" — per thickness, per CBM / per SQM / per SQFT, worked out
  from the product's prices (unitPrices). Nothing is saved. Each price set is shown only to
  people with the permission for it (see productsController.show()).
  PHP twin: views/products/_unit_prices.php.
#}
{% if unitPrices and unitPrices.sets.length %}
<div class="section unit-prices-card">
  <h2>Prices in other units — {{ product.name }}</h2>
  <p class="muted small">Worked out from this product's prices for each thickness (1 SQM = thickness × 1 m²; 1 SQM = 10.7639 SQFT). Read-only, nothing is saved. Per piece needs a size, so it is shown on the order line, not here. Ton and RMT follow the same rules as the price check (D-270).</p>
  {% for set in unitPrices.sets %}
    <details{% if loop.first %} open{% endif %}>
      <summary><b>{{ set.label }}</b> <span class="muted small">({{ set.currency }})</span></summary>
      <div class="table-scroll">
      <table class="list">
        <thead><tr><th>Thickness</th><th class="num">per CBM</th><th class="num">per SQM</th><th class="num">per SQFT</th><th class="num">Source</th></tr></thead>
        <tbody>
        {% for r in unitPrices.rows %}
          <tr>
            <td>{{ r.label }}</td>
            {% if r.missing !== null %}
              <td colspan="4" class="muted small">{{ r.missing }}</td>
            {% else %}
              {% set pr = r.prices[set.key] or { CBM: null, SQM: null, SQFT: null } %}
              {% for u in ['CBM', 'SQM', 'SQFT'] %}<td class="num">{{ (pr[u] | money) if pr[u] != null else '—' }}</td>{% endfor %}
              <td class="num">{% if r.typed %}<span class="tag typed">typed price wins (D-335)</span>{% else %}<span class="tag">worked out</span>{% endif %}</td>
            {% endif %}
          </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </details>
  {% endfor %}
</div>
{% endif %}
