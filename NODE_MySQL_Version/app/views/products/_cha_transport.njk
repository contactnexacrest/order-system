{#
  Owner decision D-300 (point 12, 11 Nov 2026): "Price includes packing and loading" (ticked by default)
  and CHA + transport — one price per container, turned into a price per unit from what one container
  really carries (the category's 8 CBM and 27 t, or the product's own; a heavy stone reaches the weight
  first). In: rules, cha (pricingController.chaView). Port of views/products/_cha_transport.php.
#}
<input type="hidden" name="includes_packing_loading" value="0">
<label class="inline full"><input type="checkbox" name="includes_packing_loading" value="1"{% if cha.includes %} checked{% endif %}> Price includes packing and loading <small class="muted">(usual — then packing and loading are not added again; untick to add the product's packing and loading costs)</small></label>
<fieldset class="full cha-transport" data-cha-transport data-container-cbm="{{ cha.containerCbm }}" data-fits-cbm="{{ cha.fitsCbm }}">
  <legend class="legend-sentence">CHA + transport (one price per container)</legend>
  <div class="field-grid">
    <label>CHA + transport per container (₹)
      <input type="text" inputmode="decimal" name="cha_transport_per_container" data-max-decimals="2" data-max-value="9999999999.99" value="{{ cha.value }}"
        placeholder="{{ cha.placeholder }}"></label>
    <div><span class="muted small">Container holds</span><br><b>{{ cha.containerCbm }} CBM · max {{ cha.containerMaxT }} t</b>
      <br><small class="muted">{{ "this product's own figures" if cha.ownContainer else 'from the category; a product can override' }}</small></div>
    <div><span class="muted small">Per unit</span><br><b data-cha-per-cbm>{{ cha.perCbm }}</b></div>
  </div>
  {% if cha.weightLine %}<p class="small muted">{{ cha.weightLine }}</p>{% endif %}
  {% if rules.grid %}
    <table class="list">
      <tr><th>Thickness</th><th>SQM per container</th><th class="num">CHA + transport per SQM (₹)</th><th class="num">per SQFT (₹)</th></tr>
      {% for r in cha.rows %}
        <tr data-cha-row data-mm="{{ r.mm }}"><td>{{ r.mm }} mm</td><td>{{ r.m2 }} SQM ({{ r.sqft }} SQFT)</td>
          <td class="num" data-cha-m2>{{ r.perM2 }}</td><td class="num" data-cha-sqft>{{ r.perSqft }}</td></tr>
      {% endfor %}
      <tr><td>{{ rules.cbm_from }} mm+</td><td colspan="3"><span data-cha-cbm-line>{{ cha.cbmLine }}</span></td></tr>
    </table>
  {% endif %}
  <p class="small muted">Empty = the product's default{% if cha.def %} (₹{{ cha.def }}){% else %} (none set yet — set it on the product){% endif %}. FOB cost = supplier price + CHA and transport per unit; the selling price is then worked out from it as usual.</p>
</fieldset>
