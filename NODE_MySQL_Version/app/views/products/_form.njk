{# Shared by create.njk and edit.njk. #}
{% set isEdit = product != null %}
{% set formAction = ('/products/' ~ product.id ~ '/update') if isEdit else '/products/create' %}
<form method="post" action="{{ formAction }}">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <div class="field-grid">
    <label>Name *<input type="text" name="name" value="{{ product.name or '' }}" placeholder="e.g., Granite Tiles (Polished)" required></label>
    <label class="full">Specifications *<textarea name="specifications" rows="4" placeholder="e.g., Material, size, finish, and packing details" required>{{ product.specifications or '' }}</textarea></label>
    {# D-302 (point 11): picked from the HS Code Master List, pre-filled with the category's default. #}
    <label>HS Code * <small class="muted">(from the HS Code Master List)</small><input type="text" name="hs_code" list="product_hs_codes" autocomplete="off" maxlength="8"
      data-in-list="product_hs_codes" data-in-list-message="Pick a code from the HS Code Master List{{ ' — or add it with &quot;+ Add a new HS code&quot;' if canManageHs else '' }}."
      value="{{ product.hs_code if (product and product.hs_code) else (categoryDefaultHs or '') }}" placeholder="e.g. 68022310 — type the code or words" required>
      {% if not isEdit and categoryDefaultHs %}<small class="muted">Pre-filled with the default of {{ categoryName }}.</small>{% endif %}</label>
    <datalist id="product_hs_codes">{% for h in hsCodes %}<option value="{{ h.code }}">{{ h.description }}{{ ' · category default' if h.code == categoryDefaultHs else '' }}</option>{% endfor %}</datalist>
    <label>Origin<input type="text" name="origin" value="{{ product.origin or '' }}" placeholder="e.g., Rajasthan, India"></label>
  </div>

  {# Owner decision D-335 (12 Nov 2026): "Costs to FOB" — the only place for CHA + transport; packing + loading only when a supplier price does not include them. #}
  {% set ff = fobForm %}
  <fieldset id="costs-to-fob">
    <legend>Costs to FOB <small class="muted">(added to every supplier price of this product — the only place for CHA and transport)</small></legend>
    <div class="field-grid">
      <label>CHA + transport per container (₹)<input type="text" inputmode="decimal" name="cha_transport_per_container" data-max-decimals="2" data-max-value="9999999999.99" value="{{ product.cha_transport_per_container if (product and product.cha_transport_per_container != null) else '' }}" placeholder="e.g. 80000.00">
        {% if ff %}<small class="muted">{{ ff.chaHint }}</small>{% endif %}</label>
      <label>Packing + loading per unit (₹)<input type="text" inputmode="decimal" name="packing_loading_cost" data-max-decimals="2" data-max-value="9999999999.99" value="{{ ff.packV if ff else '' }}" placeholder="e.g. 1500.00">
        <small class="muted">Added only when a supplier price does NOT include packing and loading.</small></label>
    </div>
  </fieldset>

  {# D-335: the price rules in effect for this product — the category's, or its own (MD only). #}
  {% set cr = categoryRules or {} %}
  <fieldset id="price-rules">
    <legend>Price rules in effect for this product</legend>
    <p class="small muted">Used only as a <strong>calculator</strong> — when you tick a thickness to work it out while adding a price. They never change a price you typed or the base price.</p>
    {% if ff %}
      <table class="list">
        <tr><th>Rule</th><th>Value</th><th>From</th></tr>
        {% for r in ff.rows %}<tr><td>{{ r.rule }}</td><td>{{ r.value }}</td><td>{% if r.own %}<span class="badge badge-warning">own rule</span>{% else %}<span class="badge">category</span>{% endif %}</td></tr>{% endfor %}
      </table>
    {% endif %}
    {% if canManagePricing %}
      <input type="hidden" name="own_rules_shown" value="1">
      <label class="inline switch"><input type="checkbox" name="own_rules" value="1"{% if ff and ff.hasOwn %} checked{% endif %}> Use own rules for this product <small class="muted">(off = the category's rules{{ (', ' + categoryName) if categoryName else '' }} · MD only)</small></label>
      <div class="field-grid" data-show-when="own_rules=1">
        <label>{{ ff.cbmFrom if ff else 50 }} mm and above, when worked out from {{ ff.baseMm if ff else 20 }} mm: {{ ff.baseMm if ff else 20 }} mm price per m² ×<input type="text" inputmode="decimal" name="thick_k_factor" data-max-decimals="3" data-max-value="1000" value="{{ pricingFmt.trim3(product.thick_k_factor) if product else '' }}" placeholder="category {{ pricingFmt.trim3(cr.thick_k_factor) or '—' }}"></label>
        <label>Container holds (CBM)<input type="text" inputmode="decimal" name="container_cbm" data-max-decimals="2" data-max-value="100" value="{{ pricingFmt.trim3(product.container_cbm) if product else '' }}" placeholder="category {{ pricingFmt.trim3(cr.container_cbm) or '8' }}"></label>
        <label>Container maximum (tonnes)<input type="text" inputmode="decimal" name="container_max_t" data-max-decimals="2" data-max-value="100" value="{{ pricingFmt.trim3(product.container_max_t) if product else '' }}" placeholder="category {{ pricingFmt.trim3(cr.container_max_t) or '27' }}"></label>
      </div>
    {% else %}
      <p class="small muted">{{ 'This product uses its own rules (marked "own rule").' if (ff and ff.hasOwn) else "This product uses the category's rules." }} Only the MD can switch on own rules for a product.</p>
    {% endif %}
    <p class="small muted">Switch on to edit the rules for this product only; the thickness % are changed on the Category price rules (or this product's Price options). The Category price rules keep the standard for every product in the category.{% if isEdit %}{# D-363 #} This product's own thickness %: <a href="/products/{{ product.id }}/configure#thickness-rules">Configure › Thickness rules</a>.{% endif %}</p>
  </fieldset>

  {# Owner decision D-245 P2: the product's selling unit (filled into an order line). Prices come from Products → pricing. #}
  <fieldset>
    <legend>Selling Unit <small class="muted">(filled into an order line when this product is picked; the price comes from the product's price build-up)</small></legend>
    <div class="field-grid">
      <label>Per (unit)
        <select name="reference_unit">
          <option value="">—</option>
          {% for u in referenceUnits %}
            <option value="{{ u.option_value }}" {{ 'selected' if (product and product.reference_unit == u.option_value) }}>{{ u.option_value }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
  </fieldset>

  <label><input type="checkbox" name="is_active" value="1" {{ 'checked' if (not isEdit) or product.is_active }}> Active</label>

  <button type="submit">{{ 'Save Changes' if isEdit else 'Add Product' }}</button>
</form>
{% if canManageHs %}{# D-302: "+ Add a new HS code" — straight into the master list, back to this form. #}
<details class="quick-add">
  <summary class="btn-sm">+ Add a new HS code to the master list…</summary>
  <form method="post" action="/hs-codes" class="field-grid card-nested">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="return_to" value="{{ ('/products/' ~ product.id ~ '/edit') if isEdit else '/products/create' }}">
    <label>HS code *<input type="text" name="code" required pattern="\d{6}|\d{8}" maxlength="8" data-pattern-message="6 or 8 digits, no dots." placeholder="e.g. 68029300"></label>
    <label>Description *<input type="text" name="description" required maxlength="255" placeholder="e.g. Granite, other (polished, worked)"></label>
    <div><button type="submit" class="btn-sm btn-accent">Add HS code</button></div>
  </form>
</details>
{% endif %}
