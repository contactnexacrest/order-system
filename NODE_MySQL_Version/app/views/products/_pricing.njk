{#
  Owner decision D-245 (4 Nov 2026), P1: the product's price. Port of views/products/_pricing.php.
   - pricingFull (view_price_buildup): the whole build-up, every associate level, and
     (manage_pricing) this product's own overrides;
   - pricingStaff (may see selling prices only): the quote price and the lowest price;
   - nothing for anyone else (Procurement sees supplier prices on Market prices).
#}
{% set unitLabel = product.reference_unit if product.reference_unit else 'unit' %}
{% if pricingFull %}
{% set P = pricingFull %}{% set B = P.build %}{% set E = P.effective %}
<div class="section" id="pricing">
  <h2>Price build-up <small class="muted">(per {{ unitLabel }}, FOB, USD · MD / ED only)</small></h2>
  {% if canMarketPrices %}<p><a class="btn-sm" href="/products/{{ product.id }}/market-prices">Market prices</a></p>{% endif %}
  {% if not B %}
    <p class="muted">{{ P.missing }} Procurement records supplier prices on the Market prices page.</p>
  {% else %}
    <table class="list" style="max-width:720px">
      <tr><td>Supplier price ({{ P.supplier.supplier_name }}, used for pricing{% if P.price_date %}, quoted {{ P.price_date }}{% endif %})
        {% if P.staleness %} <span class="badge {{ 'badge-danger' if P.staleness == 'expired' else 'badge-warning' }}">{{ P.staleness }}</span>{% endif %}</td>
        <td class="num">&#8377;{{ P.supplier_inr | money }}</td></tr>
      <tr><td>÷ pricing exchange rate (&#8377;{{ P.settings.pricing_fx_rate | rate4 }})</td><td class="num">USD {{ B.supplier_usd | money }}</td></tr>
      <tr><td>+ other costs to FOB <span class="muted small">({{ pricingFmt.modeLabel(E.other_mode, E.other_value) }}{{ ', global' if product.pricing_other_cost_mode == null else ', this product' }})</span></td><td class="num">USD {{ B.other_costs | money }}</td></tr>
      <tr><td><strong>Cost (FOB)</strong></td><td class="num"><strong>USD {{ B.cost | money }}</strong></td></tr>
      <tr><td>Minimum price = cost ÷ (1 − {{ pricingFmt.pct(E.margin_pct) }} margin) <span class="muted small">— nobody goes below this</span></td><td class="num"><strong>USD {{ B.minimum | money }}</strong></td></tr>
      <tr><td>+ team incentive reserve <span class="muted small">({{ pricingFmt.modeLabel(E.incentive_mode, E.incentive_value) }}{{ ' of profit' if E.incentive_mode == 'pct' }})</span>
        <span class="badge {{ 'badge-success' if P.program_on else 'badge-inactive' }}">program {{ 'on' if P.program_on else 'off' }}</span></td><td class="num">USD {{ B.reserve | money }}</td></tr>
      <tr><td><strong>Staff floor</strong> (lowest price your sales staff may agree)</td><td class="num"><strong>USD {{ B.staff_floor | money }}</strong></td></tr>
      <tr><td>Staff quote price (+ {{ pricingFmt.pct(E.buffer_pct) }} buffer)</td><td class="num"><strong>USD {{ B.staff_quote | money }}</strong></td></tr>
    </table>
    {% if P.levels.length %}
      <h3>Associates <small class="muted">(floor = staff floor ÷ (1 − commission %), or + a fixed amount)</small></h3>
      <table class="list" style="max-width:720px">
        <tr><th>Commission level</th><th>Commission</th><th class="num">Floor</th><th class="num">Quote price</th></tr>
        {% for l in P.levels %}
          <tr><td>{{ l.name }}</td><td>{{ l.label }}</td><td class="num">{{ l.floor | money }}</td><td class="num">{{ l.quote | money }}</td></tr>
        {% endfor %}
      </table>
    {% endif %}
  {% endif %}

  <h3>This product's own settings {% if not canManagePricing %}<small class="muted">(only the MD can change them)</small>{% endif %}</h3>
  {% set ro = '' if canManagePricing else ' disabled' %}
  <form method="post" action="/products/{{ product.id }}/pricing" class="field-grid">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label>Margin %<input type="number" name="pricing_margin_pct" min="0" max="89.99" step="0.01" value="{{ pricingOverrideValues.margin }}" placeholder="global {{ pricingFmt.pct(P.settings.margin_pct) }}"{{ ro }}></label>
    <label>Buffer %<input type="number" name="pricing_buffer_pct" min="0" max="100" step="0.01" value="{{ pricingOverrideValues.buffer }}" placeholder="global {{ pricingFmt.pct(P.settings.buffer_pct) }}"{{ ro }}></label>
    <label>Other costs to FOB<span class="row" style="display:flex;gap:6px">
      <select name="pricing_other_cost_mode" aria-label="Other costs to FOB: type"{{ ro }}>
        <option value="pct"{{ ' selected' if (product.pricing_other_cost_mode or 'pct') == 'pct' }}>%</option>
        <option value="usd"{{ ' selected' if product.pricing_other_cost_mode == 'usd' }}>USD per unit</option>
      </select>
      <input type="number" name="pricing_other_cost_value" min="0" step="0.0001" aria-label="Other costs to FOB: value" value="{{ pricingOverrideValues.other }}" placeholder="global {{ pricingFmt.pct(P.settings.other_cost_pct) }}"{{ ro }}></span></label>
    <label>Team incentive reserve<span class="row" style="display:flex;gap:6px">
      <select name="pricing_incentive_mode" aria-label="Team incentive reserve: type"{{ ro }}>
        <option value="pct"{{ ' selected' if (product.pricing_incentive_mode or 'pct') == 'pct' }}>% of profit</option>
        <option value="usd"{{ ' selected' if product.pricing_incentive_mode == 'usd' }}>USD per unit</option>
      </select>
      <input type="number" name="pricing_incentive_value" min="0" step="0.0001" aria-label="Team incentive reserve: value" value="{{ pricingOverrideValues.incentive }}" placeholder="global {{ pricingFmt.modeLabel(P.settings.incentive_mode, P.settings.incentive_value) }}"{{ ro }}></span></label>
    <p class="muted small full">Empty = uses the global value (Admin → Pricing). Fill in to override for this product only.{% if P.overrides.length %} Overridden now: {{ P.overrides | join(', ') }}.{% endif %}</p>
    {% if canManagePricing %}<div><button type="submit" class="btn-sm">Save this product's settings</button></div>{% endif %}
  </form>
</div>
{% elif pricingStaff %}
<div class="section" id="pricing">
  <h2>Price <small class="muted">(per {{ unitLabel }}, FOB, USD)</small></h2>
  {% if not pricingStaff.build %}
    <p class="muted">No price yet — ask Procurement to record the supplier price.</p>
  {% else %}
    <table class="list" style="max-width:480px">
      <tr><th class="num">Quote price</th><th class="num">Your lowest price</th></tr>
      <tr><td class="num">USD {{ pricingStaff.build.staff_quote | money }}</td><td class="num">USD {{ pricingStaff.build.staff_floor | money }}</td></tr>
    </table>
    <p class="muted small">Quote at the first price; you may agree any price down to the second. Below it, the order line needs the MD's approval.</p>
  {% endif %}
</div>
{% elif canMarketPrices %}
<div class="section">
  <h2>Market prices</h2>
  <p><a class="btn-sm" href="/products/{{ product.id }}/market-prices">Supplier and market prices</a></p>
</div>
{% endif %}
