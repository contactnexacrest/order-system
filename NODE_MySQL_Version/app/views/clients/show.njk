<div class="card page-wide">
  <p class="muted small"><a href="/clients">&larr; Back to Clients</a></p>
  <h1>{{ client.company_legal_name }}</h1>
  <p class="muted">
    Buyer Inquiry Ref: <strong>{{ client.client_unique_number }}</strong>
    {% if permissions.view_reports %}
      &nbsp;&middot;&nbsp; <a href="/reports/client/{{ client.id }}">Full Report</a>
    {% endif %}
  </p>
  {% if not client.is_active %}
    <p class="muted small">Deactivated — hidden from the main Clients list. Nothing was deleted.</p>
  {% endif %}
  {% if permissions.manage_orders %}
  <div class="btn-row">
    <a class="btn-sm btn-secondary" href="/clients/{{ client.id }}/edit">Edit</a>
    <form method="post" action="/clients/{{ client.id }}/toggle-active" style="display:inline" onsubmit="return confirm('{{ 'Deactivate' if client.is_active else 'Reactivate' }} {{ client.company_legal_name }}?{{ ' It will no longer appear in the main Clients list, but nothing is deleted and it can be reactivated any time.' if client.is_active else '' }}');">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-sm {{ 'btn-danger' if client.is_active else 'btn-success' }}">{{ 'Deactivate' if client.is_active else 'Reactivate' }}</button>
    </form>
  </div>
  {% endif %}

  <div class="section">
    <h2>Buyer / Consignee Details</h2>
    <div class="kv-grid">
      <div><span class="k">Billing Address</span><span class="v">{{ client.billing_address | nl2br }}</span></div>
      <div><span class="k">Consignee</span><span class="v">{{ client.consignee_name or 'SAME' }}</span></div>
      <div><span class="k">VAT / EORI</span><span class="v">{{ client.vat_eori_tax_no or '—' }}</span></div>
      <div><span class="k">Country of Destination</span><span class="v">{{ client.country_of_destination or '—' }}</span></div>
      <div><span class="k">Contact Person</span><span class="v">{{ client.contact_person or '—' }}</span></div>
      <div><span class="k">Email</span><span class="v">{% if permissions.view_client_email_full %}{{ client.email or '—' }}{% else %}<span class="masked-value">{{ client.email | maskEmail }}</span>{% endif %}</span></div>
      <div><span class="k">Phone</span><span class="v">{% if permissions.view_client_email_full %}{{ client.phone or '—' }}{% else %}<span class="masked-value">{{ client.phone | maskPhone }}</span>{% endif %}</span></div>
      {% if not permissions.view_client_email_full %}<p class="muted small">Full contact details are masked — you don't have the "View full client email" permission.</p>{% endif %}
    </div>
  </div>

  {% if client.agreement_footer_text or client.agreement_file_path %}
  <div class="section">
    <h2>Agreement T&amp;C Footer</h2>
    <p class="muted small">Shown as an extra note on every document generated for this client, in addition to the standard terms, only while the agreement below is active. Edit the footer text from the <a href="/clients/{{ client.id }}/edit">Edit</a> page.</p>
    {% if client.agreement_footer_text %}
      <div class="client-agreement-footer-preview">{{ client.agreement_footer_text | nl2br }}</div>
    {% endif %}

    <div class="kv-grid" style="margin-top:10px">
      <div><span class="k">Status</span><span class="v">
        {% if agreementForceExpired %}<span class="badge badge-inactive">Force-Expired</span>
        {% elif agreementExpired %}<span class="badge badge-inactive">Expired</span>
        {% else %}<span class="badge badge-active">Active</span>
        {% endif %}
      </span></div>
      <div><span class="k">Agreement File</span><span class="v">{% if client.agreement_file_path %}<a href="/clients/{{ client.id }}/agreement/download">{{ client.agreement_file_original_name or 'Download' }}</a>{% else %}No file uploaded{% endif %}</span></div>
      <div><span class="k">Expiry Date</span><span class="v">{{ agreementExpiryDate or 'No automatic expiry' }}</span></div>
    </div>

    {% if permissions.manage_orders %}
    <div class="btn-row" style="margin-top:10px">
      <form method="post" action="/clients/{{ client.id }}/agreement/force-expire" style="display:inline" onsubmit="return confirm('Force-expire this agreement now? The T&amp;C footer will stop printing on new documents immediately.');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn-sm btn-danger" {{ 'disabled' if (not agreementActive or not client.agreement_file_path) }}>Force Expire</button>
      </form>
      <form method="post" action="/clients/{{ client.id }}/agreement/renew" enctype="multipart/form-data" style="display:inline-flex;gap:6px;align-items:center">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="date" name="agreement_expiry_date" value="{{ agreementExpiryDate or '' }}" {{ 'disabled' if not agreementRenewEligible }}>
        <button type="submit" class="btn-sm btn-success" {{ 'disabled' if not agreementRenewEligible }} title="{{ 'Renew becomes available only within 30 days of the current expiry date, or once it has passed.' if not agreementRenewEligible }}">Renew</button>
      </form>
      {% if not agreementRenewEligible %}<span class="muted small">Renew appears only within 30 days of expiry, or after it's passed.</span>{% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="section">
    <h2>Additional Documents</h2>
    <p class="muted small">Free-form extras attached to this client (not tied to one order) — e.g. a standing NDA, a general compliance certificate.</p>
    <table class="list">
      <tr><th>Title</th><th>Notes</th><th>File</th><th>Uploaded</th><th></th></tr>
      {% for ad in additionalDocuments %}
      <tr>
        <td>{{ ad.document_type_label }}</td>
        <td class="muted small">{{ ad.notes }}</td>
        <td><a href="/file-store/{{ ad.id }}/download">{{ ad.original_filename }}</a></td>
        <td>{{ ad.uploaded_at }}{% if ad.uploaded_by_name %} <span class="muted small">by {{ ad.uploaded_by_name }}</span>{% endif %}</td>
        <td>
          {% if permissions.manage_orders %}
          <form method="post" action="/clients/{{ client.id }}/additional-documents/{{ ad.id }}/delete" style="display:inline" onsubmit="return confirm('Remove &quot;{{ ad.document_type_label }}&quot;? The file itself is never deleted from disk.');">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="btn-sm btn-danger">Remove</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      {% if not additionalDocuments or additionalDocuments.length == 0 %}
      <tr><td colspan="5" class="muted">No additional documents attached yet.</td></tr>
      {% endif %}
    </table>
    {% if permissions.manage_orders %}
    <form method="post" action="/clients/{{ client.id }}/additional-documents" enctype="multipart/form-data" style="margin-top:6px;display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="text" name="title" placeholder="Title *" required style="width:220px">
      <input type="text" name="notes" placeholder="Notes (optional)" style="width:260px">
      <input type="file" name="document" required>
      <button type="submit" class="btn-sm">Attach Document</button>
    </form>
    {% endif %}
  </div>

  <div class="section">
    <h2>Orders</h2>
    {% if permissions.manage_orders %}
    <div class="btn-row"><a class="btn btn-sm" href="/orders/create?client_id={{ client.id }}">+ New Order for this client</a></div>
    {% endif %}
    {% if not orders or orders.length == 0 %}
      <p class="muted">No orders yet.</p>
    {% else %}
    <table class="list">
      <tr><th>Order Ref</th><th>Current Stage</th><th>Status</th><th></th></tr>
      {% for o in orders %}
      <tr>
        <td>{{ o.order_reference }}</td>
        <td>{{ o.current_stage_name or 'Quotation' }}</td>
        <td>{{ o.status | capitalize }}</td>
        <td><a href="/orders/{{ o.id }}">View</a></td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
  </div>

  {% if permissions.manage_company_settings or permissions.impersonate_client %}
  <div class="section">
    <h2>Client Portal Access</h2>
    {% if permissions.manage_company_settings %}
      <form method="post" action="/clients/{{ client.id }}/impersonation-allowed">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label><input type="checkbox" name="allow_staff_impersonation" value="1" {{ 'checked' if client.allow_staff_impersonation }} onchange="this.form.submit()"> Allow staff to log in as this client ("Log in as this client")</label>
      </form>
      <p class="muted small">
        Global switch is currently <strong>{{ 'ON' if impersonationGloballyEnabled else 'OFF' }}</strong> (<a href="/settings">Settings</a>).
        {% if not impersonationGloballyEnabled %}Turning this on alone won't allow impersonation until the global switch is also on.{% endif %}
      </p>
    {% endif %}
    {% if permissions.impersonate_client %}
      {% if impersonationGloballyEnabled and client.allow_staff_impersonation and client.is_active %}
        <form method="post" action="/clients/{{ client.id }}/impersonate" target="_blank" onsubmit="return confirm('Log in as {{ client.company_legal_name }}? This opens their client-portal view in a new tab, alongside your own session here. This is logged.');">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button type="submit" class="btn-sm btn-secondary">Log in as this client &#8599;</button>
        </form>
      {% else %}
        <p class="muted small">"Log in as this client" isn't available right now — {{ impersonationUnavailableReason }}.</p>
      {% endif %}
    {% endif %}
  </div>
  {% endif %}

  {% if permissions.edit_locked_data %}
  <div class="section">
    <h2>Admin Override</h2>
    <form method="post" action="/clients/{{ client.id }}/override-unique-number" onsubmit="return confirmFieldOverride(this, 'the Buyer Inquiry Ref');">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Buyer Inquiry Ref <input type="text" name="client_unique_number" value="{{ client.client_unique_number }}"></label>
      <label>Reason for this change * <textarea class="override-reason" name="reason" rows="2" required></textarea></label>
      <button type="submit" class="btn-sm btn-danger">Override Buyer Inquiry Ref</button>
    </form>
  </div>
  <script>
  function confirmFieldOverride(form, label) {
    var reasonEl = form.querySelector('.override-reason');
    if (!reasonEl || reasonEl.value.trim() === '') {
      alert('A reason is required before saving.');
      return false;
    }
    return confirm('Override ' + label + '? This is logged and cannot be undone through this screen.');
  }
  </script>
  {% endif %}
</div>
