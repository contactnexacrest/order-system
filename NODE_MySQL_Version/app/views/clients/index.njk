<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Clients</h1>
      <p class="muted" style="margin:0;">Each client carries one Buyer Inquiry Ref for the whole relationship — every order and document for them reuses it.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      {% if permissions.manage_orders %}<a class="btn btn-accent" href="/clients/create">+ New Client</a>{% endif %}
      <a class="btn-sm btn-secondary" href="/clients/inactive">Deactivated Clients</a>
    </div>
  </div>

  <div class="review-banner info" style="flex-direction:column;align-items:stretch;gap:6px">
    <span>Public Quotation Form — send this to a new lead so they can submit their own details (lands in Quotation Intake Review):</span>
    <div style="display:flex;gap:6px;align-items:center">
      <input type="text" readonly aria-label="Public Quotation Form link" value="{{ quotationFormLink }}" onclick="this.select()" style="flex:1;font-family:monospace;font-size:12px">
      <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText('{{ quotationFormLink }}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 1500);">Copy Link</button>
    </div>
  </div>

  {# Owner decision D-394 (mockup 2): Show: All · Clients · Prospects. #}
  <div class="filter-chip-row" data-testid="client-show-chips">
    <span class="muted small">Show:</span>
    {% for key, label in [['all', 'All'], ['clients', 'Clients'], ['prospects', 'Prospects']] %}
      <a class="filter-chip{{ ' active' if (show or 'all') == key else '' }}" href="/clients?show={{ key }}">{{ label }} ({{ counts[key] if counts else 0 }})</a>
    {% endfor %}
  </div>

  {% if not clients or clients.length == 0 %}
    <p class="muted">{{ 'No prospects.' if show == 'prospects' else 'No clients yet.' }}</p>
  {% else %}
  <div class="card-grid">
    {% for c in clients %}
    <div class="entity-card entity-card-linked">
      <div class="entity-card-header">
        <a class="entity-card-stretched-link" href="/clients/{{ c.id }}"><span class="entity-card-title">{{ c.company_legal_name }}</span></a>
        {% if c.is_prospect == 1 %}<span class="tag tag-gold" data-testid="prospect-badge">Prospect</span>{% endif %}
        <span class="tag tag-navy">{{ c.order_count }} order{{ '' if c.order_count == 1 else 's' }}</span>
      </div>
      <div class="entity-card-sub">{{ c.client_unique_number }}</div>
      {% if c.is_prospect == 1 and c.prospect_expires_on %}
        <div class="small prospect-expiry{{ ' prospect-expiry-urgent' if c.prospect_urgent else '' }}">{{ c.prospect_line }}</div>
      {% endif %}
      <div class="entity-card-sub">
        {{ c.contact_person or '—' }}
        {% if c.email %}
          &middot;
          {% if permissions.view_client_email_full %}
            <span class="masked-value">{{ c.email }}</span>
          {% else %}
            <span class="masked-value">{{ c.email | maskEmail }}</span>
          {% endif %}
        {% endif %}
      </div>
      <div class="entity-card-footer">
        <span class="muted small">{{ c.country_of_destination or 'Country not set' }}</span>
        {% if permissions.manage_orders %}
          {# D-409: quick link to a new order for this client (same link as on the client page). #}
          <span class="entity-card-actions"><a class="entity-card-action" href="/orders/create?client_id={{ c.id }}" data-testid="client-card-new-order">+ New Order</a><a class="entity-card-action" href="/clients/{{ c.id }}/edit">Edit</a></span>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
