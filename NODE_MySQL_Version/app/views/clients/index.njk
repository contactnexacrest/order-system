<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Clients</h1>
      <p class="muted" style="margin:0;">Each client carries one Buyer Inquiry Ref for the whole relationship — every order and document for them reuses it.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn btn-accent" href="/clients/create">+ New Client</a>
      <a class="btn-sm btn-secondary" href="/clients/inactive">Deactivated Clients</a>
    </div>
  </div>

  <div class="review-banner info" style="flex-direction:column;align-items:stretch;gap:6px">
    <span>Public Quotation Form — send this to a new lead so they can submit their own details (lands in Quotation Intake Review):</span>
    <div style="display:flex;gap:6px;align-items:center">
      <input type="text" readonly value="{{ quotationFormLink }}" onclick="this.select()" style="flex:1;font-family:monospace;font-size:12px">
      <button type="button" class="btn-sm" onclick="navigator.clipboard.writeText('{{ quotationFormLink }}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy Link', 1500);">Copy Link</button>
    </div>
  </div>

  {% if not clients or clients.length == 0 %}
    <p class="muted">No clients yet.</p>
  {% else %}
  <div class="card-grid">
    {% for c in clients %}
    <div class="entity-card entity-card-linked">
      <div class="entity-card-header">
        <a class="entity-card-stretched-link" href="/clients/{{ c.id }}"><span class="entity-card-title">{{ c.company_legal_name }}</span></a>
        <span class="tag tag-navy">{{ c.order_count }} order{{ '' if c.order_count == 1 else 's' }}</span>
      </div>
      <div class="entity-card-sub">{{ c.client_unique_number }}</div>
      <div class="entity-card-sub">
        {{ c.contact_person or '—' }}
        {% if c.email %}
          &middot;
          {% if permissions.view_client_email_full %}
            <span class="masked-value">{{ c.email }}</span>
          {% else %}
            <span class="masked-value">{{ c.email | maskEmail }}</span>
          {% endif %}
        {% endif %}
      </div>
      <div class="entity-card-footer">
        <span class="muted small">{{ c.country_of_destination or 'Country not set' }}</span>
        <a class="entity-card-action" href="/clients/{{ c.id }}/edit">Edit</a>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
