{% set locked = client.is_data_locked == 1 %}
<div class="card">
  <h1>Edit Client</h1>
  <p class="muted small"><a href="/clients/{{ client.id }}">&larr; Back to Client</a></p>
  <p class="muted">Buyer Inquiry Ref: <strong>{{ client.client_unique_number }}</strong> — changed only via the Admin Override on the client's page, not here.</p>

  {% if locked %}
    <div class="review-banner bad" style="margin-bottom:14px">
      🔒 <span><strong>This client's details are locked, permanently.</strong> Locked {{ client.data_locked_at }} — {{ client.data_locked_reason or '' }}. These fields can never be edited again through the normal form; if something genuinely needs to change, the correct path is a brand-new client record, not an edit here.</span>
    </div>
    {% if not isSuperAdmin %}
      <p class="muted small">All fields below are read-only.</p>
    {% else %}
      <div class="review-banner warn" style="margin-bottom:14px">
        ⚠ <span><strong>Super Admin override available</strong> — for a genuine staff data-entry mistake only, never a client-requested change. Check the box below and give a specific reason to make an edit anyway; it will be fully logged.</span>
      </div>
    {% endif %}
  {% else %}
    <div class="review-banner warn" style="margin-bottom:14px">
      ℹ <span>Once this client confirms their details (PI-details form) or an order's advance payment is recorded, whichever happens first, these details lock permanently — no further edits, by anyone but a Super Admin fixing a genuine mistake. Get everything right before that point.</span>
    </div>
  {% endif %}

  <form method="post" action="/clients/{{ client.id }}/update">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <fieldset {{ 'disabled' if (locked and not isSuperAdmin) }}>
      <legend>Buyer Details</legend>
      <div class="field-grid">
        <label class="full">Company Legal Name *
          <input type="text" name="company_legal_name" value="{{ client.company_legal_name }}" placeholder="e.g., Test Company Ltd" required>
        </label>
        <label class="full">Billing Address *
          <textarea name="billing_address" rows="2" placeholder="e.g., 123 Example Street, Test City, Country" required>{{ client.billing_address }}</textarea>
        </label>
        <label>Billing Address Line 1
          <input type="text" name="billing_address_line1" value="{{ client.billing_address_line1 or '' }}" placeholder="Street number and street name">
        </label>
        <label>Billing Address Line 2
          <input type="text" name="billing_address_line2" value="{{ client.billing_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town
          <input type="text" name="billing_city" value="{{ client.billing_city or '' }}" placeholder="e.g., Birmingham">
        </label>
        <label>Postcode
          <input type="text" name="billing_postcode" value="{{ client.billing_postcode or '' }}" placeholder="e.g., B1 1AA">
        </label>
        <label>VAT / EORI / Tax Reg. No.
          <input type="text" name="vat_eori_tax_no" value="{{ client.vat_eori_tax_no or '' }}" placeholder="UK: EORI No. | Others: Tax Reg. No.">
        </label>
        <label>Country of Destination
          <input type="text" name="country_of_destination" value="{{ client.country_of_destination or '' }}" placeholder="e.g., Hungary / UK / France">
        </label>
        <label>Certificate of Origin Type
          <select name="coo_type">
            <option value="">— To Be Confirmed —</option>
            {% for o in cooTypes %}
              <option value="{{ o.option_value }}" {{ 'selected' if (client.coo_type or '') == o.option_value }}>{{ o.option_value }}</option>
            {% endfor %}
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset {{ 'disabled' if (locked and not isSuperAdmin) }}>
      <legend>Consignee Details</legend>
      {% set consigneeSame = (client.consignee_same_as_buyer | default(1)) | int == 1 %}
      <label><input type="checkbox" id="consignee_same_as_buyer" name="consignee_same_as_buyer" value="1" {{ 'checked' if consigneeSame }}> Same as Buyer</label>
      <div id="consignee_fields" class="field-grid" style="display:none">
        <label class="full">Consignee Company Name
          <input type="text" name="consignee_name" value="{{ client.consignee_name or '' }}" placeholder="e.g., ABC Memorial Stones Ltd">
        </label>
        <label class="full">Address Line 1
          <input type="text" name="consignee_address_line1" value="{{ client.consignee_address_line1 or '' }}" placeholder="Street number and street name">
        </label>
        <label>Address Line 2
          <input type="text" name="consignee_address_line2" value="{{ client.consignee_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town
          <input type="text" name="consignee_city" value="{{ client.consignee_city or '' }}" placeholder="e.g., Rotterdam">
        </label>
        <label>Postcode
          <input type="text" name="consignee_postcode" value="{{ client.consignee_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country
          <input type="text" name="consignee_country" value="{{ client.consignee_country or '' }}" placeholder="e.g., Netherlands">
        </label>
        <label>VAT / EORI / Tax Reg. No.
          <input type="text" name="consignee_vat_eori_tax_no" value="{{ client.consignee_vat_eori_tax_no or '' }}" placeholder="UK: EORI No. | Others: Tax Reg. No.">
        </label>
        <label>Contact Person
          <input type="text" name="consignee_contact_person" value="{{ client.consignee_contact_person or '' }}" placeholder="e.g., Jane Smith">
        </label>
        <label>Phone
          <input type="text" name="consignee_phone" value="{{ client.consignee_phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
        <label>Email
          <input type="email" name="consignee_email" value="{{ client.consignee_email or '' }}" placeholder="e.g., name@example.com">
        </label>
      </div>
    </fieldset>

    <fieldset {{ 'disabled' if (locked and not isSuperAdmin) }}>
      <legend>Notify Party</legend>
      {% set notifySame = (client.notify_party_same_as_consignee | default(1)) | int == 1 %}
      <label><input type="checkbox" id="notify_party_same_as_consignee" name="notify_party_same_as_consignee" value="1" {{ 'checked' if notifySame }}> Same as Consignee</label>
      <div id="notify_party_fields" class="field-grid" style="display:none">
        <label class="full">Notify Party Name
          <input type="text" name="notify_party" value="{{ client.notify_party or '' }}" placeholder="e.g., ABC Freight Forwarders Ltd">
        </label>
        <label class="full">Address Line 1
          <input type="text" name="notify_party_address_line1" value="{{ client.notify_party_address_line1 or '' }}" placeholder="Street number and street name">
        </label>
        <label>Address Line 2
          <input type="text" name="notify_party_address_line2" value="{{ client.notify_party_address_line2 or '' }}" placeholder="Area / district — if applicable">
        </label>
        <label>City / Town
          <input type="text" name="notify_party_city" value="{{ client.notify_party_city or '' }}" placeholder="e.g., Rotterdam">
        </label>
        <label>Postcode
          <input type="text" name="notify_party_postcode" value="{{ client.notify_party_postcode or '' }}" placeholder="e.g., 3011 AD">
        </label>
        <label>Country
          <input type="text" name="notify_party_country" value="{{ client.notify_party_country or '' }}" placeholder="e.g., Netherlands">
        </label>
        <label>Contact Person
          <input type="text" name="notify_party_contact_person" value="{{ client.notify_party_contact_person or '' }}" placeholder="e.g., Jane Smith">
        </label>
        <label>Phone
          <input type="text" name="notify_party_phone" value="{{ client.notify_party_phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
        <label>Email
          <input type="email" name="notify_party_email" value="{{ client.notify_party_email or '' }}" placeholder="e.g., name@example.com">
        </label>
      </div>
    </fieldset>

    <fieldset {{ 'disabled' if (locked and not isSuperAdmin) }}>
      <legend>Contact</legend>
      <div class="field-grid">
        <label>Contact Person
          <input type="text" name="contact_person" value="{{ client.contact_person or '' }}" placeholder="e.g., John Doe">
        </label>
        <label>Email
          <input type="email" name="email" value="{{ client.email or '' }}" placeholder="e.g., name@example.com">
        </label>
        <label>Phone
          <input type="text" name="phone" value="{{ client.phone or '' }}" placeholder="e.g., +1 555 123 4567">
        </label>
      </div>
    </fieldset>

    {% if locked and isSuperAdmin %}
      <fieldset>
        <legend>Super Admin Override</legend>
        <label><input type="checkbox" name="override_lock" value="1"> Override the lock for this save (staff data-entry error only)</label>
        <label>Reason (required, min. 10 characters)
          <input type="text" name="override_reason" style="width:400px" placeholder="e.g., Staff mistyped postcode during intake — correcting to match buyer's PO">
        </label>
      </fieldset>
    {% endif %}

    <button type="submit" {{ 'disabled' if (locked and not isSuperAdmin) }}>Save Changes</button>
  </form>

  {# Batch 3 #12 — its own form/endpoint, deliberately separate from the form above:
     this is a staff annotation of an external agreement, not a client-submitted
     detail, so it stays editable even when the client's details are locked. #}
  <form method="post" action="/clients/{{ client.id }}/agreement-footer">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <fieldset>
      <legend>Agreement</legend>
      <label>T&amp;C Footer <small class="muted">(a clause specific to this client's own commercial agreement — shown as an extra note on every document generated for them, in addition to the standard terms. Never locked by the data lock above, since it's a staff annotation of an external agreement, not a client-submitted detail.)</small>
        <textarea name="agreement_footer_text" rows="4" placeholder="e.g. Pre-shipment inspection by buyer's nominated agent is permitted at supplier's premises, by prior appointment.">{{ client.agreement_footer_text or '' }}</textarea>
      </label>
    </fieldset>
    <button type="submit">Save Agreement Footer</button>
  </form>
</div>
<script>
(function () {
  function wireSameAs(checkboxId, fieldsId) {
    var checkbox = document.getElementById(checkboxId);
    var container = document.getElementById(fieldsId);
    if (!checkbox || !container) { return; }
    var inputs = container.querySelectorAll('input, textarea, select');
    function apply() {
      var same = checkbox.checked;
      container.style.display = same ? 'none' : '';
      inputs.forEach(function (el) { el.disabled = same; });
    }
    checkbox.addEventListener('change', apply);
    apply();
  }
  wireSameAs('consignee_same_as_buyer', 'consignee_fields');
  wireSameAs('notify_party_same_as_consignee', 'notify_party_fields');
})();
</script>
