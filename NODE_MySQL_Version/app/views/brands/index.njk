{# D-431 (owner 25–26 Nov 2026): Admin › Brands — the division names associates see (name only, no logo). PHP twin: views/brands/index.php #}
<div class="card page-wide">
  <h1>Brands</h1>
  <p class="muted" data-brands-intro>The division name an associate sees on their login page, portal and e-mails, with the line under it. Buyers never see a brand: their form, e-mails, documents and portal stay NexaCrest. Agreements, invoices and payments always come from NexaCrest International Private Limited. An associate with no brand sees NexaCrest, as before.</p>
  <div class="table-scroll">
  <table class="list" data-testid="brands-table">
    <tr><th>Brand</th><th>Products it covers</th><th>Login address</th><th>Website</th><th>E-mail shown to associates</th><th>Associates</th><th>Status</th><th></th></tr>
    {% for x in brands %}
    <tr>
      <td><strong>{{ x.name }}</strong><br><small class="muted">{{ x.tagline }}</small></td>
      <td>{{ x.products or '—' }}</td>
      <td><code>/associate/login/{{ x.code }}</code></td>
      <td>{{ x.website or '—' }}</td>
      <td>{{ x.email or '—' }}</td>
      <td><a href="/associates?view=list&amp;brand={{ x.id }}">{{ x.associate_count }}</a></td>
      <td><span class="badge {{ 'badge-success' if x.status == 'active' else 'badge-inactive' }}">{{ statuses[x.status] or x.status }}</span></td>
      <td><a href="/admin/brands/{{ x.id }}">Open</a></td>
    </tr>
    {% else %}
    <tr><td colspan="8" class="muted">No brands yet — every associate sees NexaCrest.</td></tr>
    {% endfor %}
  </table>
  </div>
  {% if canEdit %}
  <details class="section"{{ ' open' if not brands.length else '' }}>
    <summary><strong>Add brand</strong></summary>
    <form method="post" action="/admin/brands" data-brand-form>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% set b = null %}
      {% include "brands/_details_fields.njk" %}
      <button type="submit">Add brand</button>
    </form>
  </details>
  {% endif %}
</div>
