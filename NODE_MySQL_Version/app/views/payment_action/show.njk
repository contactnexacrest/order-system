{# Owner request (2026-10-27): payment only, one payment at a time — the
   strip shows the order's payments (advance, freight on CFR/CIF, balance);
   below it, just the one the client acts on now. #}
{% set currency = order.currency_code or '' %}
{% set legName = legInfo.label if legInfo else '' %}
<div class="card">
  <h1>Payment Details — Order {{ order.order_reference or ('#' ~ order.id) }}</h1>
  <p class="muted">For {{ order.company_legal_name or '' }} — no login needed. Send us your payment details here once you have paid.</p>

  <ol class="action-progress" aria-label="Your payments">
    {% set n = 0 %}
    {% for leg, state in current.legs %}
      {% set n = n + 1 %}
      <li class="{{ state }}"><span class="dot">{% if state == 'done' %}&#10003;{% else %}{{ n }}{% endif %}</span>{{ legs[leg].label }}</li>
    {% endfor %}
  </ol>

  {% if current.state == 'due' %}
  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">{{ currentNum }}</span> {{ legName }} <span class="action-status todo">Action needed</span></legend>
    <ol class="action-howto">
      <li><strong>Download</strong> the {{ legInfo.document }} — our bank details are on it.</li>
      <li><strong>Pay</strong> {% if amountDue != null %}<strong>{{ currency }} {{ amountDue | money }}</strong>{% else %}the amount shown on it{% endif %} by bank transfer (T/T).</li>
      <li><strong>Send us</strong> the payment details (with the bank reference number) and a screenshot below. Our team checks them against our bank statement.</li>
    </ol>
    {% if document %}
      <p><a class="btn btn-secondary" href="/payment-action/{{ token }}/document">&#11015; Download {{ legInfo.document }} ({{ document.document_reference }})</a></p>
    {% endif %}
    <form method="post" action="/payment-action/{{ token }}/report" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Bank reference number (transaction ID, UTR or SWIFT reference) *<input type="text" name="transaction_ref" required placeholder="e.g. HDFCN26304123456" maxlength="150"></label>
        <label>Amount Paid ({{ currency }}) *<input type="number" step="0.01" min="0.01" name="amount" required value="{{ amountDue.toFixed(2) if amountDue != null else '' }}" placeholder="e.g. 1500.00"></label>
        <label>Date Paid *<input type="date" name="payment_date" required value="{{ today() }}"></label>
        <label>Paid from (bank and account)<input type="text" name="payer_bank_details" placeholder="e.g. Sent from HSBC UK, account ending 4321" maxlength="255"></label>
        <label class="full">Screenshot or bank receipt of your payment *<input type="file" name="screenshot" accept=".pdf,.jpg,.jpeg,.png" required></label>
      </div>
      <button type="submit">Send Payment Details</button>
    </form>
  </fieldset>
  {% else %}
  <div class="action-wait">
    {% if current.state == 'reported' %}
      <h2>&#10003; Thank you — we're checking your {{ legName | lower }}</h2>
      <p>We have your payment details. Our team is verifying them against our bank statement and will confirm by email. Nothing more is needed from you right now.</p>
    {% elif current.state == 'waiting' %}
      <h2>&#10003; Nothing to pay right now</h2>
      <p>Your next payment is the <strong>{{ legName | lower }}</strong>. It is shown on our {{ legInfo.document | lower }}, which we will e-mail you when it is due. This same link will then show you what to pay.</p>
    {% else %}
      <h2>&#10003; All payments received — thank you</h2>
      <p>There is nothing left to pay on this order.</p>
    {% endif %}
  </div>
  {% endif %}

  <p class="muted small">Questions? Reply to the email this link came with.</p>
</div>
