{% macro kanbanCard(s) %}
<a class="entity-card kanban-card" href="/orders/{{ s.order_id }}">
  <div class="entity-card-header">
    <span class="entity-card-title">{{ s.order_reference }}</span>
  </div>
  <div class="entity-card-sub">{{ s.company_legal_name or s.client_company_legal_name }}</div>
  <div class="entity-card-footer">
    {% if s.status == 'applied' %}
      <span class="muted small">Applied</span>
    {% elif s.status == 'rejected' %}
      <span class="muted small">{{ (s.rejection_reason or '') | truncate(40, true, '…') }}</span>
    {% else %}
      <span class="muted small">Submitted {{ s.submitted_at }}</span>
    {% endif %}
  </div>
</a>
{% endmacro %}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>PI Intake Review — Kanban Board</h1>
      <p class="muted" style="margin:0;">Submissions from the per-order PI-stage form.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn-sm btn-secondary" href="/pi-intake-review?view=list">Switch to list view</a>
    </div>
  </div>

  <div class="kanban-board">
    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Pending Review</span>
        <span class="kanban-column-count">{{ pending.length }}</span>
      </div>
      {% if pending.length == 0 %}
        <p class="kanban-column-empty">Nothing pending</p>
      {% else %}
        {% for s in pending %}{{ kanbanCard(s) }}{% endfor %}
      {% endif %}
    </div>

    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Applied</span>
        <span class="kanban-column-count">{{ applied.length }}</span>
      </div>
      {% if applied.length == 0 %}
        <p class="kanban-column-empty">Nothing here</p>
      {% else %}
        {% for s in applied %}{{ kanbanCard(s) }}{% endfor %}
      {% endif %}
    </div>

    <div class="kanban-column">
      <div class="kanban-column-header">
        <span class="kanban-column-title">Rejected</span>
        <span class="kanban-column-count">{{ rejected.length }}</span>
      </div>
      {% if rejected.length == 0 %}
        <p class="kanban-column-empty">Nothing here</p>
      {% else %}
        {% for s in rejected %}{{ kanbanCard(s) }}{% endfor %}
      {% endif %}
    </div>
  </div>
</div>
