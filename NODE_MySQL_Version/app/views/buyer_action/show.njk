{# Owner request (2026-10-26): same look as the Quotation/PI details forms —
   a wide card, a summary bar and numbered sections — instead of one narrow
   column. Sections appear in the order the buyer needs them. #}
{% set ocPending = ocAcknowledgment and ocAcknowledgment.acknowledged_at == null %}
{% set ocDone = ocAcknowledgment and ocAcknowledgment.acknowledged_at != null %}
{% set nextNum = 1 %}
<div class="card">
  <h1>Your Order {{ order.order_reference or ('#' ~ order.id) }}</h1>
  <p class="muted">For {{ order.company_legal_name or '' }} — everything you need to do on this order, in one place. No login needed.</p>
  <div class="intake-summary">
    <span>&#128230; {{ products.length }} product line{{ '' if products.length == 1 else 's' }}</span>
    <span>&#128176; {{ order.currency_code or '' }} {{ totalFobValue | money }}</span>
    <span>&#128674; {{ order.incoterm_code or '—' }}{% if order.port_of_discharge_name %} · {{ order.port_of_discharge_name }}{% endif %}</span>
  </div>

  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">{{ nextNum }}</span> Your Purchase Order
      {% if buyerPoConfirmed %}<span class="action-status done">&#10003; Received</span>{% elif buyerPoDocuments.length %}<span class="action-status">Received — being checked</span>{% else %}<span class="action-status todo">Action needed</span>{% endif %}
    </legend>
    {% set nextNum = nextNum + 1 %}
    {% if buyerPoConfirmed %}
      <p>Thank you — we have your signed Purchase Order{% if order.buyers_po_ref and order.buyers_po_ref != 'NIL' %} <strong>{{ order.buyers_po_ref }}</strong>{% endif %}. Nothing more is needed here.</p>
    {% else %}
      <ol class="action-howto">
        <li><strong>Download</strong> the Purchase Order we prepared for you.</li>
        <li><strong>Sign and stamp</strong> it.</li>
        <li><strong>Upload</strong> the signed copy below with your PO number.</li>
      </ol>
      {% if issuedBuyerPo %}
        <p><a class="btn btn-secondary" href="/buyer-action/{{ token }}/buyer-po-document">&#11015; Download Purchase Order ({{ issuedBuyerPo.document_reference }})</a></p>
      {% else %}
        <p class="intake-note">Your Purchase Order is being prepared — you can already upload your own signed PO below if you have one.</p>
      {% endif %}
    {% endif %}
    {% if buyerPoDocuments.length %}
      <table class="list">
        <tr><th>Uploaded file</th><th>Uploaded</th></tr>
        {% for doc in buyerPoDocuments %}
        <tr>
          <td>{{ doc.original_filename }}</td>
          <td>{{ doc.uploaded_at | humanDate }}</td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
    {% if advanceCleared %}
      <p class="muted small">The advance payment has already cleared, so uploads here are closed. Contact your NexaCrest representative if you need to send an updated copy.</p>
    {% elif not buyerPoConfirmed %}
      <form method="post" action="/buyer-action/{{ token }}/buyer-po" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="field-grid">
          <label>Your PO Number *<input type="text" name="buyers_po_ref" required placeholder="e.g., PO-2026-0142"></label>
          <label>Signed Purchase Order *<input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.eml,.msg" required></label>
        </div>
        <button type="submit">Upload Signed PO</button>
      </form>
    {% endif %}
  </fieldset>

  {% if ocPending or ocDone %}
  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">{{ nextNum }}</span> Order Confirmation
      {% if ocDone %}<span class="action-status done">&#10003; Acknowledged</span>{% else %}<span class="action-status todo">Action needed</span>{% endif %}
    </legend>
    {% set nextNum = nextNum + 1 %}
    {% if ocDone %}
      <p>Thank you — you acknowledged the Order Confirmation on {{ ocAcknowledgment.acknowledged_at | humanDate }}.</p>
    {% else %}
      <p><strong>Your Acknowledgement Needed</strong> — please check the order below and confirm to proceed.</p>
      <div class="action-kv">
        <div><span class="k">Order Reference</span><span class="v">{{ order.order_reference }}</span></div>
        <div><span class="k">Total Order Value</span><span class="v">{{ order.currency_code or '' }} {{ totalFobValue | money }}</span></div>
        <div><span class="k">Incoterm</span><span class="v">{{ order.incoterm_code or '—' }}</span></div>
        <div><span class="k">Port of Discharge</span><span class="v">{{ order.port_of_discharge_name or order.port_of_discharge_text or '—' }}</span></div>
      </div>
      <table class="list">
        <tr><th>Product</th><th>Quantity</th></tr>
        {% for p in products %}
        <tr><td>{{ p.description }}</td><td>{{ p.quantity }} {{ p.unit or '' }}</td></tr>
        {% endfor %}
      </table>
      <form method="post" action="/buyer-action/{{ token }}/acknowledge-oc">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn-success">I acknowledge and confirm to proceed</button>
      </form>
    {% endif %}
  </fieldset>
  {% endif %}

  {% if not advanceCleared %}
  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">{{ nextNum }}</span> Advance Payment <small class="muted">(once you've paid)</small></legend>
    <p class="muted small">Made your advance payment? Tell us the transaction details — our team checks it against our bank statement before updating your order. Once it clears you'll also get client portal access.</p>
    <form method="post" action="/buyer-action/{{ token }}/report-payment" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Transaction ID / UTR *<input type="text" name="transaction_ref" required></label>
        <label>Amount Paid<input type="text" name="amount" placeholder="e.g. 12500.00"></label>
        <label>Date Paid<input type="date" name="payment_date"></label>
        <label>Your Bank / Payer Details<input type="text" name="payer_bank_details" placeholder="e.g. Sent from HSBC UK, account ending 4321"></label>
        <label class="full">Payment Screenshot / Proof of Payment (optional)<input type="file" name="screenshot" accept=".pdf,.jpg,.jpeg,.png"></label>
      </div>
      <button type="submit">Submit Payment Details</button>
    </form>
  </fieldset>
  {% endif %}

  <p class="muted small">Need to see your full order, documents, or message our team? <a href="/client/login">Log in to your client portal</a> (set up automatically once your advance payment clears).</p>
</div>
