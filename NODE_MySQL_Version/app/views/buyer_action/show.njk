{# Owner request (2026-10-26): same look as the Quotation/PI details forms,
   and only ONE thing for the client to do at a time — task (from
   buyerActionService.currentTask()) picks the section; the strip on top
   shows where they are: Purchase Order → Advance Payment → Order Confirmation. #}
{% set payState = 'todo' if task in ['buyer_po', 'waiting_pi'] else ('current' if task in ['advance', 'advance_reported'] else 'done') %}
{% if task == 'waiting' and not advanceCleared and order.payment_method == 'LC' %}{% set payState = 'current' %}{% endif %}
{% set progress = [
  ['Purchase Order', 'current' if task == 'buyer_po' else 'done'],
  ['Advance Payment', payState],
  ['Order Confirmation', 'current' if task == 'oc' else ('done' if task == 'done' else 'todo')]
] %}
<div class="card">
  <h1>Your Order {{ order.order_reference or ('#' ~ order.id) }}</h1>
  <p class="muted">For {{ order.company_legal_name or '' }} — no login needed. We'll show you just the one thing to do next.</p>
  <div class="intake-summary">
    <span>&#128230; {{ products.length }} product line{{ '' if products.length == 1 else 's' }}</span>
    <span>&#128176; {{ order.currency_code or '' }} {{ totalFobValue | money }}</span>
    <span>&#128674; {{ order.incoterm_code or '—' }}{% if order.port_of_discharge_name %} · {{ order.port_of_discharge_name }}{% endif %}</span>
  </div>

  <ol class="action-progress" aria-label="Your steps">
    {% for item in progress %}
      <li class="{{ item[1] }}"><span class="dot">{% if item[1] == 'done' %}&#10003;{% else %}{{ loop.index }}{% endif %}</span>{{ item[0] }}</li>
    {% endfor %}
  </ol>

  {% if task == 'buyer_po' %}
  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">1</span> Your Purchase Order
      {% if buyerPoDocuments.length %}<span class="action-status">Received — being checked</span>{% else %}<span class="action-status todo">Action needed</span>{% endif %}
    </legend>
    <ol class="action-howto">
      <li><strong>Download</strong> the Purchase Order we prepared for you.</li>
      <li><strong>Sign and stamp</strong> it.</li>
      <li><strong>Upload</strong> the signed copy below with your PO number.</li>
    </ol>
    {% if issuedBuyerPo %}
      <p><a class="btn btn-secondary" href="/buyer-action/{{ token }}/buyer-po-document">&#11015; Download Purchase Order ({{ issuedBuyerPo.document_reference }})</a></p>
    {% else %}
      <p class="intake-note">We are still preparing your purchase order. If you already have your own signed purchase order, you can upload it below now.</p>
    {% endif %}
    {% if buyerPoDocuments.length %}
      <table class="list">
        <tr><th>Uploaded file</th><th>Uploaded</th></tr>
        {% for doc in buyerPoDocuments %}
        <tr>
          <td>{{ doc.original_filename }}</td>
          <td>{{ doc.uploaded_at | humanDate }}</td>
        </tr>
        {% endfor %}
      </table>
    {% endif %}
    {% if advanceCleared %}
      <p class="muted small">We have received your advance payment, so you can no longer upload here. If you need to send us a new copy, please contact your NexaCrest contact person.</p>
    {% else %}
    <form method="post" action="/buyer-action/{{ token }}/buyer-po" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Your PO Number *<input type="text" name="buyers_po_ref" required placeholder="e.g., PO-2026-0142" maxlength="100"></label>
        <label>Signed Purchase Order *<input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.eml,.msg" required></label>
      </div>
      <button type="submit">Upload Signed PO</button>
    </form>
    {% endif %}
  </fieldset>

  {% elif task == 'advance' %}
  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">2</span> Advance Payment <span class="action-status todo">Action needed</span></legend>
    <ol class="action-howto">
      <li><strong>Download</strong> your Proforma Invoice and pay the advance shown on it.</li>
      <li><strong>Tell us</strong> the payment details below (with the bank reference number). Our team checks them against our bank statement.</li>
    </ol>
    {% if issuedPi %}
      <p><a class="btn btn-secondary" href="/buyer-action/{{ token }}/proforma-invoice">&#11015; Download Proforma Invoice ({{ issuedPi.document_reference }})</a></p>
    {% endif %}
    <form method="post" action="/buyer-action/{{ token }}/report-payment" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Bank reference number (transaction ID, UTR or SWIFT reference) *<input type="text" name="transaction_ref" required placeholder="e.g. HDFCN26304123456" maxlength="150"></label>
        <label>Amount Paid<input type="number" name="amount" min="0.01" max="999999999999.99" step="0.01" placeholder="e.g. 12500.00"></label>
        <label>Date Paid<input type="date" name="payment_date" max="{{ today() }}"></label>
        <label>Paid from (bank and account)<input type="text" name="payer_bank_details" placeholder="e.g. Sent from HSBC UK, account ending 4321" maxlength="255"></label>
        <label class="full">Payment Screenshot / Proof of Payment (optional)<input type="file" name="screenshot" accept=".pdf,.jpg,.jpeg,.png"></label>
      </div>
      <button type="submit">Submit Payment Details</button>
    </form>
  </fieldset>

  {% elif task == 'oc' %}
  <fieldset class="intake-step action-step">
    <legend><span class="intake-step-num">3</span> Order Confirmation <span class="action-status todo">Action needed</span></legend>
    <p><strong>Please confirm your order.</strong> Read the order confirmation and check the summary below. If everything is correct, press the button.</p>
    {# Owner decision (2026-10-27): the buyer reads the exact document they acknowledge. #}
    {% if issuedOc %}
      <p><a class="btn btn-secondary" href="/buyer-action/{{ token }}/order-confirmation">&#11015; Download Order Confirmation ({{ issuedOc.document_reference }})</a></p>
    {% endif %}
    <div class="action-kv">
      <div><span class="k">Order Reference</span><span class="v">{{ order.order_reference }}</span></div>
      <div><span class="k">Total value of the goods (FOB — before freight and insurance)</span><span class="v">{{ order.currency_code or '' }} {{ totalFobValue | money }}</span></div>
      <div><span class="k">Advance Paid</span><span class="v">{% if advanceReceived != null %}{{ order.currency_code or '' }} {{ advanceReceived | money }}{% else %}—{% endif %}</span></div>
      <div><span class="k">Balance Due</span><span class="v">{{ order.currency_code or '' }} {{ balanceDue | money }}</span></div>
      <div><span class="k">Delivery terms (Incoterm)</span><span class="v">{{ order.incoterm_code or '—' }}</span></div>
      <div><span class="k">Port where the goods arrive</span><span class="v">{{ order.port_of_discharge_name or order.port_of_discharge_text or '—' }}</span></div>
    </div>
    <table class="list">
      <tr><th>Product</th><th>Quantity</th></tr>
      {% for p in products %}
      <tr><td>{{ p.description }}</td><td>{{ p.quantity }} {{ p.unit or '' }}</td></tr>
      {% endfor %}
    </table>
    <form method="post" action="/buyer-action/{{ token }}/acknowledge-oc">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-success">{% if issuedOc %}I have read order confirmation {{ issuedOc.document_reference }}. It is correct — please go ahead{% else %}Yes, this is correct — please go ahead{% endif %}</button>
    </form>
  </fieldset>

  {% else %}
  <div class="action-wait">
    {% if task == 'waiting_pi' %}
      <h2>&#10003; Thank you — nothing to do right now</h2>
      <p>We have your signed purchase order{% if order.buyers_po_ref and order.buyers_po_ref != 'NIL' %} <strong>{{ order.buyers_po_ref }}</strong>{% endif %}. We are now preparing your proforma invoice and will e-mail you when it is ready. This same link will then show you how to pay the advance.</p>
    {% elif task == 'advance_reported' %}
      <h2>&#10003; Thank you — we're checking your payment</h2>
      <p>We've received your advance payment details and our team is verifying them against our bank statement. We'll email you as soon as it's confirmed.</p>
    {% elif task == 'done' %}
      <h2>&#10003; All set — thank you</h2>
      <p>There's nothing left for you to do on this link. Your order is moving ahead; we'll keep you updated by e-mail and in your <a href="/client/login">buyer account</a>.</p>
    {% else %}
      <h2>&#10003; Thank you — nothing to do right now</h2>
      <p>Your order is with our team. We'll email you when there's something for you to do next — this same link will show it.</p>
    {% endif %}
  </div>
  {% endif %}

  <p class="muted small">Questions? Reply to the email this link came with{% if task != 'buyer_po' %}, or <a href="/client/login">sign in to your buyer account</a> once we have received your advance payment{% endif %}.</p>
</div>
