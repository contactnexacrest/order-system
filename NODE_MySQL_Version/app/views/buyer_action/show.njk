<div class="card">
  <h1>Order {{ order.order_reference or ('#' ~ order.id) }}</h1>
  <p class="muted">{{ order.company_legal_name or '' }}</p>

  {% if ocAcknowledgment and ocAcknowledgment.acknowledged_at == null %}
  <div class="section">
    <h2>Order Confirmation — Your Acknowledgement Needed</h2>
    <p>Please review your Order Confirmation below and confirm to proceed.</p>
    <table class="list">
      <tr><th>Order Reference</th><td>{{ order.order_reference }}</td></tr>
      <tr><th>Product(s)</th><td>
        {% for p in products %}{{ p.description }} (Qty: {{ p.quantity }} {{ p.unit or '' }}){% if not loop.last %}<br>{% endif %}{% else %}—{% endfor %}
      </td></tr>
      <tr><th>Total Order Value</th><td>{{ order.currency_code or '' }} {{ totalFobValue | money }}</td></tr>
      <tr><th>Incoterm</th><td>{{ order.incoterm_code or '—' }}</td></tr>
      <tr><th>Port of Discharge</th><td>{{ order.port_of_discharge_name or '—' }}</td></tr>
    </table>
    <form method="post" action="/buyer-action/{{ token }}/acknowledge-oc">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn-success">I acknowledge and confirm to proceed</button>
    </form>
  </div>
  {% endif %}

  <div class="section">
    <h2>Buyer PO</h2>
    <p class="muted small">Once you've signed your Purchase Order, upload a scanned copy here any time — each upload is kept, so re-uploading a corrected copy never loses the earlier one.</p>
    {% if buyerPoDocuments.length > 0 %}
      <table class="list">
        <tr><th>File</th><th>Uploaded</th></tr>
        {% for doc in buyerPoDocuments %}
        <tr>
          <td>{{ doc.original_filename }}</td>
          <td>{{ doc.uploaded_at | humanDate }}</td>
        </tr>
        {% endfor %}
      </table>
    {% else %}
      <p class="muted">No Buyer PO copy on file yet.</p>
    {% endif %}
    <form method="post" action="/buyer-action/{{ token }}/buyer-po" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Upload Buyer PO (signed) <input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.eml,.msg" required></label>
      <button type="submit" class="btn-sm">Upload</button>
    </form>
  </div>

  <p class="muted small">Need to see your full order, documents, or message our team? <a href="/client/login">Log in to your client portal</a> (set up automatically once your advance payment clears).</p>
</div>
