<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Dispute Log (All Orders)</h1>
      <p class="muted" style="margin:0;">{{ disputes.length }} shown.</p>
    </div>
    {% if kanbanUser %}<div class="btn-row" style="margin-top:0;"><a class="btn-sm btn-secondary" href="/disputes">Switch to board view</a></div>{% endif %}
  </div>

  {% set listOfBoard = kanbanUser %}{% include "disputes/_filters.njk" %}

  {% if not disputes or disputes.length == 0 %}
    <p class="muted">No disputes recorded.</p>
  {% else %}
  <div class="card-grid">
    {% for d in disputes %}{% set kanbanCard = false %}{% include "disputes/_card.njk" %}{% endfor %}
  </div>
  {% endif %}
</div>
