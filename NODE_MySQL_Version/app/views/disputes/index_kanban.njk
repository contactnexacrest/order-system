{# Owner hard rule 2026-11-01: the same filters and the same cards as the Standard list (disputes/_filters.njk, disputes/_card.njk). #}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Disputes — Kanban Board</h1>
      <p class="muted" style="margin:0;">{{ totalCount }} total &middot; every dispute by its own status.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn-sm btn-secondary" href="/disputes?view=list{{ ('&amp;status=' + (statusFilter | urlencode)) | safe if statusFilter else '' }}">Switch to list view</a>
    </div>
  </div>

  {% set listOfBoard = false %}{% include "disputes/_filters.njk" %}

  <div class="kanban-board">
    {% for statusValue, col in columns %}
      <div class="kanban-column">
        <div class="kanban-column-header">
          <span class="kanban-column-title">{{ statusValue }}</span>
          <span class="kanban-column-count">{{ col.disputes.length }}</span>
        </div>
        {% if not col.disputes.length %}
          <p class="kanban-column-empty">No disputes here</p>
        {% else %}
          {% for d in col.disputes %}{% set kanbanCard = true %}{% include "disputes/_card.njk" %}{% endfor %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
