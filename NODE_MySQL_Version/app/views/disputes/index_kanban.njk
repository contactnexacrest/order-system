{% macro kanbanCard(d) %}
<a class="entity-card kanban-card" href="/orders/{{ d.order_id }}/disputes">
  <div class="entity-card-header">
    <span class="entity-card-title">{{ d.order_reference }}</span>
  </div>
  <div class="entity-card-sub">{{ d.company_legal_name }}</div>
  <div class="muted small">{{ d.description | truncate(90, true, '…') }}</div>
  <div class="entity-card-footer">
    <span class="muted small">Notice: {{ d.notice_date }}</span>
    <span class="muted small">Due: {{ d.response_due_date or '—' }}</span>
  </div>
</a>
{% endmacro %}
<div class="card page-wide">
  <div class="page-header-row">
    <div>
      <h1>Disputes — Kanban Board</h1>
      <p class="muted" style="margin:0;">{{ totalCount }} total &middot; every dispute by its own status.</p>
    </div>
    <div class="btn-row" style="margin-top:0;">
      <a class="btn-sm btn-secondary" href="/disputes?status=all">Switch to list view</a>
    </div>
  </div>

  <div class="kanban-board">
    {% for statusValue, col in columns %}
      <div class="kanban-column">
        <div class="kanban-column-header">
          <span class="kanban-column-title">{{ statusValue }}</span>
          <span class="kanban-column-count">{{ col.disputes.length }}</span>
        </div>
        {% if col.disputes.length == 0 %}
          <p class="kanban-column-empty">No disputes here</p>
        {% else %}
          {% for d in col.disputes %}{{ kanbanCard(d) }}{% endfor %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
