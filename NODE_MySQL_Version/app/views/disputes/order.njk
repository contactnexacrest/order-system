<div class="card page-wide">
  <p class="muted small"><a href="/orders/{{ order.id }}">&larr; Back to Order</a></p>
  <h1>Disputes — {{ order.order_reference }}</h1>
  <p class="muted">{{ order.company_legal_name }}</p>

  {% if canManage %}
  <div class="section">
    <h2>Raise a Dispute</h2>
    <form method="post" action="/orders/{{ order.id }}/disputes">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="field-grid">
        <label>Notice Date *
          <input type="date" name="notice_date" value="{{ today() }}" required>
        </label>
        <label>From
          <input type="text" name="from_party" placeholder="e.g. Buyer, via email">
        </label>
        <label class="full">Description *
          <textarea name="description" required rows="3" placeholder="Describe the dispute, including any correspondence reference" style="width:100%"></textarea>
        </label>
        <label>Assign To
          <select name="assigned_to">
            <option value="">Unassigned</option>
            {% for u in users %}
              <option value="{{ u.id }}">{{ u.name }}</option>
            {% endfor %}
          </select>
        </label>
      </div>
      <button type="submit" class="btn-sm">Log Dispute</button>
    </form>
  </div>
  {% endif %}

  <div class="section">
    <h2>Dispute Log</h2>
    {% for d in disputes %}
      <details>
        <summary>{{ d.notice_date }} — {{ d.status }} — {{ d.description | truncate(80, true, '…') }}</summary>
        <div class="kv-grid">
          <div><span class="k">From</span><span class="v">{{ d.from_party or '—' }}</span></div>
          <div><span class="k">Response Due</span><span class="v">{{ d.response_due_date or '—' }}</span></div>
          <div><span class="k">Resolved At</span><span class="v">{{ d.resolved_at or '—' }}</span></div>
        </div>
        <p>{{ d.description | nl2br }}</p>
        {% if d.resolution_notes %}<p><strong>Resolution:</strong> {{ d.resolution_notes | nl2br }}</p>{% endif %}

        {% if canManage %}
        <form method="post" action="/disputes/{{ d.id }}/status">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <div class="field-grid">
            <label>Status
              <select name="status">
                {% for opt in statusOptions %}
                  <option value="{{ opt.option_value }}" {{ 'selected' if opt.option_value == d.status else '' }}>{{ opt.option_value }}</option>
                {% endfor %}
              </select>
            </label>
            <label class="full">Resolution Notes
              <input type="text" name="resolution_notes" placeholder="e.g., Resolved after reissuing corrected invoice" style="width:100%">
            </label>
          </div>
          <button type="submit" class="btn-sm">Update</button>
        </form>

        <form method="post" action="/disputes/{{ d.id }}/documents" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <div class="field-grid">
            <label>Document
              <input type="file" name="document" required>
            </label>
            <label>Received From
              <input type="text" name="received_from" placeholder="Received from (optional)">
            </label>
          </div>
          <button type="submit" class="btn-sm">Attach Document</button>
        </form>
        {% endif %}

        <div class="section-nested" style="margin-top:0.75rem">
          <h3>Replies</h3>
          {% for r in replies[d.id] %}
            <div class="reply-item" style="border-top:1px solid var(--line, #EFE6D2);padding:0.5rem 0">
              <p class="muted small">{{ r.author_name }} — {{ r.created_at }}</p>
              <p>{{ r.body | nl2br }}</p>
            </div>
          {% endfor %}
          {% if not replies[d.id] or replies[d.id].length == 0 %}
            <p class="muted small">No replies yet.</p>
          {% endif %}

          {% if canRespond %}
          <form method="post" action="/disputes/{{ d.id }}/replies">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label>Reply<textarea name="body" required rows="2" placeholder="Type your reply…" style="width:100%"></textarea></label>
            <button type="submit" class="btn-sm">Post Reply</button>
          </form>
          {% endif %}
        </div>
      </details>
    {% endfor %}
    {% if not disputes or disputes.length == 0 %}
      <p class="muted">No disputes on this order.</p>
    {% endif %}
  </div>
</div>
