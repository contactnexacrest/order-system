# Copy this file to ".env" (same folder) and fill in real values.
# .env must NEVER be committed to version control or placed inside public/.

APP_ENV=production
# Set to "local" only on your own dev machine — enables developer conveniences
# such as printing 2FA codes on screen instead of emailing them. NEVER set this
# to "local" on your production server or any environment reachable from the internet.

APP_URL=https://www.example.com
PORT=3000
SESSION_SECRET_KEY=change-this-to-a-random-32-byte-value

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexacrest
DB_USERNAME=nexacrest_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

STORAGE_BASE_PATH=/absolute/path/outside/web/root/storage

# --- PDF generation (Puppeteer over an existing Chromium — see the
# deployment guide's "Install Chromium" step). Point this at whatever
# `which chromium` / `which chromium-browser` / `which google-chrome`
# resolves to on the server. ---
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Email (SMTP) — used for deferred document sends and email-based 2FA ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=NexaCrest International Private Limited

# --- SMS gateway (2FA only) — OPTIONAL. Leave blank to offer email 2FA only. ---
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# --- Background jobs (LUT/RCMC/payment/dispute alerts, deferred email send) ---
# false (default, recommended) = you run these as two separate OS-level
# cron/systemd entries calling `node src/jobs/checkAlerts.js` and
# `node src/jobs/dispatchDeferredEmails.js` directly — see the deployment
# guide's "Background jobs" section.
# true = this same web process also runs them on an internal node-cron
# schedule (src/jobs/scheduler.js) — simpler (nothing else to configure),
# but ties job execution to the web process's uptime. Never set this to
# true AND also configure the external cron entries — that double-fires
# both jobs.
RUN_JOBS_IN_PROCESS=false
