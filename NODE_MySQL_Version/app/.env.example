# Copy this file to ".env" (same folder) and fill in real values.
# .env must NEVER be committed to version control or placed inside public/.

APP_ENV=production
# Set to "local" only on your own dev machine — enables developer conveniences
# such as printing 2FA codes on screen instead of emailing them. NEVER set this
# to "local" on your production server or any environment reachable from the internet.

DEV_SERVER=false
# Set to "true" on any dev/staging/UAT deployment (independent of APP_ENV —
# a staging server reachable over the internet is NOT "local") to show a
# bright red "DEV / TEST ENVIRONMENT" strip on every page, so nobody
# mistakes it for production. Leave "false" on the real production server.

APP_URL=https://www.example.com
PORT=3000
SESSION_SECRET_KEY=change-this-to-a-random-32-byte-value

APP_ENCRYPTION_KEY=change-me
# Required — used to encrypt the Buyer Action Link token at rest
# (encryptionService.js). Generate a real random value and never reuse
# the placeholder above in any environment staff actually log into:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this key after it's been used makes every already-encrypted
# value undecryptable (existing Buyer Action Links will need
# regenerating) — treat it like a database password, not something to
# rotate casually.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexacrest
DB_USERNAME=nexacrest_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
# Optional: DB_POOL_SIZE=10 (MySQL connection pool size; 10 when not set).

STORAGE_BASE_PATH=/absolute/path/outside/web/root/storage

# --- PDF generation (Puppeteer over an existing Chromium — see the
# deployment guide's "Install Chromium" step). Point this at whatever
# `which chromium` / `which chromium-browser` / `which google-chrome`
# resolves to on the server. ---
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Email (SMTP) — used for deferred document sends and email-based 2FA ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls (or blank) = STARTTLS, and sending fails if the server doesn't offer it;
# ssl = implicit TLS (usually port 465). Same on both stacks (QA Round 5, R5-17).
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=NexaCrest International Private Limited

# --- Zoho (owner decisions 2026-10-29) — always write all three out, never comment them out. ---
# ZOHO_INTEGRATION_ENABLED: true = this server may talk to Zoho at all. false = no Zoho call is ever made.
# ZOHO_ENVIRONMENT: test = only customers named TEST-... may go to Zoho; production = only real orders
#   (test and sample orders are never sent). Use production on the live server only.
# ZOHO_EINVOICE_ENABLED: true = GST e-invoice (IRN), e-way bill and GST filing may be used — and only when
#   ZOHO_ENVIRONMENT=production too. Keep false until NexaCrest must e-invoice. Never true while testing.
# Zoho Mail is not used to send: all mail goes through the SMTP server above (Bluehost).
# The Zoho Books credentials, the "Zoho Books enabled" switch and the go-live date are not kept here:
#   they are set in Admin -> Settings (Zoho Books). Books syncs only when ZOHO_INTEGRATION_ENABLED=true
#   AND that switch is on; with ZOHO_ENVIRONMENT=production nothing is sent until the go-live date is set.
ZOHO_INTEGRATION_ENABLED=false
ZOHO_ENVIRONMENT=test
ZOHO_EINVOICE_ENABLED=false

# --- SMS gateway (2FA only) — OPTIONAL. Leave blank to offer email 2FA only. ---
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# --- Background jobs (LUT/RCMC/payment/dispute alerts, deferred email send,
# OC auto-confirm, Zoho Books sync) ---
# false (default, recommended) = you run these as four separate OS-level
# cron/systemd entries calling `node src/jobs/checkAlerts.js`,
# `node src/jobs/dispatchDeferredEmails.js`,
# `node src/jobs/autoConfirmOcAcknowledgments.js` and
# `node src/jobs/zohoSync.js` directly — see README.md's "Background jobs"
# section and the deployment guide.
# true = this same web process also runs them on an internal node-cron
# schedule (src/jobs/scheduler.js) — simpler (nothing else to configure),
# but ties job execution to the web process's uptime. Never set this to
# true AND also configure the external cron entries — that double-fires
# every job.
RUN_JOBS_IN_PROCESS=false
