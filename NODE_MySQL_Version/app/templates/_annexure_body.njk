{#
  Shared Annexure A product-card markup — included both by ANNEXA's own
  standalone document (annexure.njk, used when a buyer/staff member wants
  Annexure A on its own) and by _layout.njk's annexure_appendix block (used
  to bake Annexure A into the SAME PDF as QT/PI/CI/etc. as a guaranteed
  appendix — see documentGenerationService's per-user mandate: "if
  Annexure is present, it must be an integral part of the document, and
  must not get missed by anyone under any condition"). One copy of the
  per-product rendering so the two can never drift apart.
#}
<div class="banner" style="background:#FAEEDA; color:#633806; text-align:left; font-weight:normal;"><strong style="color:#8A6D1D;">Note:</strong> <em>Product images and drawings are for reference only and may show optional accessories or decorative elements not included in the quoted price. All binding specifications are as stated in each product section below. Actual product appearance may vary slightly due to the natural characteristics of granite.</em></div>

{% for p in annexure_products %}
<div class="section-title">PRODUCT {{ loop.index }} &nbsp;— &nbsp;{{ p.name }}</div>
<table class="kv" style="table-layout:fixed;">
  <tr>
    {% if p.images.length and p.images[0].data_uri %}
    <td style="width:35%; background:#000000; text-align:center; vertical-align:middle; padding:0; border-color:#000000;">
      <img src="{{ p.images[0].data_uri }}" style="max-width:100%; max-height:140pt;">
    </td>
    {% else %}
    <td style="width:35%; background:#F1F1F1; text-align:center; vertical-align:middle; padding:0; border-color:#D9D9D9;">
      <span style="color:#8A8272; font-style:italic; font-size:9pt;">No Image Uploaded</span>
    </td>
    {% endif %}
    <td class="v" style="width:65%; vertical-align:top;">
      {% if p.description %}<p style="margin:0 0 4pt; font-weight:bold; color:#17233A;">{{ p.description }}</p>{% endif %}
      {% if p.finish %}<p style="margin:0 0 3pt;"><strong style="color:#17233A;">Surface Finish:</strong> {{ p.finish }}</p>{% endif %}
      {% if p.dimensions %}<p style="margin:0 0 3pt;"><strong style="color:#17233A;">Dimensions:</strong> {{ p.dimensions }}</p>{% endif %}
      {% if p.components %}<p style="margin:0 0 3pt;"><strong style="color:#17233A;">Includes:</strong> {{ p.components|nl2br }}</p>{% endif %}
      {% if p.technical_notes %}<p style="margin:0;">{{ p.technical_notes|nl2br }}</p>{% endif %}
    </td>
  </tr>
</table>
{% if p.images.length > 1 %}
<table class="annexure-images">
  <tr>
    {% for img in p.images %}
      {% if not loop.first and img.data_uri %}<td><img src="{{ img.data_uri }}"></td>{% endif %}
    {% endfor %}
  </tr>
</table>
{% endif %}
{% else %}
<p class="placeholder-italic">No product entries have been added to this Annexure yet.</p>
{% endfor %}

<div class="banner" style="background:#E6F1FB; color:#17233A; text-align:left; font-weight:normal;">This Annexure A forms an integral part of {{ order.quotation_ref or order.pi_ref or 'the referenced document' }} dated {{ meta.generated_date }}. <em style="color:#185FA5;">The commercial terms, pricing, payment conditions, and quantities stated in the main document take precedence in all cases. Product images and technical drawings in this annexure are for reference and identification purposes only. This Annexure is not valid as a standalone document.</em></div>
