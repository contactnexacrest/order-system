<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  /*
   * Document fidelity rebuild (2026-09-21) — every color/font/size/spacing
   * value below was measured directly off the real source .docx templates
   * (python-docx run-by-run dump: font, size, bold/italic, color, cell
   * shading, borders, alignment), not eyeballed. See
   * pdfRenderService.js / the @font-face below for why the font family is
   * "Aptos" but the embedded file is Carlito (SIL OFL, freely
   * redistributable; Aptos itself is not).
   */
  @font-face { font-family: 'Aptos'; src: url('{{ fonts.regular_data_uri }}') format('truetype'); font-weight: normal; font-style: normal; }
  @font-face { font-family: 'Aptos'; src: url('{{ fonts.bold_data_uri }}') format('truetype'); font-weight: bold; font-style: normal; }
  @font-face { font-family: 'Aptos'; src: url('{{ fonts.italic_data_uri }}') format('truetype'); font-weight: normal; font-style: italic; }
  @font-face { font-family: 'Aptos'; src: url('{{ fonts.bolditalic_data_uri }}') format('truetype'); font-weight: bold; font-style: italic; }

  @page { margin: 0.5in 0.59in; }
  * { box-sizing: border-box; }
  body { font-family: 'Aptos', sans-serif; font-size: 9.5pt; color: #000000; }

  table { border-collapse: collapse; }
  img { -webkit-print-color-adjust: exact; }

  /* --- Header: logo + right-aligned stacked title block, no banner/border --- */
  table.doc-header { width: 100%; margin-bottom: 6pt; }
  table.doc-header td { border: none; padding: 0; vertical-align: middle; }
  table.doc-header td.logo-cell { width: 60pt; }
  table.doc-header td.logo-cell img { width: 54pt; height: auto; }
  table.doc-header td.title-cell { text-align: right; }
  table.doc-header .company { display: block; font-size: 13pt; font-weight: bold; color: #17233A; margin-bottom: 3pt; }
  table.doc-header .doctype { display: block; font-size: 18pt; font-weight: bold; color: #17233A; margin-bottom: 2pt; }
  table.doc-header .incoterm { display: block; font-size: 10pt; font-weight: bold; color: #5B6573; }

  .mandatory-note { font-size: 9pt; font-style: italic; color: #5B6573; margin-bottom: 6pt; }
  .mandatory-note .star { font-weight: bold; font-style: normal; color: #C0392B; }

  /* --- Meta bar: N-column shaded strip, small gray label over bold navy value --- */
  table.meta { width: 100%; margin-bottom: 6pt; }
  table.meta td { border: 1px solid #D7DEE6; background: #F1F5F9; padding: 4pt 7pt; vertical-align: top; }
  table.meta .label { font-size: 8pt; color: #5B6573; display: block; }
  table.meta .value { font-size: 10pt; font-weight: bold; color: #17233A; display: block; margin-top: 1pt; }

  /* --- Banners: valid-until (amber), GST/confirmation (green), annexure warning (red) --- */
  .banner { padding: 5pt 9pt; margin-bottom: 6pt; font-size: 9.5pt; }
  .banner-amber { background: #FFF3CD; }
  .banner-amber .label { font-weight: bold; color: #633806; }
  .banner-amber .value { font-weight: bold; font-size: 11pt; color: #412402; }
  .banner-amber .note { font-style: italic; font-size: 8.5pt; color: #854F0B; }
  .banner-green { background: #EAF3DE; }
  .banner-green .label { font-weight: bold; color: #27500A; }
  .banner-green .value { color: #3B6D11; }
  .banner-green .headline { font-weight: bold; font-size: 13pt; color: #27500A; }
  .banner-green .sub { font-style: italic; font-size: 9.5pt; color: #3B6D11; }
  .banner-red { background: #FBEAEA; font-weight: bold; font-size: 10pt; color: #8A1F1F; }
  .banner-red .headline { display: block; text-align: center; font-weight: bold; font-size: 12pt; color: #8A1F1F; margin-bottom: 3pt; }
  .banner-red .sub { display: block; text-align: center; font-weight: normal; font-style: normal; font-size: 9.5pt; color: #5A1414; }
  .banner-red .sub strong { color: #8A1F1F; }

  /* --- Section title bar: solid navy, white bold text, no border --- */
  .section-title { background: #17233A; color: #FFFFFF; font-size: 11pt; font-weight: bold; padding: 4pt 9pt; margin-top: 9pt; margin-bottom: 6pt; }

  /* --- Key/value table: alternating white/shaded rows, bold navy labels --- */
  table.kv { width: 100%; margin-bottom: 6pt; }
  table.kv td { border: 1px solid #D7DEE6; padding: 3.5pt 7pt; font-size: 9.5pt; vertical-align: top; }
  table.kv td.k { font-weight: bold; color: #17233A; width: 30%; }
  table.kv td.v { width: 70%; }
  table.kv tr:nth-child(odd) td.k { background: #F1F5F9; }
  table.kv tr:nth-child(even) td.k { background: #FFFFFF; }
  table.kv-solid tr td.k { background: #F1F5F9 !important; }
  .checkbox-row .box { font-weight: normal; }
  .checkbox-row .box.checked { font-weight: bold; color: #17233A; }
  .checkbox-row .cbx { display: inline-block; width: 9pt; height: 9pt; line-height: 8pt; border: 1.3pt solid #5B6573; text-align: center; vertical-align: middle; font-size: 8pt; margin-right: 2pt; }
  .checkbox-row .box.checked .cbx { border-color: #17233A; background: #17233A; color: #FFFFFF; }
  table.kv td.v { background: #FFFFFF; }
  .placeholder-italic { font-style: italic; color: #5B6573; }

  /* --- Product table: navy-mid header, alternating spec rows, color-coded line numbers --- */
  table.products { width: 100%; margin-bottom: 6pt; }
  table.products th { background: #173B73; color: #FFFFFF; font-size: 9pt; font-weight: bold; padding: 4pt 6pt; text-align: left; border: 1px solid #173B73; }
  table.products td { border: 1px solid #D7DEE6; padding: 4pt 6pt; font-size: 9.5pt; vertical-align: top; }
  table.products td.num { text-align: right; }
  table.products td.line-no { font-weight: bold; text-align: center; }
  table.products tr.spec td { background: #EFF3F7; font-size: 8.5pt; border-top: none; }
  table.products tr.spec .spec-label { font-weight: bold; color: #17233A; }
  table.products tr.spec .spec-sep { color: #5B6573; }

  /* --- Totals table: highlight row uses the same navy-mid as the product header --- */
  table.totals { width: 100%; margin-bottom: 6pt; }
  table.totals td { border: 1px solid #D7DEE6; padding: 4pt 8pt; font-size: 9.5pt; }
  table.totals td.k { font-weight: bold; color: #17233A; width: 55%; }
  table.totals td.v { width: 45%; }
  table.totals tr.highlight td.k { background: #17233A; color: #FFFFFF; font-size: 10.5pt; }
  table.totals tr.highlight td.v { background: #173B73; color: #FFFFFF; font-weight: bold; font-style: italic; font-size: 10.5pt; }

  .weight-caption { font-weight: bold; font-size: 10.5pt; color: #17233A; margin: 6pt 0 3pt; }
  .weight-caption .note { font-weight: normal; font-style: italic; font-size: 9pt; color: #5B6573; }
  table.weight th { background: #173B73; color: #FFFFFF; font-size: 9.5pt; font-weight: bold; padding: 4pt 7pt; text-align: left; border: 1px solid #173B73; }
  table.weight td { border: 1px solid #D7DEE6; padding: 3.5pt 7pt; font-size: 9.5pt; }
  table.weight tr:nth-child(odd) td { background: #F1F5F9; }

  /* --- Payment-terms / documents-list / T&C blocks --- */
  .bullet-block { font-size: 9.5pt; margin-bottom: 6pt; }
  .bullet-block p { margin: 0 0 4pt; }
  .bullet-block .sub-line { color: #333333; }
  .bullet-block .mand-star { font-weight: bold; color: #C0392B; }
  .numbered-block { font-size: 9.5pt; margin-bottom: 6pt; }
  .numbered-block p { margin: 0 0 3pt; }
  ul.terms { margin: 0 0 6pt; padding-left: 14pt; }
  ul.terms li { font-size: 9.5pt; color: #000000; margin-bottom: 4pt; }

  /* --- Signature block --- */
  .signature-block { margin-top: 14pt; }
  .signature-block table { width: 100%; }
  .signature-block td { vertical-align: bottom; font-size: 10pt; padding: 2pt 8pt; border: none; }
  .signature-block .for-line { font-weight: bold; color: #17233A; }
  .signature-block .auth-label { font-weight: bold; color: #5B6573; }
  .signature-block .signatory-name { font-weight: bold; font-size: 13pt; color: #17233A; }
  .signature-block .signatory-title { font-weight: bold; color: #000000; }
  .signature-block .signatory-company { font-size: 9pt; color: #5B6573; }
  .signature-img { height: 32pt; }
  .seal-img { height: 85pt; margin-top: 4pt; }
  .signature-cell { position: relative; min-height: 95pt; }

  .annexure-notice { background: #FBEAEA; color: #8A1F1F; padding: 6pt 9pt; font-size: 10pt; font-weight: bold; margin-top: 6pt; margin-bottom: 4pt; }

  .annexure-product { margin-bottom: 10pt; page-break-inside: avoid; }
  .annexure-product-title { font-size: 10pt; font-weight: bold; color: #17233A; margin-bottom: 3pt; }
  table.annexure-images { width: 100%; margin-top: 4pt; }
  table.annexure-images td { border: 1px solid #D7DEE6; padding: 4pt; text-align: center; }
  table.annexure-images img { max-width: 220px; max-height: 160px; }

  {% if watermark.enabled %}
  .watermark { position: fixed; top: 300px; left: 40px; font-size: {{ watermark.font_size }}px; color: {{ watermark.color }};
    opacity: {{ watermark.opacity }}; transform: rotate(-{{ watermark.angle }}deg); z-index: 0; }
  {% endif %}
  {% block extra_style %}{% endblock %}
</style>
</head>
<body>

{% if watermark.enabled %}<div class="watermark">{{ watermark.text }}</div>{% endif %}

<table class="doc-header"><tr>
  {% if assets.logo_data_uri %}<td class="logo-cell"><img src="{{ assets.logo_data_uri }}"></td>{% endif %}
  <td class="title-cell">
    <span class="company">{{ company.legal_name|upper }}</span>
    <span class="doctype">{{ doc_title }}</span>
    {% block header_incoterm %}{% if order.incoterm_code %}<span class="incoterm">{{ order.incoterm_code }} {{ order.port_of_loading|upper }}</span>{% endif %}{% endblock %}
  </td>
</tr></table>

<div class="mandatory-note">Fields marked <span class="star">*</span> are mandatory and must be completed before this document is issued.</div>

{% block meta_table %}{% endblock %}

{% block banner %}{% endblock %}

{% block section1 %}
<div class="section-title">1. {{ section1_title | default('SELLER / EXPORTER') }}</div>
<table class="kv">
  <tr><td class="k">Company / Legal Entity</td><td class="v">{{ company.legal_name }}</td></tr>
  <tr><td class="k">Registered Office</td><td class="v">{{ company.registered_office }}</td></tr>
  <tr><td class="k">Corporate Office</td><td class="v">{{ company.corporate_office }}</td></tr>
  <tr><td class="k">GSTIN</td><td class="v">{{ company.gstin }}</td></tr>
  <tr><td class="k">IEC / PAN</td><td class="v">{{ company.iec_pan }}</td></tr>
  <tr><td class="k">Contact Person</td><td class="v">{{ company.md_name }} — {{ company.md_title }}</td></tr>
  <tr><td class="k">Phone</td><td class="v">{{ company.phone }}</td></tr>
  <tr><td class="k">Email</td><td class="v">{{ company.email }}</td></tr>
</table>
{% endblock %}

{% block body %}{% endblock %}

{% block terms_section %}
{% if terms is defined and terms|length > 0 %}
<div class="section-title">{{ terms_section_number }}. {{ terms_section_title }}</div>
{% if order.include_annexure_a %}
<div class="annexure-notice">&#9888; Annexure A — Product Technical Specifications is attached and forms an integral part of this {{ doc_title|lower }}. Refer Annexure A for product images, technical drawings, and component dimensions.</div>
{% endif %}
<ul class="terms">
  {% for clause in terms %}
    <li>{{ clause }}</li>
  {% endfor %}
</ul>
{% endif %}
{% endblock %}

{% block signature_block %}
<div class="signature-block">
  <table>
    <tr>
      <td style="width:50%;" class="for-line">For<br>{{ company.legal_name }}</td>
      <td style="width:50%;" class="auth-label">Authorised Signatory</td>
    </tr>
    <tr>
      <td class="signature-cell">
        {% if signatory.seal_data_uri %}<img class="seal-img" src="{{ signatory.seal_data_uri }}">{% endif %}
      </td>
      <td>
        {% if signatory.signature_data_uri %}<img class="signature-img" src="{{ signatory.signature_data_uri }}"><br>{% endif %}
        <span class="signatory-name">{{ signatory.name }}</span><br>
        <span class="signatory-title">{{ signatory.designation }}</span><br>
        <span class="signatory-company">{{ company.legal_name }}</span>
      </td>
    </tr>
  </table>
</div>
{% endblock %}

</body>
</html>
