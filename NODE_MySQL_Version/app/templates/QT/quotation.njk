{% extends "_layout.njk" %}

{% block meta_table %}
<table class="meta">
  <tr>
    <td><span class="label">QUOTATION NO. *</span><span class="value">{{ meta.document_reference }} {{ meta.client_revision_label }}</span></td>
    <td><span class="label">DATE *</span><span class="value">{{ order.quotation_date or meta.generated_date }}</span></td>
    <td><span class="label">BUYER INQUIRY REF *</span><span class="value">{{ order.buyer_inquiry_ref }}</span></td>
  </tr>
</table>
{% endblock %}

{% block banner %}
<div class="banner banner-amber">&#9201;&nbsp; <span class="label">VALID UNTIL *</span> &nbsp; <span class="value">{{ order.quotation_valid_until or 'To Be Confirmed' }}</span> &nbsp;&nbsp;<span class="note">Prices and terms are not valid after this date.</span></div>
{% endblock %}

{% block body %}

{% set section_number = section_numbers.buyer %}{% include '_buyer_details.njk' %}
{% if show_consignee_section %}
{% set section_number = section_numbers.consignee %}{% include '_consignee_details.njk' %}
{% endif %}
<table class="kv">
  <tr><td class="k">Certificate of Origin Type</td><td class="v">{{ order.coo_type }}</td></tr>
  <tr><td class="k">Port of Discharge *</td><td class="v">{{ order.port_of_discharge }}</td></tr>
</table>

<div class="section-title">{{ section_numbers.product }}. PRODUCT / ORDER DETAILS</div>
<table class="products">
  <tr><th>#</th><th>Product Description *</th><th>Qty *</th><th>Unit *</th><th>Unit Price ({{ order.currency_code }}) *</th><th>Amount ({{ order.currency_code }}) *</th></tr>
  {% for p in products %}
  {% set lineColor = '#1D6FA8' if loop.index % 2 == 1 else '#2D7D56' %}
  <tr>
    <td class="line-no" style="color:{{ lineColor }};">{{ loop.index }}</td>
    <td>{{ p.description }}</td>
    <td class="num">{{ p.quantity }}</td>
    <td>{{ p.unit }}</td>
    <td class="num">{{ p.unit_price }}</td>
    <td class="num">{{ p.amount }}</td>
  </tr>
  {% if p.dimensions or p.finish %}
  <tr class="spec">
    <td></td>
    <td colspan="5">
      <span class="line-no" style="color:{{ lineColor }};">{{ loop.index }}.</span>
      <span class="spec-label">Dimensions:</span> {{ p.dimensions or 'To Be Confirmed' }}
      <span class="spec-sep">&nbsp;&middot;&nbsp;</span><span class="spec-label">Finish:</span> {{ p.finish or 'To Be Confirmed' }}
      <span class="spec-sep">&nbsp;&middot;&nbsp;</span><span class="spec-label">HS Code:</span> {{ p.hs_code }}
      <span class="spec-sep">&nbsp;&middot;&nbsp;</span><span class="spec-label">Country of Origin:</span> India
    </td>
  </tr>
  {% endif %}
  {% endfor %}
</table>

<table class="totals">
  <tr><td class="k">FOB Value ({{ order.currency_code }}) *</td><td class="v">{{ financial.fob_value }}</td></tr>
  <tr><td class="k">Freight ({{ order.currency_code }})</td><td class="v">
    {% if order.is_fob %}NIL — freight arranged by buyer.{% else %}Indicative approx. {{ order.currency_code }} {{ order.indicative_freight_low or 'XXX' }}–{{ order.indicative_freight_high or 'XXX' }} per {{ order.container_type }}, {{ order.port_of_loading }} to {{ order.port_of_discharge }}. Subject to confirmation at time of booking. Actual freight confirmed and recovered IN ADVANCE by Debit Note when cargo is packed and ready — payment required within 3 Calendar Days, and must be received BEFORE shipment booking is confirmed.{% endif %}
  </td></tr>
  <tr><td class="k">Insurance ({{ order.currency_code }})</td><td class="v">
    {% if order.is_fob %}NIL — buyer's responsibility.{% else %}Indicative approx. {{ order.currency_code }} {{ order.indicative_insurance_amount or 'XX' }}. Confirmed by Debit Note when cargo is ready.{% endif %}
  </td></tr>
  <tr class="highlight"><td class="k">TOTAL QUOTED VALUE ({{ order.currency_code }})</td><td class="v">{{ financial.total_value }}</td></tr>
</table>

<p class="weight-caption">Weight &amp; Volume <span class="note">(Estimated — actuals confirmed on Packing List after production)</span></p>
<table class="weight">
  <tr><th>Parameter</th><th>Estimated Value *</th><th>Unit</th></tr>
  <tr><td>Total CBM (m&sup3;)</td><td>{{ order.estimated_total_cbm or 'To Be Confirmed' }}</td><td>m&sup3;</td></tr>
  <tr><td>Gross Weight (incl. packing)</td><td>{{ order.estimated_gross_weight_kg or 'To Be Confirmed' }}</td><td>kg</td></tr>
  <tr><td>Net Weight (stone only)</td><td>{{ order.estimated_net_weight_kg or 'To Be Confirmed' }}</td><td>kg</td></tr>
  <tr><td>No. of Packages / Crates</td><td>{{ order.estimated_package_count }}</td><td>Crates</td></tr>
  <tr><td>Package Type</td><td>{{ order.estimated_package_type }}</td><td>—</td></tr>
</table>

<div class="section-title">{{ section_numbers.shipping }}. SHIPPING / COMMERCIAL TERMS</div>
<table class="kv">
  <tr><td class="k">Incoterm *</td><td class="v">{{ order.incoterm_label }}</td></tr>
  <tr><td class="k">Port of Loading *</td><td class="v">{{ order.port_of_loading }}</td></tr>
  <tr><td class="k">Port of Discharge *</td><td class="v">{{ order.port_of_discharge }}</td></tr>
  <tr><td class="k">Container Type</td><td class="v">{{ order.container_type }}</td></tr>
  <tr><td class="k">Est. Lead Time</td><td class="v">{{ order.est_lead_time_text }}</td></tr>
  <tr><td class="k">Insurance</td><td class="v">{% if order.is_fob %}Buyer's responsibility.{% else %}Seller arranges — cost included in invoice.{% endif %}</td></tr>
</table>

<div class="section-title">{{ section_numbers.payment }}. PAYMENT TERMS</div>
<div class="bullet-block">
  <p>&#8226; {{ financial.advance_pct }}% Advance Payment on FOB Value against Proforma Invoice. <span class="mand-star">*</span></p>
  <p class="sub-line">&nbsp;&nbsp;{{ financial.advance_pct }}% Advance Amount:&nbsp;&nbsp;{{ order.currency_code }} {{ financial.advance_amount }} <span class="mand-star">*</span></p>
  <p>&#8226; {{ financial.balance_pct }}% Balance Payment on FOB Value {{ financial.balance_terms_text }} <span class="mand-star">*</span></p>
  <p class="sub-line">&nbsp;&nbsp;{{ financial.balance_pct }}% Balance Amount:&nbsp;&nbsp;{{ order.currency_code }} {{ financial.balance_amount }} <span class="mand-star">*</span></p>
  {% if not order.is_fob %}
  <p>&#8226; Freight &amp; Insurance (CFR/CIF orders only): <span class="sub-line">Actual confirmed amounts invoiced separately by Debit Note before shipment booking is confirmed. Payment required within 3 Calendar Days of Debit Note date.</span></p>
  {% endif %}
  <p>&nbsp;&nbsp;Currency: {{ order.currency_code }}</p>
</div>

<div class="section-title">{{ section_numbers.documents_provided }}. DOCUMENTS TO BE PROVIDED</div>
<div class="numbered-block">
  <p><strong>Upon shipment, the following documents will be provided:</strong></p>
  <p>1.&nbsp;&nbsp;Commercial Invoice (digitally authorised)</p>
  <p>2.&nbsp;&nbsp;Packing List (digitally authorised)</p>
  <p>3.&nbsp;&nbsp;Certificate of Origin — {{ order.coo_type }} — Issued by CAPEXIL</p>
  <p>4.&nbsp;&nbsp;Bill of Lading — 3 originals issued by the shipping line | 2 originals couriered to Buyer within 3 Working Days of Balance Payment being confirmed as Payment Cleared | 1 original retained by NexaCrest</p>
  <p>5.&nbsp;&nbsp;Fumigation Certificate — provided as standard with every shipment</p>
</div>

{% if order.special_requirements %}
<div class="section-title-highlight">SPECIAL REQUIREMENTS / INSTRUCTIONS</div>
<div class="box-highlight-amber">{{ order.special_requirements }}</div>
{% endif %}

{% endblock %}

{% block annexure_appendix %}
{% if order.include_annexure_a and annexure_has_content is defined and annexure_has_content %}
<div class="annexure-appendix-start">
  <div class="section-title">ANNEXURE A</div>
  {% include '_annexure_body.njk' %}
</div>
{% endif %}
{% endblock %}
