{% extends "_layout.njk" %}

{% block meta_table %}
<table class="meta">
  <tr>
    <td class="label">ANNEXURE TO</td><td class="value">{{ order.quotation_ref or order.buyer_inquiry_ref }}</td>
    <td class="label">DATE</td><td class="value">{{ meta.generated_date }}</td>
  </tr>
  <tr>
    <td class="label">BUYER INQUIRY REF</td><td class="value" colspan="3">{{ order.buyer_inquiry_ref }}</td>
  </tr>
</table>
{% endblock %}

{% block body %}

<div class="section-title">2. BUYER</div>
<table class="kv">
  <tr><td class="k">Company Legal Name</td><td class="v">{{ buyer.company_legal_name }}</td></tr>
</table>

<div class="section-title">3. PRODUCT TECHNICAL SPECIFICATIONS</div>
{% for p in annexure_products %}
<div class="annexure-product">
  <div class="annexure-product-title">{{ loop.index }}. {{ p.name }}</div>
  <table class="kv">
    {% if p.description %}<tr><td class="k">Description</td><td class="v">{{ p.description }}</td></tr>{% endif %}
    {% if p.dimensions %}<tr><td class="k">Dimensions</td><td class="v">{{ p.dimensions }}</td></tr>{% endif %}
    {% if p.finish %}<tr><td class="k">Finish</td><td class="v">{{ p.finish }}</td></tr>{% endif %}
    {% if p.components %}<tr><td class="k">Components</td><td class="v">{{ p.components|nl2br }}</td></tr>{% endif %}
    {% if p.technical_notes %}<tr><td class="k">Technical Notes</td><td class="v">{{ p.technical_notes|nl2br }}</td></tr>{% endif %}
  </table>
  {% if p.images.length %}
  <table class="annexure-images">
    <tr>
      {% for img in p.images %}
        {% if img.data_uri %}<td><img src="{{ img.data_uri }}"></td>{% endif %}
      {% endfor %}
    </tr>
  </table>
  {% endif %}
</div>
{% else %}
<p class="muted">No product entries have been added to this Annexure yet.</p>
{% endfor %}

{% endblock %}
