<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  {#
    Deliberately does NOT go through any shared buyer-document layout and
    shares none of its CSS classes or navy/gold brand styling — this
    document must never be visually mistakable for a buyer-facing one,
    even if it somehow ended up in the wrong hands. Plain grayscale,
    heavy red internal-only banners top and bottom instead of a watermark.
  #}
  @page { margin: 0.5in 0.59in; }
  * { box-sizing: border-box; }
  body { font-family: 'Aptos', sans-serif; font-size: 9.5pt; color: #000000; }
  table { border-collapse: collapse; width: 100%; }

  .internal-banner { background: #8A1F1F; color: #FFFFFF; font-weight: bold; font-size: 12pt;
    text-align: center; padding: 8pt; margin-bottom: 10pt; border: 2pt solid #5A1414; }
  .internal-banner .sub { display: block; font-weight: normal; font-size: 8.5pt; margin-top: 3pt; }

  .meta-title { font-size: 14pt; font-weight: bold; color: #17233A; margin-bottom: 2pt; }
  .meta-sub { font-size: 9.5pt; color: #333333; margin-bottom: 10pt; }

  table.meta { margin-bottom: 10pt; }
  table.meta td { border: 1px solid #999999; background: #F2F2F2; padding: 4pt 7pt; vertical-align: top; }
  table.meta .label { font-size: 8pt; color: #555555; display: block; }
  table.meta .value { font-size: 9.5pt; font-weight: bold; color: #17233A; display: block; margin-top: 1pt; }

  .section-title { background: #444444; color: #FFFFFF; font-size: 10.5pt; font-weight: bold;
    padding: 4pt 9pt; margin-top: 10pt; margin-bottom: 6pt; }

  table.data th { background: #666666; color: #FFFFFF; font-size: 8.5pt; font-weight: bold;
    padding: 4pt 6pt; text-align: left; border: 1px solid #666666; }
  table.data td { border: 1px solid #CCCCCC; padding: 4pt 6pt; font-size: 8.5pt; vertical-align: top; }
  table.data tr.totals td { font-weight: bold; background: #EEEEEE; }
  .empty-note { font-style: italic; color: #666666; font-size: 9pt; padding: 6pt 0; }

  .footer-note { margin-top: 14pt; font-size: 8pt; font-style: italic; color: #555555; border-top: 1pt solid #999999; padding-top: 6pt; }
</style>
</head>
<body>

<div class="internal-banner">
  &#9888; INTERNAL USE ONLY — NOT FOR CLIENT / BUYER
  <span class="sub">Do not attach to, forward with, or otherwise include this document alongside any client-facing document.</span>
</div>

<div class="meta-title">CA FINANCIAL ANNEXURE</div>
<div class="meta-sub">Government Export Benefits &amp; Expenses — {{ order.order_reference }} ({{ order.company_legal_name }})</div>

<table class="meta"><tr>
  <td><span class="label">Document Reference</span><span class="value">{{ meta.document_reference }}</span></td>
  <td><span class="label">Revision</span><span class="value">Rev.{{ '%02d'|format(meta.revision_number) }}</span></td>
  <td><span class="label">Generated</span><span class="value">{{ meta.generated_date }}</span></td>
  <td><span class="label">Generated By</span><span class="value">{{ meta.generated_by_name }}</span></td>
</tr></table>

<div class="section-title">GOVERNMENT EXPORT BENEFITS CLAIMED</div>
{% if benefits.length === 0 %}
  <div class="empty-note">No export benefit claims are linked to this order.</div>
{% else %}
<table class="data">
  <tr><th>Scheme</th><th>Reference No.</th><th>Claimed Amount</th><th>Claimed Date</th><th>Received Amount</th><th>Received Date</th><th>Status</th></tr>
  {% set claimedTotal = 0 %}
  {% set receivedTotal = 0 %}
  {% for b in benefits %}
  <tr>
    <td>{{ b.scheme_name }}</td>
    <td>{{ b.reference_number or '—' }}</td>
    <td>{{ b.currency_code }} {{ '%.2f'|format(b.claimed_amount) }}</td>
    <td>{{ b.claimed_at }}</td>
    <td>{% if b.received_amount !== null %}{{ b.currency_code }} {{ '%.2f'|format(b.received_amount) }}{% else %}—{% endif %}</td>
    <td>{{ b.received_at or '—' }}</td>
    <td>{{ 'Received' if b.received_amount !== null else 'Claimed / Pending' }}</td>
  </tr>
  {% set claimedTotal = claimedTotal + b.claimed_amount %}
  {% set receivedTotal = receivedTotal + (b.received_amount or 0) %}
  {% endfor %}
  <tr class="totals"><td colspan="2">TOTAL</td><td>{{ '%.2f'|format(claimedTotal) }}</td><td></td><td>{{ '%.2f'|format(receivedTotal) }}</td><td colspan="2"></td></tr>
</table>
{% endif %}

<div class="section-title">EXPENSES LINKED TO THIS ORDER</div>
{% if expenses.length === 0 %}
  <div class="empty-note">No expenses are linked to this order.</div>
{% else %}
<table class="data">
  <tr><th>Category</th><th>Description</th><th>Vendor</th><th>Amount</th><th>Date</th><th>TDS</th></tr>
  {% set expenseTotal = 0 %}
  {% for e in expenses %}
  <tr>
    <td>{{ e.category }}</td>
    <td>{{ e.description or '—' }}</td>
    <td>{{ e.vendor_name or '—' }}</td>
    <td>{{ e.currency_code }} {{ '%.2f'|format(e.amount) }}</td>
    <td>{{ e.expense_date }}</td>
    <td>{% if e.is_tds_applicable %}Yes — {{ '%.2f'|format(e.tds_amount or 0) }}{% else %}—{% endif %}</td>
  </tr>
  {% set expenseTotal = expenseTotal + e.amount %}
  {% endfor %}
  <tr class="totals"><td colspan="3">TOTAL</td><td>{{ '%.2f'|format(expenseTotal) }}</td><td colspan="2"></td></tr>
</table>
{% endif %}

<div class="footer-note">
  This document is generated for {{ company.legal_name }}'s internal accounting/CA use only. It contains
  government export-benefit and expense data that must never be shared with, forwarded to, printed for, or
  otherwise made accessible to the client/buyer of this order under any circumstances.
</div>

<div class="internal-banner" style="margin-top:14pt;">
  &#9888; INTERNAL USE ONLY — NOT FOR CLIENT / BUYER
</div>

</body>
</html>
