<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  {#
    Deliberately does NOT extend _layout.html.twig and shares none of its
    CSS classes or navy/gold brand styling — this document must never be
    visually mistakable for a buyer-facing one, even if it somehow ended
    up in the wrong hands. Plain grayscale, heavy red internal-only
    banners top and bottom instead of a watermark.
  #}
  @page { margin: 0.5in 0.59in; }
  * { box-sizing: border-box; }
  body { font-family: 'Aptos', sans-serif; font-size: 9.5pt; color: #000000; }
  table { border-collapse: collapse; width: 100%; }

  .internal-banner { background: #8A1F1F; color: #FFFFFF; font-weight: bold; font-size: 12pt;
    text-align: center; padding: 8pt; margin-bottom: 10pt; border: 2pt solid #5A1414; }
  .internal-banner .sub { display: block; font-weight: normal; font-size: 8.5pt; margin-top: 3pt; }

  .meta-title { font-size: 14pt; font-weight: bold; color: #17233A; margin-bottom: 2pt; }
  .meta-sub { font-size: 9.5pt; color: #333333; margin-bottom: 10pt; }

  table.meta { margin-bottom: 10pt; }
  table.meta td { border: 1px solid #999999; background: #F2F2F2; padding: 4pt 7pt; vertical-align: top; }
  table.meta .label { font-size: 8pt; color: #555555; display: block; }
  table.meta .value { font-size: 9.5pt; font-weight: bold; color: #17233A; display: block; margin-top: 1pt; }

  .section-title { background: #444444; color: #FFFFFF; font-size: 10.5pt; font-weight: bold;
    padding: 4pt 9pt; margin-top: 10pt; margin-bottom: 6pt; }

  table.data th { background: #666666; color: #FFFFFF; font-size: 8.5pt; font-weight: bold;
    padding: 4pt 6pt; text-align: left; border: 1px solid #666666; }
  table.data td { border: 1px solid #CCCCCC; padding: 4pt 6pt; font-size: 8.5pt; vertical-align: top; }
  table.data tr.totals td { font-weight: bold; background: #EEEEEE; }
  .empty-note { font-style: italic; color: #666666; font-size: 9pt; padding: 6pt 0; }

  .sub-title { font-size: 9.5pt; font-weight: bold; color: #17233A; margin: 8pt 0 4pt; border-bottom: 1px solid #999999; padding-bottom: 2pt; }
  table.kv td { border: 1px solid #CCCCCC; padding: 3pt 6pt; font-size: 8.5pt; vertical-align: top; }
  table.kv td.k { background: #F2F2F2; color: #555555; width: 22%; }
  table.kv td.v { font-weight: bold; color: #17233A; width: 28%; }
  td.num, th.num { text-align: right; }
  table.pl td { border: 1px solid #CCCCCC; padding: 4pt 8pt; font-size: 9pt; }
  table.pl td.num { width: 28%; }
  table.pl tr.sub td { font-weight: bold; background: #F2F2F2; }
  table.pl tr.grand td { font-weight: bold; background: #DDDDDD; font-size: 10pt; }
  .tag { font-size: 7.5pt; border: 1px solid #999999; padding: 0 4px; border-radius: 3px; color: #444444; }
  .warn { color: #8A1F1F; font-weight: bold; }
  ul.flags { margin: 4pt 0 0 14pt; padding: 0; font-size: 8.5pt; }
  ul.flags li { margin-bottom: 2pt; }
  .footer-note { margin-top: 14pt; font-size: 8pt; font-style: italic; color: #555555; border-top: 1pt solid #999999; padding-top: 6pt; }
</style>
</head>
<body>

<div class="internal-banner">
  &#8252; INTERNAL USE ONLY — NOT FOR CLIENT / BUYER
  <span class="sub">Do not attach to, forward with, or otherwise include this document alongside any client-facing document.</span>
</div>

{# Owner request (2026-10-27, approved mockup, confirmed twice): the complete
   order snapshot, A to F — every value pre-formatted by
   caFinancialSnapshotService so PHP and Node print the same document. #}
<div class="meta-title">CA FINANCIAL ANNEXURE — COMPLETE ORDER SNAPSHOT</div>
<div class="meta-sub">Order details, supplier cost, every expense, government benefits and profit — {{ snapshot.subtitle }}</div>

<table class="meta"><tr>
  <td><span class="label">Document Reference</span><span class="value">{{ meta.document_reference }}</span></td>
  <td><span class="label">Revision</span><span class="value">Rev.{{ '%02d'|format(meta.revision_number) }}</span></td>
  <td><span class="label">Generated</span><span class="value">{{ meta.generated_date }}</span></td>
  <td><span class="label">Generated By</span><span class="value">{{ meta.generated_by_name }}</span></td>
</tr></table>

<div class="section-title">A. ORDER DETAILS</div>
<table class="kv">
  {% for r in snapshot.details %}
  <tr><td class="k">{{ r[0] }}</td><td class="v">{{ r[1] }}</td><td class="k">{{ r[2] }}</td><td class="v">{{ r[3] }}</td></tr>
  {% endfor %}
</table>
<div class="sub-title">Products</div>
{% if not snapshot.products.length %}
  <div class="empty-note">No products on this order.</div>
{% else %}
<table class="data">
  <tr><th>Description</th><th>HS Code</th><th class="num">Quantity</th><th class="num">Unit Price</th><th class="num">Amount ({{ snapshot.currency }})</th></tr>
  {% for p in snapshot.products %}
  <tr><td>{{ p.description }}</td><td>{{ p.hs_code }}</td><td class="num">{{ p.quantity }}</td><td class="num">{{ p.unit_price }}</td><td class="num">{{ p.amount }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="4">TOTAL FOB</td><td class="num">{{ snapshot.fob_total }}</td></tr>
</table>
{% endif %}
<div class="sub-title">Money received from the buyer</div>
{% if not snapshot.receipts.length %}
  <div class="empty-note">No payment received from the buyer yet.</div>
{% else %}
<table class="data">
  <tr><th>Leg</th><th class="num">Amount ({{ snapshot.currency }})</th><th class="num">Rate (&#8377;)</th><th class="num">INR</th><th>Received</th><th>Cleared</th><th>Basis</th></tr>
  {% for r in snapshot.receipts %}
  <tr><td>{{ r.leg }}</td><td class="num">{{ r.amount }}</td><td class="num">{{ r.rate }}</td><td class="num">{{ r.inr }}</td><td>{{ r.received }}</td><td>{{ r.cleared }}</td><td>{{ r.basis }}</td></tr>
  {% endfor %}
  <tr class="totals"><td>TOTAL</td><td class="num">{{ snapshot.receipts_foreign }}</td><td></td><td class="num">{{ snapshot.receipts_inr }}</td><td colspan="3"></td></tr>
</table>
{% endif %}

<div class="section-title">B. SUPPLIER COST</div>
{% if not snapshot.supplier %}
  <div class="empty-note">No Supplier PO exists for this order.</div>
{% else %}
<table class="kv">
  {% for r in snapshot.supplier.rows %}
  <tr><td class="k">{{ r[0] }}</td><td class="v">{{ r[1] }}</td><td class="k">{{ r[2] }}</td><td class="v">{{ r[3] }}</td></tr>
  {% endfor %}
</table>
<div class="sub-title">Supplier bills &amp; payments</div>
{% if not snapshot.supplier.bills.length %}
  <div class="empty-note">No supplier bills or payments recorded yet.</div>
{% else %}
<table class="data">
  <tr><th>Leg</th><th>Bill / Invoice</th><th class="num">Taxable &#8377;</th><th class="num">GST &#8377;</th><th class="num">Bill Total &#8377;</th><th>Paid</th><th>Mode · UTR</th></tr>
  {% for b in snapshot.supplier.bills %}
  <tr><td>{{ b.leg }}</td><td>{{ b.bill }}</td><td class="num">{{ b.taxable }}</td><td class="num">{{ b.gst }}</td><td class="num">{{ b.total }}</td><td{% if b.unpaid %} class="warn"{% endif %}>{{ b.paid }}</td><td>{{ b.utr }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="4">TOTAL PAID TO SUPPLIER</td><td class="num">{{ snapshot.supplier.paid_total }}</td><td colspan="2">{{ snapshot.supplier.paid_check }}</td></tr>
</table>
{% endif %}
{% endif %}

<div class="section-title">C. EXPENSES — EVERY COST OF THIS ORDER</div>
<div class="sub-title">C1. Freight &amp; insurance</div>
<table class="data">
  <tr><th>Item</th><th>Source</th><th class="num">Amount (INR)</th></tr>
  {% for r in snapshot.freight_rows %}
  <tr><td>{{ r[0] }}</td><td>{{ r[1] }}</td><td class="num">{{ r[2] }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="2">SUBTOTAL</td><td class="num">{{ snapshot.c1_total }}</td></tr>
</table>
<div class="sub-title">C2. Logistics partner bills — CHA / transport / freight forwarder</div>
{% if not snapshot.logistics.length %}
  <div class="empty-note">No logistics partner bills recorded yet.</div>
{% else %}
<table class="data">
  <tr><th>Partner</th><th>For</th><th>Bill / Invoice</th><th class="num">Bill Total &#8377;</th><th>Paid</th><th>Mode · UTR</th></tr>
  {% for b in snapshot.logistics %}
  <tr><td>{{ b.partner }}</td><td>{{ b.for }}</td><td>{{ b.bill }}</td><td class="num">{{ b.total }}</td><td{% if b.unpaid %} class="warn"{% endif %}>{{ b.paid }}</td><td>{{ b.utr }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="3">SUBTOTAL (excluding ocean freight, counted in C1)</td><td class="num">{{ snapshot.logistics_total }}</td><td colspan="2">Paid &#8377;{{ snapshot.logistics_paid }} · Due &#8377;{{ snapshot.logistics_due }}</td></tr>
</table>
{% endif %}
<div class="sub-title">C3. Other order costs (Step 12a)</div>
{% if not snapshot.costs.length %}
  <div class="empty-note">No other order costs recorded.</div>
{% else %}
<table class="data">
  <tr><th>Category</th><th>Description</th><th class="num">Amount (INR)</th><th>Date</th><th>Recorded By</th></tr>
  {% for c in snapshot.costs %}
  <tr><td>{{ c.category }}{% if c.tag %} <span class="tag">{{ c.tag }}</span>{% endif %}</td><td>{{ c.description }}</td><td class="num">{{ c.amount }}</td><td>{{ c.date }}</td><td>{{ c.by }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="2">SUBTOTAL</td><td class="num">{{ snapshot.costs_total }}</td><td colspan="2"></td></tr>
</table>
{% endif %}
<div class="sub-title">C4. Order expenses with receipts (travel, hotel, courier, …)</div>
{% if not snapshot.expenses.length %}
  <div class="empty-note">No expenses recorded yet — while there are none, travel uses the provisional % in C3. Once real travel expenses are added, they replace it.</div>
{% else %}
<table class="data">
  <tr><th>Date</th><th>Category</th><th>Details</th><th class="num">Amount (INR)</th><th>Paid By</th><th>Receipt</th></tr>
  {% for e in snapshot.expenses %}
  <tr><td>{{ e.date }}</td><td>{{ e.category }}</td><td>{{ e.details }}</td><td class="num">{{ e.amount }}</td><td>{{ e.paid_by }}</td><td>{{ e.receipt }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="3">SUBTOTAL</td><td class="num">{{ snapshot.expenses_total }}</td><td colspan="2"></td></tr>
</table>
{% endif %}
<div class="sub-title">C5. Expenses booked in Zoho Books (linked to this order)</div>
{% if not snapshot.zoho.length %}
  <div class="empty-note">None linked to this order.</div>
{% else %}
<table class="data">
  <tr><th>Category</th><th>Description</th><th>Vendor</th><th class="num">Amount</th><th>Date</th></tr>
  {% for z in snapshot.zoho %}
  <tr><td>{{ z.category }}{% if z.tag %} <span class="tag">{{ z.tag }}</span>{% endif %}</td><td>{{ z.description }}</td><td>{{ z.vendor }}</td><td class="num">{{ z.amount }}</td><td>{{ z.date }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="3">SUBTOTAL (counted in this order's cost)</td><td class="num">{{ snapshot.zoho_total }}</td><td></td></tr>
</table>
{% endif %}
<div class="sub-title">Expenses summary</div>
<table class="data">
  <tr><th>Group</th><th class="num">Amount (INR)</th></tr>
  {% for r in snapshot.summary %}
  <tr><td>{{ r[0] }}</td><td class="num">{{ r[1] }}</td></tr>
  {% endfor %}
  <tr class="totals"><td>TOTAL EXPENSES (excluding supplier)</td><td class="num">{{ snapshot.expenses_grand }}</td></tr>
</table>

<div class="section-title">D. GOVERNMENT EXPORT BENEFITS</div>
{% if not snapshot.benefits.length %}
  <div class="empty-note">No export benefit claims are linked to this order.</div>
{% else %}
<table class="data">
  <tr><th>Scheme</th><th>Reference No.</th><th class="num">Claimed</th><th>Claimed Date</th><th class="num">Received</th><th>Received Date</th><th>Status</th></tr>
  {% for b in snapshot.benefits %}
  <tr><td>{{ b.scheme }}</td><td>{{ b.reference }}</td><td class="num">{{ b.claimed }}</td><td>{{ b.claimed_date }}</td><td class="num">{{ b.received }}</td><td>{{ b.received_date }}</td><td>{{ b.status }}</td></tr>
  {% endfor %}
  <tr class="totals"><td colspan="2">TOTAL</td><td class="num">{{ snapshot.benefits_claimed }}</td><td></td><td class="num">{{ snapshot.benefits_received }}</td><td colspan="2"></td></tr>
</table>
{% endif %}

<div class="section-title">E. PROFIT</div>
<table class="pl">
  {% for r in snapshot.pl %}
  <tr{% if r[0] != 'line' %} class="{{ r[0] }}"{% endif %}><td>{{ r[1] }}{% if r[2] %} <span class="tag">{{ r[2] }}</span>{% endif %}</td><td class="num">{{ r[3] }}</td></tr>
  {% endfor %}
</table>
<div class="sub-title">Cash position so far (money actually in and out)</div>
<table class="data">
  <tr><th>Received from buyer</th><th>Benefits received</th><th>Paid to supplier</th><th>Paid to logistics</th><th>Expenses</th><th>Net so far</th></tr>
  <tr>{% for v in snapshot.cash %}<td class="num">{% if loop.last %}<b>{{ v }}</b>{% else %}{{ v }}{% endif %}</td>{% endfor %}</tr>
</table>

<div class="section-title">F. OPEN ITEMS FOR THE CA</div>
<ul class="flags">
  {% for f in snapshot.open %}
  <li{% if f.warn %} class="warn"{% endif %}>{{ f.text }}</li>
  {% endfor %}
</ul>

<div class="footer-note">This document is generated for NexaCrest International Private Limited's internal accounting/CA use only. It contains order, supplier-cost, expense, government-benefit and profitability data that must never be shared with, forwarded to, printed for, or otherwise made accessible to the client/buyer of this order under any circumstances.</div>

</body>
</html>
