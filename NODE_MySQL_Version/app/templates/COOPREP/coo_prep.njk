{% extends "_layout.njk" %}

{% block header_incoterm %}{% endblock %}

{% block meta_table %}
<table class="meta">
  <tr>
    <td><span class="label">SHIPMENT REF *</span><span class="value">{{ order.pi_ref or '—' }}</span></td>
    <td><span class="label">DATE PREPARED *</span><span class="value">{{ meta.generated_date }}</span></td>
    <td><span class="label">COO TYPE *</span><span class="value">{{ order.coo_type }}</span></td>
    <td><span class="label">BUYER INQUIRY REF *</span><span class="value">{{ order.buyer_inquiry_ref }}</span></td>
  </tr>
</table>
{% endblock %}

{% block banner %}
<div class="box-info-blue"><strong>Internal use only — not sent to buyer.</strong> <em>Complete this sheet before requesting COO from CAPEXIL. Hand to your CHA along with the documents listed below. COO is issued by CAPEXIL — not by NexaCrest.</em></div>
{% endblock %}

{% block section1 %}{% endblock %}

{% block signature_block %}{% endblock %}

{% block body %}

<div class="section-title">1. DOCUMENTS TO SUBMIT TO CAPEXIL / CHA</div>
<p class="placeholder-italic" style="font-size:9pt;">Tick each item once collected and ready. Do not apply for COO until all mandatory items are ticked.</p>
<table class="checklist">
  <tr><th style="width:6%;">&#10003;</th><th>Document</th><th>What to check before submitting</th><th>Where it comes from</th></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>Commercial Invoice (signed copy)</strong></td><td>Must be signed and stamped. Values, HS code, buyer/seller details must be final — no estimates.</td><td>{{ order.ci_ref or 'NexaCrest_05_CommercialInvoice.docx' }}</td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>Packing List (signed copy)</strong></td><td>Crate count, weights, CBM must be actuals — not estimates from PI.</td><td>NexaCrest_04_PackingList.docx</td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>Fumigation Certificate (copy)</strong></td><td>Provided as standard with every NexaCrest shipment — collect from fumigation agency and include with COO application.</td><td>Fumigation agency — standard every shipment</td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>Shipping Bill (copy)</strong></td><td>Filed by CHA with Indian customs. Do not apply for COO before Shipping Bill is filed.</td><td>CHA provides after filing</td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>Bill of Lading (copy)</strong></td><td>BL number, date, vessel name, port of loading/discharge must match CI and PL exactly.</td><td>Shipping line / CHA provides</td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>RCMC Certificate (copy)</strong></td><td>NexaCrest RCMC issued by CAPEXIL — already obtained. Check validity date has not expired.</td><td><strong>Already obtained — check validity</strong></td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>IEC Certificate (copy)</strong></td><td>NexaCrest IEC — {{ company.iec_pan }} — already obtained.</td><td><strong>Already obtained</strong></td></tr>
  <tr><td class="chk checkbox-row"><span class="cbx"></span></td><td><strong>GSP Declaration (if GSP Form A)</strong></td><td>Self-declaration of origin criteria — required for GSP Form A only. CHA will advise the format.</td><td>Required for GSP Form A only</td></tr>
</table>

<div class="section-title">2. INFORMATION REQUIRED ON THE COO APPLICATION</div>
<p class="placeholder-italic" style="font-size:9pt;">All values below must match the Commercial Invoice and Packing List exactly. Any mismatch causes rejection.</p>
{% set productList = [] %}
{% set hsCodeList = [] %}
{% for p in products %}
  {% set productList = productList.concat([p.description ~ ((', ' ~ p.finish) if p.finish else '')]) %}
  {% set hsCodeList = hsCodeList.concat([p.hs_code]) %}
{% endfor %}
<table class="checklist">
  <tr><th>Field</th><th>Value for this shipment *</th><th>Source document</th></tr>
  <tr><td><strong>Exporter — Legal Name *</strong></td><td>{{ company.legal_name }}</td><td class="placeholder-italic">Hardcoded — never changes</td></tr>
  <tr><td><strong>Exporter — Registered Address *</strong></td><td>{{ company.registered_office }}</td><td class="placeholder-italic">Hardcoded — never changes</td></tr>
  <tr><td><strong>Exporter — GSTIN *</strong></td><td>{{ company.gstin }}</td><td class="placeholder-italic">Hardcoded — never changes</td></tr>
  <tr><td><strong>Exporter — IEC *</strong></td><td>{{ company.iec_pan }}</td><td class="placeholder-italic">Hardcoded — never changes</td></tr>
  <tr><td><strong>Consignee — Legal Name *</strong></td><td>{{ buyer.company_legal_name }}</td><td class="placeholder-italic">Commercial Invoice Section 2</td></tr>
  <tr><td><strong>Consignee — Address *</strong></td><td>{{ buyer.consignee_address or buyer.billing_address }}</td><td class="placeholder-italic">Commercial Invoice Section 2</td></tr>
  <tr><td><strong>Consignee — Country *</strong></td><td>{{ buyer.country_of_destination or 'TBC' }}</td><td class="placeholder-italic">Commercial Invoice Section 2</td></tr>
  <tr><td><strong>Vessel Name &amp; Voyage No. *</strong></td><td>{{ shipping.vessel_name or 'TBC' }}{{ (' / V.' ~ shipping.voyage_number) if shipping.voyage_number else '' }}</td><td class="placeholder-italic">Bill of Lading</td></tr>
  <tr><td><strong>Port of Loading *</strong></td><td>{{ order.port_of_loading }}</td><td class="placeholder-italic">Hardcoded — never changes</td></tr>
  <tr><td><strong>Port of Discharge *</strong></td><td>{{ order.port_of_discharge }}</td><td class="placeholder-italic">Bill of Lading / Commercial Invoice Section 3</td></tr>
  <tr><td><strong>Bill of Lading No. *</strong></td><td>{{ shipping.bl_number or 'TBC' }}</td><td class="placeholder-italic">Bill of Lading</td></tr>
  <tr><td><strong>Bill of Lading Date *</strong></td><td>{{ shipping.bl_date or 'TBC — same as CI date' }}</td><td class="placeholder-italic">Bill of Lading / Commercial Invoice</td></tr>
  <tr><td><strong>Product Description *</strong></td><td>{{ productList|join('; ') }}</td><td class="placeholder-italic">Commercial Invoice Section 4</td></tr>
  <tr><td><strong>HS Code *</strong></td><td>{{ hsCodeList|join(', ') }}</td><td class="placeholder-italic">Hardcoded — verify against CI</td></tr>
  <tr><td><strong>Country of Origin *</strong></td><td>India</td><td class="placeholder-italic">Hardcoded — never changes</td></tr>
  <tr><td><strong>No. of Packages *</strong></td><td>{{ (packing.crate_count ~ ' Wooden Crates') if packing.crate_count else 'TBC' }}</td><td class="placeholder-italic">Packing List Section 3 / BL</td></tr>
  <tr><td><strong>Gross Weight *</strong></td><td>{{ (packing.total_gross_weight_kg ~ ' kg') if packing.total_gross_weight_kg else 'TBC' }}</td><td class="placeholder-italic">Packing List Section 3</td></tr>
  <tr><td><strong>Net Weight *</strong></td><td>{{ (packing.total_net_weight_kg ~ ' kg') if packing.total_net_weight_kg else 'TBC' }}</td><td class="placeholder-italic">Packing List Section 3</td></tr>
  <tr><td><strong>Total CBM *</strong></td><td>{{ (packing.total_cbm ~ ' m³') if packing.total_cbm else 'TBC' }}</td><td class="placeholder-italic">Packing List Section 3</td></tr>
  <tr><td><strong>FOB Value *</strong></td><td>{{ order.currency_code }} {{ financial.fob_value }}</td><td class="placeholder-italic">Commercial Invoice Section 4</td></tr>
  <tr><td><strong>Invoice No. &amp; Date *</strong></td><td>{{ order.ci_ref or 'TBC' }} — {{ order.ci_date or 'TBC' }}</td><td class="placeholder-italic">Commercial Invoice meta bar</td></tr>
  <tr><td><strong>Origin Criteria (GSP Form A only)</strong></td><td>Usually 'P' for wholly produced, or 'W/{{ hsCodeList|first }}' for worked in India — CHA advises</td><td class="placeholder-italic">Required for GSP Form A only</td></tr>
  <tr><td><strong>Competent Authority Signature</strong></td><td>Signed and stamped by CAPEXIL authorised officer — not by NexaCrest</td><td class="placeholder-italic">CAPEXIL issues — not your responsibility</td></tr>
</table>

<div class="section-title">3. STEP-BY-STEP PROCESS</div>
<table class="checklist">
  <tr><td style="width:8%; padding:0;"><span class="step-no">Step 1</span></td><td>Confirm COO type with buyer (GSP Form A or non-preferential) — ideally at Quotation/PI stage.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 2</span></td><td>Cargo packed. Packing List finalised with actuals. CHA files Shipping Bill with customs.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 3</span></td><td>Shipment booked. Bill of Lading issued by shipping line.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 4</span></td><td>Complete this preparation sheet — fill Section 2 values from CI, PL, and BL.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 5</span></td><td>Collect all documents listed in Section 1. Tick each checkbox.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 6</span></td><td>Submit complete package to CHA — or apply directly on the CAPEXIL portal (www.capexil.com). CHA handles this in most cases.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 7</span></td><td>CAPEXIL verifies and issues COO — typically 1–3 working days.</td></tr>
  <tr><td style="padding:0;"><span class="step-no">Step 8</span></td><td>COO received. Include with shipment documents sent to buyer (along with CI, PL, BL).</td></tr>
</table>

<div class="section-title">4. NEXACREST CAPEXIL REGISTRATION DETAILS</div>
<table class="kv">
  <tr><td class="k">Prepared By *</td><td class="v placeholder-italic">Name of person completing this sheet</td></tr>
  <tr><td class="k">RCMC Issuing Body</td><td class="v">CAPEXIL — Chemicals and Allied Products Export Promotion Council</td></tr>
  <tr><td class="k">Member Company</td><td class="v">{{ company.legal_name }}</td></tr>
  <tr><td class="k">IEC</td><td class="v">{{ company.iec_pan }}</td></tr>
  <tr><td class="k">RCMC Number *</td><td class="v">{{ company.rcmc_number }}</td></tr>
  <tr><td class="k">RCMC Valid Until *</td><td class="v">{{ company.rcmc_valid_until|date('d F Y') }}</td></tr>
  <tr><td class="k">CAPEXIL Portal</td><td class="v">www.capexil.com — COO applications can be submitted online</td></tr>
  <tr><td class="k">CAPEXIL Office</td><td class="v">Chennai Regional Office handles granite/stone exporters from Karnataka — confirm with CHA</td></tr>
</table>
<div class="box-warning-amber">&#9888; <strong>Annual renewal:</strong> RCMC must be renewed annually. If RCMC expires, CAPEXIL cannot issue a COO — your shipment documents will be incomplete and customs clearance will fail. Set a reminder 60 days before expiry.</div>

{% endblock %}
