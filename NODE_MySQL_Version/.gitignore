# Real secrets — SMTP/DB credentials, encryption/session keys. Never committed.
# Copy app/.env.example to app/.env and fill in real values instead.
app/.env

# app/node_modules/ is intentionally NOT ignored — this package ships with
# npm dependencies already installed, by explicit design, so a
# non-developer can deploy without running npm install (see README).

# Runtime-generated documents (PDFs/DOCX per order) and scratch files —
# not source, and can contain buyer data that shouldn't sit in git history.
storage/clients/*
storage/associates/*
storage/temp/*
storage/logs/*
storage/internal/reference_library/*
!storage/clients/.gitkeep
!storage/temp/.gitkeep
!storage/logs/.gitkeep
!storage/internal/reference_library/.gitkeep

# Puppeteer's own browser download cache, if ever regenerated locally.
app/.browser-cache/

# External QA report L-45: documentImageOptimizer's resized/recompressed
# copy of each embedded logo/signature/seal/watermark/Annexure-photo —
# regenerated automatically (keyed by the source file's own path+mtime),
# never hand-edited, not source.
storage/pdf_image_cache/*
!storage/pdf_image_cache/.gitkeep

# Per-user signature/seal uploads (signatoryController.uploadUserAsset) —
# named signature_user<id>_<timestamp>_<hash>.<ext> /
# designation_seal_user<id>_<timestamp>_<hash>.<ext>, written here by
# anyone (including the integration test suite, which exercises the real
# upload path against the live storage dir) who uploads one; the seeded
# default signatures/seals in this same folder keep their own plain
# names and are unaffected.
storage/assets/signatures/signature_user*
storage/assets/designation_seals/designation_seal_user*

# Scratch files the integration test suite writes via the real upload/
# file-store path (e.g. uploadFileFixture() in tests/support) — not
# source, regenerated on every test run.
storage/test/*
!storage/test/.gitkeep

# OS/editor noise
.DS_Store
*.swp
